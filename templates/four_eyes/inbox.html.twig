{% extends 'base.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}

{% block title %}{{ 'four_eyes.inbox.title'|trans({}, 'four_eyes') }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {{ _fa_page_header.render({
        title: 'four_eyes.inbox.title'|trans({}, 'four_eyes'),
        subtitle: 'four_eyes.inbox.lead'|trans({}, 'four_eyes')
    }) }}

    {% if requests is empty %}
        {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'success', icon: 'status-ok' } } %}
            {% block alert_body %}{{ 'four_eyes.inbox.empty'|trans({}, 'four_eyes') }}{% endblock %}
        {% endembed %}
    {% else %}
        <div class="list-group">
            {% for r in requests %}
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fa-status-pill fa-status-pill--primary">
                                    {{ ('four_eyes.action.' ~ r.actionType)|trans({}, 'four_eyes') }}
                                </span>
                                <strong>#{{ r.id }}</strong>
                                <span class="text-muted">·</span>
                                <small class="text-muted">
                                    {{ 'four_eyes.requested_by'|trans({}, 'four_eyes') }}
                                    {{ r.requestedBy.fullName|default(r.requestedBy.email) }}
                                </small>
                            </div>
                            <div class="small">
                                {{ 'four_eyes.expires_at'|trans({}, 'four_eyes') }}: {{ r.expiresAt|fa_datetime }}
                            </div>
                            <pre class="small bg-body-secondary p-2 mt-2 mb-0">{{ r.payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            {% include 'four_eyes/_decision_buttons.html.twig' with { requestId: r.id } only %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_four_eyes_edit', { id: r.id }) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                                    <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i>
                                    {{ 'four_eyes.reassign_approver'|trans({}, 'four_eyes') }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {% include 'four_eyes/_reject_modal.html.twig' with { requestId: r.id } only %}
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
