{# Four-eyes reject dialog for one request; used by the four-eyes inbox and My Day. #}
{% import '_macros/workflow.html.twig' as workflow_macros %}
{{ workflow_macros.decision_modal({
    id: 'fourEyesReject' ~ requestId,
    tone: 'danger',
    title: 'four_eyes.reject_modal.title'|trans({}, 'four_eyes'),
    submit_label: 'four_eyes.reject'|trans({}, 'four_eyes'),
    action: path('app_four_eyes_reject', { id: requestId }),
    token: csrf_token('four_eyes_reject_' ~ requestId),
    field: { name: 'reason', label: 'four_eyes.reject_modal.reason'|trans({}, 'four_eyes'), required: true, minlength: 20 },
}) }}
