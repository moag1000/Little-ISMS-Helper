{% extends 'admin/layout.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block admin_title %}{{ 'permission.title'|trans({}, 'messages') }}{% endblock %}
{% block admin_subtitle %}
    <p class="text-muted">{{ 'permission.subtitle'|trans({}, 'messages') }}</p>
{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'admin.nav.permissions'|trans({}, 'admin') }}</li>
{% endblock %}

{% block admin_content %}
    {{ _fa_page_header.render({
        title: 'permission.title'|trans({}, 'messages'),
        subtitle: 'permission.subtitle'|trans({}, 'messages')
    }) }}

    <div>
    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('permission_index'),
        filter_keys: ['category'],
        list_title: 'permission.list'|trans({}, 'messages'),
        empty: { mood: 'sleeping', title: 'role_management.permissions.no_results'|trans({}, 'role_management') },
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label for="permission-category" class="form-label">{{ 'permission.category'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="permission-category" name="category" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                    {% for category in categories %}
                        <option value="{{ category }}"{{ app.request.query.get('category') == category ? ' selected' : '' }}>{{ category|title }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if system_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'permission.summary.system'|trans({'%count%': system_count}, 'messages') }}</span>{% endif %}
            {% if custom_count > 0 %}<span class="fa-status-pill fa-status-pill--neutral">{{ 'permission.summary.custom'|trans({'%count%': custom_count}, 'messages') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                {% block table_head %}
                    <tr>
                        <th scope="col">{{ 'permission.action'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'permission.category'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'permission.description'|trans({}, 'messages') }}</th>
                        <th scope="col" class="text-center">{{ 'permission.system_permission'|trans({}, 'messages') }}</th>
                        <th scope="col" class="text-end">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body %}
                    {% for permission in page %}
                        <tr>
                            <td><code>{{ permission.name }}</code></td>
                            <td>{{ permission.category|title }}</td>
                            <td>{{ permission.description }}</td>
                            <td class="text-center">
                                {% if permission.isSystemPermission %}
                                    {% include '_components/_badge.html.twig' with { variant: 'info', content: 'permission.statistics.system'|trans({}, 'messages') } only %}
                                {% else %}
                                    {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'permission.statistics.custom'|trans({}, 'messages') } only %}
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('permission_show', {id: permission.id}) }}"
                                   class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost">
                                    <i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i> {{ 'common.details'|trans({}, 'messages') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
    </div>
{% endblock %}
