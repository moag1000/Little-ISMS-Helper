<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ config.name }} - {{ 'pdf.report.title'|trans({}, 'compliance_wizard') }}</title>
    <style>
        :root {
            --primary:       #0ea5e9;
            --surface:       var(--surface)fff;
            --surface-2:     #f1f5f9;
            --fg:            #0f172a;
            --fg-2:          #475569;
            --fg-3:          var(--fg-3);
            --border:        #cbd5e1;
            --success:       #166534;
            --success-tint:  #dcfce7;
            --danger:        #991b1b;
            --danger-tint:   #fecaca;
            --warning:       #92400e;
            --warning-tint:  #fef3c7;
            --info-tint:     var(--info-tint);
            --info-text:     var(--info-text);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11pt;
            line-height: 1.5;
            color: var(--fg);
            padding: 20px 40px;
        }
        .header {
            border-bottom: 3px solid var(--primary);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header h1 {
            font-size: 24pt;
            color: var(--primary);
            margin-bottom: 5px;
        }
        .header .subtitle {
            color: var(--fg-2);
            font-size: 12pt;
        }
        .meta-info {
            background: var(--surface-2);
            padding: 15px;
            margin-bottom: 30px;
            border-radius: 5px;
        }
        .meta-info table {
            width: 100%;
        }
        .meta-info td {
            padding: 5px 10px;
        }
        .meta-info .label {
            font-weight: bold;
            color: var(--fg-2);
            width: 150px;
        }
        .score-box {
            text-align: center;
            padding: 30px;
            margin: 30px 0;
            border-radius: 10px;
        }
        .score-box.compliant { background: var(--success-tint); border: 2px solid var(--success); }
        .score-box.partial { background: var(--surface)3cd; border: 2px solid var(--warning); }
        .score-box.in_progress { background: var(--info-tint); border: 2px solid var(--primary); }
        .score-box.non_compliant { background: var(--danger-tint); border: 2px solid var(--danger); }
        .score-box .score {
            font-size: 48pt;
            font-weight: bold;
        }
        .score-box.compliant .score { color: var(--success); }
        .score-box.partial .score { color: var(--warning); }
        .score-box.in_progress .score { color: var(--info-text); }
        .score-box.non_compliant .score { color: var(--danger); }
        .score-box .status {
            font-size: 14pt;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        h2 {
            color: var(--primary);
            font-size: 16pt;
            margin: 30px 0 15px 0;
            padding-bottom: 5px;
            border-bottom: 1px solid var(--border);
        }
        h3 {
            font-size: 12pt;
            margin: 20px 0 10px 0;
        }
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        table.data-table th,
        table.data-table td {
            border: 1px solid var(--border);
            padding: 8px 12px;
            text-align: left;
        }
        table.data-table th {
            background: var(--surface-2);
            font-weight: bold;
        }
        table.data-table tr:nth-child(even) {
            background: var(--surface-2);
        }
        .progress-bar {
            background: var(--border);
            border-radius: 4px;
            height: 10px;
            overflow: hidden;
        }
        .progress-bar .fill {
            height: 100%;
            border-radius: 4px;
        }
        .progress-bar .fill.success { background: var(--success); }
        .progress-bar .fill.warning { background: var(--warning); }
        .progress-bar .fill.danger { background: var(--danger); }
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 9pt;
            font-weight: bold;
        }
        .badge.success { background: var(--success-tint); color: var(--success); }
        .badge.warning { background: var(--surface)3cd; color: var(--warning); }
        .badge.danger { background: var(--danger-tint); color: var(--danger); }
        .gap-item {
            background: var(--surface)3cd;
            border-left: 4px solid var(--warning);
            padding: 10px 15px;
            margin: 10px 0;
        }
        .gap-item.critical {
            background: var(--danger-tint);
            border-left-color: var(--danger);
        }
        .gap-item strong {
            display: block;
            margin-bottom: 5px;
        }
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            font-size: 9pt;
            color: var(--fg-2);
            text-align: center;
        }
        .page-break {
            page-break-before: always;
        }
        @media print {
            body { padding: 0; }
            .page-break { page-break-before: always; }
        }
    </style>
</head>
<body>
    {% set _wd = 'wizard' %}
    {# Header #}
    <div class="header">
        <h1>{{ config.name }}</h1>
        <div class="subtitle">{{ 'pdf.report.title'|trans({}, 'compliance_wizard') }}</div>
    </div>

    {# Meta Information #}
    <div class="meta-info">
        <table>
            <tr>
                <td class="label">{{ 'pdf.report.framework'|trans({}, 'compliance_wizard') }}</td>
                <td>{{ config.name }} ({{ config.code }})</td>
                <td class="label">{{ 'pdf.report.assessment_date'|trans({}, 'compliance_wizard') }}</td>
                <td>{{ generated_at|fa_datetime }}</td>
            </tr>
            <tr>
                <td class="label">{{ 'pdf.report.organization'|trans({}, 'compliance_wizard') }}</td>
                <td>{{ tenant ? tenant.name : '—' }}</td>
                <td class="label">{{ 'pdf.report.categories_assessed'|trans({}, 'compliance_wizard') }}</td>
                <td>{{ result.categories|length }}</td>
            </tr>
        </table>
    </div>

    {# Overall Score #}
    <div class="score-box {{ result.status }}">
        <div class="score">{{ result.overall_score }}%</div>
        <div class="status">
            {{ ('wizard.status.' ~ result.status)|trans({}, 'wizard') }}
        </div>
    </div>

    {# Executive Summary #}
    <h2>{{ 'pdf.report.summary_heading'|trans({}, 'compliance_wizard') }}</h2>
    <p>
        {{ 'pdf.report.summary_scope'|trans({'%count%': result.categories|length, '%framework%': config.name}, 'compliance_wizard') }}
        {{ 'pdf.report.summary_score'|trans({}, 'compliance_wizard') }} <strong>{{ result.overall_score }}%</strong>.
        {% if result.critical_gap_count > 0 %}
        <strong style="color: var(--danger);">{{ result.critical_gap_count }}</strong> {{ 'pdf.report.summary_critical_gaps'|trans({}, 'compliance_wizard') }}
        {% else %}
        {{ 'pdf.report.summary_no_critical_gaps'|trans({}, 'compliance_wizard') }}
        {% endif %}
    </p>

    {# Category Overview #}
    <h2>{{ 'pdf.report.category_results'|trans({}, 'compliance_wizard') }}</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th scope="col">{{ 'pdf.report.col_category'|trans({}, 'compliance_wizard') }}</th>
                <th scope="col" style="width: 100px;">{{ 'pdf.report.col_score'|trans({}, 'compliance_wizard') }}</th>
                <th scope="col" style="width: 150px;">{{ 'pdf.report.col_progress'|trans({}, 'compliance_wizard') }}</th>
                <th scope="col" style="width: 80px;">{{ 'pdf.report.col_gaps'|trans({}, 'compliance_wizard') }}</th>
                <th scope="col" style="width: 100px;">{{ 'pdf.report.col_status'|trans({}, 'compliance_wizard') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for key, category in result.categories %}
            <tr>
                <td><strong>{{ category.name|trans({}, 'wizard') }}</strong></td>
                <td>{{ category.score }}%</td>
                <td>
                    <div class="progress-bar">
                        <div class="fill {% if category.score >= 80 %}success{% elseif category.score >= 60 %}warning{% else %}danger{% endif %}"
                             style="width: {{ category.score }}%;"></div>
                    </div>
                </td>
                <td>{{ category.gap_count }}</td>
                <td>
                    <span class="badge {% if category.score >= 80 %}success{% elseif category.score >= 60 %}warning{% else %}danger{% endif %}">
                        {{ ('wizard.status.' ~ category.status)|trans({}, 'wizard') }}
                    </span>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Critical Gaps #}
    {% if result.critical_gaps|length > 0 %}
    <div class="page-break"></div>
    <h2>{{ 'pdf.report.critical_gaps_heading'|trans({}, 'compliance_wizard') }}</h2>
    {% for gap in result.critical_gaps %}
    <div class="gap-item critical">
        <strong>{{ gap.title|trans({}, gap.translation_domain|default(_wd)) }}</strong>
        {% if gap.description is defined %}
        <p>{{ gap.description|trans(gap.description_params|default({}), gap.translation_domain|default(_wd)) }}</p>
        {% endif %}
        {% if gap.action is defined %}
        <p><strong>{{ 'pdf.report.recommended_action'|trans({}, 'compliance_wizard') }}</strong> {{ gap.action|trans({}, 'wizard') }}</p>
        {% endif %}
        <span class="badge danger">{{ 'pdf.report.priority'|trans({}, 'compliance_wizard') }}: {{ ('pdf.report.priority_value.' ~ gap.priority)|trans({}, 'compliance_wizard') }}</span>
    </div>
    {% endfor %}
    {% endif %}

    {# Detailed Results #}
    <div class="page-break"></div>
    <h2>{{ 'pdf.report.detailed_heading'|trans({}, 'compliance_wizard') }}</h2>

    {% for key, category in result.categories %}
    <h3>{{ category.name|trans({}, 'wizard') }} - {{ category.score }}%</h3>

    <table class="data-table">
        <thead>
            <tr>
                <th scope="col">{{ 'pdf.report.col_check'|trans({}, 'compliance_wizard') }}</th>
                <th scope="col" style="width: 80px;">{{ 'pdf.report.col_score'|trans({}, 'compliance_wizard') }}</th>
                <th scope="col" style="width: 100px;">{{ 'pdf.report.col_status'|trans({}, 'compliance_wizard') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for item_key, item in category.items %}
            <tr>
                <td>
                    {{ item.name|trans({}, item.translation_domain|default(_wd)) }}
                    {% if item.gap %}
                    <br><small style="color: var(--danger);">{{ 'pdf.report.gap'|trans({}, 'compliance_wizard') }}: {{ item.gap.title|trans({}, item.gap.translation_domain|default(item.translation_domain|default(_wd))) }}</small>
                    {% endif %}
                </td>
                <td>{{ item.score }}%</td>
                <td>
                    <span class="badge {% if item.score >= 80 %}success{% elseif item.score >= 50 %}warning{% else %}danger{% endif %}">
                        {{ ('wizard.status.' ~ item.status)|trans({}, 'wizard') }}
                    </span>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if category.gaps|length > 0 %}
    <p><strong>{{ 'pdf.report.category_gaps'|trans({}, 'compliance_wizard') }}</strong></p>
    {% for gap in category.gaps %}
    <div class="gap-item {% if gap.priority == 'critical' %}critical{% endif %}">
        <strong>{{ gap.title|trans({}, gap.translation_domain|default(_wd)) }}</strong>
        {% if gap.description is defined %}
        <p>{{ gap.description|trans(gap.description_params|default({}), gap.translation_domain|default(_wd)) }}</p>
        {% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% endfor %}

    {# Footer #}
    <div class="footer">
        <p>
            {{ 'pdf.report.generated_by'|trans({}, 'compliance_wizard') }} | {{ generated_at|fa_datetime }}<br>
            {{ 'pdf.report.disclaimer'|trans({}, 'compliance_wizard') }}
        </p>
    </div>
</body>
</html>
