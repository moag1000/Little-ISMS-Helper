{% trans_default_domain 'privacy'%}<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ 'processing_activity.title'|trans({}, 'privacy') }}</title>
    <style>
        :root {
            --primary:       var(--primary);
            --surface:       var(--surface);
            --surface-2:     var(--surface-2);
            --fg:            #0f172a;
            --fg-2:          var(--fg-2);
            --fg-3:          var(--fg-3);
            --border:        var(--border);
            --success:       var(--success);
            --success-tint:  var(--success-tint);
            --danger:        var(--danger);
            --danger-tint:   var(--danger-tint);
            --warning:       var(--warning);
            --warning-tint:  var(--warning-tint);
            --info-tint:     var(--info-tint);
            --info-text:     var(--info-text);
        }

        @page {
            margin: 2cm;
            @bottom-right {
                content: "{{ 'pdf.doc_base.page'|trans({}, 'messages') }} " counter(page) " {{ 'pdf.doc_base.of'|trans({}, 'messages') }} " counter(pages);
            }
        }
        body {
            font-family: Arial, sans-serif;
            font-size: 10pt;
            line-height: 1.4;
        }
        h1 {
            font-size: 18pt;
            color: var(--bg);
            border-bottom: 3px solid transparent;
            border-image: linear-gradient(90deg, var(--primary) 0%, var(--accent) 50%, var(--accent) 100%) 1;
            padding-bottom: 10px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }
        h2 {
            font-size: 14pt;
            color: var(--primary);
            margin-top: 25px;
            margin-bottom: 10px;
            page-break-after: avoid;
            border-bottom: 2px solid var(--primary);
            padding-bottom: 5px;
            padding-left: 10pt;
            border-left: 4px solid var(--accent);
        }
        h3 {
            font-size: 12pt;
            color: var(--surface);
            margin-top: 15px;
            margin-bottom: 8px;
            font-weight: bold;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
            page-break-inside: avoid;
        }
        th {
            background: linear-gradient(90deg, var(--bg) 0%, var(--surface) 100%);
            color: var(--primary);
            font-weight: bold;
            padding: 8px;
            text-align: left;
            border: 1px solid var(--border);
            text-transform: uppercase;
            letter-spacing: 0.3pt;
        }
        td {
            padding: 8px;
            border: 1px solid var(--border);
            vertical-align: top;
        }
        .activity {
            page-break-inside: avoid;
            margin-bottom: 30px;
            border: 2px solid var(--border);
            border-left-width: 4px;
            border-left-color: var(--primary);
            padding: 15px;
            background: linear-gradient(135deg, var(--bg) 0%, var(--surface) 100%);
        }
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 9pt;
            font-weight: bold;
            margin-right: 5px;
            letter-spacing: 0.3pt;
            border: 1.5pt solid transparent;
        }
        .badge-danger {
            background: linear-gradient(135deg, var(--danger) 0%, var(--danger) 100%);
            border-color: var(--danger);
            color: var(--surface);
        }
        .badge-warning {
            background: linear-gradient(135deg, var(--warning) 0%, var(--warning) 100%);
            border-color: var(--warning);
            color: var(--surface);
        }
        .badge-success {
            background: linear-gradient(135deg, var(--success) 0%, var(--success) 100%);
            border-color: var(--success);
            color: var(--surface);
        }
        .badge-info {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
            border-color: var(--primary-hover);
            color: var(--surface);
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .metadata {
            background: linear-gradient(135deg, var(--bg) 0%, var(--border) 100%);
            padding: 10px;
            margin-bottom: 20px;
            font-size: 9pt;
            border: 2px solid var(--border);
            border-left: 4px solid var(--primary);
        }
        ul {
            margin: 5px 0;
            padding-left: 20px;
        }
        li {
            margin-bottom: 3px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ 'processing_activity.pdf.heading'|trans({}, 'privacy') }}</h1>
        <p style="font-size: 11pt; color: var(--fg-2);">{{ 'processing_activity.pdf.art_30_title'|trans({}, 'privacy')}}</p>
    </div>

    <div class="metadata">
        <strong>{{ 'processing_activity.pdf.organization'|trans({}, 'privacy') }}:</strong> {{ export.tenant.name }}<br>
        <strong>{{ 'processing_activity.pdf.tenant_code'|trans({}, 'privacy') }}:</strong> {{ export.tenant.code }}<br>
        <strong>{{ 'common.generated'|trans({}, 'messages') }}:</strong> {{ export.generated_at|fa_datetime(true) }}<br>
        <strong>{{ 'processing_activity.pdf.generated_by'|trans({}, 'privacy') }}:</strong> {{ export.generated_by }}<br>
        <strong>{{ 'processing_activity.pdf.total_activities'|trans({}, 'privacy') }}:</strong> {{ export.total_activities }}
    </div>

    <h2>{{ 'processing_activity.pdf.table_of_contents'|trans({}, 'privacy')}}</h2>
    <ul>
        {% for pa in export.processing_activities %}
            <li>{{ loop.index }}. {{ pa.name }} ({{ ('processing_activity.status.' ~ pa.status)|trans({}, 'privacy') }})</li>
        {% endfor %}
    </ul>

    <div style="page-break-before: always;"></div>

    {% for pa in export.processing_activities %}
        <div class="activity">
            <h2>{{ loop.index }}. {{ pa.name }}</h2>

            {% if pa.processes_special_categories %}
                <span class="badge badge-danger">{{ 'processing_activity.pdf.special_categories'|trans({}, 'privacy') }}</span>
            {% endif %}
            {% if pa.has_third_country_transfer %}
                <span class="badge badge-warning">{{ 'processing_activity.pdf.third_country_transfer'|trans({}, 'privacy') }}</span>
            {% endif %}
            {% if pa.requires_dpia and not pa.dpia_completed %}
                <span class="badge badge-danger">{{ 'processing_activity.pdf.badge_dpia_required'|trans({}, 'privacy') }}</span>
            {% endif %}

            {% if pa.description %}
                <p><strong>{{ 'processing_activity.pdf.description'|trans({}, 'privacy') }}:</strong> {{ pa.description }}</p>
            {% endif %}

            <h3>{{ 'processing_activity.pdf.art_30_1b'|trans({}, 'privacy')}}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.processing_activity'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.name }}</td>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.purposes_processing'|trans({}, 'privacy')}}</td>
                    <td>
                        <ul>
                            {% for purpose in pa.purposes %}
                                <li>{{ purpose }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.legal_basis'|trans({}, 'privacy') }}</td>
                    <td>
                        <strong>{{ pa.legal_basis }}</strong>
                        {% if pa.legal_basis_details %}
                            <br>{{ pa.legal_basis_details }}
                        {% endif %}
                    </td>
                </tr>
            </table>

            <h3>{{ 'processing_activity.pdf.art_30_1c'|trans({}, 'privacy')}}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.data_subject_categories'|trans({}, 'privacy') }}</td>
                    <td>
                        <ul>
                            {% for category in pa.data_subject_categories %}
                                <li>{{ category }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.estimated_number'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.estimated_data_subjects_count ?? '—' }}</td>
                </tr>
            </table>

            <h3>{{ 'processing_activity.pdf.art_30_1c_data'|trans({}, 'privacy')}}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.personal_data_categories'|trans({}, 'privacy') }}</td>
                    <td>
                        <ul>
                            {% for category in pa.personal_data_categories %}
                                <li>{{ category }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
                {% if pa.processes_special_categories %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.special_categories'|trans({}, 'privacy') }}</td>
                        <td>
                            <strong style="color: var(--danger);">{{ 'processing_activity.pdf.yes'|trans({}, 'privacy') }}</strong>
                            <ul>
                                {% for detail in pa.special_categories_details ?? [] %}
                                    <li>{{ detail }}</li>
                                {% endfor %}
                            </ul>
                            {% if pa.legal_basis_special_categories %}
                                <br><strong>{{ 'processing_activity.pdf.legal_basis_short'|trans({}, 'privacy') }}:</strong> {{ pa.legal_basis_special_categories }}
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
                {% if pa.processes_criminal_data %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.criminal_data'|trans({}, 'privacy') }}</td>
                        <td><strong style="color: var(--warning);">{{ 'processing_activity.pdf.yes'|trans({}, 'privacy') }}</strong></td>
                    </tr>
                {% endif %}
            </table>

            <h3>{{ 'processing_activity.pdf.art_30_1d'|trans({}, 'privacy')}}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.recipient_categories'|trans({}, 'privacy') }}</td>
                    <td>
                        {% if pa.recipient_categories %}
                            <ul>
                                {% for recipient in pa.recipient_categories %}
                                    <li>{{ recipient }}</li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
                {% if pa.recipient_details %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.specific_recipients'|trans({}, 'privacy') }}</td>
                        <td>{{ pa.recipient_details }}</td>
                    </tr>
                {% endif %}
            </table>

            <h3>{{ 'processing_activity.pdf.art_30_1e'|trans({}, 'privacy')}}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.third_country_transfer'|trans({}, 'privacy') }}</td>
                    <td>
                        {% if pa.has_third_country_transfer %}
                            <strong style="color: var(--warning);">{{ 'processing_activity.pdf.yes'|trans({}, 'privacy') }}</strong>
                        {% else %}
                            {{ 'processing_activity.pdf.no'|trans({}, 'privacy') }}
                        {% endif %}
                    </td>
                </tr>
                {% if pa.has_third_country_transfer %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.countries'|trans({}, 'privacy') }}</td>
                        <td>
                            <ul>
                                {% for country in pa.third_countries ?? [] %}
                                    <li>{{ country }}</li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                    <tr>
                        <td>{{ 'processing_activity.pdf.safeguards'|trans({}, 'privacy') }}</td>
                        <td>{{ pa.transfer_safeguards ?? '—' }}</td>
                    </tr>
                {% endif %}
            </table>

            <h3>{{ 'processing_activity.pdf.art_30_1f'|trans({}, 'privacy') }}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.retention_period'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.retention_period ?? '—' }}</td>
                </tr>
                {% if pa.retention_period_days %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.days'|trans({}, 'privacy') }}</td>
                        <td>{{ pa.retention_period_days }}</td>
                    </tr>
                {% endif %}
                {% if pa.retention_legal_basis %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.legal_basis_retention'|trans({}, 'privacy')}}</td>
                        <td>{{ pa.retention_legal_basis }}</td>
                    </tr>
                {% endif %}
            </table>

            <h3>{{ 'processing_activity.pdf.art_30_1g'|trans({}, 'privacy')}}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.security_measures'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.technical_organizational_measures ?? '—' }}</td>
                </tr>
                {% if pa.implemented_controls|length > 0 %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.iso_controls'|trans({}, 'privacy') }}</td>
                        <td>
                            <ul>
                                {% for control in pa.implemented_controls %}
                                    <li>{{ control.id }} - {{ control.name }}</li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% endif %}
            </table>

            <h3>{{ 'processing_activity.pdf.additional_information'|trans({}, 'privacy') }}</h3>
            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'processing_activity.pdf.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'processing_activity.pdf.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.responsible_department'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.responsible_department ?? '—' }}</td>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.contact_person'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.contact_person ?? '—' }}</td>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.dpo'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.data_protection_officer ?? '—' }}</td>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.status'|trans({}, 'privacy') }}</td>
                    <td>{{ ('processing_activity.status.' ~ pa.status)|trans({}, 'privacy') }}</td>
                </tr>
                <tr>
                    <td>{{ 'processing_activity.pdf.risk_level'|trans({}, 'privacy') }}</td>
                    <td>{{ pa.risk_level ? ('processing_activity.risk_level.' ~ pa.risk_level)|trans({}, 'privacy') : 'processing_activity.pdf.not_assessed'|trans({}, 'privacy') }}</td>
                </tr>
                {% if pa.requires_dpia %}
                    <tr>
                        <td>{{ 'processing_activity.pdf.dpia_required'|trans({}, 'privacy') }}</td>
                        <td>
                            <strong style="color: var(--danger);">{{ 'processing_activity.pdf.yes'|trans({}, 'privacy') }}</strong>
                            {% if pa.dpia_completed %}
                                <span class="badge badge-success">{{ 'processing_activity.pdf.completed'|trans({'%date%': pa.dpia_date}, 'privacy') }}</span>
                            {% else %}
                                <span class="badge badge-danger">{{ 'processing_activity.pdf.pending'|trans({}, 'privacy') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
                <tr>
                    <td>{{ 'processing_activity.pdf.completeness'|trans({}, 'privacy') }}</td>
                    <td>
                        {{ pa.completeness_percentage }}%
                        {% if pa.is_complete %}
                            <span class="badge badge-success">{{ 'processing_activity.pdf.complete'|trans({}, 'privacy') }}</span>
                        {% else %}
                            <span class="badge badge-warning">{{ 'processing_activity.pdf.incomplete'|trans({}, 'privacy') }}</span>
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>

        {% if not loop.last %}
            <div style="page-break-before: always;"></div>
        {% endif %}
    {% endfor %}

    <div style="page-break-before: always;"></div>

    <h2>{{ 'processing_activity.pdf.declaration'|trans({}, 'privacy') }}</h2>
    <p>{{ 'processing_activity.pdf.declaration_text'|trans({'%tenant%': export.tenant.name, '%date%': export.generated_at|fa_date}, 'privacy') }}</p>

    <p style="margin-top: 40px;">
        <strong>{{ 'processing_activity.pdf.signature'|trans({}, 'privacy') }}:</strong> ____________________________<br>
        <strong>{{ 'processing_activity.pdf.date'|trans({}, 'privacy') }}:</strong> ____________________________<br>
        <strong>{{ 'processing_activity.pdf.name_position'|trans({}, 'privacy') }}:</strong> ____________________________
    </p>
</body>
</html>
