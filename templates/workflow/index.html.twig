{% extends 'base.html.twig' %}
{% trans_default_domain 'workflows' %}

{% block title %}{{ 'workflow.title.list'|trans({}, 'workflows') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_feature_card.html.twig' as _fa_feature_card %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_empty_state.html.twig' as _fa_empty_state %}
{% import '_macros/workflow.html.twig' as workflow_macros %}

{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'nav.workflows'|trans({}, 'nav') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'workflow.title.list'|trans({}, 'workflows'),
    subtitle: 'workflow.description.overview'|trans({}, 'workflows'),
    actions: [
        { label: 'workflow.action.definitions'|trans({}, 'workflows'), variant: 'ghost', icon: 'nav-list-check', href: path('app_workflow_definitions') },
        { label: 'workflow.action.pending'|trans({}, 'workflows'), variant: 'primary', icon: 'ui-hourglass', href: path('app_my_day') ~ '#workflows-pending' }
    ]
}) }}

<main>

{# Statistics Cards #}
<div class="kpi-grid">
    <div class="col-auto">
        {{ _fa_feature_card.render({ label: 'workflow.stats.total'|trans({}, 'workflows'), value: statistics.total, variant: 'primary' }) }}
    </div>
    <div class="col-auto">
        {{ _fa_feature_card.render({ label: 'workflow.stats.in_progress'|trans({}, 'workflows'), value: statistics.in_progress, variant: 'info' }) }}
    </div>
    <div class="col-auto">
        {{ _fa_feature_card.render({ label: 'workflow.stats.pending'|trans({}, 'workflows'), value: statistics.pending, variant: 'warning' }) }}
    </div>
    <div class="col-auto">
        {{ _fa_feature_card.render({ label: 'workflow.stats.approved'|trans({}, 'workflows'), value: statistics.approved, variant: 'success' }) }}
    </div>
</div>

{# Quick Links #}
<div class="module-grid mb-4">
    {% embed '_components/_card.html.twig' %}
        {% block card_body %}
            <div class="fs-2-mb-sm"><i class="fa-icon fa-icon--ui-hourglass" aria-hidden="true"></i></div>
            <h2>{{ 'workflow.section.pending'|trans({}, 'workflows') }}</h2>
            <p class="text-muted-mt-xs">
                {{ 'workflow.description.pending'|trans({}, 'workflows') }}
            </p>
            <div class="mt-2">
                <strong class="fs-4">{{ statistics.pending }}</strong>
            </div>
            <div class="mt-2">
                <a href="{{ path('app_my_day') ~ '#workflows-pending' }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ 'common.view'|trans({}, 'messages') }}</a>
            </div>
        {% endblock %}
    {% endembed %}

    {% embed '_components/_card.html.twig' %}
        {% block card_body %}
            <div class="fs-2-mb-sm"><i class="fa-icon fa-icon--ui-refresh" aria-hidden="true"></i></div>
            <h2>{{ 'workflow.section.in_progress'|trans({}, 'workflows') }}</h2>
            <p class="text-muted-mt-xs">
                {{ 'workflow.description.in_progress'|trans({}, 'workflows') }}
            </p>
            <div class="mt-2">
                <strong class="fs-4">{{ statistics.in_progress }}</strong>
            </div>
            <div class="mt-2">
                <a href="{{ path('app_workflow_active') }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ 'common.view'|trans({}, 'messages') }}</a>
            </div>
        {% endblock %}
    {% endembed %}

    {% embed '_components/_card.html.twig' %}
        {% block card_body %}
            <div class="fs-2-mb-sm"><i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i></div>
            <h2>{{ 'workflow.section.overdue'|trans({}, 'workflows') }}</h2>
            <p class="text-muted-mt-xs">
                {{ 'workflow.description.overdue'|trans({}, 'workflows') }}
            </p>
            <div class="mt-2">
                <strong class="fs-15-danger">{{ instances|filter(i => i.overdue)|length }}</strong>
            </div>
            <div class="mt-2">
                <a href="{{ path('app_workflow_overdue') }}" class="fa-cyber-btn fa-cyber-btn--danger fa-cyber-btn--sm">{{ 'common.view'|trans({}, 'messages') }}</a>
            </div>
        {% endblock %}
    {% endembed %}
</div>

{# Workflow Instances Table #}
<h2>{{ 'workflow.section.recent_instances'|trans({}, 'workflows') }}</h2>

{% if instances is not empty %}
{% embed '_components/_table.html.twig' with {
    'wrapperClass': 'table-container',
    'noMargin': true
} %}
    {% block table_head %}
        <tr>
            <th scope="col">{{ 'workflow.field.entity'|trans({}, 'workflows') }}</th>
            <th scope="col">{{ 'workflow.field.workflow'|trans({}, 'workflows') }}</th>
            <th scope="col">{{ 'workflow.field.current_step'|trans({}, 'workflows') }}</th>
            <th scope="col">{{ 'workflow.field.status'|trans({}, 'workflows') }}</th>
            <th scope="col">{{ 'workflow.field.initiated_by'|trans({}, 'workflows') }}</th>
            <th scope="col">{{ 'workflow.field.due_date'|trans({}, 'workflows') }}</th>
            <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
        </tr>
    {% endblock %}
    {% block table_body %}
        {% for instance in instances|slice(0, 20) %}
        <tr>
            <td><strong>{{ instance.entityType|split('\\')|last }} #{{ instance.entityId }}</strong></td>
            <td>
                {% include '_components/_badge.html.twig' with { variant: 'info', content: instance.workflow ? instance.workflow.name : '-' } %}
            </td>
            <td>{{ instance.currentStep ? instance.currentStep.name : '-' }}</td>
            <td>
                {% set statusColors = {
                    'pending': 'warning',
                    'in_progress': 'info',
                    'approved': 'success',
                    'rejected': 'danger',
                    'cancelled': 'secondary'
                } %}
                {% include '_components/_badge.html.twig' with { variant: statusColors[instance.status] ?? 'secondary', content: ('workflow.status.' ~ instance.status)|trans({}, 'workflows') } %}
                {% if instance.status == 'in_progress' and hasEligibleApprovers[instance.id] is defined and not hasEligibleApprovers[instance.id] %}
                    {% include '_components/_badge.html.twig' with { variant: 'danger', class: 'ms-1', title: 'workflow.warning.no_eligible_approvers'|trans({}, 'workflows'), icon: 'ui-person' } %}
                {% endif %}
            </td>
            <td>{{ instance.initiatedBy ? (instance.initiatedBy.firstName ~ ' ' ~ instance.initiatedBy.lastName) : '-' }}</td>
            <td>
                {% if instance.dueDate %}
                    {{ instance.dueDate|date('d.m.Y') }}
                    {% if instance.dueDate < date() and instance.status not in ['approved', 'rejected', 'cancelled'] %}
                        {% include '_components/_badge.html.twig' with { variant: 'danger', class: 'ms-1', content: 'workflow.badge.overdue'|trans({}, 'workflows') } %}
                    {% endif %}
                {% else %}
                    <span class="text-muted">-</span>
                {% endif %}
            </td>
            <td class="text-center">
                <div class="btn-group" role="group">
                    {% if instance.status in ['pending', 'in_progress'] and (userCanApprove[instance.id] ?? false) %}
                        <button type="button"
                                class="fa-cyber-btn fa-cyber-btn--success fa-cyber-btn--sm" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="approveWorkflow{{ instance.id }}"
                                title="{{ 'workflow.widget.action.approve'|trans({}, 'workflows') }}">
                            <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
                        </button>
                        <button type="button"
                                class="fa-cyber-btn fa-cyber-btn--danger fa-cyber-btn--sm" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="rejectWorkflow{{ instance.id }}"
                                title="{{ 'workflow.widget.action.reject'|trans({}, 'workflows') }}">
                            <i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    <a href="{{ path('app_workflow_instance_show', {id: instance.id}) }}"
                       class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm"
                       title="{{ 'common.view'|trans({}, 'messages') }}">
                        <i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i>
                    </a>
                </div>
            </td>
        </tr>
        {% endfor %}
    {% endblock %}
{% endembed %}
{% else %}
    {{ _fa_empty_state.render({
        mood: 'sleeping',
        title: 'workflow.message.no_instances'|trans({}, 'workflows')
    }) }}
{% endif %}

{# Modals for Approve/Reject Actions #}
{% for instance in instances|slice(0, 20) %}
    {% if instance.status in ['pending', 'in_progress'] and (userCanApprove[instance.id] ?? false) %}
        {{ workflow_macros.decision_modals(instance.id, instance.workflow.name, (instance.entityType|split('\\')|last) ~ ' #' ~ instance.entityId) }}
    {% endif %}
{% endfor %}

</main>
{% endblock %}
