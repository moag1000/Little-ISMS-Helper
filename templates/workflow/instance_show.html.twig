{% extends 'base.html.twig' %}
{% trans_default_domain 'workflows' %}

{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_isms_approval_stages.html.twig' as _isms_approval_stages %}
{% import '_macros/workflow.html.twig' as workflow_macros %}
{% block title %}{{ instance.entityType|split('\\')|last }} #{{ instance.entityId }} - {{ 'workflow.title.instance_show'|trans({}, 'workflows') }}{% endblock %}

{% block body %}
{# Business-Summary-Block oben, Step-Namen humanisiert, Frist als Badge,
   "Rückfrage stellen"-Aktion ohne Workflow-Blockade. #}
{% set deadline_dt = instance.dueDate %}
{% set hours_remaining = deadline_dt ? ((deadline_dt.timestamp - "now"|date('U')) / 3600)|round(0, 'floor') : null %}
{% set is_overdue = hours_remaining is not null and hours_remaining < 0 %}
{% set is_critical = hours_remaining is not null and hours_remaining < 24 and hours_remaining >= 0 %}
{% set deadline_variant = is_overdue ? 'danger' : (is_critical ? 'warning' : 'info') %}

<div class="page-header">
    <div>
        <h1>{{ instance.entityType|split('\\')|last }} #{{ instance.entityId }}</h1>
        <div class="mt-2">
            {% import '_components/_status_vocabulary.html.twig' as _status %}
            {{ _status.pill('workflow', instance.status, ('workflow.status.' ~ instance.status)|trans({}, 'workflows')) }}
            {% if instance.overdue %}
                {% include '_components/_badge.html.twig' with { variant: 'danger', class: 'ms-1', content: 'workflow.badge.overdue'|trans({}, 'workflows') } %}
            {% endif %}
            {% if deadline_dt %}
                {% include '_components/_badge.html.twig' with {
                    variant: deadline_variant,
                    class: 'ms-1',
                    content: ('approval.deadline.label'|trans({}, 'workflows')) ~ ': ' ~ deadline_dt|fa_datetime
                        ~ (is_overdue ? ' — ' ~ ('approval.deadline.overdue'|trans({}, 'workflows')) : '')
                        ~ (is_critical ? ' — ' ~ ('approval.deadline.critical_warning'|trans({}, 'workflows')) : '')
                } %}
            {% endif %}
        </div>
    </div>
    <div class="button-group">
        <a href="{{ path('app_workflow_index') }}" class="fa-cyber-btn fa-cyber-btn--ghost">
            <i class="fa-icon fa-icon--util-arrow-left" aria-hidden="true"></i> {{ 'common.back_to_list'|trans({}, 'messages') }}
        </a>
    </div>
</div>

{# Business-Summary-Block (Aurora _fa_alert) — visible to current approvers #}
{% if can_approve %}
{% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mb-4' } } %}
    {% block alert_body %}
        <div class="fa-alert__title">{{ 'approval.business_summary.heading'|trans({}, 'workflows') }}</div>
        <p class="fa-alert__message mb-2">
            <strong>{{ 'approval.business_summary.what_is_it_label'|trans({}, 'workflows') }}</strong>
            {{ business_summary_what_is_it|default('approval.business_summary.what_is_it_default'|trans({}, 'workflows')) }}
        </p>
        <p class="fa-alert__message mb-2">
            <strong>{{ 'approval.business_summary.what_expected_label'|trans({}, 'workflows') }}</strong>
            {{ 'approval.business_summary.what_expected'|trans({}, 'workflows') }}
        </p>
        <p class="fa-alert__message mb-2">
            <strong>{{ 'approval.business_summary.what_if_reject_label'|trans({}, 'workflows') }}</strong>
            {{ 'approval.business_summary.what_if_reject'|trans({}, 'workflows') }}
        </p>
        <p class="fa-alert__message mb-0">
            <strong>{{ 'approval.business_summary.what_if_idle_label'|trans({}, 'workflows') }}</strong>
            {% if escalation_target is defined and escalation_target and deadline_dt %}
                {{ 'approval.business_summary.what_if_idle_with_target'|trans({'%deadline%': deadline_dt|fa_date, '%target%': escalation_target}, 'workflows') }}
            {% else %}
                {{ 'approval.business_summary.what_if_idle'|trans({}, 'workflows') }}
            {% endif %}
        </p>
    {% endblock %}
{% endembed %}
{% endif %}

{# Instance Overview #}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_header %}
        <div class="card-header">
            <h2 class="mb-0">{{ 'workflow.section.overview'|trans({}, 'workflows') }}</h2>
        </div>
    {% endblock %}
    {% block card_body %}
    {% import '_components/_fa_progress.html.twig' as _fa_progress %}
        <div class="row">
            <div class="col-md-3 mb-3">
                <strong class="d-block text-muted">{{ 'workflow.field.workflow'|trans({}, 'workflows') }}</strong>
                {% include '_components/_badge.html.twig' with { variant: 'info', content: instance.workflow ? instance.workflow.name : '—' } %}
            </div>

            <div class="col-md-3 mb-3">
                <strong class="d-block text-muted">{{ 'workflow.field.current_step'|trans({}, 'workflows') }}</strong>
                {{ instance.currentStep ? instance.currentStep.name|workflow_step_label : '—' }}
            </div>

            <div class="col-md-3 mb-3">
                <strong class="d-block text-muted">{{ 'workflow.field.initiated_by'|trans({}, 'workflows') }}</strong>
                {% if instance.initiatedBy %}
                    {{ instance.initiatedBy.firstName ~ ' ' ~ instance.initiatedBy.lastName }}
                {% else %}
                    <span class="text-muted">{{ 'workflow.message.unassigned'|trans({}, 'workflows') }}</span>
                {% endif %}
            </div>

            {% if instance.dueDate %}
            <div class="col-md-3 mb-3">
                <strong class="d-block text-muted">{{ 'workflow.field.due_date'|trans({}, 'workflows') }}</strong>
                {{ instance.dueDate|fa_datetime }}
            </div>
            {% endif %}

            <div class="col-md-3 mb-3">
                <strong class="d-block text-muted">{{ 'workflow.field.created_at'|trans({}, 'workflows') }}</strong>
                {{ instance.startedAt|fa_datetime }}
            </div>

            {% if instance.completedAt %}
            <div class="col-md-3 mb-3">
                <strong class="d-block text-muted">{{ 'workflow.field.completed_at'|trans({}, 'workflows') }}</strong>
                {{ instance.completedAt|fa_datetime }}
            </div>
            {% endif %}
        </div>

        {# Progress Bar #}
        {% if instance.workflow and instance.workflow.steps|length > 0 %}
        <div class="mt-3">
            <strong class="d-block mb-2">{{ 'workflow.field.progress'|trans({}, 'workflows') }}</strong>
            {% set progress = instance.progressPercentage %}
            {{ _fa_progress.render({ value: progress, tone: progress == 100 ? 'success' : 'primary', showText: true }) }}
        </div>
        {% endif %}
    {% endblock %}
{% endembed %}

{# Warning: No eligible approvers for current step #}
{% if instance.status == 'in_progress' and not has_eligible_approvers %}
{% embed '_components/_fa_alert.html.twig' with { props: {
    variant: is_granted('ROLE_ADMIN') ? 'warning' : 'danger',
    icon: 'status-warning',
    title: 'workflow.warning.no_eligible_approvers_title'|trans({}, 'workflows'),
    class: 'mb-4'
} } %}
    {% block alert_body %}
        {% trans_default_domain 'workflows' %}
        <p class="fa-alert__message mb-2">{{ 'workflow.warning.no_eligible_approvers_desc'|trans({}, 'workflows') }}</p>

        {% if is_granted('ROLE_ADMIN') %}
            {# Admin view: can still approve + configure link #}
            <p class="fa-alert__message mb-3">{{ 'workflow.warning.no_eligible_approvers_admin'|trans({}, 'workflows') }}</p>
            <div class="d-flex gap-2 flex-wrap">
                {% if instance.workflow %}
                <a href="{{ path('app_workflow_definition_show', {id: instance.workflow.id}) }}" class="fa-cyber-btn fa-cyber-btn--warning">
                    <i class="fa-icon fa-icon--ui-settings" aria-hidden="true"></i> {{ 'workflow.warning.configure_step'|trans({}, 'workflows') }}
                </a>
                {% endif %}
            </div>
        {% else %}
            {# Regular user view: contact admin message #}
            <p class="fa-alert__message mb-0">
                <strong>{{ 'workflow.warning.admin_action_required'|trans({}, 'workflows') }}:</strong>
                {{ 'workflow.warning.no_eligible_approvers_user'|trans({}, 'workflows') }}
            </p>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endif %}

{# Workflow Steps — Aurora ISMS-Pattern: isms-approval-stages #}
{% if instance.workflow and instance.workflow.steps|length > 0 %}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_header %}
        <div class="card-header">
            <h2 class="mb-0">{{ 'workflow.section.steps'|trans({}, 'workflows') }}</h2>
        </div>
    {% endblock %}
    {% block card_body %}
        {% import '_components/_isms_approval_stages.html.twig' as _isms_approval_stages %}
        {% set _stages = [] %}
        {% for step in instance.workflow.steps %}
            {% set isCurrentStep = instance.currentStep and step.id == instance.currentStep.id %}
            {% set isCompleted = step.id in instance.completedSteps %}
            {% set _state = isCompleted ? 'completed' : (isCurrentStep ? 'current' : 'pending') %}
            {% set _translated_desc = step.name|workflow_step_description %}
            {% set _description = _translated_desc ?: step.description %}
            {% set _badge = isCurrentStep
                ? 'workflow.badge.current'|trans({}, 'workflows')
                : (isCompleted ? 'workflow.badge.completed'|trans({}, 'workflows') : null) %}
            {% set _badge_variant = isCurrentStep ? 'primary' : (isCompleted ? 'success' : null) %}
            {% set _actions = [] %}
            {% if isCurrentStep and can_approve %}
                {% set _actions = [
                    { label: 'approval.action.approve'|trans({}, 'workflows'),
                      variant: 'success', icon: 'ui-check', modal_target: '#approveModal' },
                    { label: 'approval.action.reject'|trans({}, 'workflows'),
                      variant: 'danger', icon: 'ui-close', modal_target: '#rejectModal' },
                    { label: 'approval.action.clarify'|trans({}, 'workflows'),
                      variant: 'ghost', icon: 'ui-help', modal_target: '#clarifyModal' }
                ] %}
            {% endif %}
            {% set _stages = _stages|merge([{
                name: step.name|workflow_step_label,
                state: _state,
                description: _description,
                badge: _badge,
                badge_variant: _badge_variant,
                actions: _actions
            }]) %}
        {% endfor %}
        {{ _isms_approval_stages.render({
            stages: _stages,
            ariaLabel: 'workflow.section.steps'|trans({}, 'workflows')
        }) }}
    {% endblock %}
{% endembed %}
{% endif %}

{# Approval History — Aurora ISMS-Trail Timeline #}
{% if instance.approvalHistory|length > 0 %}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_header %}
        <div class="card-header">
            <h2 class="mb-0">{{ 'workflow.section.activity_log'|trans({}, 'workflows') }}</h2>
        </div>
    {% endblock %}
    {% block card_body %}
        <div class="isms-trail">
            {% for entry in instance.approvalHistory|reverse %}
                {% set isAutoApproved = entry.action == 'auto_approved' or (entry.auto_progression is defined and entry.auto_progression) %}
                {% set tone = entry.action in ['approved', 'auto_approved'] ? 'success'
                    : (entry.action == 'rejected' ? 'danger'
                    : (entry.action in ['cancelled', 'expired'] ? 'neutral' : 'warning')) %}
                {% set icon = entry.action in ['approved', 'auto_approved'] ? 'fa-icon--ui-check'
                    : (entry.action == 'rejected' ? 'fa-icon--ui-close'
                    : (entry.action == 'cancelled' ? 'fa-icon--status-critical'
                    : (entry.action == 'submitted' ? 'fa-icon--ui-edit' : 'fa-icon--ui-circle'))) %}
                <article class="isms-trail__entry">
                    <span class="isms-trail__dot isms-trail__dot--{{ tone }}" aria-hidden="true">
                        <i class="fa-icon {{ icon }}"></i>
                    </span>
                    <div class="isms-trail__head">
                        <span class="isms-trail__title">
                            {% if isAutoApproved %}
                                {{ 'workflow.action.auto_approved'|trans({}, 'workflows') }}
                            {% else %}
                                {{ entry.action|capitalize }}
                            {% endif %}
                            {% if entry.step_name is defined %}
                                <small class="text-muted ms-1">({{ entry.step_name|workflow_step_label }})</small>
                            {% endif %}
                        </span>
                        <span class="isms-trail__meta">{{ entry.timestamp|date('d.m.Y H:i:s') }}</span>
                    </div>
                    <div class="isms-trail__body">
                        {% set actor = entry.approver_name|default(entry.user|default(null)) %}
                        {% if actor %}
                            <span class="isms-trail__actor">
                                <i class="fa-icon fa-icon--nav-users" aria-hidden="true"></i>
                                {{ actor }}
                            </span>
                        {% endif %}
                        {% if entry.comments is defined and entry.comments %}
                            {{ entry.comments }}
                        {% elseif entry.reason is defined and entry.reason %}
                            {{ entry.reason }}
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
{% endif %}

{# Action Buttons #}
<div class="d-flex gap-2 mt-4">
    {% if instance.status in ['pending', 'in_progress'] %}
    <form method="post" action="{{ path('app_workflow_instance_cancel', {id: instance.id}) }}" class="d-inline"
          data-controller="ui-actions"
          data-action="submit->ui-actions#confirm"
          data-ui-actions-message-param="{{ 'workflow.confirm.cancel'|trans({}, 'workflows') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ instance.id) }}">
        <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
            <i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i> {{ 'workflow.action.cancel'|trans({}, 'workflows') }}
        </button>
    </form>
    {% endif %}

    <a href="{{ path('app_workflow_index') }}" class="fa-cyber-btn fa-cyber-btn--ghost">
        <i class="fa-icon fa-icon--ui-list" aria-hidden="true"></i> {{ 'common.back_to_list'|trans({}, 'messages') }}
    </a>
</div>

{# Approve / Reject / Clarify — the shared decision dialog (bottom sheet on phones) #}
{% if can_approve %}
{{ workflow_macros.decision_modal({
    id: 'approveModal',
    tone: 'success',
    title: 'approval.approve_modal.title'|trans({}, 'workflows'),
    submit_label: 'approval.approve_modal.submit'|trans({}, 'workflows'),
    action: path('app_workflow_instance_approve', {id: instance.id}),
    token: csrf_token('approve' ~ instance.id),
    field: {
        name: 'comments', label: 'approval.approve_modal.comment_label'|trans({}, 'workflows'),
        placeholder: 'approval.approve_modal.comment_placeholder'|trans({}, 'workflows'),
    },
}) }}
{{ workflow_macros.decision_modal({
    id: 'rejectModal',
    tone: 'danger',
    title: 'approval.action.reject'|trans({}, 'workflows'),
    action: path('app_workflow_instance_reject', {id: instance.id}),
    token: csrf_token('reject' ~ instance.id),
    field: { name: 'comments', label: 'workflow.widget.field.reason'|trans({}, 'workflows'), required: true },
}) }}
{# Clarify sends a question to the initiator without deciding.
   Audit-event: workflow_clarification_requested (WorkflowController::clarifyInstance). #}
{{ workflow_macros.decision_modal({
    id: 'clarifyModal',
    tone: 'neutral',
    icon: 'ui-help',
    submit_variant: 'info',
    title: 'approval.clarify_modal.title'|trans({}, 'workflows'),
    submit_label: 'approval.clarify_modal.submit'|trans({}, 'workflows'),
    cancel_label: 'approval.clarify_modal.cancel'|trans({}, 'workflows'),
    action: path('app_workflow_instance_clarify', {id: instance.id}),
    token: csrf_token('clarify' ~ instance.id),
    intro: 'approval.clarify_modal.intro'|trans({}, 'workflows'),
    field: {
        name: 'question', label: 'approval.clarify_modal.question_label'|trans({}, 'workflows'), required: true, rows: 4,
        placeholder: 'approval.clarify_modal.question_placeholder'|trans({}, 'workflows'),
    },
}) }}
{% endif %}
{% endblock %}
