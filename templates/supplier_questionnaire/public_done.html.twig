{% extends 'base_public.html.twig' %}

{% block title %}{{ questionnaire.title }}{% endblock %}

{% block body %}
<div class="container py-5 text-center" style="max-width: 640px;">
    {% if accepted %}
        <h1 class="h3 mb-3">{{ 'supplier.questionnaire.public.thanks_title'|trans({}, 'suppliers') }}</h1>
        <p class="text-body-secondary">{{ 'supplier.questionnaire.public.thanks_body'|trans({}, 'suppliers') }}</p>
    {% else %}
        <div class="fa-alert fa-alert--info" role="alert"><i class="fa-icon fa-icon--status-info fa-alert__icon" aria-hidden="true"></i><div class="fa-alert__body"><p class="fa-alert__message">{{ 'supplier.questionnaire.public.closed'|trans({}, 'suppliers') }}</p></div></div>
    {% endif %}
</div>
{% endblock %}
