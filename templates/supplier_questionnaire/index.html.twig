{% extends 'base.html.twig' %}
{% trans_default_domain 'suppliers' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'supplier.questionnaire.title'|trans({}, 'suppliers') }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [{ label: 'supplier.questionnaire.title'|trans({}, 'suppliers') }]
    } %}

    {{ _fa_page_header.render({
        title: 'supplier.questionnaire.title'|trans({}, 'suppliers')
    }) }}

    {# Send a new questionnaire #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="post" action="{{ path('supplier_questionnaire_create', {_locale: app.request.locale}) }}" class="row g-2 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('supplier_questionnaire_create') }}">
                <div class="col-md-5">
                    <label class="form-label" for="supplier_id">{{ 'supplier.questionnaire.field.supplier'|trans({}, 'suppliers') }}</label>
                    <select class="form-select" id="supplier_id" name="supplier_id" required>
                        {% for s in suppliers %}
                            <option value="{{ s.id }}">{{ s.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="title">{{ 'supplier.questionnaire.field.title'|trans({}, 'suppliers') }}</label>
                    <input type="text" class="form-control" id="title" name="title" value="{{ 'supplier.questionnaire.default_title'|trans({}, 'suppliers') }}">
                </div>
                <div class="col-md-3">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">{{ 'supplier.questionnaire.action.send'|trans({}, 'suppliers') }}</button>
                </div>
            </form>
        </div>
    </div>

    {# Sent questionnaires #}
    <div class="fa-table-wrap mb-3">
    <table class="fa-table fa-table--hover">
        <thead class="fa-table__head">
            <tr>
                <th class="fa-table__th" scope="col">{{ 'supplier.questionnaire.field.supplier'|trans({}, 'suppliers') }}</th>
                <th class="fa-table__th" scope="col">{{ 'supplier.questionnaire.field.title'|trans({}, 'suppliers') }}</th>
                <th class="fa-table__th" scope="col">{{ 'supplier.questionnaire.field.status'|trans({}, 'suppliers') }}</th>
                <th class="fa-table__th" scope="col">{{ 'supplier.questionnaire.field.sent_at'|trans({}, 'suppliers') }}</th>
            </tr>
        </thead>
        <tbody class="fa-table__body">
            {% for q in questionnaires %}
                <tr class="fa-table__row">
                    <td class="fa-table__cell">{{ q.supplier ? q.supplier.name : '—' }}</td>
                    <td class="fa-table__cell">{{ q.title }}</td>
                    <td class="fa-table__cell"><span class="badge bg-secondary">{{ ('supplier.questionnaire.status.' ~ q.status)|trans({}, 'suppliers') }}</span></td>
                    <td class="fa-table__cell">{{ q.sentAt ? q.sentAt|date('Y-m-d') : '—' }}</td>
                </tr>
            {% else %}
                <tr class="fa-table__row"><td colspan="4" class="fa-table__cell fa-table__empty">{{ 'supplier.questionnaire.empty'|trans({}, 'suppliers') }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endblock %}
