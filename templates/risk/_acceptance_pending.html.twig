{#
 # Requested risk acceptance waiting for a decision (ISO 27005 §8.4.4).
 # Shows the business summary and the requester's justification; the approver
 # (RiskAcceptanceVoter: tier from the organisation's approval thresholds)
 # decides right here. My Day links to #acceptance.
 #}
{% if risk.acceptanceStatus == 'pending_approval' and risk.acceptanceJustification is not null %}
<section class="fa-section mb-4" id="acceptance" aria-labelledby="acceptance-title">
    <div class="fa-section__header">
        <h2 class="fa-section__title" id="acceptance-title">{{ 'risk.acceptance.pending.title'|trans({}, 'risk') }}</h2>
    </div>
    <div class="fa-section__body">
        <p class="fw-semibold mb-2">{{ risk_business_summary(risk) }}</p>
        <p class="mb-3"><span class="text-body-secondary">{{ 'risk.acceptance.pending.justification'|trans({}, 'risk') }}:</span> {{ risk.acceptanceJustification }}</p>
        {% if is_granted('risk_acceptance_approve', risk) %}
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--success"
                        data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open"
                        data-fa-modal-id="approveAcceptance{{ risk.id }}">
                    <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
                    {{ 'risk.acceptance.pending.approve'|trans({}, 'risk') }}
                </button>
                <button type="button" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--danger"
                        data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open"
                        data-fa-modal-id="rejectAcceptance{{ risk.id }}">
                    <i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i>
                    {{ 'risk.acceptance.pending.reject'|trans({}, 'risk') }}
                </button>
            </div>
            {% include 'risk/_acceptance_decide_modals.html.twig' with { riskId: risk.id, subject: risk.title, summary: risk_business_summary(risk) } only %}
        {% else %}
            <p class="text-body-secondary small mb-0">{{ 'risk.acceptance.pending.waiting'|trans({}, 'risk') }}</p>
        {% endif %}
    </div>
</section>
{% endif %}
