{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'risk' %}

{% block title %}{{ 'risk.modern.header.title'|trans({}, 'risk')}}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{# Breadcrumb Navigation #}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'risk.modern.breadcrumb'|trans({}, 'risk')}
    ]
} %}

{{ _fa_page_header.render({
    title: 'risk.modern.header.title'|trans({}, 'risk'),
    subtitle: 'risk.modern.header.subtitle'|trans({}, 'risk'),
    actions: [
        { label: 'risk.action.quick_new'|trans({}, 'risk'), variant: 'ghost', icon: 'ui-lightbulb', href: path('app_risk_new_quick') },
        { label: 'risk.modern.header.action.new'|trans({}, 'risk'), variant: 'primary', icon: 'plus', href: path('app_risk_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } },
        { label: 'risk.modern.header.action.matrix'|trans({}, 'risk'), variant: 'ghost', icon: 'nav-grid', href: path('app_risk_matrix') }
    ]|merge(is_granted('ROLE_AUDITOR') ? [{ label: 'audit_workbook.action.export_xlsx'|trans({}, 'audit_workbook'), variant: 'success', icon: 'download', href: path('app_audit_workbook_risk_register') }] : [])
     |merge(is_granted('ROLE_MANAGER') ? [{ label: 'filtered_export.button.label'|trans({}, 'filtered_export'), href: path('app_filtered_export_entity', { entityType: 'risk', format: 'xlsx' }) ~ (app.request.queryString ? '?' ~ app.request.queryString : ''), variant: 'ghost', icon: 'nav-file-earmark-spreadsheet' }] : [])
     |merge([
        { label: 'risk.modern.header.action.export_pdf'|trans({}, 'risk'), href: path('app_risk_export_pdf') ~ (app.request.queryString ? '?' ~ app.request.queryString : ''), variant: 'ghost', attrs: { 'data-turbo': 'false' } }
     ])
}) }}
    {% include '_components/_focus_filter_notice.html.twig' with { focus: focus|default(null), count: page.total } %}
{% set _global_hints = alva_hints('risk_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}


{# WS-5 Bulk tag actions bar (polymorphic) #}
{% if is_granted('TAG_APPLY') %}
    {% include '_components/_bulk_action_bar.html.twig' with {
        entity_class:   'App\\Entity\\Risk',
        action_urls: {
            tag_add: path('admin_tag_bulk_apply', {entityClass: 'Risk'}),
        },
        available_tags: available_tags(),
    } only %}
{% endif %}

<div class="container-fluid py-4">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_risk_index'),
    filter_keys: ['level', 'status', 'treatment', 'owner', 'view', 'review_overdue', 'tag', 'location', 'focus'],
    list_title: 'risk.index.all_risks'|trans({}, 'risk'),
    empty: {
        mood: 'sleeping',
        title: 'risk.index.empty.title'|trans({}, 'risk'),
        text: 'risk.index.empty.description'|trans({}, 'risk'),
        actions: [{ label: 'risk.index.empty.action'|trans({}, 'risk'), variant: 'primary', icon: 'plus', href: path('app_risk_new') }],
        norm_ref: 'ISO 27001 Clause 6.1.2',
        help_link: path('app_help_glossary') ~ '#glossary-risk',
    },
    card_attrs: 'data-controller="bulk-actions" data-bulk-actions-endpoint-value="/' ~ app.request.locale ~ '/risk"',
} %}
    {% block list_filters %}
        {% for _hk in ['location', 'tag', 'review_overdue', 'focus'] %}
            {% if app.request.query.get(_hk) is not null and app.request.query.get(_hk) != '' %}
                <input type="hidden" name="{{ _hk }}" value="{{ app.request.query.get(_hk) }}">
            {% endif %}
        {% endfor %}
        {% import '_components/_fa_cyber_field.html.twig' as _fa_cyber %}
        {% if currentTenant %}
        <div class="col-md-3">
            <label for="view-filter" class="form-label">{{ 'common.view'|trans({}, 'messages') }}</label>
            <select class="form-select fa-cyber-input__field" id="view-filter" name="view" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="own" {{ inheritanceInfo.currentView == 'own' ? 'selected' : '' }}>{{ 'corporate.view.own_only'|trans({}, 'messages') }}</option>
                {% if inheritanceInfo.hasParent %}
                <option value="inherited" {{ inheritanceInfo.currentView == 'inherited' ? 'selected' : '' }}>{{ 'corporate.view.including_inherited'|trans({}, 'messages') }}</option>
                {% endif %}
                {% if inheritanceInfo.hasSubsidiaries %}
                <option value="subsidiaries" {{ inheritanceInfo.currentView == 'subsidiaries' ? 'selected' : '' }}>{{ 'corporate.view.including_subsidiaries'|trans({}, 'messages') }}</option>
                {% endif %}
                {% if inheritanceInfo.isAdmin %}
                <option value="orphaned" {{ inheritanceInfo.currentView == 'orphaned' ? 'selected' : '' }}>{{ 'corporate.view.orphaned'|trans({}, 'tenant') }}</option>
                <option value="all" {{ inheritanceInfo.currentView == 'all' ? 'selected' : '' }}>{{ 'corporate.view.all_tenants'|trans({}, 'tenant') }}</option>
                {% endif %}
            </select>
        </div>
        {% endif %}
        <div class="col-md-3">
            <label for="filter-level" class="form-label">{{ 'risk.filter.level_label'|trans({}, 'risk') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-level" name="level">
                <option value="">{{ 'risk.filter.all_risks'|trans({}, 'risk') }}</option>
                {# Select-options pull labels from risk_level_label() (SSoT) #}
                <option value="critical" {{ app.request.query.get('level') == 'critical' ? 'selected' : '' }}>{{ risk_level_label('critical') }} ({{ risk_threshold('critical') }})</option>
                <option value="high" {{ app.request.query.get('level') == 'high' ? 'selected' : '' }}>{{ risk_level_label('high') }} ({{ risk_threshold('high') }})</option>
                <option value="medium" {{ app.request.query.get('level') == 'medium' ? 'selected' : '' }}>{{ risk_level_label('medium') }} ({{ risk_threshold('medium') }})</option>
                <option value="low" {{ app.request.query.get('level') == 'low' ? 'selected' : '' }}>{{ risk_level_label('low') }} ({{ risk_threshold('low') }})</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="filter-status" class="form-label">{{ 'risk.filter.status_label'|trans({}, 'risk') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-status" name="status">
                <option value="">{{ 'risk.filter.all_status'|trans({}, 'risk') }}</option>
                <option value="identified" {{ app.request.query.get('status') == 'identified' ? 'selected' : '' }}>{{ 'risk.filter.status_identified'|trans({}, 'risk') }}</option>
                <option value="assessed" {{ app.request.query.get('status') == 'assessed' ? 'selected' : '' }}>{{ 'risk.filter.status_assessed'|trans({}, 'risk') }}</option>
                <option value="in_treatment" {{ app.request.query.get('status') == 'in_treatment' ? 'selected' : '' }}>{{ 'risk.filter.status_in_treatment'|trans({}, 'risk') }}</option>
                <option value="treated" {{ app.request.query.get('status') == 'treated' ? 'selected' : '' }}>{{ 'risk.filter.status_treated'|trans({}, 'risk') }}</option>
                <option value="mitigated" {{ app.request.query.get('status') == 'mitigated' ? 'selected' : '' }}>{{ 'risk.filter.status_mitigated'|trans({}, 'risk') }}</option>
                <option value="monitored" {{ app.request.query.get('status') == 'monitored' ? 'selected' : '' }}>{{ 'risk.filter.status_monitored'|trans({}, 'risk') }}</option>
                <option value="closed" {{ app.request.query.get('status') == 'closed' ? 'selected' : '' }}>{{ 'risk.filter.status_closed'|trans({}, 'risk') }}</option>
                <option value="accepted" {{ app.request.query.get('status') == 'accepted' ? 'selected' : '' }}>{{ 'risk.filter.status_accepted'|trans({}, 'risk') }}</option>
                <option value="open" {{ app.request.query.get('status') == 'open' ? 'selected' : '' }}>{{ 'risk.filter.status_open'|trans({}, 'risk') }}</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="filter-treatment" class="form-label">{{ 'risk.filter.treatment_label'|trans({}, 'risk') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-treatment" name="treatment">
                <option value="">{{ 'risk.filter.all_strategies'|trans({}, 'risk') }}</option>
                <option value="mitigate" {{ app.request.query.get('treatment') == 'mitigate' ? 'selected' : '' }}>{{ 'risk.index.treatment.mitigate'|trans({}, 'risk') }}</option>
                <option value="accept" {{ app.request.query.get('treatment') == 'accept' ? 'selected' : '' }}>{{ 'risk.index.treatment.accept'|trans({}, 'risk') }}</option>
                <option value="transfer" {{ app.request.query.get('treatment') == 'transfer' ? 'selected' : '' }}>{{ 'risk.index.treatment.transfer'|trans({}, 'risk') }}</option>
                <option value="avoid" {{ app.request.query.get('treatment') == 'avoid' ? 'selected' : '' }}>{{ 'risk.index.treatment.avoid'|trans({}, 'risk') }}</option>
            </select>
        </div>
        <div class="col-md-3">
            {{ _fa_cyber.text('owner', {
                id: 'filter-owner',
                label: 'risk.filter.owner_label'|trans({}, 'risk'),
                value: app.request.query.get('owner'),
                placeholder: 'risk.filter.owner_placeholder'|trans({}, 'risk')
            }) }}
        </div>
    {% endblock %}
    {% block list_summary %}
        {% if critical_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'risk.summary.critical'|trans({'%count%': critical_count}, 'risk') }}</span>{% endif %}
        {% if high_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'risk.summary.high'|trans({'%count%': high_count}, 'risk') }}</span>{% endif %}
        {% if unowned_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'risk.summary.unowned'|trans({'%count%': unowned_count}, 'risk') }}</span>{% endif %}
        {% include '_components/_review_due_chip.html.twig' with { type: 'risk' } only %}
    {% endblock %}
    {% block list_table %}
        {% embed '_components/_table.html.twig' with {
            'class': 'table-hover table-bulk-selectable mb-0',
            'noMargin': true,
            'responsive': true
        } %}
            {% block table_head %}
                <tr>
                    <th scope="col" class="bulk-select-column">
                        <input type="checkbox"
                               class="form-check-input"
                               data-action="bulk-actions#selectAll"
                               data-bulk-actions-target="selectAllCheckbox"
                               aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                    </th>
                    <th scope="col">{{ 'risk.index.table.title'|trans({}, 'risk') }}</th>
                    <th scope="col">{{ 'risk.index.table.threat'|trans({}, 'risk') }}</th>
                    <th scope="col" class="text-center">{{ 'risk.index.table.risk_score'|trans({}, 'risk') }}<a href="{{ path('app_help_glossary') }}#glossary-inherent-risk" class="text-muted ms-1" title="{{ 'common.glossary_link'|trans({}, 'messages') }}" data-bs-toggle="tooltip"><i class="fa-icon fa-icon--ui-help" aria-hidden="true" style="font-size: 0.75rem;"></i></a></th>
                    <th scope="col" class="text-center">{{ 'risk.index.table.residual_risk'|trans({}, 'risk') }}<a href="{{ path('app_help_glossary') }}#glossary-residual-risk" class="text-muted ms-1" title="{{ 'common.glossary_link'|trans({}, 'messages') }}" data-bs-toggle="tooltip"><i class="fa-icon fa-icon--ui-help" aria-hidden="true" style="font-size: 0.75rem;"></i></a></th>
                    <th scope="col">{{ 'risk.index.table.treatment'|trans({}, 'risk') }}</th>
                    <th scope="col" class="text-center">{{ 'risk.index.table.risk_subject'|trans({}, 'risk') }}</th>
                    <th scope="col" class="text-center">{{ 'risk.index.table.actions'|trans({}, 'risk') }}</th>
                </tr>
            {% endblock %}
            {% block table_body_attrs %}id="risk-rows"{% endblock %}
            {% block table_body %}
                {% set workflowStates = workflow_states(page) %}
                {% for risk in page %}
                    {% include 'risk/_row.html.twig' with { risk: risk, currentTenant: currentTenant } %}
                {% endfor %}
            {% endblock %}
        {% endembed %}
        {% include '_components/_bulk_action_bar.html.twig' with {
            actions: ['export', 'assign', 'review', 'delete'],
            variant: 'brand'
        } %}
    {% endblock %}
{% endembed %}

{% if page.total == 0 %}
    {% set _system_templates = system_templates('App\\Entity\\Risk') %}
    {% if _system_templates|length > 0 %}
        <div class="text-center mt-3">
            <button type="button" class="fa-cyber-btn fa-cyber-btn--secondary"
                    data-controller="fa-modal-dispatcher"
                    data-action="click->fa-modal-dispatcher#open"
                    data-fa-modal-id="systemTemplateModalRisk">
                {{ 'system_templates.cta.button'|trans({}, 'system_templates') }}
            </button>
            <div class="form-text small">
                {{ 'system_templates.cta.hint'|trans({}, 'system_templates') }}
            </div>
        </div>
        {% include '_components/_system_template_selector.html.twig' with {
            templates: _system_templates,
            entity_class: 'App\\Entity\\Risk',
            redirect_to: 'app_risk_index',
            modal_id: 'systemTemplateModalRisk'
        } %}
    {% endif %}
{% endif %}
</div>

<style>
/* Risk Score Badges */
.risk-score {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 8px;
    padding: 0 8px;
}

.risk-score-critical {
    background: var(--danger);
    color: white;
}

.risk-score-high {
    background: var(--warning);
    color: var(--on-warning);
}

.risk-score-medium {
    background: var(--warning);
    color: var(--on-warning);
}

.risk-score-low {
    background: var(--success);
    color: var(--on-success);
}

.risk-score-improved {
    background: var(--success-glow);
    color: var(--success);
}
</style>
{% endblock %}
