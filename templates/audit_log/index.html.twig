{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'audit_log' %}
{% import '_components/_fa_empty_state.html.twig' as _fa_empty_state %}

{# Title/subtitle suppressed — fa-page-header renders these inside admin_content #}
{% block admin_title %}{% endblock %}
{% block admin_subtitle %}{% endblock %}

{% block admin_content %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'nav.admin'|trans({}, 'nav'), url: path('admin_dashboard') },
        { label: 'audit_log.page.title'|trans({}, 'audit_log') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'audit_log.page.title'|trans({}, 'audit_log'),
    subtitle: 'audit_log.page.subtitle'|trans({}, 'audit_log'),
    actions: [
        { label: 'audit_log.filter.statistics'|trans({}, 'audit_log'), href: path('app_audit_log_statistics'), variant: 'ghost', icon: 'nav-bar-chart' }
    ]
}) }}
<div class="container-fluid py-4">

{# HMAC-Chain Verify button — Auditor's "manipulationssicher?" answer #}
<div class="d-flex justify-content-end mb-3">
    <form method="post" action="{{ path('app_audit_log_verify') }}" class="d-inline"
          data-controller="ui-actions" data-action="submit->ui-actions#submitOnce">
        <input type="hidden" name="_token" value="{{ csrf_token('audit_log_verify') }}">
        <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
            <i class="fa-icon fa-icon--compliance-shield" aria-hidden="true"></i>
            {{ 'audit_log.integrity.verify_button'|trans({}, 'audit_log') }}
        </button>
    </form>
</div>

{% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info' } } %}
    {% block alert_body %}
        <div class="fa-alert__title">{{ 'audit_log.section.statistics'|trans({}, 'audit_log') }}</div>
        <p><strong>{{ 'audit_log.stats.total_logs'|trans({}, 'audit_log') }}:</strong> {{ totalLogs }}</p>
        <p><strong>{{ 'audit_log.stats.last_24h'|trans({}, 'audit_log') }}:</strong> {{ recentActivity }} {{ 'common.activities'|trans({}, 'messages') }}</p>

        {% if actionStats|length > 0 %}
        <p><strong>{{ 'audit_log.stats.actions'|trans({}, 'audit_log') }}:</strong></p>
        <ul>
            {% for stat in actionStats %}
            <li>{{ stat.action|capitalize }}: {{ stat.count }}</li>
            {% endfor %}
        </ul>
        {% endif %}

        {% if entityTypeStats|length > 0 %}
        <p><strong>{{ 'audit_log.stats.entity_types'|trans({}, 'audit_log') }}:</strong></p>
        <ul>
            {% for stat in entityTypeStats %}
            <li>{{ stat.entityType }}: {{ stat.count }}</li>
            {% endfor %}
        </ul>
        {% endif %}
    {% endblock %}
{% endembed %}

{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_audit_log_index'),
    show_search: false,
    filter_keys: ['entityType', 'action', 'userName', 'dateFrom', 'dateTo'],
    list_title: 'audit_log.section.entries'|trans({}, 'audit_log'),
    empty: { mood: 'sleeping', title: 'audit_log.message.no_entries'|trans({}, 'audit_log') },
} %}
    {% block list_filters %}
        {% import '_components/_fa_cyber_field.html.twig' as _fa_cyber %}
        <div class="col-md-3">
            <label for="entityType" class="form-label">{{ 'audit_log.filter.entity_type'|trans({}, 'audit_log') }}</label>
            <select name="entityType" id="entityType" class="form-select fa-cyber-input__field">
                <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                {% for entityType in entityTypes %}
                <option value="{{ entityType }}" {% if filters.entityType|default('') == entityType %}selected{% endif %}>{{ entityType }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label for="action" class="form-label">{{ 'audit_log.filter.action'|trans({}, 'audit_log') }}</label>
            <select name="action" id="action" class="form-select fa-cyber-input__field">
                <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                {% for action in actions %}
                <option value="{{ action }}" {% if filters.action|default('') == action %}selected{% endif %}>{{ action|capitalize }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            {{ _fa_cyber.text('userName', { id: 'userName', label: 'audit_log.filter.user'|trans({}, 'audit_log'), value: filters.userName ?? '' }) }}
        </div>
        <div class="col-md-2">
            {{ _fa_cyber.text('dateFrom', { id: 'dateFrom', type: 'date', label: 'audit_log.filter.date_from'|trans({}, 'audit_log'), value: filters.dateFrom ?? '' }) }}
        </div>
        <div class="col-md-2">
            {{ _fa_cyber.text('dateTo', { id: 'dateTo', type: 'date', label: 'audit_log.filter.date_to'|trans({}, 'audit_log'), value: filters.dateTo ?? '' }) }}
        </div>
    {% endblock %}
    {% block list_table %}
        {% import '_components/_fa_audit_row.html.twig' as _fa_audit_row %}
        <div class="p-3">
            {# Tab Navigation #}
            <ul class="nav nav-tabs mt-md" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            data-bs-toggle="tab"
                            data-bs-target="#table-view"
                            type="button"
                            role="tab">
                        <i class="fa-icon fa-icon--nav-grid" aria-hidden="true"></i> {{ 'audit_log.section.table'|trans({}, 'audit_log') }}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#timeline-view"
                            type="button"
                            role="tab">
                        <i class="fa-icon fa-icon--nav-calendar-check" aria-hidden="true"></i> {{ 'audit_log.section.timeline'|trans({}, 'audit_log') }}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#compact-view"
                            type="button"
                            role="tab">
                        <i class="fa-icon fa-icon--ui-list" aria-hidden="true"></i> {{ 'audit_log.section.compact'|trans({}, 'audit_log') }}
                    </button>
                </li>
            </ul>

            {# Tab Content #}
            <div class="tab-content mt-md">
                {# Table View — fa-audit-feed (CRUD change-log) #}
                <div class="tab-pane fade show active" id="table-view" role="tabpanel">
                    <div class="fa-audit-feed">
                        {% for log in page %}
                            {%- set sev = pill_tone_action(log.action) -%}
                            {{ _fa_audit_row.render({
                                ts:     log.createdAt|fa_datetime(true),
                                sev:    sev,
                                actor:  log.userName|default('system'),
                                action: log.action,
                                target: log.entityType ~ (log.entityId ? '#' ~ log.entityId : ''),
                                pill:   log.description|default('')|slice(0, 60),
                                hash:   log.id|default('')|slice(0, 12)
                            }) }}
                            {# Actor + entity + detail links per row #}
                            <div class="small ps-1 pb-1 d-flex gap-3">
                                <a href="{{ path('app_audit_log_user', {userName: log.userName}) }}" class="link-primary">
                                    <i class="fa-icon fa-icon--nav-users" aria-hidden="true"></i>
                                    {{ log.userName }}
                                </a>
                                {% if log.entityId %}
                                <a href="{{ path('app_audit_log_entity', {entityType: log.entityType, entityId: log.entityId}) }}" class="link-primary">
                                    {{ log.entityType }} #{{ log.entityId }}
                                </a>
                                {% endif %}
                                <a href="{{ path('app_audit_log_detail', {id: log.id}) }}" class="link-primary">
                                    {{ 'audit_log.table.view_details'|trans({}, 'audit_log') }}
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Timeline View #}
                <div class="tab-pane fade" id="timeline-view" role="tabpanel">
                    {% include '_components/_audit_timeline.html.twig' with {
                        auditLogs: page.items
                    } %}
                </div>

                {# Compact View — tamper-evident log line per entry, mono-typed #}
                <div class="tab-pane fade" id="compact-view" role="tabpanel">
                    {% for log in page %}
                        {%- set sev = pill_tone_action(log.action) -%}
                        {{ _fa_audit_row.render({
                            ts: log.createdAt|fa_time(true),
                            sev: sev,
                            actor: log.userName|default('system'),
                            action: log.action,
                            target: log.entityType ~ (log.entityId ? '#' ~ log.entityId : ''),
                            hash: log.id|default('')
                        }) }}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
