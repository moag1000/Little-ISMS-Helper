{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'objective'%}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'objective.page.title'|trans({}, 'objective') }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.objectives'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'objective.page.title'|trans({}, 'objective'),
        actions: is_granted('ISMS_STEERING_EDIT') ? [
            { label: 'objective.action.add_new'|trans({}, 'objective'), variant: 'primary', icon: 'plus', href: path('app_objective_new'), attrs: {'data-turbo-frame': 'fa-form-modal'} }
        ] : []
    }) }}
{% set _global_hints = alva_hints('objective_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_objective_index'),
        list_title: 'objective.list.title'|trans({}, 'objective'),
        empty: {
            mood: 'sleeping',
            title: 'objective.message.no_objectives'|trans({}, 'objective'),
            actions: is_granted('ISMS_STEERING_EDIT') ? [
                { label: 'objective.action.add_new'|trans({}, 'objective'), variant: 'primary', icon: 'plus', href: path('app_objective_new') }
            ] : []
        },
        card_attrs: 'data-controller="bulk-actions" data-bulk-actions-endpoint-value="/' ~ app.request.locale ~ '/objective"',
    } %}
        {% block list_summary %}
            {% if achieved_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'objective.summary.achieved'|trans({'%count%': achieved_count}, 'objective') }}</span>{% endif %}
            {% if delayed_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'objective.summary.delayed'|trans({'%count%': delayed_count}, 'objective') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                {% block table_head %}
                    <tr>
                        {% if is_granted('ISMS_STEERING_EDIT') %}
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        {% endif %}
                        <th scope="col">{{ 'objective.table.title'|trans({}, 'objective') }}</th>
                        <th scope="col">{{ 'objective.table.category'|trans({}, 'objective') }}</th>
                        <th scope="col">{{ 'objective.table.target_date'|trans({}, 'objective') }}</th>
                        <th scope="col">{{ 'objective.table.progress'|trans({}, 'objective') }}</th>
                        <th scope="col">{{ 'objective.table.status'|trans({}, 'objective') }}</th>
                        <th scope="col">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="objective-rows"{% endblock %}
                {% block table_body %}
                    {% for objective in page %}
                        {% include 'objective/_row.html.twig' with { objective: objective } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
            {% if is_granted('ISMS_STEERING_EDIT') %}
                {% include '_components/_bulk_action_bar.html.twig' with { actions: ['delete'] } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
