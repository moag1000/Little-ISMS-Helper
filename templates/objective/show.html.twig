{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% trans_default_domain 'objective' %}

{% block title %}{{ objective.title }}{% endblock %}

{% block body %}
{% import '_components/_fa_status_chip.html.twig' as _fa_status_chip %}
{% import '_components/_lifecycle_actions.html.twig' as _lifecycle_actions %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
<div class="container-fluid py-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.objectives'|trans({}, 'nav'), url: path('app_objective_index') },
            { label: objective.title }
        ]
    } %}

    {% set _show_actions = [] %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set _show_actions = _show_actions|merge([{ label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit', href: path('app_objective_edit', {id: objective.id}) }]) %}
    {% endif %}
    {% set _show_actions = _show_actions|merge([{ label: 'common.back_to_list'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('app_objective_index') }]) %}
    {{ _fa_page_header.render({
        title: objective.title,
        subtitle: objective.category|default(''),
        actions: _show_actions
    }) }}

    {% set _pct = kpi_progress ?? objective.progressPercentage %}
    {% set _status %}{{ _fa_status_chip.render({ entity_class: 'App\\Entity\\ISMSObjective', status_key: objective.status }) }}{% endset %}
    {% set _actions %}{{ _lifecycle_actions.dropdown(objective, 'isms-objective', 'isms_objective_lifecycle') }}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'show.status.owner'|trans({}, 'messages'), value: objective.effectiveResponsiblePerson },
            { label: 'show.status.target_date'|trans({}, 'messages'), value: objective.targetDate ? objective.targetDate|fa_date : null },
            { label: 'show.status.progress'|trans({}, 'messages'), value: _pct is not null ? _pct ~ ' %' : null },
        ],
        workflow: workflow_state(objective),
    }) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: objective } only %}

    <div class="row">
        <div class="col-lg-8 fa-show-section" id="details">
            {% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
                {% block card_header %}
                    <div class="card-header"><h2 class="mb-0">{{ 'show.anchor.details'|trans({}, 'messages') }}</h2></div>
                {% endblock %}
                {% block card_body %}
                    {% import '_components/_fa_progress.html.twig' as _fa_progress %}
                    {% import '_components/_fa_alert.html.twig' as _fa_alert %}
                    <p class="lead">{{ objective.description }}</p>

                    <div class="row mb-3">
                        <div class="col-md-6"><div class="fw-semibold text-muted small text-uppercase mb-2">{{ 'objective.field.category'|trans({}, 'objective') }}</div><p>{{ objective.category }}</p></div>
                        <div class="col-md-6"><div class="fw-semibold text-muted small text-uppercase mb-2">{{ 'objective.field.responsible_person'|trans({}, 'objective') }}</div><p>{{ objective.effectiveResponsiblePerson ?? '—' }}{% include '_components/_deputy_persons.html.twig' with { deputies: objective.responsibleDeputyPersons } only %}</p></div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6"><div class="fw-semibold text-muted small text-uppercase mb-2">{{ 'objective.field.target_date'|trans({}, 'objective') }}</div><p>{{ objective.targetDate|fa_date }}</p></div>
                        <div class="col-md-6"><div class="fw-semibold text-muted small text-uppercase mb-2">{{ 'objective.field.achieved_date'|trans({}, 'objective') }}</div><p>{{ objective.achievedDate|fa_date }}</p></div>
                    </div>

                    {% if objective.measurableIndicators %}
                    <div class="fw-semibold text-muted small text-uppercase mb-2">{{ 'objective.field.measurable_indicators'|trans({}, 'objective') }}</div>
                    <p>{{ objective.measurableIndicators|nl2br }}</p>
                    {% endif %}

                    <div class="fw-semibold text-muted small text-uppercase mb-2">{{ 'objective.table.progress'|trans({}, 'objective') }}</div>
                    {% set _pct = kpi_progress ?? objective.progressPercentage %}
                    {{ _fa_progress.render({ value: _pct, tone: _pct >= 75 ? 'success' : (_pct >= 50 ? 'warning' : 'danger'), showText: true, class: 'mb-2' }) }}
                    <p><strong>{{ 'objective.label.current'|trans({}, 'objective') }}:</strong> {{ kpi_current ?? objective.currentValue }} {{ objective.unit }} / <strong>{{ 'objective.label.target'|trans({}, 'objective') }}:</strong> {{ objective.targetValue }} {{ objective.unit }}</p>
                    {% if objective.kpiKey %}
                        <p class="text-muted-color small">{{ 'objective.label.kpi_computed'|trans({ '%kpi%': ('dashboard.kpi.' ~ objective.kpiKey)|trans({}, 'dashboard'), '%scope%': objective.kpiLocation ? objective.kpiLocation.name : 'objective.label.kpi_scope_all'|trans({}, 'objective') }, 'objective') }}{% if objective.kpiLocation %} · <a href="{{ path('app_location_map', { site: objective.kpiLocation.id }) }}">{{ 'objective.label.kpi_on_map'|trans({}, 'objective') }}</a>{% endif %}</p>
                    {% endif %}

                    {% if objective.progressNotes %}
                    <div class="fw-semibold text-muted small text-uppercase mb-2 mt-3">{{ 'objective.field.progress_notes'|trans({}, 'objective') }}</div>
                    {{ _fa_alert.render({ variant: 'info', body: objective.progressNotes|nl2br }) }}
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-lg-4">
            {% embed '_components/_card.html.twig' %}
                {% block card_header %}
                    <div class="card-header"><h2 class="mb-0">{{ 'common.metadata'|trans({}, 'messages') }}</h2></div>
                {% endblock %}
                {% block card_body %}
                    <dl class="row mb-0 small">
                        <dt class="col-sm-5">{{ 'common.created_at'|trans({}, 'messages') }}</dt><dd class="col-sm-7">{{ objective.createdAt|fa_datetime }}</dd>
                        <dt class="col-sm-5">{{ 'common.updated_at'|trans({}, 'messages') }}</dt><dd class="col-sm-7">{{ objective.updatedAt|fa_datetime }}</dd>
                        <dt class="col-sm-5">{{ 'common.id'|trans({}, 'messages') }}</dt><dd class="col-sm-7"><code>{{ objective.id }}</code></dd>
                    </dl>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: objective, lifecycle: 'isms-objective' } only %}
</div>
{% endblock %}
