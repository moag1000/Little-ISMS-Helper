{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'audit' %}
{% block title %}{{ 'audit_management.title'|trans({}, 'audit')}}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
<div class="container-fluid">
    {# Breadcrumb Navigation #}
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.dashboard'|trans({}, 'nav'), url: path('app_dashboard') },
            { label: 'audit_management.title'|trans({}, 'audit')}
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'audit_management.title'|trans({}, 'audit'),
        subtitle: 'audit_management.subtitle'|trans({}, 'audit'),
        actions: [
            { label: 'audit.new'|trans({}, 'audit'), href: path('app_audit_new'), variant: 'primary', icon: 'plus', attrs: {'data-turbo-frame': 'fa-form-modal'} },
            { label: 'common.export_excel'|trans({}, 'messages'), href: path('app_audit_export_excel'), variant: 'ghost', icon: 'nav-file-earmark-spreadsheet' }
        ]
    }) }}
{% set _global_hints = alva_hints('audit_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

<div class="py-4">
    {# Upcoming Audits Highlight #}
    {% if upcoming|length > 0 %}
    {{ _fa_alert.render({ variant: 'info', class: 'mb-4', title: 'audit.upcoming_audits'|trans({}, 'audit'), body: 'audit.upcoming_audits_count'|trans({'%count%': upcoming|length}, 'audit') }) }}
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_audit_index'),
        filter_keys: ['status', 'scope_type', 'date_from', 'date_to'],
        search_placeholder: 'audit.filter.search_placeholder'|trans({}, 'audit'),
        list_title: 'audit.list.all'|trans({}, 'audit'),
        empty: {
            mood: 'sleeping',
            title: 'audit.empty.title'|trans({}, 'audit'),
            text: 'audit.empty.description'|trans({}, 'audit'),
            actions: [
                { label: 'audit.new'|trans({}, 'audit'), variant: 'primary', icon: 'plus', href: path('app_audit_new'), attrs: {'data-turbo-frame': 'fa-form-modal'} }
            ]
        },
    } %}
        {% block list_filters %}
            <div class="col-md-3">
                <label for="audit-status" class="form-label">{{ 'audit.field.status'|trans({}, 'audit') }}</label>
                <select name="status" id="audit-status" class="form-select fa-cyber-input__field" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="">{{ 'audit.filter.all_status'|trans({}, 'audit') }}</option>
                    {% for st in ['planned', 'in_progress', 'conducted', 'completed', 'reported', 'postponed', 'cancelled'] %}
                        <option value="{{ st }}" {% if app.request.query.get('status') == st %}selected{% endif %}>{{ ('audit.status.' ~ st)|trans({}, 'audit') }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="audit-scope-type" class="form-label">{{ 'audit.field.scope_type'|trans({}, 'audit') }}</label>
                <select name="scope_type" id="audit-scope-type" class="form-select fa-cyber-input__field" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                    {% for st in ['full_isms', 'compliance_framework', 'asset', 'asset_type', 'asset_group', 'location', 'department', 'corporate_wide', 'corporate_subsidiaries'] %}
                        <option value="{{ st }}" {% if app.request.query.get('scope_type') == st %}selected{% endif %}>{{ ('audit.scope_type.' ~ st)|trans({}, 'audit') }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="audit-date-from" class="form-label">{{ 'common.date_from'|trans({}, 'messages') }}</label>
                <input type="date" name="date_from" id="audit-date-from" class="form-control fa-cyber-input__field" value="{{ app.request.query.get('date_from') }}">
            </div>
            <div class="col-md-3">
                <label for="audit-date-to" class="form-label">{{ 'common.date_to'|trans({}, 'messages') }}</label>
                <input type="date" name="date_to" id="audit-date-to" class="form-control fa-cyber-input__field" value="{{ app.request.query.get('date_to') }}">
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if (status_counts.planned ?? 0) > 0 %}<span class="fa-status-pill fa-status-pill--neutral">{{ 'audit.status_count.planned'|trans({'%count%': status_counts.planned}, 'audit') }}</span>{% endif %}
            {% if (status_counts.in_progress ?? 0) > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'audit.status_count.in_progress'|trans({'%count%': status_counts.in_progress}, 'audit') }}</span>{% endif %}
            {% if (status_counts.completed ?? 0) > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'audit.status_count.completed'|trans({'%count%': status_counts.completed}, 'audit') }}</span>{% endif %}
            {% if (status_counts.reported ?? 0) > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'audit.status_count.reported'|trans({'%count%': status_counts.reported}, 'audit') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with {
                'class': 'table-hover mb-0',
                'theadClass': 'thead-sticky',
                'noMargin': true,
                'responsive': true
            } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="w-120px">{{ 'audit.field.audit_number'|trans({}, 'audit') }}</th>
                        <th scope="col">{{ 'audit.field.title'|trans({}, 'audit') }}</th>
                        <th scope="col" class="w-150px">{{ 'audit.field.scope_type'|trans({}, 'audit') }}</th>
                        <th scope="col" class="w-130px">{{ 'audit.field.planned_date'|trans({}, 'audit') }}</th>
                        <th scope="col" class="w-130px">{{ 'audit.field.status'|trans({}, 'audit') }}</th>
                        <th scope="col" class="w-180px w-text-right">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="audit-rows"{% endblock %}
                {% block table_body %}
                    {% for audit in page %}
                        {% include 'audit/_row.html.twig' with { audit: audit } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
</div>
</div>
{% endblock %}
