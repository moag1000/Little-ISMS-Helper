{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'asset' %}
{% block title %}{{ 'asset.modern.header.title'|trans({}, 'asset')}}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{# Breadcrumb Navigation #}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'asset.modern.breadcrumb'|trans({}, 'asset')}
    ]
} %}

{{ _fa_page_header.render({
    title: 'asset.modern.header.title'|trans({}, 'asset'),
    subtitle: 'asset.modern.header.subtitle'|trans({}, 'asset'),
    actions: [
        { label: 'asset.action.print_all_labels'|trans({}, 'asset'), href: path('app_asset_qr_labels_bulk'), variant: 'ghost', icon: 'ui-key', attrs: { 'data-turbo-prefetch': 'false', 'data-turbo': 'false' } },
        { label: 'asset.action.quick_new'|trans({}, 'asset'), href: path('app_asset_new_quick'), variant: 'ghost', icon: 'ui-lightbulb' },
        { label: 'asset.action.create'|trans({}, 'asset'), href: path('app_asset_new'), variant: 'primary', icon: 'plus', attrs: { 'data-turbo-frame': 'fa-form-modal' } }
    ]|merge(is_granted('ROLE_MANAGER') ? [{ label: 'filtered_export.button.label'|trans({}, 'filtered_export'), href: path('app_filtered_export_entity', { entityType: 'asset', format: 'xlsx' }) ~ (app.request.queryString ? '?' ~ app.request.queryString : ''), variant: 'ghost', icon: 'nav-file-earmark-spreadsheet', attrs: { 'data-turbo-prefetch': 'false', 'data-turbo': 'false' } }] : [])
}) }}
{% set _global_hints = alva_hints('asset_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

<div class="container-fluid py-4">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_asset_index'),
    filter_keys: ['type', 'classification', 'owner', 'status', 'dora_relevant', 'view', 'tag', 'location'],
    list_title: 'asset.modern.table.title_all'|trans({}, 'asset'),
    empty: {
        mood: 'sleeping',
        title: 'asset.modern.empty.title'|trans({}, 'asset'),
        text: 'asset.modern.empty.description'|trans({}, 'asset'),
        norm_ref: 'ISO 27001 A.5.9 · ISO 9001: Infrastruktur (7.1.3)',
        help_link: path('app_help_glossary') ~ '#glossary-asset',
        actions: [{ label: 'asset.action.create'|trans({}, 'asset'), variant: 'primary', icon: 'plus', href: path('app_asset_new') }],
    },
    card_attrs: { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': '/' ~ app.request.locale ~ '/asset', 'data-bulk-actions-entity-label': 'asset.modern.header.title'|trans({}, 'asset') },
} %}
    {% block list_filters %}
        {% include '_components/_isms_scope_filter.html.twig' %}
        {% if app.request.query.getInt('location') > 0 %}
            <input type="hidden" name="location" value="{{ app.request.query.getInt('location') }}">
        {% endif %}
        {% import '_components/_fa_filter_select.html.twig' as _fa_filter_select %}
        {% import '_components/_fa_cyber_field.html.twig' as _fa_cyber %}
            {% if currentTenant %}
            <div class="col-md-3">
                <label for="view-filter" class="form-label">{{ 'common.view'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="view-filter" name="view" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="own" {{ inheritanceInfo.currentView == 'own' ? 'selected' : '' }}>{{ 'corporate.view.own_only'|trans({}, 'tenant') }}</option>
                    {% if inheritanceInfo.hasParent %}
                    <option value="inherited" {{ inheritanceInfo.currentView == 'inherited' ? 'selected' : '' }}>{{ 'corporate.view.including_inherited'|trans({}, 'tenant') }}</option>
                    {% endif %}
                    {% if inheritanceInfo.hasSubsidiaries %}
                    <option value="subsidiaries" {{ inheritanceInfo.currentView == 'subsidiaries' ? 'selected' : '' }}>{{ 'corporate.view.including_subsidiaries'|trans({}, 'tenant') }}</option>
                    {% endif %}
                    {% if inheritanceInfo.isAdmin %}
                    <option value="orphaned" {{ inheritanceInfo.currentView == 'orphaned' ? 'selected' : '' }}>{{ 'corporate.view.orphaned'|trans({}, 'tenant') }}</option>
                    <option value="all" {{ inheritanceInfo.currentView == 'all' ? 'selected' : '' }}>{{ 'corporate.view.all_tenants'|trans({}, 'tenant') }}</option>
                    {% endif %}
                </select>
            </div>
            {% endif %}
            <div class="col-md-3">
                <label for="filter-type" class="form-label">{{ 'asset.label.type'|trans({}, 'asset') }}</label>
                <select class="form-select fa-cyber-input__field" id="filter-type" name="type">
                    <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                    {% if typeStats|length > 0 %}
                        {% for stat in typeStats %}
                            <option value="{{ stat.assetType }}" {{ app.request.query.get('type') == stat.assetType ? 'selected' : '' }}>
                                {{ stat.assetType }} ({{ stat.count }})
                            </option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="filter-classification" class="form-label">{{ 'asset.label.data_classification'|trans({}, 'asset') }}</label>
                <select class="form-select fa-cyber-input__field" id="filter-classification" name="classification">
                    <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                    <option value="public" {{ app.request.query.get('classification') == 'public' ? 'selected' : '' }}>{{ 'asset.classification.public'|trans({}, 'asset') }}</option>
                    <option value="internal" {{ app.request.query.get('classification') == 'internal' ? 'selected' : '' }}>{{ 'asset.classification.internal'|trans({}, 'asset') }}</option>
                    <option value="confidential" {{ app.request.query.get('classification') == 'confidential' ? 'selected' : '' }}>{{ 'asset.classification.confidential'|trans({}, 'asset') }}</option>
                    <option value="restricted" {{ app.request.query.get('classification') == 'restricted' ? 'selected' : '' }}>{{ 'asset.classification.restricted'|trans({}, 'asset') }}</option>
                </select>
            </div>
            <div class="col-md-3">
                {{ _fa_cyber.text('owner', {
                    id: 'filter-owner',
                    label: 'asset.label.owner'|trans({}, 'asset'),
                    value: app.request.query.get('owner'),
                    placeholder: 'common.search'|trans({}, 'messages') ~ '...'
                }) }}
            </div>
            <div class="col-md-3">
                {{ _fa_filter_select.render({
                    name: 'status',
                    label: 'asset.label.status'|trans({}, 'asset'),
                    values: ['active', 'inactive', 'in_use', 'returned', 'retired', 'disposed'],
                    prefix: 'asset.status.',
                    domain: 'asset',
                    selected: app.request.query.get('status'),
                    all_label: 'common.all'|trans({}, 'messages')
                }) }}
            </div>
            {% if is_module_active('nis2_dora') %}
            <div class="col-md-3">
                <label for="filter-dora-relevant" class="form-label">DORA</label>
                <select class="form-select fa-cyber-input__field" id="filter-dora-relevant" name="dora_relevant">
                    <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                    <option value="1" {{ app.request.query.get('dora_relevant') == '1' ? 'selected' : '' }}>{{ 'asset.field.is_dora_relevant'|trans({}, 'asset') }}</option>
                </select>
            </div>
            {% endif %}
    {% endblock %}
    {% block list_summary %}
        {% if critical_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'asset.summary.critical'|trans({'%count%': critical_count}, 'asset') }}</span>{% endif %}
        {% if restricted_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'asset.summary.restricted'|trans({'%count%': restricted_count}, 'asset') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        {% embed '_components/_table.html.twig' with {
                'class': 'table-hover table-bulk-selectable mb-0',
                'caption': 'asset.modern.table.caption'|trans({}, 'asset'),
                'noMargin': true,
                'responsive': true
            } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'asset.label.name'|trans({}, 'asset') }}</th>
                        <th scope="col">{{ 'asset.label.type'|trans({}, 'asset') }}</th>
                        <th scope="col">{{ 'asset.label.owner'|trans({}, 'asset') }}</th>
                        <th scope="col" class="text-center">{{ 'asset.label.classification'|trans({}, 'asset') }}</th>
                        <th scope="col" class="text-center">CIA</th>
                        <th scope="col" class="text-center">{{ 'asset.label.risks'|trans({}, 'asset') }}</th>
                        <th scope="col" class="text-center">{{ 'asset.label.status'|trans({}, 'asset') }}</th>
                        <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="asset-rows"{% endblock %}
                {% block table_body %}
                    {% set workflowStates = workflow_states(page) %}
                {% for asset in page %}
                        {% include 'asset/_row.html.twig' with { asset: asset, currentTenant: currentTenant, recommendations: recommendations } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}

        {% include '_components/_bulk_action_bar.html.twig' with {
            actions: ['export', 'assign', 'delete']
        } %}
    {% endblock %}
{% endembed %}

{# WS-5 bulk tag actions bar (polymorphic) #}
{% if is_granted('TAG_APPLY') %}
    {% include '_components/_bulk_action_bar.html.twig' with {
        entity_class:   'App\\Entity\\Asset',
        action_urls: {
            tag_add: path('admin_tag_bulk_apply', {entityClass: 'Asset'}),
        },
        available_tags: available_tags(),
    } only %}
{% endif %}

{% if page.isEmpty and not app.request.query.get('q') and not app.request.query.get('type') and not app.request.query.get('classification') and not app.request.query.get('owner') and not app.request.query.get('status') %}
    {% set _system_templates = system_templates('App\\Entity\\Asset') %}
    {% if _system_templates|length > 0 %}
        <div class="text-center mt-3">
            <button type="button" class="fa-cyber-btn fa-cyber-btn--secondary"
                    data-controller="fa-modal-dispatcher"
                    data-action="click->fa-modal-dispatcher#open"
                    data-fa-modal-id="systemTemplateModalAsset">
                {{ 'system_templates.cta.button'|trans({}, 'system_templates') }}
            </button>
            <div class="form-text small">
                {{ 'system_templates.cta.hint'|trans({}, 'system_templates') }}
            </div>
        </div>
        {% include '_components/_system_template_selector.html.twig' with {
            templates: _system_templates,
            entity_class: 'App\\Entity\\Asset',
            redirect_to: 'app_asset_index',
            modal_id: 'systemTemplateModalAsset'
        } %}
    {% endif %}
{% endif %}
</div>
{% endblock %}
