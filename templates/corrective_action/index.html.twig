{% extends 'base.html.twig' %}

{% block title %}{{ 'corrective_action.page.title'|trans({}, 'audits') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'audit_finding.page.title'|trans({}, 'audits'), url: path('app_audit_finding_index') },
        { label: 'corrective_action.page.title'|trans({}, 'audits') }
    ]
} %}
{{ _fa_page_header.render({
    title: 'corrective_action.page.title'|trans({}, 'audits'),
    actions: [
        { label: 'corrective_action.action.new'|trans({}, 'audits'), href: path('app_corrective_action_new'), variant: 'primary', icon: 'plus', attrs: {'data-turbo-frame': 'fa-form-modal'} }
    ]
}) }}
{% set _global_hints = alva_hints('corrective_action_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

<div class="container-fluid py-4">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_corrective_action_index'),
    filter_keys: ['source_type'],
    list_title: 'corrective_action.list.title'|trans({}, 'audits'),
    empty: {
        mood: 'sleeping',
        title: 'corrective_action.message.none'|trans({}, 'audits'),
    },
} %}
    {% block list_filters %}
        <div class="col-md-4">
            <label for="filter-source-type" class="form-label">{{ 'corrective_action.filter.source_type'|trans({}, 'audits') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-source-type" name="source_type" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="">{{ 'corrective_action.filter.all'|trans({}, 'audits') }} ({{ counts_by_source_type|reduce((sum, n) => sum + n, 0) }})</option>
                {% for st in ['audit_finding', 'incident', 'change_request', 'manual'] %}
                    <option value="{{ st }}" {{ source_type_filter == st ? 'selected' : '' }}>{{ ('corrective_action.source_type.' ~ st)|trans({}, 'audits') }} ({{ counts_by_source_type[st] ?? 0 }})</option>
                {% endfor %}
            </select>
        </div>
    {% endblock %}
    {% block list_summary %}
        {% if overdue_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'corrective_action.summary.overdue'|trans({'%count%': overdue_count}, 'audits') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        <div class="d-flex flex-column gap-2 p-3" id="corrective-action-rows">
            {% set workflowStates = workflow_states(page) %}
            {% for a in page %}
                {% include 'corrective_action/_row.html.twig' with { action: a } %}
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
