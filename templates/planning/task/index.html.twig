{% extends 'base.html.twig' %}
{% trans_default_domain 'planning' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'planning.task.title.list'|trans({}, 'planning') }}{% endblock %}

{% block body %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.planning'|trans({}, 'nav') }
        ]
    } %}
</div>

{{ _fa_page_header.render({
    title: 'planning.task.title.list'|trans({}, 'planning'),
    actions: [
        { label: 'planning.task.action.create'|trans({}, 'planning'), variant: 'primary', icon: 'plus', href: path('app_planning_task_new') }
    ]
}) }}

<div class="container-fluid py-3">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_planning_task_index'),
    list_title: 'planning.task.title.list'|trans({}, 'planning'),
    empty: {
        mood: 'sleeping',
        title: 'planning.task.message.no_tasks'|trans({}, 'planning'),
        actions: [
            { label: 'planning.task.action.create'|trans({}, 'planning'), variant: 'primary', icon: 'plus', href: path('app_planning_task_new') }
        ]
    },
} %}
    {% block list_table %}
        {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
            {% block table_head %}
                <tr>
                    <th scope="col">{{ 'planning.task.col.name'|trans({}, 'planning') }}</th>
                    <th scope="col">{{ 'planning.task.col.group'|trans({}, 'planning') }}</th>
                    <th scope="col" class="text-center">{{ 'planning.task.col.default_pt_per_week'|trans({}, 'planning') }}</th>
                    <th scope="col" class="text-center">{{ 'planning.task.col.recurring'|trans({}, 'planning') }}</th>
                    <th scope="col">{{ 'planning.task.col.visibility'|trans({}, 'planning') }}</th>
                    <th scope="col" class="text-center">{{ 'planning.common.active'|trans({}, 'planning') }}</th>
                    <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
                </tr>
            {% endblock %}
            {% block table_body %}
                {% for task in page %}
                <tr>
                    <td><strong>{{ task.name }}</strong></td>
                    <td>
                        {% if task.group %}
                            {{ task.group.name }}
                        {% else %}
                            <span class="text-muted-color">-</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if task.defaultPtPerWeek is not null %}
                            {{ task.defaultPtPerWeek }}
                        {% else %}
                            <span class="text-muted-color">-</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if task.recurring %}
                            {% include '_components/_badge.html.twig' with { variant: 'info', content: '✓' } %}
                        {% else %}
                            {% include '_components/_badge.html.twig' with { variant: 'secondary', content: '✗' } %}
                        {% endif %}
                    </td>
                    <td>
                        {% include '_components/_badge.html.twig' with {
                            variant: task.visibility == 'all' ? 'info' : 'secondary',
                            content: ('planning.visibility.' ~ task.visibility)|trans({}, 'planning')
                        } %}
                    </td>
                    <td class="text-center">
                        {% if task.active %}
                            {% include '_components/_badge.html.twig' with { variant: 'success', content: '✓' } %}
                        {% else %}
                            {% include '_components/_badge.html.twig' with { variant: 'secondary', content: '✗' } %}
                        {% endif %}
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="{{ path('app_planning_task_edit', {id: task.id}) }}"
                               class="fa-cyber-btn fa-cyber-btn--ghost"
                               aria-label="{{ 'planning.common.edit'|trans({}, 'planning') }} {{ task.name }}">
                                <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i>
                            </a>
                            <form method="post" action="{{ path('app_planning_task_delete', {id: task.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~task.id) }}">
                                <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--danger"
                                        aria-label="{{ 'planning.common.delete'|trans({}, 'planning') }} {{ task.name }}"
                                        data-controller="ui-actions"
                                        data-action="click->ui-actions#confirm"
                                        data-ui-actions-message-param="{{ 'planning.common.confirm_delete'|trans({}, 'planning') }}"
                                        data-ui-actions-tone-param="danger">
                                    <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
