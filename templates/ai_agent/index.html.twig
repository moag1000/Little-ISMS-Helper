{% extends 'base.html.twig' %}
{% trans_default_domain 'mris' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% block title %}{{ 'mris.ai_agent.index.title'|trans({}, 'mris') }}{% endblock %}

{% block body %}
<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans({}, 'nav') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'mris.ai_agent.index.title'|trans({}, 'mris') }}</li>
        </ol>
    </nav>

    {{ _fa_page_header.render({
        badge: { icon: 'nav-robot', label: '' },
        title: 'mris.ai_agent.index.title'|trans({}, 'mris')
    }) }}

    <div class="mb-4">
        <p class="text-muted small mb-0">
            {{ 'mris.ai_agent.index.intro'|trans({}, 'mris')|raw }}<br>
            <em>{{ 'mris.ai_agent.index.source'|trans({}, 'mris') }}</em>
        </p>
    </div>

    {# Inventory Stats #}
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            {% embed '_components/_card.html.twig' with { 'class': 'text-center h-100' } %}
                {% block card_body %}
                    <div class="display-4 fw-bold">{{ stats.total }}</div>
                    <div class="small text-muted">{{ 'mris.ai_agent.index.stat_total'|trans({}, 'mris') }}</div>
                {% endblock %}
            {% endembed %}
        </div>
        <div class="col-md-3">
            {% embed '_components/_card.html.twig' with { 'class': 'text-center h-100' } %}
                {% block card_body %}
                    <div class="display-4 fw-bold text-danger">{{ stats.by_classification.high_risk }}</div>
                    <div class="small text-muted">{{ 'mris.ai_agent.index.stat_high_risk'|trans({}, 'mris') }}</div>
                {% endblock %}
            {% endembed %}
        </div>
        <div class="col-md-3">
            {% embed '_components/_card.html.twig' with { 'class': 'text-center h-100' } %}
                {% block card_body %}
                    <div class="display-4 fw-bold text-warning">{{ stats.unclassified }}</div>
                    <div class="small text-muted">{{ 'mris.ai_agent.index.stat_unclassified'|trans({}, 'mris') }}</div>
                {% endblock %}
            {% endembed %}
        </div>
        <div class="col-md-3">
            {% embed '_components/_card.html.twig' with { 'class': 'text-center h-100' } %}
                {% block card_body %}
                    <div class="display-4 fw-bold text-{{ stats.avg_completeness >= 80 ? 'success' : (stats.avg_completeness >= 50 ? 'warning' : 'danger') }}">{{ stats.avg_completeness }}%</div>
                    <div class="small text-muted">{{ 'mris.ai_agent.index.stat_completeness'|trans({}, 'mris') }}</div>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# High-Risk Warning #}
    {% if high_risk_incomplete|length > 0 %}
        {{ _fa_alert.render({ variant: 'danger', class: 'mb-4', body: 'mris.ai_agent.index.high_risk_incomplete'|trans({'%count%': high_risk_incomplete|length}, 'mris') }) }}
    {% endif %}

    {# Inventory Table #}
    {% if agents|length == 0 %}
        {{ _fa_alert.render({ variant: 'info', body: 'mris.ai_agent.index.empty'|trans({}, 'mris') }) }}
    {% else %}
        {% embed '_components/_card.html.twig' %}
            {% block card_body %}
                {% embed '_components/_fa_table.html.twig' %}
                    {% block table_head %}
                        <tr>
                            <th scope="col" class="fa-table__th">{{ 'mris.ai_agent.index.col.name'|trans({}, 'mris') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'mris.ai_agent.index.col.provider'|trans({}, 'mris') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'mris.ai_agent.index.col.model'|trans({}, 'mris') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'mris.ai_agent.index.col.classification'|trans({}, 'mris') }}</th>
                            <th scope="col" class="fa-table__th fa-table__th--center">{{ 'mris.ai_agent.index.col.completeness'|trans({}, 'mris') }}</th>
                            <th scope="col" class="fa-table__th fa-table__th--actions"></th>
                        </tr>
                    {% endblock %}
                    {% block table_body %}
    {% import '_components/_fa_progress.html.twig' as _fa_progress %}
                        {% for agent in agents %}
                            {% set comp = completeness[agent.id] %}
                            <tr class="fa-table__row">
                                <td class="fa-table__cell">
                                    <strong>{{ agent.name }}</strong>
                                    {% if agent.aiAgentPurpose %}
                                        <div class="small text-muted">{{ agent.aiAgentPurpose|slice(0, 60) }}{% if agent.aiAgentPurpose|length > 60 %}…{% endif %}</div>
                                    {% endif %}
                                </td>
                                <td class="fa-table__cell">{{ agent.aiAgentProvider|default('—') }}</td>
                                <td class="fa-table__cell"><code>{{ agent.aiAgentModelVersion|default('—') }}</code></td>
                                <td class="fa-table__cell">
                                    {% if agent.aiAgentClassification == 'prohibited' %}
                                        {% include '_components/_badge.html.twig' with { variant: 'dark', content: 'mris.ai_agent.index.class.prohibited'|trans({}, 'mris') } %}
                                    {% elseif agent.aiAgentClassification == 'high_risk' %}
                                        {% include '_components/_badge.html.twig' with { variant: 'danger', content: 'mris.ai_agent.index.class.high_risk'|trans({}, 'mris') } %}
                                    {% elseif agent.aiAgentClassification == 'limited_risk' %}
                                        {% include '_components/_badge.html.twig' with { variant: 'warning', content: 'mris.ai_agent.index.class.limited_risk'|trans({}, 'mris') } %}
                                    {% elseif agent.aiAgentClassification == 'minimal_risk' %}
                                        {% include '_components/_badge.html.twig' with { variant: 'success', content: 'mris.ai_agent.index.class.minimal_risk'|trans({}, 'mris') } %}
                                    {% else %}
                                        {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'mris.ai_agent.index.class.unclassified'|trans({}, 'mris') } %}
                                    {% endif %}
                                </td>
                                <td class="fa-table__cell fa-table__cell--center">
                                    {{ _fa_progress.render({ value: comp.percentage, tone: comp.percentage >= 80 ? 'success' : (comp.percentage >= 50 ? 'warning' : 'danger') }) }}
                                </td>
                                <td class="fa-table__cell fa-table__cell--actions">
                                    <a href="{{ path('app_asset_show', {id: agent.id}) }}" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost" aria-label="{{ 'common.view'|trans({}, 'messages') }}">
                                        <i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endblock %}
        {% endembed %}
    {% endif %}

    {{ _fa_alert.render({ variant: 'info', class: 'mt-4 small', body: 'mris.ai_agent.index.required_fields'|trans({}, 'mris') }) }}
</div>
{% endblock %}
