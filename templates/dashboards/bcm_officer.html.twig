{% extends 'base.html.twig' %}
{% trans_default_domain 'dashboards' %}

{% block title %}{{ 'bcm_officer.title'|trans }}{% endblock %}

{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_kpi_tile.html.twig' as _kpi_tile %}
{% import '_components/_fa_empty_state.html.twig' as _fa_empty_state %}

{% block body %}
<div class="fa-aurora-surface role-dashboard bcm-officer-dashboard">
    {{ _fa_page_header.render({
        title:    'bcm_officer.title'|trans,
        subtitle: 'bcm_officer.subtitle'|trans,
        actions: [
            { label: 'action.standard_dashboard'|trans,    variant: 'ghost',   icon: 'nav-home',     href: path('app_dashboard') },
            { label: 'bcm_officer.action.bc_plans'|trans,  variant: 'ghost',   icon: 'nav-workflow', href: path('app_bc_plan_index') },
            { label: 'bcm_officer.action.exercises'|trans, variant: 'ghost',   icon: 'nav-stars',    href: path('app_bc_exercise_index') },
            { label: 'bcm_officer.action.crisis_team'|trans, variant: 'primary', icon: 'nav-people', href: path('app_crisis_team_index') }
        ]
    }) }}

    {# Key figures from the KPI catalog (ISO 22301 8.2.2 BIA, 8.4 plans, 8.5 exercises) #}
    <div class="row g-3 mt-2 mb-4">
        <div class="col-6 col-md-3">{{ _kpi_tile.render('bia_coverage', { icon: 'nav-process', href: path('app_business_process_index') }) }}</div>
        <div class="col-6 col-md-3">{{ _kpi_tile.render('critical_processes', { href: path('app_business_process_index') }) }}</div>
        <div class="col-6 col-md-3">{{ _kpi_tile.render('active_bc_plans', { icon: 'nav-workflow', href: path('app_bc_plan_index') }) }}</div>
        <div class="col-6 col-md-3">{{ _kpi_tile.render('bc_exercises_ytd', { icon: 'nav-stars', href: path('app_bc_exercise_index') }) }}</div>
    </div>

    {# ── Workflow Transparency (Pending Approvals + Lifecycle Stuck) ── #}
    <div class="row g-4 mt-2">

        {# What is waiting for this person — every deadline source, same list as My Day #}
        <div class="col-12 col-lg-6">
            {% include 'dashboards/_my_obligations.html.twig' %}
        </div>

        {# Lifecycle Stuck #}
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fa-icon fa-icon--nav-clock-history" aria-hidden="true"></i>
                    <strong>{{ 'bcm_officer.section.lifecycle_stuck'|trans }}</strong>
                    {% if dashboard.lifecycle_stuck|length > 0 %}
                    <span class="fa-status-pill fa-status-pill--sm fa-status-pill--danger ms-auto">{{ dashboard.lifecycle_stuck|length }}</span>
                    {% endif %}
                </div>
                <div class="card-body p-0">
                    {% if dashboard.lifecycle_stuck|length > 0 %}
                    <ul class="list-group list-group-flush">
                        {% for item in dashboard.lifecycle_stuck|slice(0, 10) %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="text-truncate me-2">{{ item.label|default('—') }}</span>
                            {% if item.href is defined %}
                            <a href="{{ item.href }}" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost">
                                {{ 'action.view_details'|trans }}
                            </a>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    {{ _fa_empty_state.render({
                        icon:  'nav-clock-history',
                        title: 'bcm_officer.empty.no_approvals_title'|trans,
                        text:  'bcm_officer.empty.no_approvals_text'|trans
                    }) }}
                    {% endif %}
                </div>
            </div>
        </div>

    </div>{# /row #}

    {% include 'dashboards/_report_downloads.html.twig' %}

</div>
{% endblock %}
