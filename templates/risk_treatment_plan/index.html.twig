{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'risk_treatment_plan' %}

{% block title %}{{ 'risk_treatment_plan.title'|trans({}, 'risk_treatment_plan') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'nav.risks'|trans({}, 'nav'), url: path('app_risk_index') },
        { label: 'nav.treatment_plans'|trans({}, 'nav') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'risk_treatment_plan.title'|trans({}, 'risk_treatment_plan'),
    subtitle: 'risk_treatment_plan.description'|trans({}, 'risk_treatment_plan'),
    actions: [
        { label: 'risk_treatment_plan.new'|trans({}, 'risk_treatment_plan'), variant: 'primary', icon: 'plus', href: path('app_risk_treatment_plan_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }
    ]
}) }}
{% set _global_hints = alva_hints('risk_treatment_plan_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}


<div>
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_risk_treatment_plan_index'),
    filter_keys: ['status', 'priority', 'responsible_person', 'overdue_only'],
    list_title: 'risk_treatment_plan.list.title'|trans({}, 'risk_treatment_plan'),
    empty: { mood: 'sleeping', title: 'risk_treatment_plan.no_plans'|trans({}, 'risk_treatment_plan') },
} %}
    {% block list_filters %}
        {% import '_components/_fa_cyber_field.html.twig' as _fa_cyber %}
        <div class="col-md-3">
            <label for="filter-status" class="form-label">{{ 'risk_treatment_plan.field.status'|trans({}, 'risk_treatment_plan') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-status" name="status" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                {% for st in ['planned', 'in_progress', 'completed', 'on_hold', 'cancelled'] %}
                    <option value="{{ st }}" {{ app.request.query.get('status') == st ? 'selected' : '' }}>{{ ('risk_treatment_plan.status.' ~ st)|trans({}, 'risk_treatment_plan') }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label for="filter-priority" class="form-label">{{ 'risk_treatment_plan.field.priority'|trans({}, 'risk_treatment_plan') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-priority" name="priority" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                {% for pr in ['critical', 'high', 'medium', 'low'] %}
                    <option value="{{ pr }}" {{ app.request.query.get('priority') == pr ? 'selected' : '' }}>{{ ('risk_treatment_plan.priority.' ~ pr)|trans({}, 'risk_treatment_plan') }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            {{ _fa_cyber.text('responsible_person', {
                id: 'filter-responsible',
                label: 'risk_treatment_plan.field.responsible_person'|trans({}, 'risk_treatment_plan'),
                value: app.request.query.get('responsible_person'),
                placeholder: 'common.search'|trans({}, 'messages') ~ '...'
            }) }}
        </div>
        <div class="col-md-3">
            <label for="filter-overdue" class="form-label">{{ 'risk_treatment_plan.filter.overdue'|trans({}, 'risk_treatment_plan') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-overdue" name="overdue_only" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                <option value="1" {{ app.request.query.get('overdue_only') == '1' ? 'selected' : '' }}>{{ 'risk_treatment_plan.filter.overdue_only'|trans({}, 'risk_treatment_plan') }}</option>
            </select>
        </div>
    {% endblock %}
    {% block list_summary %}
        {% if overdue_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'risk_treatment_plan.summary.overdue'|trans({'%count%': overdue_count}, 'risk_treatment_plan') }}</span>{% endif %}
        {% if in_progress_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'risk_treatment_plan.summary.in_progress'|trans({'%count%': in_progress_count}, 'risk_treatment_plan') }}</span>{% endif %}
        {% if completed_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'risk_treatment_plan.summary.completed'|trans({'%count%': completed_count}, 'risk_treatment_plan') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
            {% block table_head %}
                <tr>
                    <th scope="col">{{ 'risk_treatment_plan.field.title'|trans({}, 'risk_treatment_plan') }}</th>
                    <th scope="col">{{ 'risk_treatment_plan.field.risk'|trans({}, 'risk_treatment_plan') }}</th>
                    <th scope="col" class="text-center">{{ 'risk_treatment_plan.field.status'|trans({}, 'risk_treatment_plan') }}</th>
                    <th scope="col" class="text-center">{{ 'risk_treatment_plan.field.priority'|trans({}, 'risk_treatment_plan') }}</th>
                    <th scope="col">{{ 'risk_treatment_plan.field.responsible_person'|trans({}, 'risk_treatment_plan') }}</th>
                    <th scope="col" class="text-center">{{ 'risk_treatment_plan.field.completion'|trans({}, 'risk_treatment_plan') }}</th>
                    <th scope="col">{{ 'risk_treatment_plan.field.target_date'|trans({}, 'risk_treatment_plan') }}</th>
                    <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
                </tr>
            {% endblock %}
            {% block table_body_attrs %}id="risk-treatment-plan-rows"{% endblock %}
            {% block table_body %}
                {% for plan in page %}
                    {% include 'risk_treatment_plan/_row.html.twig' with { plan: plan } %}
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
