{% trans_default_domain 'privacy' %}<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ 'data_breach.pdf.report_title'|trans({}, 'privacy') }} - {{ breach.referenceNumber }}</title>
    <style>
        :root {
            --primary:       var(--primary);
            --surface:       var(--surface);
            --surface-2:     var(--surface-2);
            --fg:            #0f172a;
            --fg-2:          var(--fg-2);
            --fg-3:          var(--fg-3);
            --border:        var(--border);
            --success:       var(--success);
            --success-tint:  var(--success-tint);
            --danger:        var(--danger);
            --danger-tint:   var(--danger-tint);
            --warning:       var(--warning);
            --warning-tint:  var(--warning-tint);
            --info-tint:     var(--info-tint);
            --info-text:     var(--info-text);
        }

        @page {
            margin: 2cm;
        }
        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.6;
            color: var(--fg);
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 3px solid transparent;
            border-image: linear-gradient(90deg, var(--primary) 0%, var(--accent) 50%, var(--accent) 100%) 1;
            padding-bottom: 15px;
        }
        .header h1 {
            color: var(--bg);
            margin: 0;
            font-size: 24pt;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }
        .header p {
            margin: 5px 0;
            color: #666;
        }
        .meta-info {
            background: linear-gradient(135deg, var(--bg) 0%, var(--border) 100%);
            padding: 15px;
            margin-bottom: 20px;
            border: 2px solid var(--border);
            border-left-width: 4px;
            border-left-color: var(--primary);
        }
        .meta-info table {
            width: 100%;
            border-collapse: collapse;
        }
        .meta-info td {
            padding: 5px 10px;
        }
        .meta-info td:first-child {
            font-weight: bold;
            width: 35%;
        }
        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }
        .section h2 {
            color: var(--primary);
            border-bottom: 2px solid var(--primary);
            padding-bottom: 5px;
            margin-top: 0;
            font-size: 14pt;
            padding-left: 10pt;
            border-left: 4px solid var(--accent);
        }
        .section h3 {
            color: var(--surface);
            font-size: 12pt;
            margin-top: 15px;
            margin-bottom: 8px;
            font-weight: bold;
        }
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 9pt;
            font-weight: bold;
            color: var(--surface);
            letter-spacing: 0.3pt;
            border: 1.5pt solid transparent;
        }
        .badge-danger {
            background: linear-gradient(135deg, var(--danger) 0%, var(--danger) 100%);
            border-color: var(--danger);
        }
        .badge-warning {
            background: linear-gradient(135deg, var(--warning) 0%, var(--warning) 100%);
            border-color: var(--warning);
            color: var(--surface);
        }
        .badge-success {
            background: linear-gradient(135deg, var(--success) 0%, var(--success) 100%);
            border-color: var(--success);
        }
        .badge-info {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
            border-color: var(--primary-hover);
        }
        .badge-secondary {
            background: linear-gradient(135deg, var(--fg-2) 0%, var(--fg-2) 100%);
            border-color: var(--fg-2);
        }
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        .table th,
        .table td {
            border: 1px solid var(--border);
            padding: 8px;
            text-align: left;
        }
        .table th {
            background: linear-gradient(90deg, var(--bg) 0%, var(--surface) 100%);
            color: var(--primary);
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.3pt;
        }
        .alert {
            padding: 12px 15px;
            margin: 15px 0;
            border-left: 4px solid;
        }
        .alert-danger {
            background: var(--danger-tint);
            border-color: var(--danger);
            color: var(--danger);
        }
        .alert-warning {
            background: var(--warning-tint);
            border-color: var(--warning);
            color: var(--warning);
        }
        .footer {
            margin-top: 40px;
            padding-top: 15px;
            border-top: 1px solid var(--border);
            font-size: 9pt;
            color: #666;
            text-align: center;
        }
        ul {
            margin: 5px 0;
            padding-left: 20px;
        }
        .page-break {
            page-break-after: always;
        }
    </style>
</head>
<body>
    {# Header #}
    <div class="header">
        <h1>{{ 'data_breach.pdf.heading'|trans({}, 'privacy') }}</h1>
        <p>{{ 'data_breach.pdf.subheading'|trans({}, 'privacy') }}</p>
        <p><strong>{{ breach.title }}</strong></p>
        <p>{{ breach.referenceNumber }} - {{ "now"|fa_datetime }}</p>
    </div>

    {# Meta Information #}
    <div class="meta-info">
        <table>
            <tr>
                <td>{{ 'data_breach.pdf.reference_number'|trans({}, 'privacy') }}:</td>
                <td><strong>{{ breach.referenceNumber }}</strong></td>
            </tr>
            <tr>
                <td>{{ 'data_breach.pdf.status'|trans({}, 'privacy') }}:</td>
                <td>
                    {% set status_class = {
                        'draft': 'secondary',
                        'under_assessment': 'info',
                        'authority_notified': 'success',
                        'subjects_notified': 'success',
                        'closed': 'secondary'
                    }[breach.status] %}
                    <span class="badge badge-{{ status_class }}">{{ ('data_breach.pdf.status_values.' ~ breach.status)|trans({}, 'privacy') }}</span>
                </td>
            </tr>
            <tr>
                <td>{{ 'data_breach.pdf.risk_level'|trans({}, 'privacy') }}:</td>
                <td>
                    {% if breach.riskLevel %}
                        {% set risk_class = {'low': 'success', 'medium': 'info', 'high': 'warning', 'critical': 'danger'}[breach.riskLevel] %}
                        <span class="badge badge-{{ risk_class }}">{{ ('data_breach.pdf.level.' ~ breach.riskLevel)|trans({}, 'privacy') }}</span>
                    {% else %}
                        {{ 'data_breach.pdf.not_assessed'|trans({}, 'privacy') }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>{{ 'data_breach.pdf.affected_data_subjects'|trans({}, 'privacy') }}:</td>
                <td>{{ breach.affectedDataSubjects is not null ? breach.affectedDataSubjects|number_format : '—' }}</td>
            </tr>
            <tr>
                <td>{{ 'data_breach.pdf.detected_at'|trans({}, 'privacy') }}:</td>
                <td>{{ breach.detectedAt|fa_datetime }}</td>
            </tr>
            <tr>
                <td>{{ 'data_breach.pdf.report_generated'|trans({}, 'privacy') }}:</td>
                <td>{{ "now"|fa_datetime }}</td>
            </tr>
        </table>
    </div>

    {# 72-Hour Deadline Status #}
    {% if breach.requiresAuthorityNotification %}
        <div class="section">
            <h2>{{ 'data_breach.pdf.deadline_heading'|trans({}, 'privacy') }}</h2>
            {% if breach.supervisoryAuthorityNotifiedAt %}
                <p>
                    <strong>{{ 'data_breach.pdf.authority_notified'|trans({}, 'privacy') }}:</strong> {{ breach.supervisoryAuthorityNotifiedAt|fa_datetime }}
                </p>
                <p><strong>{{ 'data_breach.pdf.authority'|trans({}, 'privacy') }}:</strong> {{ breach.supervisoryAuthorityName }}</p>
                <p><strong>{{ 'data_breach.pdf.method'|trans({}, 'privacy') }}:</strong> {{ breach.notificationMethod }}</p>
                {% if breach.supervisoryAuthorityReference %}
                    <p><strong>{{ 'data_breach.pdf.reference_number'|trans({}, 'privacy') }}:</strong> {{ breach.supervisoryAuthorityReference }}</p>
                {% endif %}
                {% if breach.notificationDelayReason %}
                    <div class="alert alert-warning">
                        <strong>{{ 'data_breach.pdf.delay_justification'|trans({}, 'privacy') }}:</strong><br>
                        {{ breach.notificationDelayReason }}
                    </div>
                {% endif %}
            {% else %}
                {% set hours = breach.hoursUntilAuthorityDeadline %}
                {% if hours < 0 %}
                    <div class="alert alert-danger">
                        <strong>{{ 'data_breach.pdf.overdue_label'|trans({}, 'privacy') }}:</strong> {{ 'data_breach.pdf.overdue_text'|trans({'%hours%': (hours * -1)|number_format}, 'privacy') }}<br>
                        <strong>{{ 'data_breach.pdf.detection'|trans({}, 'privacy') }}:</strong> {{ breach.detectedAt|fa_datetime }}<br>
                        <strong>{{ 'data_breach.pdf.deadline'|trans({}, 'privacy') }}:</strong> {{ breach.authorityNotificationDeadline|fa_datetime }}
                    </div>
                {% else %}
                    <div class="alert alert-warning">
                        <strong>{{ 'data_breach.pdf.pending_label'|trans({}, 'privacy') }}:</strong> {{ 'data_breach.pdf.pending_text'|trans({'%hours%': hours|number_format}, 'privacy') }}<br>
                        <strong>{{ 'data_breach.pdf.deadline'|trans({}, 'privacy') }}:</strong> {{ breach.authorityNotificationDeadline|fa_datetime }}
                    </div>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}

    {# Linked Incident & VVT #}
    <div class="section">
        <h2>2. {{ 'data_breach.pdf.linked_heading'|trans({}, 'privacy') }}</h2>
        {% if breach.incident %}
            <p><strong>{{ 'data_breach.pdf.security_incident'|trans({}, 'privacy') }}:</strong> {{ breach.incident.incidentNumber }} - {{ breach.incident.title }}</p>
            <p><strong>{{ 'data_breach.pdf.incident_severity'|trans({}, 'privacy') }}:</strong>
                {% set sev_class = {'low': 'success', 'medium': 'info', 'high': 'warning', 'critical': 'danger'}[breach.incident.severity ? breach.incident.severity.value : ''] %}
                <span class="badge badge-{{ sev_class }}">{{ breach.incident.severity ? ('data_breach.pdf.level.' ~ breach.incident.severity.value)|trans({}, 'privacy') : '' }}</span>
            </p>
        {% else %}
            <p><em>{{ 'data_breach.pdf.standalone'|trans({}, 'privacy') }}</em></p>
        {% endif %}
        {% if breach.processingActivity %}
            <p><strong>{{ 'data_breach.pdf.processing_activity'|trans({}, 'privacy') }}:</strong> {{ breach.processingActivity.name }}</p>
        {% endif %}
    </div>

    <div class="page-break"></div>

    {# Art. 33(3)(a) - Nature of Breach #}
    <div class="section">
        <h2>3. {{ 'data_breach.pdf.art_33_3a_nature'|trans({}, 'privacy')}}</h2>

        <h3>{{ 'data_breach.pdf.breach_description'|trans({}, 'privacy') }}:</h3>
        <p>{{ breach.breachNature|nl2br }}</p>

        <h3>{{ 'data_breach.pdf.categories_personal_data'|trans({}, 'privacy')}}</h3>
        {% if breach.dataCategories|length > 0 %}
            <ul>
                {% for category in breach.dataCategories %}
                    <li>{{ category }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p><em>—</em></p>
        {% endif %}

        <h3>{{ 'data_breach.pdf.categories_data_subjects'|trans({}, 'privacy')}}</h3>
        {% if breach.dataSubjectCategories|length > 0 %}
            <ul>
                {% for category in breach.dataSubjectCategories %}
                    <li>{{ category }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p><em>—</em></p>
        {% endif %}

        <h3>{{ 'data_breach.pdf.approx_number_subjects'|trans({}, 'privacy')}}</h3>
        <p>{{ breach.affectedDataSubjects|default('—') }}</p>

        {% if breach.specialCategoriesAffected %}
            <div class="alert alert-warning">
                <strong>{{ 'data_breach.pdf.special_heading'|trans({}, 'privacy') }}</strong><br>
                {{ 'data_breach.pdf.special_text'|trans({}, 'privacy') }}
            </div>
        {% endif %}

        {% if breach.criminalDataAffected %}
            <div class="alert alert-warning">
                <strong>{{ 'data_breach.pdf.criminal_heading'|trans({}, 'privacy') }}</strong><br>
                {{ 'data_breach.pdf.criminal_text'|trans({}, 'privacy') }}
            </div>
        {% endif %}
    </div>

    {# Art. 33(3)(b) - Likely Consequences #}
    <div class="section">
        <h2>4. {{ 'data_breach.pdf.art_33_3b_consequences'|trans({}, 'privacy')}}</h2>
        <p>{{ breach.likelyConsequences|nl2br }}</p>
    </div>

    {# Art. 33(3)(c) & (d) - Measures #}
    <div class="section">
        <h2>5. {{ 'data_breach.pdf.art_33_3c_d_measures'|trans({}, 'privacy')}}</h2>

        <h3>{{ 'data_breach.pdf.measures_taken'|trans({}, 'privacy')}}</h3>
        <p>{{ breach.measuresTaken|nl2br }}</p>

        {% if breach.mitigationMeasures %}
            <h3>{{ 'data_breach.pdf.measures_mitigate'|trans({}, 'privacy')}}</h3>
            <p>{{ breach.mitigationMeasures|nl2br }}</p>
        {% endif %}
    </div>

    <div class="page-break"></div>

    {# Risk Assessment #}
    {% if breach.riskLevel or breach.riskAssessment %}
        <div class="section">
            <h2>6. {{ 'data_breach.pdf.risk_assessment'|trans({}, 'privacy') }}</h2>
            {% if breach.riskLevel %}
                <p><strong>{{ 'data_breach.pdf.risk_level'|trans({}, 'privacy') }}:</strong>
                    {% set risk_class = {'low': 'success', 'medium': 'info', 'high': 'warning', 'critical': 'danger'}[breach.riskLevel] %}
                    <span class="badge badge-{{ risk_class }}">{{ ('data_breach.pdf.level.' ~ breach.riskLevel)|trans({}, 'privacy') }}</span>
                </p>
            {% endif %}
            {% if breach.riskAssessment %}
                <p>{{ breach.riskAssessment|nl2br }}</p>
            {% endif %}
        </div>
    {% endif %}

    {# Art. 34 - Data Subject Notification #}
    <div class="section">
        <h2>7. {{ 'data_breach.pdf.art_34_communication'|trans({}, 'privacy')}}</h2>
        {% if breach.requiresSubjectNotification %}
            <p><strong>{{ 'data_breach.pdf.subject_required'|trans({}, 'privacy') }}:</strong> {{ 'data_breach.pdf.subject_required_yes'|trans({}, 'privacy') }}</p>
            {% if breach.dataSubjectsNotifiedAt %}
                <p><strong>{{ 'data_breach.pdf.notification_date'|trans({}, 'privacy') }}:</strong> {{ breach.dataSubjectsNotifiedAt|fa_datetime }}</p>
                <p><strong>{{ 'data_breach.pdf.notification_method'|trans({}, 'privacy') }}:</strong> {{ breach.subjectNotificationMethod }}</p>
                <p><strong>{{ 'data_breach.pdf.subjects_notified'|trans({}, 'privacy') }}:</strong> {{ breach.subjectsNotified|number_format }}</p>
            {% else %}
                <p class="alert alert-warning"><strong>{{ 'data_breach.pdf.pending_short'|trans({}, 'privacy') }}:</strong> {{ 'data_breach.pdf.subjects_pending'|trans({}, 'privacy') }}</p>
            {% endif %}
        {% else %}
            <p><strong>{{ 'data_breach.pdf.subject_required'|trans({}, 'privacy') }}:</strong> {{ 'data_breach.pdf.no'|trans({}, 'privacy') }}</p>
            {% if breach.noSubjectNotificationReason %}
                <p><strong>{{ 'data_breach.pdf.exemption_reason'|trans({}, 'privacy') }}:</strong><br>
                {{ breach.noSubjectNotificationReason }}</p>
            {% endif %}
        {% endif %}
    </div>

    {# Investigation & Follow-up #}
    {% if breach.rootCause or breach.lessonsLearned or breach.followUpActions|length > 0 %}
        <div class="section">
            <h2>8. {{ 'data_breach.pdf.investigation_heading'|trans({}, 'privacy') }}</h2>

            {% if breach.rootCause %}
                <h3>{{ 'data_breach.pdf.root_cause'|trans({}, 'privacy') }}:</h3>
                <p>{{ breach.rootCause|nl2br }}</p>
            {% endif %}

            {% if breach.lessonsLearned %}
                <h3>{{ 'data_breach.pdf.lessons_learned'|trans({}, 'privacy') }}:</h3>
                <p>{{ breach.lessonsLearned|nl2br }}</p>
            {% endif %}

            {% if breach.followUpActions|length > 0 %}
                <h3>{{ 'data_breach.pdf.follow_up'|trans({}, 'privacy') }}:</h3>
                <ul>
                    {% for action in breach.followUpActions %}
                        <li>{{ action }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}

    {# DPO Consultation #}
    {% if breach.dataProtectionOfficer %}
        <div class="section">
            <h2>9. {{ 'data_breach.pdf.dpo_heading'|trans({}, 'privacy') }}</h2>
            <p><strong>{{ 'data_breach.pdf.dpo'|trans({}, 'privacy') }}:</strong> {{ breach.dataProtectionOfficer.firstName }} {{ breach.dataProtectionOfficer.lastName }}</p>
            <p><strong>{{ 'data_breach.pdf.email'|trans({}, 'privacy') }}:</strong> {{ breach.dataProtectionOfficer.email }}</p>
        </div>
    {% endif %}

    {# Declaration #}
    <div class="section">
        <h2>10. {{ 'data_breach.pdf.declaration'|trans({}, 'privacy') }}</h2>
        <p>
            {{ 'data_breach.pdf.declaration_text'|trans({}, 'privacy') }}
        </p>
        {% if breach.assessor %}
            <p>
                <strong>{{ 'data_breach.pdf.prepared_by'|trans({}, 'privacy') }}:</strong> {{ breach.assessor.firstName }} {{ breach.assessor.lastName }}<br>
                <strong>{{ 'data_breach.pdf.email'|trans({}, 'privacy') }}:</strong> {{ breach.assessor.email }}
            </p>
        {% endif %}
    </div>

    {# Footer #}
    <div class="footer">
        <p>
            {{ 'data_breach.pdf.report_title'|trans({}, 'privacy') }} - {{ breach.referenceNumber }}<br>
            {{ 'common.generated'|trans({}, 'messages') }}: {{ "now"|fa_datetime(true) }}<br>
            {{ 'data_breach.pdf.footer_text'|trans({}, 'privacy') }}
        </p>
    </div>
</body>
</html>
