{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'privacy' %}

{% block title %}{{ 'privacy.data_breach.management'|trans({}, 'privacy') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'privacy.breadcrumb.privacy'|trans({}, 'privacy'), icon: 'nav-shield-lock' },
            { label: 'privacy.breadcrumb.data_breaches'|trans({}, 'privacy') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'privacy.data_breach.management'|trans({}, 'privacy'),
        subtitle: 'privacy.data_breach.subtitle'|trans({}, 'privacy'),
        actions: [
            { label: 'privacy.data_breach.actions.dashboard'|trans({}, 'privacy'), href: path('app_data_breach_dashboard'), variant: 'ghost', icon: 'nav-dashboard' },
            { label: 'privacy.data_breach.actions.new'|trans({}, 'privacy'), href: path('app_data_breach_new'), variant: 'danger', icon: 'plus', attrs: { 'data-turbo-frame': 'fa-form-modal' } }
        ]
    }) }}
{% set _global_hints = alva_hints('data_breach_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {# CRITICAL: Overdue Notifications Alert #}
    {% if compliance_score.overdue_notifications > 0 %}
        {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'danger', dismissible: true } } %}
            {% block alert_body %}
                <div class="fa-alert__title">{{ 'privacy.data_breach.alert.overdue_title'|trans({}, 'privacy') }}</div>
                <p class="fa-alert__message">{{ 'privacy.data_breach.alert.overdue_text'|trans({'%count%': compliance_score.overdue_notifications}, 'privacy')|raw }}</p>
                <hr>
                <p class="mb-0">
                    <a href="{{ path('app_data_breach_index', {filter: 'overdue'}) }}" class="fa-alert__link">
                        {{ 'privacy.data_breach.alert.view_overdue'|trans({}, 'privacy') }}
                    </a>
                </p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {# Overall Compliance Score #}
    {% embed '_components/_card.html.twig' with {class: 'mb-4 text-center'} %}
        {% block card_body %}
            <div class="small fw-semibold text-muted mb-2">{{ 'privacy.data_breach.score.heading'|trans({}, 'privacy') }}</div>
            {% set score = compliance_score.overall_score %}
            <div class="display-1 mb-0
                {% if score >= 80 %}text-success
                {% elseif score >= 60 %}text-warning
                {% else %}text-danger{% endif %}">
                {{ score }}%
            </div>
            <div class="row mt-4">
                <div class="col-md-4">
                    <small class="text-muted">{{ 'privacy.data_breach.score.notification_compliance'|trans({}, 'privacy') }}</small>
                    <h4>{{ compliance_score.notification_compliance }}%</h4>
                </div>
                <div class="col-md-4">
                    <small class="text-muted">{{ 'privacy.data_breach.score.timeliness'|trans({}, 'privacy') }}</small>
                    <h4 class="{% if compliance_score.timeliness_score < 80 %}text-danger{% else %}text-success{% endif %}">
                        {{ compliance_score.timeliness_score }}%
                    </h4>
                </div>
                <div class="col-md-4">
                    <small class="text-muted">{{ 'privacy.data_breach.score.completeness'|trans({}, 'privacy') }}</small>
                    <h4>{{ compliance_score.completeness_score }}%</h4>
                </div>
            </div>
            <p class="text-muted mt-3">
                {{ 'privacy.data_breach.score.summary'|trans({'%total%': statistics.total, '%subjects%': compliance_score.total_affected_subjects}, 'privacy') }}
            </p>
        {% endblock %}
    {% endembed %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_data_breach_index'),
        filter_keys: ['filter'],
        list_title: 'data_breach.index.table_title'|trans({}, 'messages'),
        empty: {
            mood: current_filter != 'all' ? 'curious' : 'celebrating',
            title: 'data_breach.index.no_breaches_found'|trans({}, 'privacy'),
            actions: current_filter != 'all' ? [
                { label: 'data_breach.index.view_all_breaches'|trans({}, 'privacy'), variant: 'ghost', icon: 'ui-list', href: path('app_data_breach_index') }
            ] : [],
        },
        card_attrs: 'data-controller="bulk-actions" data-bulk-actions-endpoint-value="/' ~ app.request.locale ~ '/data-breach"',
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label for="filter-status" class="form-label">{{ 'data_breach.index.filter_title'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="filter-status" name="filter">
                    <option value="">{{ 'data_breach.index.filter_all'|trans({}, 'messages') }} ({{ statistics.total }})</option>
                    <option value="overdue" {{ current_filter == 'overdue' ? 'selected' : '' }}>{{ 'data_breach.index.filter_overdue'|trans({}, 'messages') }} ({{ compliance_score.overdue_notifications }})</option>
                    <option value="pending_authority" {{ current_filter == 'pending_authority' ? 'selected' : '' }}>{{ 'data_breach.index.filter_pending_authority'|trans({}, 'messages') }}</option>
                    <option value="pending_subjects" {{ current_filter == 'pending_subjects' ? 'selected' : '' }}>{{ 'data_breach.index.filter_pending_subjects'|trans({}, 'messages') }}</option>
                    <option value="draft" {{ current_filter == 'draft' ? 'selected' : '' }}>{{ 'data_breach.index.filter_draft'|trans({}, 'messages') }} ({{ statistics.draft }})</option>
                    <option value="under_assessment" {{ current_filter == 'under_assessment' ? 'selected' : '' }}>{{ 'data_breach.index.filter_under_assessment'|trans({}, 'messages') }} ({{ statistics.under_assessment }})</option>
                    <option value="authority_notified" {{ current_filter == 'authority_notified' ? 'selected' : '' }}>{{ 'data_breach.index.filter_authority_notified'|trans({}, 'messages') }} ({{ statistics.authority_notified }})</option>
                    <option value="closed" {{ current_filter == 'closed' ? 'selected' : '' }}>{{ 'data_breach.index.filter_closed'|trans({}, 'messages') }} ({{ statistics.closed }})</option>
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% set _overdue = breaches|filter(b => b.authorityNotificationOverdue)|length %}
            {% set _high_risk = breaches|filter(b => b.riskLevel in ['high', 'critical'])|length %}
            {% set _special = breaches|filter(b => b.specialCategoriesAffected)|length %}
            {% if _overdue > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'privacy.data_breach.summary.overdue'|trans({'%count%': _overdue}, 'privacy') }}</span>{% endif %}
            {% if _high_risk > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'privacy.data_breach.summary.high_risk'|trans({'%count%': _high_risk}, 'privacy') }}</span>{% endif %}
            {% if _special > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'privacy.data_breach.summary.special_categories'|trans({'%count%': _special}, 'privacy') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'data_breach.index.col_reference'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_title'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_status'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_risk'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_affected_subjects'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_deadline'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_authority'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_subjects'|trans({}, 'messages') }}</th>
                        <th scope="col">{{ 'data_breach.index.col_actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="data-breach-rows"{% endblock %}
                {% block table_body %}
                    {% set workflowStates = workflow_states(page) %}
                    {% for breach in page %}
                        {% include 'data_breach/_row.html.twig' with { breach: breach } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
            {% include '_components/_bulk_action_bar.html.twig' with { actions: ['export', 'delete'] } %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
