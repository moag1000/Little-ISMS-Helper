{% extends 'base.html.twig' %}
{% trans_default_domain 'locations' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ location.name }} - {{ 'location.title.show'|trans({}, 'locations') }}{% endblock %}

{% block body %}
<div class="container">
    {# M-4 — module-gating: Locations #}
    {% if not is_module_active('locations') %}
        {{ _fa_alert.render({
            variant: 'info',
            icon: 'nav-shield-alert',
            body: 'common.module_not_active'|trans({'%module%': 'Locations'}, 'messages')
        }) }}
    {% else %}
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.locations'|trans({}, 'nav'), url: path('app_location_index') },
            { label: location.name }
        ]
    } %}

    {% set _site = location %}
    {% for _i in 1..20 %}{% if _site.parentLocation %}{% set _site = _site.parentLocation %}{% endif %}{% endfor %}
    {{ _fa_page_header.render({
        badge: { icon: 'geo-alt', label: ('location.type.' ~ location.locationType)|trans({}, 'locations') },
        title: location.name,
        subtitle: location.code|default(''),
        actions: [
            { label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit', href: path('app_location_edit', {id: location.id}) },
            { label: 'location.map.show_on_map'|trans({}, 'locations'), variant: 'ghost', href: path('app_location_map', { site: _site.id }) },
            { label: 'common.back_to_list'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('app_location_index') }
        ]
    }) }}

    {% import '_components/_status_pill.html.twig' as _pill %}
    {% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
    {% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
    {% set _status %}{{ _pill.render((location.active ? 'common.active' : 'common.inactive')|trans({}, 'messages'), location.active ? 'success' : 'neutral') }}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        facts: [
            { label: 'show.status.owner'|trans({}, 'messages'), value: location.effectiveResponsiblePerson },
            { label: 'location.field.security_level'|trans({}, 'locations'), value: location.securityLevel ? ('location.security.' ~ location.securityLevel)|trans({}, 'locations') : null },
            { label: 'show.status.protection'|trans({}, 'messages'), value: profile and profile.site.protection ? profile.site.protection : null },
        ],
        workflow: workflow_state(location),
    }) }}

    {% set _links = entity_links(location) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'profile', label: 'location.profile.title'|trans({}, 'locations'), show: profile is not empty },
        { id: 'details', label: 'location.section.details'|trans({}, 'locations') },
        { id: 'address', label: 'location.section.address'|trans({}, 'locations'), show: location.address or location.city or location.country },
        { id: 'children', label: 'location.section.child_locations'|trans({}, 'locations'), count: location.childLocations|length, show: location.childLocations|length > 0 },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: location } only %}

{# Site profile ("Steckbrief"): the same figures as the location map, ISO 27001 A.7. #}
{% if profile %}
{% set _p = profile.site %}
<div id="profile" class="fa-show-section">
{% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
    {% block card_body %}
    <h2>{{ 'location.profile.title'|trans({}, 'locations') }}</h2>
    {% if profile.partOf %}
        <p class="text-muted">{{ 'location.profile.not_site'|trans({ '%site%': _p.name }, 'locations') }}</p>
    {% endif %}
    <div class="stats-grid mt-3 grid-responsive-250">
        <div class="stat-item">
            <strong>{{ _p.protection ?: '–' }}</strong>
            <span>{{ 'location.map.col.protection'|trans({}, 'locations') }}</span>
        </div>
        <div class="stat-item">
            <strong>{{ _p.riskBand == 'none' ? '–' : _p.score }}</strong>
            <span>{{ 'location.map.col.risk'|trans({}, 'locations') }}</span>
        </div>
        <div class="stat-item">
            <strong>{{ _p.checksRate is not null ? _p.checksRate ~ ' %' : '–' }}</strong>
            <span>{{ 'location.map.export.col.rate'|trans({}, 'locations') }}</span>
        </div>
    </div>
    {% if profile.peer and profile.peer.rank %}
        <p class="mt-3 mb-0">{{ ('location.map.peer.rank_sentence.' ~ profile.peer.rank)|trans({ '%count%': profile.peer.size }, 'locations') }}</p>
    {% endif %}
    {% if _p.gaps|length > 0 %}
        <h3 class="h6 mt-3">{{ 'location.profile.checks'|trans({}, 'locations') }}</h3>
        <ul class="mb-0">
            {% for _c in _p.gaps %}
                <li>{{ ('location.map.check.' ~ _c)|trans({}, 'locations') }} ({{ check_norms[_c] }})</li>
            {% endfor %}
        </ul>
    {% endif %}
    {% for _o in profile.objectives %}
        <p class="mt-2 mb-0">{{ _o.title }}: {{ 'location.map.objectives.line'|trans({ '%target%': _o.target, '%current%': _o.current ?? '–', '%months%': _o.monthsLeft ?? '–' }, 'locations') }}</p>
    {% endfor %}
    {% endblock %}
{% endembed %}
</div>
{% endif %}

{# Location Details #}
<div id="details" class="fa-show-section">
{% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
    {% block card_body %}
    <h2>{{ 'location.section.details'|trans({}, 'locations') }}</h2>

    {% if location.description %}
    <div class="form-group mt-3">
        <label class="form-label">{{ 'location.field.description'|trans({}, 'locations') }}</label>
        <p class="text-light-pre-wrap">{{ location.description }}</p>
    </div>
    {% endif %}

    <div class="stats-grid mt-3 grid-responsive-250">
        <div class="stat-item">
            <strong>{{ ('location.type.' ~ location.locationType)|trans({}, 'locations') }}</strong>
            <span>{{ 'location.field.type'|trans({}, 'locations') }}</span>
        </div>

        {% if location.parentLocation %}
        <div class="stat-item">
            <strong>
                <a href="{{ path('app_location_show', {id: location.parentLocation.id}) }}">
                    {{ location.parentLocation.name }}
                </a>
            </strong>
            <span>{{ 'location.field.parent_location'|trans({}, 'locations') }}</span>
        </div>
        {% endif %}

        <div class="stat-item">
            <strong>
                {% set securityColors = {
                    'public': 'secondary',
                    'restricted': 'info',
                    'controlled': 'warning',
                    'secure': 'warning',
                    'high_security': 'danger'
                } %}
                {% include '_components/_badge.html.twig' with { variant: securityColors[location.securityLevel] ?? 'secondary', content: ('location.security.' ~ location.securityLevel)|trans({}, 'locations') } %}
            </strong>
            <span>{{ 'location.field.security_level'|trans({}, 'locations') }}</span>
        </div>

        <div class="stat-item">
            <strong>
                {% if location.requiresBadgeAccess %}
                    {% include '_components/_badge.html.twig' with { variant: 'success', content: 'common.yes'|trans({}, 'messages') } %}
                {% else %}
                    {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'common.no'|trans({}, 'messages') } %}
                {% endif %}
            </strong>
            <span>{{ 'location.field.badge_access'|trans({}, 'locations') }}</span>
        </div>

        <div class="stat-item">
            <strong>{{ location.effectiveResponsiblePerson ?? '—' }}</strong>
            <span>{{ 'location.field.responsible_person'|trans({}, 'locations') }}</span>
            {% include '_components/_deputy_persons.html.twig' with { deputies: location.responsibleDeputyPersons } only %}
        </div>

        <div class="stat-item">
            <strong>{{ location.accessControlSystem ?: '–' }}</strong>
            <span>{{ 'location.field.access_control'|trans({}, 'locations') }}</span>
        </div>
    </div>
    {% endblock %}
{% endembed %}
</div>

{# Address Information #}
{% if location.address or location.city or location.country %}
<div id="address" class="fa-show-section">
{% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
    {% block card_body %}
    <h2>{{ 'location.section.address'|trans({}, 'locations') }}</h2>
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mt-2' } } %}
        {% block alert_body %}
            {% if location.address %}
                <p>{{ location.address }}</p>
            {% endif %}
            {% if location.postalCode or location.city %}
                <p>
                    {% if location.postalCode %}{{ location.postalCode }}{% endif %}
                    {{ location.city }}
                </p>
            {% endif %}
            {% if location.country %}
                <p><strong>{{ location.country }}</strong></p>
            {% endif %}
            {% if location.geoSource %}
                <p class="small mb-0">{{ ('location.geo.source.' ~ location.geoSource)|trans({}, 'locations') }}</p>
            {% endif %}
        {% endblock %}
    {% endembed %}
    {% endblock %}
{% endembed %}
</div>
{% endif %}

{# Child Locations #}
{% if location.childLocations|length > 0 %}
<div id="children" class="fa-show-section">
{% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
    {% block card_body %}
    <h2>{{ 'location.section.child_locations'|trans({}, 'locations') }} ({{ location.childLocations|length }})</h2>
    <div class="mt-2">
    {% embed '_components/_table.html.twig' with {
        'noMargin': true,
        'responsive': true
    } %}
        {% block table_head %}
            <tr>
                <th scope="col">{{ 'location.field.name'|trans({}, 'locations') }}</th>
                <th scope="col">{{ 'location.field.type'|trans({}, 'locations') }}</th>
                <th scope="col">{{ 'location.field.security_level'|trans({}, 'locations') }}</th>
                <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
            </tr>
        {% endblock %}
        {% block table_body %}
            {% for child in location.childLocations %}
            <tr>
                <td>{{ child.name }}</td>
                <td>{% include '_components/_badge.html.twig' with { variant: 'info', content: ('location.type.' ~ child.locationType)|trans({}, 'locations') } %}</td>
                <td>
                    {% set securityColors = {
                        'public': 'secondary',
                        'restricted': 'info',
                        'controlled': 'warning',
                        'secure': 'warning',
                        'high_security': 'danger'
                    } %}
                    {% include '_components/_badge.html.twig' with { variant: securityColors[child.securityLevel] ?? 'secondary', content: ('location.security.' ~ child.securityLevel)|trans({}, 'locations') } %}
                </td>
                <td class="text-center">
                    <a href="{{ path('app_location_show', {id: child.id}) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ 'common.view'|trans({}, 'messages') }}</a>
                </td>
            </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
    </div>
    {% endblock %}
{% endembed %}
</div>
{% endif %}

{% include '_components/_fa_show_history.html.twig' with { entity: location } only %}

<div class="button-group mt-xl">
    <form method="post" action="{{ path('app_location_delete', {id: location.id}) }}" class="d-inline"
          data-controller="ui-actions"
          data-action="submit->ui-actions#confirm"
          data-ui-actions-message-param="{{ 'location.confirm.delete'|trans({}, 'locations') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.id) }}">
        <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger"><i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}</button>
    </form>
</div>
    {% endif %} {# /M-4 locations module gate #}
</div>
{% endblock %}
