{% extends 'base.html.twig' %}
{% trans_default_domain 'locations' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'location.title.list'|trans({}, 'locations') }}{% endblock %}

{% block body %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}

<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.locations'|trans({}, 'nav') }
        ]
    } %}
</div>

{{ _fa_page_header.render({
    title: 'location.title.list'|trans({}, 'locations'),
    subtitle: 'location.description.overview'|trans({}, 'locations'),
    actions: [
        { label: 'location.action.create'|trans({}, 'locations'), variant: 'primary', icon: 'plus', href: path('app_location_new'), attrs: { 'data-turbo-frame': 'fa-drawer' } }
    ]
}) }}
{% set _global_hints = alva_hints('location_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}


{% include 'location/_view_switch.html.twig' with { active: 'list' } %}

<div class="container-fluid">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_location_index'),
    filter_keys: ['type'],
    list_title: 'location.title.list'|trans({}, 'locations'),
    empty: { mood: 'sleeping', title: 'location.message.no_locations'|trans({}, 'locations') },
} %}
    {% block list_filters %}
        <div class="col-md-4">
            <label for="type-filter" class="form-label">{{ 'location.field.type'|trans({}, 'locations') }}</label>
            <select class="form-select fa-cyber-input__field" id="type-filter" name="type" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value=""></option>
                {% for key in ['building', 'floor', 'room', 'area', 'datacenter', 'server_room', 'office', 'warehouse', 'gate', 'entrance', 'parking', 'outdoor', 'region', 'other'] %}
                    <option value="{{ key }}" {{ type == key ? 'selected' : '' }}>{{ ('location.type.' ~ key)|trans({}, 'locations') }}</option>
                {% endfor %}
            </select>
        </div>
    {% endblock %}
    {% block list_summary %}
        {% if building_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'location.summary.buildings'|trans({'%count%': building_count}, 'locations') }}</span>{% endif %}
        {% if room_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'location.summary.rooms'|trans({'%count%': room_count}, 'locations') }}</span>{% endif %}
        {% if secure_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'location.summary.secure'|trans({'%count%': secure_count}, 'locations') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
            {% block table_head %}
                <tr>
                    <th scope="col">{{ 'location.field.name'|trans({}, 'locations') }}</th>
                    <th scope="col">{{ 'location.field.type'|trans({}, 'locations') }}</th>
                    <th scope="col">{{ 'location.field.code'|trans({}, 'locations') }}</th>
                    <th scope="col">{{ 'location.field.city'|trans({}, 'locations') }}</th>
                    <th scope="col">{{ 'location.field.security_level'|trans({}, 'locations') }}</th>
                    <th scope="col" class="text-center">{{ 'location.field.badge_access'|trans({}, 'locations') }}</th>
                    <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
                </tr>
            {% endblock %}
            {% block table_body_attrs %}id="location-rows"{% endblock %}
            {% block table_body %}
                {% for location in page %}
                    {% include 'location/_row.html.twig' with { location: location } %}
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
