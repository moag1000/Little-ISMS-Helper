{% extends 'base.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_filter_chip.html.twig' as _fa_filter_chip %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_kpi_tile.html.twig' as _kpi_tile %}
{% import '_components/_fa_feature_card.html.twig' as _fa_feature_card %}

{% block title %}{{ 'location.map.title'|trans({}, 'locations') }}{% endblock %}

{% block body %}
{% set _lens_layer = { ciso: 'risk', isb: 'gaps', cm: 'gaps', owner: 'risk' } %}
{% set _sites = lens == 'owner' ? sites|filter(s => s.mine) : sites %}
{% set _lens_kpis = {
    ciso: ['location_critical_sites', 'location_checks_rate', 'overdue_treatments', 'fte_saved_days'],
    isb: ['location_open_gaps', 'location_checks_rate', 'overdue_treatments', 'open_incidents'],
    cm: ['location_checks_rate', 'location_open_gaps', 'control_compliance', 'fte_saved_days'],
    owner: []
} %}
{% set _read_only = is_granted('ROLE_AUDITOR') and not is_granted('ROLE_MANAGER') %}
{% set _gap_fix = {
    owner: 'edit', deputy: 'edit', access_control: 'edit', camera: 'edit',
    risks_treated: 'risks', incidents_closed: 'incidents'
} %}

<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.locations'|trans({}, 'nav'), url: path('app_location_index') },
            { label: 'location.map.title'|trans({}, 'locations') }
        ]
    } %}
</div>

{% set _actions = [] %}
{% if is_granted('ROLE_ADMIN') %}
    {% set _actions = _actions|merge([{ label: 'location.map.action.settings'|trans({}, 'locations'), variant: 'ghost', href: path('admin_settings_location_map') }]) %}
{% endif %}
{{ _fa_page_header.render({
    title: 'location.map.title'|trans({}, 'locations'),
    subtitle: ('location.map.lens.' ~ lens ~ '.question')|trans({}, 'locations'),
    actions: _actions
}) }}

<div class="location-map-page"
      data-controller="location-map"
      data-location-map-sites-value="{{ _sites|json_encode|e('html_attr') }}"
      data-location-map-world-url-value="{{ asset('data/world-map.json') }}"
      data-location-map-layer-value="{{ _lens_layer[lens] }}"
      data-location-map-focus-value="{{ lens == 'cm' ? 'true' : 'false' }}">

    {% include 'location/_view_switch.html.twig' with { active: 'map' } %}

    <div class="location-map__kpis">
        {% for _key in _lens_kpis[lens] %}
            {{ _kpi_tile.render(_key, { href: _key == 'fte_saved_days' ? path('analytics_fte_index') : null }) }}
        {% endfor %}
        {% if lens == 'owner' and _sites|length > 3 %}
            {# Many own sites: one tile instead of a wall; the table lists each site. #}
            {% set _rates = _sites|map(s => s.checksRate) %}
            {{ _fa_feature_card.render({
                label: 'location.map.peer.own_avg'|trans({ '%count%': _sites|length }, 'locations'),
                value: ((_rates|reduce((carry, r) => carry + r, 0)) / _rates|length)|round ~ ' %',
                variant: _sites|filter(s => s.gaps is not empty)|length == 0 ? 'success' : 'warning',
                hint: 'location.map.peer.own_gaps'|trans({ '%count%': _sites|filter(s => s.gaps is not empty)|length }, 'locations')
            }) }}
        {% elseif lens == 'owner' %}
            {% for site in _sites %}
                {% set _peer = peers[site.id] ?? null %}
                {{ _fa_feature_card.render({
                    label: 'location.map.peer.own_rate'|trans({ '%site%': site.name }, 'locations'),
                    value: site.checksRate is not null ? site.checksRate ~ ' %' : '–',
                    variant: site.gaps is empty ? 'success' : (site.gaps|length >= 3 ? 'danger' : 'warning'),
                    hint: peer_mode == 'off' ? null : (_peer and _peer.medianRate is not null ? 'location.map.peer.median_hint'|trans({ '%median%': _peer.medianRate, '%count%': _peer.size }, 'locations') : 'location.map.peer.none'|trans({}, 'locations'))
                }) }}
            {% endfor %}
        {% endif %}
    </div>

    <div class="location-map__toolbar">
        {% set _lens_items = [] %}
        {% set _lens_index = 0 %}
        {% for _l in lenses %}
            {% set _lens_items = _lens_items|merge([{ label: ('location.map.lens.' ~ _l ~ '.label')|trans({}, 'locations'), href: path('app_location_map', { lens: _l }) }]) %}
            {% if _l == lens %}{% set _lens_index = loop.index0 %}{% endif %}
        {% endfor %}
        {{ _fa_filter_chip.group(_lens_items, _lens_index, {
            ariaLabel: 'location.map.lens.aria'|trans({}, 'locations')
        }) }}

        {% set _layer_items = [] %}
        {% for _layer in ['risk', 'gaps'] %}
            {% set _layer_items = _layer_items|merge([{
                label: ('location.map.layer.' ~ _layer)|trans({}, 'locations'),
                attrs: { 'data-layer': _layer, 'data-location-map-target': 'layerButton', 'data-action': 'location-map#setLayer' }
            }]) %}
        {% endfor %}
        {{ _fa_filter_chip.group(_layer_items, _lens_layer[lens] == 'gaps' ? 1 : 0, {
            ariaLabel: 'location.map.layer.aria'|trans({}, 'locations')
        }) }}

        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="location-map-focus"
                   data-location-map-target="focusToggle" data-action="location-map#toggleFocus"
                   {{ lens == 'cm' ? 'checked' : '' }}>
            <label class="form-check-label" for="location-map-focus">{{ 'location.map.focus'|trans({}, 'locations') }}</label>
        </div>
    </div>

    {% if unplaced|length > 0 %}
        {% set _names = unplaced|map(s => '<a href="' ~ path('app_location_edit', { id: s.id }) ~ '">' ~ s.name|e ~ '</a>')|join(', ') %}
        {{ _fa_alert.render({
            variant: 'info',
            title: 'location.map.unplaced.title'|trans({ '%count%': unplaced|length }, 'locations'),
            body: 'location.map.unplaced.body'|trans({}, 'locations') ~ ' ' ~ _names
        }) }}
    {% endif %}
    {% set _can_refine = is_granted('ROLE_MANAGER') and (unsaved > 0 or (online_enabled and coarse|length > 0)) %}
    {% if coarse|length > 0 or _can_refine %}
        <div class="location-map__notice">
            {% if coarse|length > 0 %}<span>{{ 'location.map.coarse'|trans({ '%count%': coarse|length }, 'locations') }}</span>{% endif %}
            {% if _can_refine %}
                <form method="post" action="{{ path('app_location_map_geocode') }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('location_map_geocode') }}">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ (online_enabled and coarse|length > 0 ? 'location.map.action.refine' : 'location.map.action.store')|trans({}, 'locations') }}</button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    <div class="location-map">
        <figure class="location-map__figure">
            <svg class="location-map__svg" data-location-map-target="svg" viewBox="0 0 1000 437"
                 role="img" aria-label="{{ 'location.map.aria'|trans({ '%count%': _sites|length }, 'locations') }}">
                <rect class="location-map__sea" x="-2000" y="-2000" width="5000" height="5000"></rect>
                <path class="location-map__land" data-location-map-target="land"></path>
                <path class="location-map__borders" data-location-map-target="borders"></path>
                <g data-location-map-target="pins"></g>
            </svg>
            <div class="location-map__tip" data-location-map-target="tip" hidden></div>
            <div class="location-map__zoom" role="group" aria-label="{{ 'location.map.zoom.aria'|trans({}, 'locations') }}">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" data-action="location-map#zoomIn" aria-label="{{ 'location.map.zoom.in'|trans({}, 'locations') }}">+</button>
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" data-action="location-map#zoomOut" aria-label="{{ 'location.map.zoom.out'|trans({}, 'locations') }}">−</button>
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" data-action="location-map#reset">{{ 'location.map.zoom.fit'|trans({}, 'locations') }}</button>
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" data-action="location-map#world">{{ 'location.map.zoom.world'|trans({}, 'locations') }}</button>
            </div>
            <figcaption class="location-map__legend">
                <span>{{ 'location.map.legend.size'|trans({}, 'locations') }}</span>
                <span class="location-map__key location-map__key--region">{{ 'location.map.legend.region'|trans({}, 'locations') }}</span>
                <span data-location-map-target="legend" data-layer="risk">
                    <span class="location-map__key location-map__key--ok">{{ 'location.map.legend.risk_low'|trans({}, 'locations') }}</span>
                    <span class="location-map__key location-map__key--warn">{{ 'location.map.legend.risk_medium'|trans({}, 'locations') }}</span>
                    <span class="location-map__key location-map__key--danger">{{ 'location.map.legend.risk_high'|trans({}, 'locations') }}</span>
                    <span class="location-map__key location-map__key--crit">{{ 'location.map.legend.risk_critical'|trans({}, 'locations') }}</span>
                    <span class="location-map__key location-map__key--none">{{ 'location.map.legend.risk_none'|trans({}, 'locations') }}</span>
                </span>
                <span data-location-map-target="legend" data-layer="gaps" hidden>
                    <span class="location-map__key location-map__key--ok">{{ 'location.map.legend.gaps_none'|trans({}, 'locations') }}</span>
                    <span class="location-map__key location-map__key--warn">{{ 'location.map.legend.gaps_some'|trans({}, 'locations') }}</span>
                    <span class="location-map__key location-map__key--danger">{{ 'location.map.legend.gaps_many'|trans({}, 'locations') }}</span>
                </span>
            </figcaption>
        </figure>

        <aside class="location-map__panel" data-location-map-target="panel" hidden aria-live="polite">
            <button type="button" class="location-map__close fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm"
                    data-action="location-map#closePanel" aria-label="{{ 'common.close'|trans({}, 'messages') }}">×</button>
            <div data-panel-body></div>
        </aside>
    </div>

    {% if levers|length > 0 %}
        <section class="fa-section location-map__levers">
            <div class="fa-section__header">
                <h2 class="fa-section__title">{{ 'location.map.levers.title'|trans({}, 'locations') }}</h2>
            </div>
            <div class="fa-section__body">
                <ol class="mb-0">
                    {% for _l in levers %}
                        <li>
                            <a href="{{ path('app_risk_show', { id: _l.id }) }}">{{ 'location.map.levers.item'|trans({ '%site%': _l.siteName, '%risk%': _l.title }, 'locations') }}</a>
                            <span class="text-muted-color">{{ _l.from }} → {{ _l.to }}</span>
                        </li>
                    {% endfor %}
                </ol>
            </div>
        </section>
    {% endif %}

    {% if lens == 'cm' %}
        {% set _same = [] %}
        {% for _check in ['owner', 'deputy', 'access_control', 'camera', 'risks_treated', 'incidents_closed'] %}
            {% set _hit = _sites|filter(s => _check in s.gaps) %}
            {% if _hit|length >= 2 %}
                {% set _same = _same|merge([{ check: _check, sites: _hit }]) %}
            {% endif %}
        {% endfor %}
        {% if _same|length > 0 %}
            <section class="fa-section location-map__same">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">{{ 'location.map.same_gap.title'|trans({}, 'locations') }}</h2>
                </div>
                <div class="fa-section__body">
                    <ul class="list-unstyled mb-0">
                        {% for _g in _same|sort((a, b) => b.sites|length <=> a.sites|length) %}
                            <li>
                                <strong>{{ ('location.map.check.' ~ _g.check)|trans({}, 'locations') }}</strong>
                                <span class="text-muted-color">({{ check_norms[_g.check] }})</span>:
                                {{ 'location.map.same_gap.count'|trans({ '%count%': _g.sites|length }, 'locations') }}
                                {% for _s in _g.sites %}<a href="{{ path('app_location_edit', { id: _s.id }) }}">{{ _s.name }}</a>{{ not loop.last ? ', ' }}{% endfor %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
        {% endif %}
    {% endif %}

    <form method="post" action="{{ path('app_location_map_bulk') }}" id="location-map-selection" class="location-map__selection">
        <input type="hidden" name="_token" value="{{ csrf_token('location_map_bulk') }}">
        <input type="hidden" name="lens" value="{{ lens }}">
        <div class="location-map__bulk">
            <span class="text-muted-color">{{ 'location.map.bulk.hint'|trans({}, 'locations') }}</span>
            <button type="submit" data-turbo="false" formaction="{{ path('app_location_map_export', { format: 'xlsx' }) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ 'location.map.export.xlsx'|trans({}, 'locations') }}</button>
            <button type="submit" data-turbo="false" formaction="{{ path('app_location_map_export', { format: 'pdf' }) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ 'location.map.export.pdf'|trans({}, 'locations') }}</button>
            {% if bulk %}
                <label class="visually-hidden" for="location-map-bulk-target">{{ 'location.map.bulk.action'|trans({}, 'locations') }}</label>
                <select name="target" id="location-map-bulk-target" class="form-select form-select-sm location-map__bulk-select">
                    <option value="">{{ 'location.map.bulk.action'|trans({}, 'locations') }}</option>
                    {% for _a in ['owner', 'deputy', 'tag'] %}
                        {% if bulk[_a] is not empty %}
                            <optgroup label="{{ ('location.map.bulk.' ~ _a)|trans({}, 'locations') }}">
                                {% for _id, _label in bulk[_a] %}<option value="{{ _a }}:{{ _id }}">{{ _label }}</option>{% endfor %}
                            </optgroup>
                        {% endif %}
                    {% endfor %}
                </select>
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm">{{ 'location.map.bulk.apply'|trans({}, 'locations') }}</button>
            {% endif %}
        </div>
    {% embed '_components/_table.html.twig' with { 'wrapperClass': 'table-container' } %}
        {% block table_head %}
            <tr>
                <th scope="col"><span class="visually-hidden">{{ 'location.map.bulk.select'|trans({}, 'locations') }}</span></th>
                <th scope="col">{{ 'location.field.name'|trans({}, 'locations') }}</th>
                <th scope="col">{{ 'location.map.col.place'|trans({}, 'locations') }}</th>
                <th scope="col" class="text-end">{{ 'location.map.col.protection'|trans({}, 'locations') }}</th>
                <th scope="col">{{ 'location.map.col.risk'|trans({}, 'locations') }}</th>
                <th scope="col">{{ 'location.map.col.gaps'|trans({}, 'locations') }}</th>
                <th scope="col" class="text-end">{{ 'location.map.col.incidents'|trans({}, 'locations') }}</th>
            </tr>
        {% endblock %}
        {% block table_body %}
            {% for site in _sites %}
                <tr data-location-map-target="row" data-site-id="{{ site.id }}" data-action="click->location-map#selectRow" class="location-map__row">
                    <td><input type="checkbox" class="form-check-input" name="ids[]" value="{{ site.id }}" form="location-map-selection" aria-label="{{ 'location.map.bulk.select_site'|trans({ '%site%': site.name }, 'locations') }}"></td>
                    <td><a href="{{ path('app_location_show', { id: site.id }) }}">{{ site.name }}</a>{% if site.mine %} <span class="text-muted-color">· {{ 'location.map.mine'|trans({}, 'locations') }}</span>{% endif %}</td>
                    <td>{{ (site.area in ['EU', 'WORLD'] ? ('location.map.area.' ~ site.area)|trans({}, 'locations') : [site.city, site.country]|filter(v => v)|join(', ')) ?: '–' }}{% if site.type == 'region' %} <span class="text-muted-color">· {{ 'location.type.region'|trans({}, 'locations') }}</span>{% endif %}</td>
                    <td class="text-end">{{ site.protection ?: '–' }}</td>
                    <td>{% if site.riskBand == 'none' %}<span class="text-muted-color">–</span>{% else %}{{ site.score }} {{ risk_level_label(site.riskBand) }}{% endif %}</td>
                    <td>{{ 'location.map.gaps_of'|trans({ '%count%': site.gaps|length, '%total%': site.checksApplicable }, 'locations') }}</td>
                    <td class="text-end">{{ site.openIncidents }}</td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-muted-color">{{ 'location.message.no_locations'|trans({}, 'locations') }}</td></tr>
            {% endfor %}
            <tr data-location-map-target="empty" hidden><td colspan="7" class="text-muted-color">{{ 'location.map.no_action'|trans({}, 'locations') }}</td></tr>
        {% endblock %}
    {% endembed %}
    </form>

    {% for site in _sites %}
        <template data-site-panel="{{ site.id }}">
            <h2 class="location-map__panel-title">{{ site.name }}</h2>
            <p class="text-muted-color mb-2">
                {{ (site.area in ['EU', 'WORLD'] ? ('location.map.area.' ~ site.area)|trans({}, 'locations') : [site.city, site.country]|filter(v => v)|join(', ')) }}
                {% if site.type == 'region' %}· {{ 'location.type.region'|trans({}, 'locations') }}{% endif %}
                {% if site.securityLevel %}· {{ ('location.security.' ~ site.securityLevel)|trans({}, 'locations') }}{% endif %}
                {% if site.children > 0 %}· {{ 'location.map.children'|trans({ '%count%': site.children }, 'locations') }}{% endif %}
            </p>
            <dl class="location-map__facts">
                <div><dt>{{ 'location.map.col.protection'|trans({}, 'locations') }}</dt><dd>{{ site.protection ?: '–' }} <small class="text-muted-color">C {{ site.cia[0] }} · I {{ site.cia[1] }} · A {{ site.cia[2] }}</small></dd></div>
                <div><dt>{{ 'location.map.col.risk'|trans({}, 'locations') }}</dt><dd>{% if site.riskBand == 'none' %}–{% else %}{{ site.score }} {{ risk_level_label(site.riskBand) }}{% endif %}</dd></div>
                <div><dt>{{ 'location.map.col.assets'|trans({}, 'locations') }}</dt><dd>{{ site.assets }}</dd></div>
                <div><dt>{{ 'location.map.col.incidents'|trans({}, 'locations') }}</dt><dd>{{ site.openIncidents }}</dd></div>
                {% if money %}<div><dt>{{ 'location.map.export.col.ale'|trans({}, 'locations') }}</dt><dd>{{ (site.ale ?? 0)|number_format(0, ',', '.') }} €</dd></div>{% endif %}
            </dl>

            {% if site.topRisks|length > 0 %}
                <h3 class="location-map__panel-sub">{{ 'location.map.panel.top_risks'|trans({}, 'locations') }}</h3>
                <ul class="location-map__list">
                    {% for r in site.topRisks %}
                        <li><a href="{{ path('app_risk_show', { id: r.id }) }}">{{ r.title }}</a> <span class="text-muted-color">{{ r.score }}</span></li>
                    {% endfor %}
                </ul>
            {% endif %}

            <h3 class="location-map__panel-sub">{{ 'location.map.panel.checks'|trans({ '%count%': site.gaps|length, '%total%': site.checksApplicable }, 'locations') }}</h3>
            <ul class="location-map__checks">
                {% for _key, _ok in site.checks %}
                    {% if _ok is not null %}
                        <li class="{{ _ok ? 'is-ok' : 'is-gap' }}">
                            <span class="location-map__check-mark" aria-hidden="true">{{ _ok ? '✓' : '✗' }}</span>
                            <span>
                                {{ ('location.map.check.' ~ _key)|trans({}, 'locations') }}
                                <small class="text-muted-color">{{ check_norms[_key] }}</small>
                                <span class="visually-hidden">{{ (_ok ? 'location.map.check_ok' : 'location.map.check_gap')|trans({}, 'locations') }}</span>
                                {% if not _ok %}
                                    {% set _fix = _gap_fix[_key] %}
                                    {% if not _read_only %}<br><a href="{{ _fix == 'edit' ? path('app_location_edit', { id: site.id }) : (_fix == 'risks' ? path('app_risk_index', { location: site.id }) : path('app_incident_index', { location: site.id })) }}">{{ ('location.map.fix.' ~ _key)|trans({}, 'locations') }}</a>{% endif %}
                                    {% set _solved = (peers[site.id].solvedAt ?? {})[_key] ?? null %}
                                    {% if _solved %}<br><small>{{ 'location.map.peer.solved_at'|trans({}, 'locations') }} <a href="{{ path('app_location_show', { id: _solved.id }) }}">{{ _solved.name }}</a>{% if _solved.owner ?? null %} ({{ _solved.owner }}){% endif %}</small>{% endif %}
                                {% endif %}
                            </span>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>

            {% if peer_mode != 'off' %}
                {% set _peer = peers[site.id] ?? null %}
                <h3 class="location-map__panel-sub">{{ 'location.map.peer.title'|trans({}, 'locations') }}</h3>
                {% if _peer and _peer.rank %}
                    <p class="mb-1">{{ ('location.map.peer.rank_sentence.' ~ _peer.rank)|trans({ '%count%': _peer.size }, 'locations') }}</p>
                    <p class="text-muted-color small mb-2">
                        {{ 'location.map.peer.values'|trans({ '%rate%': _peer.rate, '%median%': _peer.medianRate, '%score%': site.score, '%median_score%': _peer.medianScore }, 'locations') }}
                        · {{ ('location.map.peer.basis.' ~ _peer.basis)|trans({ '%tag%': _peer.tag }, 'locations') }}
                    </p>
                {% else %}
                    <p class="text-muted-color small">{{ 'location.map.peer.none'|trans({}, 'locations') }}</p>
                {% endif %}
            {% endif %}

            {% for _o in objectives[site.id] ?? [] %}
                {% if loop.first %}<h3 class="location-map__panel-sub">{{ 'location.map.objectives.title'|trans({}, 'locations') }}</h3><ul class="location-map__list">{% endif %}
                <li><a href="{{ path('app_objective_show', { id: _o.id }) }}">{{ _o.title }}</a><br>
                    <small class="text-muted-color">{{ 'location.map.objectives.line'|trans({ '%target%': _o.target, '%current%': _o.current ?? '–', '%months%': _o.monthsLeft ?? '–' }, 'locations') }}</small></li>
                {% if loop.last %}</ul>{% endif %}
            {% endfor %}

            {# Auditors see the map read-only: no quick actions. #}
            {% if not _read_only %}
            <h3 class="location-map__panel-sub">{{ 'location.map.actions.title'|trans({}, 'locations') }}</h3>
            <div class="location-map__actions">
                <a class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" href="{{ path('app_risk_new', { fromLocation: site.id }) }}">{{ 'location.map.actions.risk'|trans({}, 'locations') }}</a>
                <a class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" href="{{ path('app_incident_new') }}">{{ 'location.map.actions.incident'|trans({}, 'locations') }}</a>
                {% if is_granted('ROLE_MANAGER') %}
                    <a class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" href="{{ path('app_location_edit', { id: site.id }) }}">{{ 'location.map.actions.owner'|trans({}, 'locations') }}</a>
                    <a class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" href="{{ path('app_audit_new') }}">{{ 'location.map.actions.audit'|trans({}, 'locations') }}</a>
                    {% if is_module_active('bcm') %}<a class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" href="{{ path('app_bc_exercise_new') }}">{{ 'location.map.actions.exercise'|trans({}, 'locations') }}</a>{% endif %}
                {% endif %}
            </div>
            {% endif %}

            <div class="location-map__links">
                <a href="{{ path('app_location_show', { id: site.id }) }}">{{ 'location.map.link.location'|trans({}, 'locations') }}</a>
                <a href="{{ path('app_risk_index', { location: site.id }) }}">{{ 'location.map.link.risks'|trans({ '%count%': site.risks }, 'locations') }}</a>
