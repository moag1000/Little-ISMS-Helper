{% trans_default_domain 'soa'%}<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statement of Applicability Export - ISO/IEC 27001:2022</title>
    <style>
        @media print {
            .no-print {
                display: none;
            }
            body {
                margin: 0;
                padding: 20px;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            line-height: 1.6;
            color: var(--fg, #333);
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: var(--surface, #fff);
        }

        .header {
            border-bottom: 3px solid var(--primary-strong, #2c5282);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        h1 {
            color: var(--primary-strong, #2c5282);
            font-size: 2rem;
            margin-bottom: 10px;
        }

        h2 {
            color: var(--primary-strong, #2c5282);
            font-size: 1.5rem;
            margin-top: 30px;
            margin-bottom: 15px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 10px;
        }

        h3 {
            color: var(--fg, #2d3748);
            font-size: 1.2rem;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .meta-info {
            color: var(--fg-3, #718096);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .stat-box {
            background: var(--surface-2, #f7fafc);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }

        .stat-box .value {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary-strong, #2c5282);
            display: block;
        }

        .stat-box .label {
            color: var(--fg-3, #718096);
            font-size: 0.9rem;
            margin-top: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 0.85rem;
        }

        th {
            background: var(--primary-strong, #2c5282);
            color: var(--on-primary, white);
            padding: 12px 8px;
            text-align: left;
            font-weight: 600;
        }

        td {
            padding: 10px 8px;
            border-bottom: 1px solid var(--border);
        }

        tr:nth-child(even) {
            background: var(--surface-2, #f7fafc);
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            text-align: center;
        }

        .badge-success {
            background: var(--success, #48bb78);
            color: var(--on-success, white);
        }

        .badge-warning {
            background: var(--warning, #ed8936);
            color: var(--on-warning, white);
        }

        .badge-danger {
            background: var(--danger, #f56565);
            color: var(--on-danger, white);
        }

        .badge-secondary {
            background: var(--border);
            color: var(--fg-2, #4a5568);
        }

        .badge-info {
            background: var(--primary, #4299e1);
            color: var(--on-primary, white);
        }

        .control-detail {
            margin: 30px 0;
            page-break-inside: avoid;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            background: var(--surface, #ffffff);
        }

        .control-header {
            background: var(--surface-2, #edf2f7);
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
        }

        .detail-section {
            margin: 15px 0;
        }

        .detail-label {
            font-weight: 600;
            color: var(--fg, #2d3748);
            margin-bottom: 5px;
        }

        .detail-value {
            color: var(--fg-2, #4a5568);
            padding-left: 10px;
            white-space: pre-wrap;
        }

        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 2px solid var(--border);
            text-align: center;
            color: var(--fg-3, #718096);
            font-size: 0.85rem;
        }

        .btn {
            display: inline-block;
            padding: 10px 20px;
            margin: 10px 5px;
            background: var(--primary-strong, #2c5282);
            color: var(--on-primary, white);
            text-decoration: none;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }

        .btn:hover {
            background: var(--primary-hover, #2a4365);
        }

        .btn-secondary {
            background: var(--fg-3, #718096);
        }

        .btn-secondary:hover {
            background: var(--fg-2, #4a5568);
        }

        @page {
            margin: 2cm;
        }

        /* Utility Classes */
        .text-center {
            text-align: center;
        }

        .text-center-mb-20 {
            text-align: center;
            margin-bottom: 20px;
        }

        .text-light-gray {
            color: var(--fg-3, #a0aec0);
        }

        .fs-08-light-gray {
            font-size: 0.8rem;
            color: var(--fg-3, #a0aec0);
        }
    </style>
</head>
<body>
    <div class="no-print text-center-mb-20">
        <button data-controller="ui-actions" data-action="ui-actions#print" class="fa-cyber-btn fa-cyber-btn--primary">
            <i class="fa-icon fa-icon--ui-printer" aria-hidden="true"></i> {{ 'soa.action.print'|trans({}, 'soa') }}
        </button>
        <a href="{{ path('app_soa_index') }}" class="fa-cyber-btn fa-cyber-btn--ghost">← {{ 'soa.action.back_to_overview'|trans({}, 'soa') }}</a>
    </div>

    <div class="header">
        <h1>{{ 'soa.title'|trans({}, 'soa')}}</h1>
        <div class="meta-info">
            <strong>{{ 'soa.export.standard'|trans({}, 'soa') }}</strong> ISO/IEC 27001:2022 Annex A Controls<br>
            {{ 'soa.report.generated_at'|trans({'%datetime%': generatedAt|fa_datetime}, 'soa') }}
        </div>
    </div>

    {# Summary Statistics #}
    <h2>{{ 'soa.report.pdf.section_summary'|trans({}, 'soa') }}</h2>
    <div class="stats-grid">
        <div class="stat-box">
            <span class="value">{{ controls|length }}</span>
            <div class="label">{{ 'soa.kpi.total_controls'|trans({}, 'soa') }}</div>
        </div>

        <div class="stat-box">
            <span class="value">{{ controls|filter(c => c.applicable)|length }}</span>
            <div class="label">{{ 'soa.kpi.applicable_controls'|trans({}, 'soa') }}</div>
        </div>

        <div class="stat-box">
            {% set implemented = controls|filter(c => c.applicable and c.implementationStatus == 'implemented')|length %}
            <span class="value">{{ implemented }}</span>
            <div class="label">{{ 'soa.kpi.implemented_controls'|trans({}, 'soa') }}</div>
        </div>

        <div class="stat-box">
            {% set applicable = controls|filter(c => c.applicable)|length %}
            {% set implemented = controls|filter(c => c.applicable and c.implementationStatus == 'implemented')|length %}
            {% set percentage = applicable > 0 ? (implemented / applicable * 100)|round : 0 %}
            <span class="value">{{ percentage }}%</span>
            <div class="label">{{ 'soa.kpi.compliance_rate'|trans({}, 'soa') }}</div>
        </div>
    </div>

    {# Category Breakdown #}
    <h2>{{ 'soa.export.category_overview'|trans({}, 'soa') }}</h2>
    {% set categories = ['Organizational', 'People', 'Physical', 'Technological'] %}
    <table>
        <thead>
            <tr>
                <th scope="col">{{ 'soa.table.category'|trans({}, 'soa') }}</th>
                <th scope="col" class="text-center">{{ 'soa.export.col_total'|trans({}, 'soa') }}</th>
                <th scope="col" class="text-center">{{ 'soa.table.applicable'|trans({}, 'soa') }}</th>
                <th scope="col" class="text-center">{{ 'soa.status.implemented'|trans({}, 'soa') }}</th>
                <th scope="col" class="text-center">{{ 'soa.kpi.compliance_rate'|trans({}, 'soa') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for category in categories %}
                {% set cat_controls = controls|filter(c => c.category == category) %}
                {% set applicable = cat_controls|filter(c => c.applicable) %}
                {% set implemented = applicable|filter(c => c.implementationStatus == 'implemented') %}
                {% set rate = applicable|length > 0 ? (implemented|length / applicable|length * 100)|round : 0 %}
                <tr>
                    <td><strong>{{ category }}</strong></td>
                    <td class="text-center">{{ cat_controls|length }}</td>
                    <td class="text-center">{{ applicable|length }}</td>
                    <td class="text-center">{{ implemented|length }}</td>
                    <td class="text-center">{{ rate }}%</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Controls Overview Table #}
    <h2>{{ 'soa.export.controls_overview'|trans({}, 'soa') }}</h2>
    <table>
        <thead>
            <tr>
                <th scope="col">{{ 'soa.table.control_id'|trans({}, 'soa') }}</th>
                <th scope="col">{{ 'soa.table.name'|trans({}, 'soa') }}</th>
                <th scope="col">{{ 'soa.table.category'|trans({}, 'soa') }}</th>
                <th scope="col" class="text-center">{{ 'soa.table.applicable'|trans({}, 'soa') }}</th>
                <th scope="col">{{ 'soa.label.status'|trans({}, 'soa') }}</th>
                <th scope="col" class="text-center">{{ 'soa.table.progress'|trans({}, 'soa') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for control in controls|sort((a, b) => a.controlId <=> b.controlId) %}
            <tr>
                <td><strong>{{ control.controlId }}</strong></td>
                <td>{{ control.name }}</td>
                <td><span class="badge badge-info">{{ control.category }}</span></td>
                <td class="text-center">
                    {% if control.applicable %}
                        <span class="badge badge-success">✓</span>
                    {% else %}
                        <span class="badge badge-secondary">✗</span>
                    {% endif %}
                </td>
                <td>
                    {% if control.applicable %}
                        {% if control.implementationStatus == 'implemented' %}
                            <span class="badge badge-success">{{ 'soa.status.implemented'|trans({}, 'soa') }}</span>
                        {% elseif control.implementationStatus == 'in_progress' %}
                            <span class="badge badge-warning">{{ 'soa.in_progress_badge'|trans({}, 'soa')}}</span>
                        {% elseif control.implementationStatus == 'not_started' %}
                            <span class="badge badge-danger">{{ 'soa.status.not_started'|trans({}, 'soa') }}</span>
                        {% endif %}
                    {% else %}
                        <span class="badge badge-secondary">{{ 'soa.value.na'|trans({}, 'soa') }}</span>
                    {% endif %}
                </td>
                <td class="text-center">
                    {% if control.applicable %}
                        {{ control.implementationPercentage }}%
                    {% else %}
                        -
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Detailed Controls Information #}
    <h2>{{ 'soa.export.detail_heading'|trans({}, 'soa') }}</h2>

    {% for control in controls|sort((a, b) => a.controlId <=> b.controlId) %}
    <div class="control-detail">
        <div class="control-header">
            <h2>{{ control.controlId }}: {{ control.name }}</h2>
            <span class="badge badge-info">{{ control.category }}</span>
            {% if control.applicable %}
                <span class="badge badge-success">{{ 'soa.field.applicable'|trans({}, 'soa') }}</span>
            {% else %}
                <span class="badge badge-secondary">{{ 'soa.status.not_applicable'|trans({}, 'soa') }}</span>
            {% endif %}
        </div>

        <div class="detail-section">
            <div class="detail-label">{{ 'soa.section.description'|trans({}, 'soa') }}:</div>
            <div class="detail-value">{{ control.description }}</div>
        </div>

        <div class="detail-section">
            <div class="detail-label">{{ 'soa.export.applicability_justification'|trans({}, 'soa') }}</div>
            <div class="detail-value">
                {% if control.justification %}
                    {{ control.justification }}
                {% else %}
                    <em class="text-light-gray">{{ 'soa.empty.no_justification'|trans({}, 'soa') }}</em>
                {% endif %}
            </div>
        </div>

        {% if control.applicable %}
            <div class="detail-section">
                <div class="detail-label">{{ 'soa.table.implementation_status'|trans({}, 'soa') }}:</div>
                <div class="detail-value">
                    {% if control.implementationStatus == 'implemented' %}
                        <span class="badge badge-success">✓ {{ 'soa.status.implemented'|trans({}, 'soa') }}</span> - {{ control.implementationPercentage }}%
                    {% elseif control.implementationStatus == 'in_progress' %}
                        <span class="badge badge-warning">{{ 'soa.in_progress_badge_emoji'|trans({}, 'soa') }}</span> - {{ control.implementationPercentage }}%
                    {% elseif control.implementationStatus == 'not_started' %}
                        <span class="badge badge-danger">⏸ {{ 'soa.status.not_started'|trans({}, 'soa') }}</span> - {{ control.implementationPercentage }}%
                    {% endif %}
                </div>
            </div>

            {% if control.implementationNotes %}
            <div class="detail-section">
                <div class="detail-label">{{ 'soa.field.implementation_notes'|trans({}, 'soa') }}:</div>
                <div class="detail-value">{{ control.implementationNotes }}</div>
            </div>
            {% endif %}

            <div class="detail-section">
                <div class="detail-label">{{ 'soa.field.responsible_person'|trans({}, 'soa') }}:</div>
                <div class="detail-value">
                    {% if control.responsiblePerson %}
                        {{ control.responsiblePerson }}
                    {% else %}
                        <em class="text-light-gray">{{ 'soa.field.unassigned'|trans({}, 'soa') }}</em>
                    {% endif %}
                </div>
            </div>

            {% if control.targetDate %}
            <div class="detail-section">
                <div class="detail-label">{{ 'soa.field.target_date'|trans({}, 'soa') }}:</div>
                <div class="detail-value">{{ control.targetDate|fa_date }}</div>
            </div>
            {% endif %}
        {% endif %}

        <div class="detail-section fs-08-light-gray">
            <em>{{ 'soa.field.updated_at'|trans({}, 'soa') }}: {{ control.updatedAt|fa_datetime }}</em>
        </div>
    </div>
    {% endfor %}

    <div class="footer">
        <p><strong>Statement of Applicability (SoA)</strong></p>
        <p>ISO/IEC 27001:2022 Annex A Controls</p>
        <p>{{ 'soa.report.generated_at'|trans({'%datetime%': generatedAt|fa_datetime}, 'soa') }}</p>
    </div>
</body>
</html>
