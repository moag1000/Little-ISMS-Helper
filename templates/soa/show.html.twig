{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% trans_default_domain 'soa' %}
{% import '_components/_status_pill.html.twig' as pill %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}

{% block title %}{{ control.controlId }} - {{ control.name }}{% endblock %}

{% block body %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
<div class="container">
    {# M-4 — module-gating: SoA / Control Management (ISO 27001 Annex A) #}
    {% if not is_module_active('controls') %}
        {{ _fa_alert.render({
            variant: 'info',
            icon: 'nav-shield-alert',
            body: 'common.module_not_active'|trans({'%module%': 'Controls / SoA'}, 'messages')
        }) }}
    {% else %}
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.soa'|trans({}, 'nav'), url: path('app_soa_index') },
            { label: control.controlId ~ ': ' ~ control.name }
        ]
    } %}

    {% set hint = alva_hint(control) %}
    {% if hint %}{{ _fa_alva_hint.render(hint) }}{% endif %}

    {%- set categoryLabel = ('soa.category.' ~ control.category)|trans({}, 'soa') -%}
    {{ _fa_page_header.render({
        badge: { icon: 'status-ok', label: control.controlId },
        title: control.name,
        subtitle: categoryLabel,
        actions: (is_granted('edit', control) ? [
            { label: 'soa.action.edit'|trans({}, 'soa'), variant: 'primary', icon: 'ui-edit', href: path('app_soa_edit', {id: control.id}) }
        ] : [])|merge([
            { label: 'soa.action.back_to_category'|trans({'%category%': categoryLabel}, 'soa'), variant: 'ghost', icon: 'util-arrow-left', href: path('app_soa_by_category', {category: control.category}) }
        ])
    }) }}

    {# MRIS resilience badge kept below header — multi-badge title row not supported by macro #}
    {% set mrisLocale = app.request.locale|default('de') %}
    <div class="d-flex flex-wrap gap-2 mb-3">
        {% if control.mythosResilience == 'standfest' %}
            <span tabindex="0" data-bs-toggle="tooltip" title="{{ mris_help('mris.help.standfest', 'tooltip', mrisLocale) }}">
                {% include '_components/_badge.html.twig' with { variant: 'success', content: 'soa.mris.standfest'|trans({}, 'soa') } %}
            </span>
        {% elseif control.mythosResilience == 'degradiert' %}
            <span tabindex="0" data-bs-toggle="tooltip" title="{{ mris_help('mris.help.partially_degraded', 'tooltip', mrisLocale) }}">
                {% include '_components/_badge.html.twig' with { variant: 'warning', content: 'soa.mris.degradiert'|trans({}, 'soa') } %}
            </span>
        {% elseif control.mythosResilience == 'reibung' %}
            <span tabindex="0" data-bs-toggle="tooltip" title="{{ mris_help('mris.help.pure_friction', 'tooltip', mrisLocale) }}">
                {% include '_components/_badge.html.twig' with { variant: 'danger', content: 'soa.mris.reibung'|trans({}, 'soa') } %}
            </span>
        {% elseif control.mythosResilience == 'nicht_betroffen' %}
            <span tabindex="0" data-bs-toggle="tooltip" title="{{ mris_help('mris.help.not_affected', 'tooltip', mrisLocale) }}">
                {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'soa.mris.nicht_betroffen'|trans({}, 'soa') } %}
            </span>
        {% endif %}
    </div>
</div>

{# MRIS-Warning für "Reine Reibung"-Controls (gem. Peddi 2026, MRIS v1.5 Anhang A) #}
{% if control.mythosResilience == 'reibung' %}
<div data-tour="mris-reibung-warning">
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'danger', class: 'mb-4' } } %}
        {% block alert_body %}
            <strong>{{ 'soa.mris.reibung_warning_title'|trans({}, 'soa') }}</strong><br>
            {{ 'soa.mris.reibung_warning_body'|trans({}, 'soa') }}
            {% if control.mythosFlankingMhcs is not empty %}
                <br>
                <strong>{{ 'soa.mris.flanking_mhcs'|trans({}, 'soa') }}:</strong>
                {% for mhc in control.mythosFlankingMhcs %}
                    <code>{{ mhc }}</code>{% if not loop.last %}, {% endif %}
                {% endfor %}
            {% endif %}
            <br>
            <small class="text-muted">{{ 'soa.mris.source'|trans({}, 'soa') }}</small>
        {% endblock %}
    {% endembed %}
</div>
{% elseif control.mythosResilience == 'degradiert' and control.mythosFlankingMhcs is not empty %}
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'warning', icon: 'status-info', class: 'mb-4' } } %}
        {% block alert_body %}
            <strong>{{ 'soa.mris.degradiert_hint_title'|trans({}, 'soa') }}</strong><br>
            {{ 'soa.mris.degradiert_hint_body'|trans({}, 'soa') }}
            <strong>{{ 'soa.mris.flanking_mhcs'|trans({}, 'soa') }}:</strong>
            {% for mhc in control.mythosFlankingMhcs %}
                <code>{{ mhc }}</code>{% if not loop.last %}, {% endif %}
            {% endfor %}
            <br>
            <small class="text-muted">{{ 'soa.mris.source'|trans({}, 'soa') }}</small>
        {% endblock %}
    {% endembed %}
{% endif %}

{# Detail skeleton (UI wave E): status band → anchor bar → links → sections → comments #}
{% set _impl = control.implementationStatus %}
{% set _status %}{% if not control.applicable %}{{ pill.render('soa.status.not_applicable'|trans({}, 'soa'), 'neutral', {size: 'sm'}) }}{% elseif _impl in ['implemented', 'verified'] %}{{ pill.render('soa.status.implemented'|trans({}, 'soa'), 'success', {size: 'sm'}) }}{% elseif _impl in ['in_progress', 'partial', 'planned'] %}{{ pill.render('soa.status.in_progress'|trans({}, 'soa'), 'warning', {size: 'sm'}) }}{% elseif _impl == 'not_started' %}{{ pill.render('soa.status.not_started'|trans({}, 'soa'), 'danger', {size: 'sm'}) }}{% else %}{{ pill.render('soa.value.na'|trans({}, 'soa'), 'neutral', {size: 'sm'}) }}{% endif %}{% endset %}
{% set _actions %}{% if control.applicable is not same as(false) %}{% include '_components/_review_confirm_button.html.twig' with { entity: control, route: 'app_soa_review_confirm' } only %}{% endif %}{% endset %}
{{ _fa_status_band.render({
    status: _status,
    actions: _actions,
    facts: [
        { label: 'show.status.owner'|trans({}, 'messages'), value: control.effectiveResponsiblePerson },
        { label: 'show.status.target_date'|trans({}, 'messages'), value: control.targetDate ? control.targetDate|fa_date : null },
        { label: 'show.status.next_review'|trans({}, 'messages'), value: control.nextReviewDate ? control.nextReviewDate|fa_date : null },
    ],
    workflow: workflow_state(control),
}) }}

{{ _fa_anchor_bar.render([
    { id: 'links', label: 'show.anchor.links'|trans({}, 'messages') },
    { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
    { id: 'implementation', label: 'soa.section.implementation_details'|trans({}, 'soa'), show: control.applicable },
    { id: 'effectiveness', label: 'soa.section.effectiveness_check'|trans({}, 'soa'), show: control.applicable },
    { id: 'evidence', label: 'soa.section.evidence'|trans({}, 'soa') },
    { id: 'comments', label: 'show.anchor.comments'|trans({}, 'messages'), count: comments|default([])|length },
]) }}

{% include '_components/_fa_entity_links.html.twig' with { entity: control } only %}

{# Control Description #}
<div id="details" class="fa-show-section">
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_body %}
        <h2>{{ 'soa.section.description'|trans({}, 'soa') }}</h2>
        <p class="text-light-mt-sm-lh">
            {{ control.description }}
        </p>
    {% endblock %}
{% endembed %}

{# Applicability Status #}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_body %}
    {% import '_components/_fa_progress.html.twig' as _fa_progress %}
        <h2>{{ 'soa.section.applicability_status'|trans({}, 'soa') }}</h2>
        <div class="stats-grid mt-2 grid-responsive-200">
            <div class="stat-item">
                <strong class="fs-4">
                    {% if control.applicable %}
                        {% include '_components/_badge.html.twig' with { variant: 'success', size: 'lg', content: '✓ ' ~ 'soa.value.yes'|trans({}, 'soa') } %}
                        <span class="visually-hidden">{{ 'soa.table.applicable'|trans({}, 'soa') }}</span>
                    {% else %}
                        {% include '_components/_badge.html.twig' with { variant: 'secondary', size: 'lg', class: 'badge-neutral-lg', content: '✗ ' ~ 'soa.status.not_applicable'|trans({}, 'soa') } %}
                    {% endif %}
                </strong>
                <span>{{ 'soa.field.applicable'|trans({}, 'soa') }}</span>
            </div>

            {% if control.applicable %}
            <div class="stat-item">
                <strong class="fs-4">
                    {% if control.implementationStatus == 'implemented' %}
                        {% include '_components/_badge.html.twig' with { variant: 'success', size: 'lg', icon: 'status-ok', content: 'soa.status.implemented'|trans({}, 'soa') } %}
                    {% elseif control.implementationStatus == 'in_progress' %}
                        {% include '_components/_badge.html.twig' with { variant: 'warning', size: 'lg', icon: 'util-refresh', content: 'soa.status.in_progress'|trans({}, 'soa') } %}
                    {% elseif control.implementationStatus == 'not_started' %}
                        {% include '_components/_badge.html.twig' with { variant: 'danger', size: 'lg', icon: 'pause', content: 'soa.status.not_started'|trans({}, 'soa') } %}
                    {% else %}
                        {% include '_components/_badge.html.twig' with { variant: 'secondary', size: 'lg', class: 'badge-neutral-lg', content: 'soa.value.na'|trans({}, 'soa') } %}
                    {% endif %}
                </strong>
                <span>{{ 'soa.table.implementation_status'|trans({}, 'soa') }}</span>
            </div>

            <div class="stat-item">
                <strong class="fs-4">{{ control.implementationPercentage }}%</strong>
                <span>{{ 'soa.field.implementation_percentage'|trans({}, 'soa') }}</span>
            </div>
            {% endif %}
        </div>

        {% if control.applicable %}
        {{ _fa_progress.render({ value: control.implementationPercentage, showText: true, size: 'lg', class: 'mt-3' }) }}
        {% endif %}
    {% endblock %}
{% endembed %}

{# Justification #}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_body %}
        <h2>{{ 'soa.section.justification'|trans({}, 'soa') }}</h2>
        {% if control.justification %}
            {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mt-2' } } %}
                {% block alert_body %}
                    <p class="ws-pre-wrap-lh">{{ control.justification }}</p>
                {% endblock %}
            {% endembed %}
        {% else %}
            <p class="text-muted mt-sm">
                {{ 'soa.message.no_justification'|trans({}, 'soa') }}
            </p>
        {% endif %}
    {% endblock %}
{% endembed %}

</div>

{% if control.applicable %}
{# Implementation Details #}
<div id="implementation" class="fa-show-section">
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_body %}
        <h2>{{ 'soa.section.implementation_details'|trans({}, 'soa') }}</h2>

        <div class="form-group mt-3">
            <h2 class="fs-1 mb-sm">{{ 'soa.section.implementation_notes'|trans({}, 'soa') }}</h2>
            {% if control.implementationNotes %}
                {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info' } } %}
                    {% block alert_body %}
                        <p class="ws-pre-wrap-lh">{{ control.implementationNotes }}</p>
                    {% endblock %}
                {% endembed %}
            {% else %}
                <p class="text-muted">
                    {{ 'soa.message.no_implementation_notes'|trans({}, 'soa') }}
                </p>
            {% endif %}
        </div>

        <div class="stats-grid mt-3 grid-responsive-250">
            <div class="stat-item">
                <strong>
                    {% if control.responsiblePersonUser %}
                        {{ control.responsiblePersonUser.fullName }}
                    {% elseif control.responsiblePersonRef %}
                        {{ control.responsiblePersonRef.displayName }}
                    {% else %}
                        <span class="text-muted">{{ 'soa.field.unassigned'|trans({}, 'soa') }}</span>
                    {% endif %}
                </strong>
                <span>{{ 'soa.field.responsible_person'|trans({}, 'soa') }}</span>
                {% if control.responsibleDeputyPersons|length > 0 %}
                    <span class="text-muted small d-block">
                        {{ 'soa.field.deputies'|trans({}, 'soa') }}:
                        {{ control.responsibleDeputyPersons|map(p => p.displayName)|join(', ') }}
                    </span>
                {% endif %}
            </div>

            <div class="stat-item">
                <strong>
                    {% if control.targetDate %}
                        {{ control.targetDate|fa_date }}
                    {% else %}
                        <span class="text-muted">{{ 'soa.field.not_set'|trans({}, 'soa') }}</span>
                    {% endif %}
                </strong>
                <span>{{ 'soa.field.target_date'|trans({}, 'soa') }}</span>
            </div>
        </div>
    {% endblock %}
{% endembed %}
</div>
{% endif %}

{# Data Reuse: Training Coverage #}
{% if control.trainings is defined and control.trainings|length > 0 %}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_body %}
        {% import '_components/_fa_alert.html.twig' as _fa_alert %}
        <h2>{{ 'soa.section.training_coverage'|trans({}, 'soa') }} ({{ control.trainings|length }})</h2>
        {{ _fa_alert.render({ variant: control.hasTrainingCoverage ? 'success' : 'warning', body: '<strong>Status: ' ~ control.trainingStatus|upper ~ '</strong>' ~ (not control.hasTrainingCoverage ? '<br>' ~ 'soa.empty.no_completed_trainings'|trans({}, 'soa') : '') }) }}
        <div class="data-reuse-list">
            {% for training in control.trainings %}
                <div class="data-reuse-item">
                    <strong>{{ training.title }}</strong>
                    <span class="{{ badge_status(training.status) }}">{{ training.status|upper }}</span>
                    {% if training.completionDate %}
                        <small>Abgeschlossen: {{ training.completionDate|fa_date }}</small>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
{% endif %}

{# Evidence Documents #}
<div id="evidence" class="fa-show-section">
{% include 'evidence/_upload_widget.html.twig' with {
    entityType: 'control',
    entityId: control.id,
    documents: control.evidenceDocuments
} %}
</div>

{# Control Effectiveness Score #}
<div id="effectiveness" class="fa-show-section">
{% if control.applicable and control.implementationPercentage == 100 %}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_body %}
        <h2>{{ 'soa.section.control_effectiveness'|trans({}, 'soa') }}</h2>
        <div class="stats-grid grid-responsive-200">
            <div class="stat-item">
                <strong style="font-size: 2rem; color: {{ control.effectivenessScore >= 80 ? 'var(--color-success)' : (control.effectivenessScore >= 50 ? 'var(--color-warning)' : 'var(--color-danger)') }}">
                    {{ control.effectivenessScore|number_format(1) }}%
                </strong>
                <span>{{ 'soa.label.effectiveness_score'|trans({}, 'soa') }}</span>
            </div>
        </div>
        <p class="text-light-mt-sm">
            {{ 'soa.empty.effectiveness_note'|trans({}, 'soa') }}
        </p>
    {% endblock %}
{% endembed %}
{% endif %}

{# Wirksamkeits-Check Widget — ISO 27001 §9.1 cross-link #}
{% if control.applicable %}
{% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
    {% block card_body %}
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
            <div>
                <h2 class="h6 mb-1">{{ 'soa.section.effectiveness_check'|trans({}, 'soa') }}</h2>
                {% set lastTest = control.lastEffectivenessTest %}
                {% set isOverdue = lastTest is null or lastTest < date('-12 months') %}
                <div class="d-flex align-items-center gap-2 mt-2">
                    {% if lastTest %}
                        <span class="text-muted small">{{ 'soa.label.last_effectiveness_test'|trans({}, 'soa') }}: <strong>{{ lastTest|fa_date }}</strong></span>
                    {% else %}
                        <span class="text-muted small"><em>{{ 'soa.label.never_tested'|trans({}, 'soa') }}</em></span>
                    {% endif %}
                    {% if isOverdue %}
                        <span class="fa-status-pill fa-status-pill--danger">{{ 'soa.label.overdue'|trans({}, 'soa') }}</span>
                    {% else %}
                        <span class="fa-status-pill fa-status-pill--success">{{ 'soa.label.check_current'|trans({}, 'soa') }}</span>
                    {% endif %}
                </div>
            </div>
            {% if is_granted('ROLE_AUDITOR') %}
            <a href="{{ path('app_effectiveness_monitor') }}" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost">
                <i class="fa-icon fa-icon--nav-speedometer" aria-hidden="true"></i>
                {{ 'soa.action.open_monitor'|trans({}, 'soa') }}
            </a>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endif %}
</div>

{# Metadata #}
{% embed '_components/_card.html.twig' %}
    {% block card_body %}
        <h2>{{ 'soa.section.metadata'|trans({}, 'soa') }}</h2>
        <div class="stats-grid mt-2 grid-responsive-250">
            <div class="stat-item">
                <strong>{{ control.createdAt|fa_datetime }}</strong>
                <span>{{ 'soa.field.created_at'|trans({}, 'soa') }}</span>
            </div>

            <div class="stat-item">
                <strong>{{ control.updatedAt|fa_datetime }}</strong>
                <span>{{ 'soa.field.updated_at'|trans({}, 'soa') }}</span>
            </div>

            {% if control.lastReviewDate %}
            <div class="stat-item">
                <strong>{{ control.lastReviewDate|fa_date }}</strong>
                <span>{{ 'soa.field.last_review'|trans({}, 'soa') }}</span>
            </div>
            {% endif %}

            {% if control.nextReviewDate %}
            <div class="stat-item">
                <strong>{{ control.nextReviewDate|fa_date }}</strong>
                <span>{{ 'soa.field.next_review'|trans({}, 'soa') }}</span>
            </div>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}

{# A2 Auto-Mapping-Vorschläge #}
{% if mapping_suggestions is defined and mapping_suggestions|length > 0 %}
    {% embed '_components/_card.html.twig' with { class: 'mt-4 border-info' } %}
        {% block card_header %}
            {% import '_components/_status_pill.html.twig' as pill %}
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">
                    <i class="fa-icon fa-icon--nav-magic" aria-hidden="true"></i>
                    {{ 'control.mapping_suggestions.title'|trans({
                        '%count%': mapping_suggestions_total,
                        '%frameworks%': mapping_suggestions|length
                    }, 'control') }}
                </h2>
                {{ pill.render(mapping_suggestions_total, 'primary', {size: 'sm'}) }}
            </div>
        {% endblock %}
        {% block card_body %}
            {% import '_components/_status_pill.html.twig' as pill %}
            <p class="small text-muted">{{ 'control.mapping_suggestions.description'|trans({}, 'control') }}</p>

            {% for code, rows in mapping_suggestions %}
                <div class="mb-3">
                    <h3 class="h6">
                        <span class="border fa-status-pill fa-status-pill--neutral">{{ code }}</span>
                        {{ rows[0].framework.name }}
                    </h3>
                    <ul class="list-unstyled mb-0">
                        {% for row in rows %}
                            {% set conf_pct = (row.confidence * 100)|round %}
                            {% set conf_variant = conf_pct >= 50 ? 'success' : (conf_pct >= 30 ? 'warning' : 'secondary') %}
                            {% set conf_label = conf_pct >= 50
                                ? 'control.mapping_suggestions.confidence.high'|trans({}, 'control')
                                : (conf_pct >= 30
                                    ? 'control.mapping_suggestions.confidence.medium'|trans({}, 'control')
                                    : 'control.mapping_suggestions.confidence.low'|trans({}, 'control'))
                            %}
                            <li class="d-flex justify-content-between align-items-start border-bottom py-2">
                                <div class="flex-grow-1">
                                    <div>
                                        <code>{{ row.requirement.requirementId }}</code>
                                        <span class="ms-1">{{ row.requirement.title }}</span>
                                    </div>
                                    {% if row.requirement.category %}
                                        <div class="small text-muted">{{ row.requirement.category }}</div>
                                    {% endif %}
                                </div>
                                <div class="ms-2 d-flex align-items-center gap-2">
                                    {{ pill.render(conf_label, conf_variant == 'secondary' ? 'neutral' : conf_variant, {size: 'sm', title: 'control.mapping_suggestions.confidence.tooltip'|trans({'%pct%': conf_pct}, 'control')}) }}
                                    {% if is_granted('edit', control) %}
                                    <form method="post"
                                          action="{{ path('app_soa_accept_suggestion', { id: control.id, requirementId: row.requirement.id }) }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('accept_suggestion_' ~ control.id ~ '_' ~ row.requirement.id) }}">
                                        <input type="hidden" name="confidence" value="{{ row.confidence }}">
                                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--success">
                                            <i class="fa-icon fa-icon--ui-plus" aria-hidden="true"></i>
                                            {{ 'control.mapping_suggestions.accept'|trans({}, 'control') }}
                                        </button>
                                    </form>
                                    <form method="post"
                                          action="{{ path('app_suggestion_mapping_reject', { id: control.id, requirement: row.requirement.id }) }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('suggestion_mapping_reject_' ~ control.id ~ '_' ~ row.requirement.id) }}">
                                        <input type="hidden" name="confidence" value="{{ row.confidence }}">
                                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost">
                                            {{ 'suggestions.action.not_a_match'|trans({}, 'suggestions') }}
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}

            <div class="small text-muted mt-2">
                <i class="fa-icon fa-icon--ui-info" aria-hidden="true"></i>
                {{ 'control.mapping_suggestions.footer_hint'|trans({}, 'control') }}
            </div>
        {% endblock %}
    {% endembed %}
{% endif %}

{# Inverse-Coverage Impact-Analyse #}
{% include '_components/_impact_coverage.html.twig' with {
    impact: impact_coverage|default({total: 0, frameworks: []}),
    entity_label: 'control'
} %}

{# Action Buttons #}
<div class="d-flex gap-2 mt-4">
    {% if is_granted('edit', control) %}
    <a href="{{ path('app_soa_edit', {id: control.id}) }}" class="fa-cyber-btn fa-cyber-btn--success">
        <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i> {{ 'soa.action.edit'|trans({}, 'soa') }}
    </a>
    {% endif %}
    <a href="{{ path('app_soa_index') }}" class="fa-cyber-btn fa-cyber-btn--ghost">
        <i class="fa-icon fa-icon--ui-list" aria-hidden="true"></i> {{ 'common.back_to_list'|trans({}, 'messages') }}
    </a>
</div>

{# V4 LB-4: Comment-Thread adoption (C7 macro). #}
<div id="comments" class="fa-show-section">
{% include '_components/_isms_comment_thread.html.twig' with {
    comments: comments|default([]),
    entityType: 'Control',
    entityId: control.id,
    showForm: true,
    formAction: path('app_comment_post', {entityType: 'Control', entityId: control.id}),
    csrfToken: csrf_token('isms-comment')
} only %}
</div>
