{% extends 'pdf/_base_document.html.twig' %}
{% trans_default_domain 'soa' %}

{# Document Metadata #}
{% block document_id %}{{ 'DOC-ISMS-SOA-001'|e }}{% endblock %}
{% block document_title %}{{ 'page.title'|trans({}, 'messages') }}{% endblock %}
{% block document_type %}{{ 'report.document_type'|trans({}, 'reports') }}{% endblock %}
{% block document_version %}{{ version }}{% endblock %}
{# Approval state from the decision register (ISO 27001 5.1 / 6.1.3), never assumed. #}
{% set _soa_approval = management_approval('soa') %}
{% block document_status %}{{ _soa_approval ? 'status.approved'|trans({}, 'messages') : 'soa.governance.not_approved'|trans({}, 'soa') }}{% endblock %}
{% set _soa_status_class = _soa_approval ? 'approved' : 'draft' %}
{% block document_status_class %}{{ _soa_status_class }}{% endblock %}
{% block document_classification %}{{ 'label.classification_confidential'|trans({}, 'messages') }}{% endblock %}
{% block classification_class %}{{ 'confidential'|e }}{% endblock %}

{# Header/Footer #}
{% block header_center %}{{ 'report.header_center'|trans({}, 'reports') }}{% endblock %}
{% block header_right %}{{ 'label.classification_confidential_upper'|trans({}, 'messages') }}{% endblock %}
{% block footer_version %}{{ version }}{% endblock %}

{# Show Approval Section #}
{% set show_approval = true %}
{% block reviewer_name %}{{ app.user.fullName|default(('report.default_reviewer'|trans({}, 'reports'))) }}{% endblock %}
{% block review_date %}{{ generatedAt|fa_date }}{% endblock %}
{% block approver_name %}{{ _soa_approval and _soa_approval.decidedBy ? _soa_approval.decidedBy.fullName : '—' }}{% endblock %}
{% block approval_date %}{{ _soa_approval ? _soa_approval.decidedAt|fa_date : '—' }}{% endblock %}

{# No version history table: versions of the SoA are the snapshots (soa/snapshot), not invented rows. #}
{% set show_version_history = false %}

{# Custom Styles for SoA — Aurora token CSS (no raw hex) #}
{% block custom_styles %}{% include 'soa/_report_v2_styles.css.twig' %}{% endblock %}

{# Main Document Content #}
{% block document_content %}

{# Executive Summary #}
<h1>{{ 'soa.title'|trans({}, 'soa')}}</h1>
<p class="text-center text-muted mb-medium">
    {{ 'report.pdf.subtitle'|trans({}, 'soa') }}
</p>

<div class="mb-large">
    <h2>{{ 'report.pdf.section_summary'|trans({}, 'soa') }}</h2>
    <p>
        {{ 'report.pdf.intro_line1'|trans({'%tenant%': '<strong>' ~ (tenant_name|default('report.pdf.default_tenant'|trans({}, 'soa')))|e ~ '</strong>'}, 'soa')|raw }}
    </p>
    <p>
        {{ 'report.pdf.intro_line2'|trans({}, 'soa') }}
    </p>
</div>

{# ISO 27001 4.3: the scope the SoA applies to #}
{% include '_components/_isms_scope_block.html.twig' with { scope: isms_scope(), heading: 'h2' } only %}

{# Statistics Overview #}
<h2>{{ 'section.implementation_overview'|trans({}, 'soa') }}</h2>
<div class="stats-grid">
    <div class="stats-row">
        <div class="stats-cell">
            <div class="stats-label">{{ 'kpi.total_controls'|trans({}, 'soa') }}</div>
            <div class="stats-value">{{ stats.total }}</div>
        </div>
        <div class="stats-cell">
            <div class="stats-label">{{ 'kpi.applicable_controls'|trans({}, 'soa') }}</div>
            <div class="stats-value">{{ stats.total }}</div>
        </div>
        <div class="stats-cell">
            <div class="stats-label">{{ 'status.implemented'|trans({}, 'soa') }}</div>
            <div class="stats-value">{{ stats.implemented }}</div>
        </div>
        <div class="stats-cell">
            <div class="stats-label">{{ 'kpi.compliance_rate'|trans({}, 'soa') }}</div>
            <div class="stats-value">
                <span class="percentage">{% if stats.total > 0 %}{{ ((stats.implemented / stats.total) * 100)|round }}%{% else %}0%{% endif %}</span>
            </div>
        </div>
    </div>
</div>

<div class="mb-large">
    <p><strong>{{ 'report.pdf.implementation_status_heading'|trans({}, 'soa') }}</strong></p>
    <ul>
        <li>{{ 'report.pdf.stat_fully_implemented'|trans({'%count%': stats.implemented}, 'soa') }}</li>
        <li>{{ 'report.pdf.stat_in_progress'|trans({'%count%': stats.in_progress}, 'soa') }}</li>
        <li>{{ 'report.pdf.stat_not_started'|trans({'%count%': stats.not_started}, 'soa') }}</li>
        <li>{{ 'report.pdf.stat_not_applicable'|trans({'%count%': stats.not_applicable}, 'soa') }}</li>
    </ul>
</div>

{# Controls by Category #}
<div class="page-break"></div>
<h2>{{ 'section.controls_by_category'|trans({}, 'soa') }}</h2>

{% for categoryName, categoryControls in controlsByCategory %}
<div class="category-header">{{ categoryName }}</div>

<table class="control-table">
    <thead>
        <tr>
            <th scope="col" style="width: 8%;">{{ 'table.control_id'|trans({}, 'soa') }}</th>
            <th scope="col" style="width: 22%;">{{ 'table.name'|trans({}, 'soa') }}</th>
            <th scope="col" style="width: 30%;">{{ 'section.description'|trans({}, 'soa') }}</th>
            <th scope="col" style="width: 12%;" class="text-center">{{ 'table.mris'|trans({}, 'soa') }}<br><span style="font-weight:normal;font-size:10px;">{{ '(Peddi 2026)'|e }}</span></th>
            <th scope="col" style="width: 8%;" class="text-center">{{ 'table.applicable'|trans({}, 'soa') }}</th>
            <th scope="col" style="width: 10%;" class="text-center">{{ 'field.status'|trans({}, 'soa') }}</th>
            <th scope="col" style="width: 10%;" class="text-center">{{ 'table.progress'|trans({}, 'soa') }}</th>
        </tr>
    </thead>
    <tbody>
        {% for control in categoryControls %}
        <tr>
            <td class="control-id">{{ control.controlId }}</td>
            <td><strong>{{ control.name }}</strong></td>
            <td class="text-muted">{{ control.description|slice(0, 200) }}{% if control.description|length > 200 %}...{% endif %}</td>
            <td class="text-center">
                {% if control.mythosResilience == 'standfest' %}<span class="badge" style="background:#d1e7dd;color:#0f5132;">{{ 'mris.standfest'|trans({}, 'soa') }}</span>
                {% elseif control.mythosResilience == 'degradiert' %}<span class="badge" style="background:#fff3cd;color:#664d03;">{{ 'report.pdf.mris_degradiert_short'|trans({}, 'soa') }}</span>
                {% elseif control.mythosResilience == 'reibung' %}<span class="badge" style="background:#f8d7da;color:#842029;">{{ 'mris.reibung'|trans({}, 'soa') }}</span>
                {% elseif control.mythosResilience == 'nicht_betroffen' %}<span class="badge" style="background:#e2e3e5;color:#41464b;">{{ 'mris.nicht_betroffen'|trans({}, 'soa') }}</span>
                {% else %}<span class="text-muted" style="font-size:10px;">—</span>
                {% endif %}
                {% if control.mythosFlankingMhcs is not empty %}
                    <div style="font-size:9px;color:#666;margin-top:2px;">{{ control.mythosFlankingMhcs|join(', ') }}</div>
                {% endif %}
            </td>
            <td class="text-center">
                {% if control.applicable %}
                    <span class="badge badge-applicable">✓ {{ 'value.yes'|trans({}, 'soa') }}</span>
                {% else %}
                    <span class="badge badge-not-applicable">✗ {{ 'value.no'|trans({}, 'soa') }}</span>
                {% endif %}
            </td>
            <td class="text-center">
                {% if control.applicable %}
                    {% if control.implementationStatus == 'implemented' %}
                        <span class="badge badge-implemented">{{ 'status.implemented'|trans({}, 'soa') }}</span>
                    {% elseif control.implementationStatus == 'partial' %}
                        <span class="badge badge-partial">{{ 'status.partial'|trans({}, 'soa') }}</span>
                    {% elseif control.implementationStatus == 'planned' %}
                        <span class="badge badge-planned">{{ 'status.planned'|trans({}, 'soa') }}</span>
                    {% else %}
                        <span class="badge badge-not-implemented">{{ 'report.pdf.status_open'|trans({}, 'soa') }}</span>
                    {% endif %}
                {% else %}
                    <span class="badge badge-not-applicable">{{ 'value.na'|trans({}, 'soa') }}</span>
                {% endif %}
            </td>
            <td class="text-center">
                {% if control.applicable %}
                    <strong>{{ control.implementationPercentage }}%</strong>
                {% else %}
                    —
                {% endif %}
            </td>
        </tr>
        {% if not control.applicable and control.justification %}
        <tr>
            <td colspan="6" style="background-color: #fef3c7; padding: 5pt;">
                <strong>{{ 'report.pdf.justification_prefix'|trans({}, 'soa') }}</strong> {{ control.justification }}
            </td>
        </tr>
        {% endif %}
        {% endfor %}
    </tbody>
</table>
{% endfor %}

{# Detailed Justifications #}
<div class="page-break"></div>
<h2>{{ 'report.pdf.section_detailed_justifications'|trans({}, 'soa') }}</h2>

<h3>{{ 'report.pdf.section_non_applicable'|trans({}, 'soa') }}</h3>
{% set hasNonApplicable = false %}
{% for control in controls %}
    {% if not control.applicable %}
        {% set hasNonApplicable = true %}
        <div class="no-break mb-medium">
            <p><strong>{{ control.controlId }} - {{ control.name }}</strong></p>
            <p class="text-muted" style="margin-left: 15pt;">
                <em>{{ 'field.justification'|trans({}, 'soa') }}:</em> {{ control.justification|default('empty.no_justification'|trans({}, 'soa')) }}
            </p>
        </div>
    {% endif %}
{% endfor %}
{% if not hasNonApplicable %}
<p class="text-muted">{{ 'report.pdf.all_controls_applicable'|trans({}, 'soa') }}</p>
{% endif %}

<h3>{{ 'report.pdf.section_planned'|trans({}, 'soa') }}</h3>
{% set hasPlanned = false %}
{% for control in controls %}
    {% if control.applicable and control.implementationStatus == 'planned' %}
        {% set hasPlanned = true %}
        <div class="no-break mb-medium">
            <p><strong>{{ control.controlId }} - {{ control.name }}</strong></p>
            <p class="text-muted" style="margin-left: 15pt;">
                <em>{{ 'field.target_date'|trans({}, 'soa') }}:</em> {{ control.targetDate|fa_date }}<br>
                <em>{{ 'label.responsible'|trans({}, 'soa') }}</em> {{ control.effectiveResponsiblePerson|default('field.unassigned'|trans({}, 'soa')) }}
            </p>
        </div>
    {% endif %}
{% endfor %}
{% if not hasPlanned %}
<p class="text-muted">{{ 'report.pdf.no_planned_implementations'|trans({}, 'soa') }}</p>
{% endif %}

{% endblock %}

{# References Section #}
{% set show_references = true %}
{% block references_content %}
<table>
    <thead>
        <tr>
            <th scope="col" style="width: 20%;">{{ 'report.pdf.ref_col_document'|trans({}, 'soa') }}</th>
            <th scope="col" style="width: 15%;">{{ 'report.pdf.ref_col_type'|trans({}, 'soa') }}</th>
            <th scope="col">{{ 'section.description'|trans({}, 'soa') }}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>{{ 'ISO/IEC 27001:2022'|e }}</td>
            <td>{{ 'soa.pdf_v2.type_standard'|trans({}, 'soa') }}</td>
            <td>{{ 'soa.iso27001_full_title'|trans({}, 'soa')}}</td>
        </tr>
        <tr>
            <td>{{ 'ISO/IEC 27002:2022'|e }}</td>
            <td>{{ 'soa.pdf_v2.type_standard'|trans({}, 'soa') }}</td>
            <td>{{ 'soa.pdf_v2.iso27002_title'|trans({}, 'soa') }}</td>
        </tr>
        <tr>
            <td>{{ 'ISMS-POL-001'|e }}</td>
            <td>{{ 'soa.pdf_v2.type_policy'|trans({}, 'soa') }}</td>
            <td>{{ 'report.pdf.ref_isms_policy'|trans({}, 'soa') }}</td>
        </tr>
        <tr>
            <td>{{ 'ISMS-RISK-001'|e }}</td>
            <td>{{ 'soa.pdf_v2.type_risk_assessment'|trans({}, 'soa') }}</td>
            <td>{{ 'report.pdf.ref_risk_assessment'|trans({}, 'soa') }}</td>
        </tr>
    </tbody>
</table>
{% endblock %}
