{% extends 'base.html.twig' %}
{% trans_default_domain 'api_token' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'api_token.title'|trans({}, 'api_token') }}{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 880px;">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [{ label: 'api_token.title'|trans({}, 'api_token') }]
    } %}

    {{ _fa_page_header.render({
        title: 'api_token.title'|trans({}, 'api_token'),
        subtitle: 'api_token.intro'|trans({}, 'api_token')
    }) }}

    {% if new_token %}
        {% import '_components/_fa_alert.html.twig' as _fa_alert %}
        {% set _token_html %}<pre class="mb-0 mt-2 user-select-all">{{ new_token }}</pre>{% endset %}
        {{ _fa_alert.render({ variant: 'success', title: 'api_token.created_once'|trans({}, 'api_token'), body: _token_html, class: 'mb-3' }) }}
    {% endif %}

    {# Create #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="post" action="{{ path('app_api_tokens_create') }}" class="row g-2 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('api_token_create') }}">
                <div class="col-md-6">
                    <label class="form-label" for="label">{{ 'api_token.field.label'|trans({}, 'api_token') }}</label>
                    <input type="text" class="form-control" id="label" name="label" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="expires_days">{{ 'api_token.field.expires_days'|trans({}, 'api_token') }}</label>
                    <input type="number" min="1" class="form-control" id="expires_days" name="expires_days" placeholder="—">
                </div>
                <div class="col-md-3">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">{{ 'api_token.action.create'|trans({}, 'api_token') }}</button>
                </div>
            </form>
        </div>
    </div>

    {# Assistant connection (MCP): endpoint + ready-made client configuration #}
    <section class="fa-section mb-4" id="mcp">
        <div class="fa-section__header">
            <h2 class="fa-section__title">{{ 'mcp.tokens.title'|trans({}, 'mcp') }}</h2>
            {% if mcp_enabled %}
                <span class="fa-status-pill fa-status-pill--success">{{ 'mcp.tokens.status_on'|trans({}, 'mcp') }}</span>
            {% else %}
                <span class="fa-status-pill fa-status-pill--neutral">{{ 'mcp.tokens.status_off'|trans({}, 'mcp') }}</span>
            {% endif %}
        </div>
        <div class="fa-section__body">
            <p class="small">{{ 'mcp.tokens.intro'|trans({}, 'mcp') }}</p>
            {% if not mcp_enabled %}
                <p class="small">
                    {{ 'mcp.tokens.off_hint'|trans({}, 'mcp') }}
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_settings_ai') }}#mcp">{{ 'mcp.tokens.off_admin_link'|trans({}, 'mcp') }}</a>{% endif %}
                </p>
            {% endif %}
            <p class="small mb-1 fw-bold">{{ 'mcp.tokens.endpoint'|trans({}, 'mcp') }}</p>
            <pre class="small user-select-all mb-3">{{ mcp_url }}</pre>
            {% for _key, _snippet in mcp_snippets %}
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <p class="small fw-bold mb-0">{{ ('mcp.tokens.snippet.' ~ _key)|trans({}, 'mcp') }}</p>
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm"
                            data-controller="ui-actions"
                            data-action="ui-actions#copyToClipboard"
                            data-ui-actions-text-param="{{ _snippet }}">{{ 'mcp.tokens.copy'|trans({}, 'mcp') }}</button>
                </div>
                <p class="small text-muted-color mb-1">{{ ('mcp.tokens.snippet_help.' ~ _key)|trans({}, 'mcp') }}</p>
                <pre class="small mb-3">{{ _snippet }}</pre>
            {% endfor %}
            <p class="small mb-0">{{ 'mcp.tokens.safety'|trans({}, 'mcp') }}</p>
        </div>
    </section>

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        list_title: 'api_token.title'|trans({}, 'api_token'),
        empty: { mood: 'sleeping', title: 'api_token.empty'|trans({}, 'api_token') },
    } %}
        {% block list_table %}
            <table class="fa-table fa-table--hover">
                <thead class="fa-table__head">
                    <tr>
                        <th class="fa-table__th" scope="col">{{ 'api_token.field.label'|trans({}, 'api_token') }}</th>
                        <th class="fa-table__th" scope="col">{{ 'api_token.field.created'|trans({}, 'api_token') }}</th>
                        <th class="fa-table__th" scope="col">{{ 'api_token.field.expires'|trans({}, 'api_token') }}</th>
                        <th class="fa-table__th" scope="col">{{ 'api_token.field.last_used'|trans({}, 'api_token') }}</th>
                        <th class="fa-table__th" scope="col">{{ 'api_token.field.status'|trans({}, 'api_token') }}</th>
                        <th scope="col" class="fa-table__th fa-table__th--actions">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                </thead>
                <tbody class="fa-table__body">
                    {% for token in page %}
                        <tr class="fa-table__row">
                            <td class="fa-table__cell">{{ token.label }}</td>
                            <td class="fa-table__cell">{{ token.createdAt|fa_date }}</td>
                            <td class="fa-table__cell">{{ token.expiresAt|fa_date }}</td>
                            <td class="fa-table__cell">{{ token.lastUsedAt|fa_datetime }}</td>
                            <td class="fa-table__cell">
                                {% if token.revoked %}
                                    <span class="fa-status-pill fa-status-pill--neutral">{{ 'api_token.status.revoked'|trans({}, 'api_token') }}</span>
                                {% else %}
                                    <span class="fa-status-pill fa-status-pill--success">{{ 'api_token.status.active'|trans({}, 'api_token') }}</span>
                                {% endif %}
                            </td>
                            <td class="fa-table__cell fa-table__cell--actions">
                                {% if not token.revoked %}
                                <form method="post" action="{{ path('app_api_tokens_revoke', {id: token.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('api_token_revoke') }}">
                                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger fa-cyber-btn--sm">{{ 'api_token.action.revoke'|trans({}, 'api_token') }}</button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
