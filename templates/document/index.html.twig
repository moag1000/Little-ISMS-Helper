{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'document' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'document.title'|trans({}, 'document') }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {# Breadcrumb Navigation #}
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'common.dashboard'|trans({}, 'messages'), url: path('app_dashboard') },
            { label: 'document.title'|trans({}, 'document') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'document.title'|trans({}, 'document'),
        subtitle: 'document.subtitle'|trans({}, 'document'),
        actions: [
            { label: 'document.action.policy_wizard'|trans({}, 'document'), variant: 'success', icon: 'nav-magic', href: path('app_policy_wizard_index') },
            { label: 'document.action.upload'|trans({}, 'document'), variant: 'primary', icon: 'ui-upload', href: path('app_document_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }
        ]|merge(is_granted('ROLE_MANAGER') ? [{ label: 'filtered_export.button.label'|trans({}, 'filtered_export'), href: path('app_filtered_export_entity', { entityType: 'document', format: 'xlsx' }) ~ (app.request.queryString ? '?' ~ app.request.queryString : ''), variant: 'ghost', icon: 'nav-file-earmark-spreadsheet' }] : [])
        |merge(is_granted('ROLE_ADMIN') ? [{ label: 'document.action.policy_pack_export'|trans({}, 'document'), href: path('admin_policy_pack_export'), variant: 'ghost', icon: 'nav-download', attrs: {'data-turbo': 'false'} }] : [])
    }) }}
    {% if is_granted('POLICY_WIZARD_EXPORT') %}
        <form method="post" action="{{ path('app_policy_export_tenant_zip_dispatch') }}" class="d-flex justify-content-end mb-3"
              data-turbo="false"
              data-controller="ui-actions"
              data-action="submit->ui-actions#confirm"
              data-ui-actions-message-param="{{ 'policy_wizard.export.zip.confirm'|trans({}, 'policy_wizard') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('policy_export_tenant_zip_dispatch') }}">
            <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                <i class="fa-icon fa-icon--nav-download" aria-hidden="true"></i>
                {{ 'document.action.policy_zip_export'|trans({}, 'document') }}
            </button>
        </form>
    {% endif %}
    {% include '_components/_focus_filter_notice.html.twig' with { focus: focus|default(null), count: page.total } %}
{% set _global_hints = alva_hints('document_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {# Alva-Tipp: Policy-Wizard generates ISO 27001 / DORA / BSI / BCM / GDPR mandatory policies — Aurora alert migration #}
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mb-3' } } %}
        {% block alert_body %}
            <div class="d-flex align-items-start gap-3">
                <i class="fa-icon fa-icon--nav-magic flex-shrink-0" aria-hidden="true"></i>
                <div class="flex-grow-1">
                    <strong>{{ 'document.alva_tipp.policy_wizard.title'|trans({}, 'document') }}</strong>
                    <p class="mb-2 mt-1">{{ 'document.alva_tipp.policy_wizard.body'|trans({}, 'document') }}</p>
                    <a href="{{ path('app_policy_wizard_index') }}" class="fa-cyber-btn fa-cyber-btn--success fa-cyber-btn--sm">
                        <i class="fa-icon fa-icon--nav-magic me-1" aria-hidden="true"></i>
                        {{ 'document.alva_tipp.policy_wizard.cta'|trans({}, 'document') }}
                    </a>
                </div>
            </div>
        {% endblock %}
    {% endembed %}


    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_document_index'),
        filter_keys: ['view', 'status', 'category', 'include_history', 'focus', 'review_overdue'],
        list_title: 'document.section.all_documents'|trans({}, 'document'),
        empty: {
            mood: 'sleeping',
            title: 'document.message.no_documents'|trans({}, 'document'),
            text: 'document.message.upload_first'|trans({}, 'document'),
            actions: [{ label: 'document.action.upload'|trans({}, 'document'), variant: 'primary', icon: 'ui-upload', href: path('app_document_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }],
        },
        card_attrs: 'data-controller="bulk-actions" data-bulk-actions-endpoint-value="/' ~ app.request.locale ~ '/document"',
    } %}
        {% block list_filters %}
            {% if app.request.query.get('review_overdue') == '1' %}<input type="hidden" name="review_overdue" value="1">{% endif %}
            {% if currentTenant %}
            <div class="col-md-3">
                <label for="view-filter" class="form-label">{{ 'common.view'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="view-filter" name="view" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="own" {{ inheritanceInfo.currentView == 'own' ? 'selected' : '' }}>{{ 'corporate.view.own_only'|trans({}, 'messages') }}</option>
                    {% if inheritanceInfo.hasParent %}
                    <option value="inherited" {{ inheritanceInfo.currentView == 'inherited' ? 'selected' : '' }}>{{ 'corporate.view.including_inherited'|trans({}, 'messages') }}</option>
                    {% endif %}
                    {% if inheritanceInfo.hasSubsidiaries %}
                    <option value="subsidiaries" {{ inheritanceInfo.currentView == 'subsidiaries' ? 'selected' : '' }}>{{ 'corporate.view.including_subsidiaries'|trans({}, 'messages') }}</option>
                    {% endif %}
                </select>
            </div>
            {% endif %}
            <div class="col-md-3">
                <label for="status-filter" class="form-label">{{ 'common.status'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="status-filter" name="status" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                    {% for _st in ['draft', 'in_review', 'approved', 'published', 'archived'] %}
                        <option value="{{ _st }}" {{ currentStatus == _st ? 'selected' : '' }}>{{ ('document.status.' ~ _st)|trans({}, 'document') }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="category-filter" class="form-label">{{ 'common.category'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="category-filter" name="category" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="">{{ 'document.filter.all_categories'|trans({}, 'document') }}</option>
                    {% for _cat in categories %}
                        <option value="{{ _cat }}" {{ currentCategory == _cat ? 'selected' : '' }}>{{ _cat|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="include-history-toggle" class="form-label">{{ 'policy_wizard.history_toggle.label'|trans({}, 'policy_wizard') }}</label>
                <select class="form-select fa-cyber-input__field" id="include-history-toggle" name="include_history" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="0" {{ includeHistory ? '' : 'selected' }}>{{ 'policy_wizard.history_toggle.current_only'|trans({}, 'policy_wizard') }}</option>
                    <option value="1" {{ includeHistory ? 'selected' : '' }}>{{ 'policy_wizard.history_toggle.with_history'|trans({}, 'policy_wizard') }}</option>
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if kpiDrafts > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'document.summary.drafts'|trans({'%count%': kpiDrafts}, 'document') }}</span>{% endif %}
            {% if kpiInReview > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'document.summary.in_review'|trans({'%count%': kpiInReview}, 'document') }}</span>{% endif %}
            {% include '_components/_review_due_chip.html.twig' with { type: 'document' } only %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_fa_table.html.twig' with {
            'stickyHead': true,
            'hover': true,
            'id': 'documentTable'
        } %}
            {% block table_head %}
                {% import '_macros/inheritance_badge.html.twig' as inheritance %}
                {% import '_components/_status_pill.html.twig' as pill %}
                <tr>
                    <th scope="col" class="fa-table__th fa-table__th--checkbox bulk-select-column">
                        <input type="checkbox"
                               data-action="bulk-actions#selectAll"
                               data-bulk-actions-target="selectAllCheckbox"
                               aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                    </th>
                    <th scope="col" class="fa-table__th w-50px"><span class="visually-hidden">{{ 'document.table.icon'|trans({}, 'document') }}</span></th>
                    <th scope="col" class="fa-table__th">{{ 'common.name'|trans({}, 'messages') }}</th>
                    <th scope="col" class="fa-table__th w-130px">{{ 'common.status'|trans({}, 'messages') }}</th>
                    <th scope="col" class="fa-table__th w-150px">{{ 'common.category'|trans({}, 'messages') }}</th>
                    <th scope="col" class="fa-table__th w-100px">{{ 'common.size'|trans({}, 'messages') }}</th>
                    <th scope="col" class="fa-table__th w-150px">{{ 'document.table.uploaded_by'|trans({}, 'document') }}</th>
                    <th scope="col" class="fa-table__th w-130px">{{ 'common.date'|trans({}, 'messages') }}</th>
                    <th scope="col" class="fa-table__th w-180px text-right">{{ 'common.actions'|trans({}, 'messages') }}</th>
                </tr>
            {% endblock %}
            {% block table_body_attrs %}id="documentTableBody"{% endblock %}
            {% block table_body %}
                {% set workflowStates = workflow_states(page) %}
                {% for document in page %}
                    {% include 'document/_row.html.twig' with {
                        document: document,
                        currentTenant: currentTenant,
                        driftMap: driftMap|default({}),
                        supersededIds: supersededIds|default({}),
                        auditorScores: auditorScores|default({})
                    } %}
                {% endfor %}
            {% endblock %}
        {% endembed %}
            {% include '_components/_bulk_action_bar.html.twig' with {
                actions: ['status_change', 'approve', 'review', 'export', 'delete'],
                variant: 'brand'
            } %}
        {% endblock %}
    {% endembed %}

    {% if page.isEmpty and app.request.query.count == 0 %}
        {% set _system_templates = system_templates('App\\Entity\\Document') %}
        {# ISO 27001 policy starter set #}
        {% if _system_templates|length > 0 %}
            <div class="text-center mt-3">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--secondary"
                        data-controller="fa-modal-dispatcher"
                        data-action="click->fa-modal-dispatcher#open"
                        data-fa-modal-id="systemTemplateModalDocument">
                    {{ 'system_templates.cta.button'|trans({}, 'system_templates') }}
                </button>
                <div class="form-text small">
                    {{ 'system_templates.cta.hint'|trans({}, 'system_templates') }}
                </div>
            </div>
            {% include '_components/_system_template_selector.html.twig' with {
                templates: _system_templates,
                entity_class: 'App\\Entity\\Document',
                redirect_to: 'app_document_index',
                modal_id: 'systemTemplateModalDocument'
            } %}
        {% endif %}
    {% endif %}
</div>

{% endblock %}
