{% extends 'base.html.twig' %}
{% trans_default_domain 'notification' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'notification.center.title'|trans({}, 'notification') }}{% endblock %}

{% block body %}
    <div class="container py-4">
        {{ _fa_page_header.render({
            title: 'notification.center.title'|trans({}, 'notification'),
            subtitle: 'notification.center.subtitle'|trans({}, 'notification'),
            actions: [
                {
                    label: 'notification.bell.mark_all_read'|trans({}, 'notification'),
                    variant: 'ghost',
                    icon: 'ui-checks',
                    href: '#',
                    attrs: {
                        'data-controller': 'ui-actions',
                        'data-action': 'ui-actions#submitForm',
                        'data-ui-actions-form-id-param': 'mark-read-form'
                    }
                }
            ]
        }) }}

        <form id="mark-read-form" method="post" action="{{ path('app_notification_mark_read') }}" class="d-none">
            <input type="hidden" name="_token" value="{{ csrf_token('notification_mark_read') }}">
        </form>

        {# The user's own reminders: daily digests and urgent statutory deadlines. #}
        {% if notices is not empty %}
            <section class="fa-section mb-4" aria-labelledby="my-reminders-title">
                <h2 id="my-reminders-title" class="h5 mb-2">{{ 'notification.center.my_reminders'|trans({}, 'notification') }}</h2>
                <ul class="list-group">
                    {% for notice in notices %}
                        {% set isUnread = lastSeen is null or notice.createdAt > lastSeen %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <span>
                                {% if isUnread %}<span class="fa-status-pill fa-status-pill--primary me-2">{{ 'notification.center.badge.new'|trans({}, 'notification') }}</span>{% endif %}
                                {% if notice.kind == 'urgent' %}<span class="fa-status-pill fa-status-pill--danger me-2">{{ 'notification.center.kind.urgent'|trans({}, 'notification') }}</span>{% endif %}
                                {% if notice.link %}<a href="{{ notice.link }}" class="fw-semibold">{{ notice.title }}</a>{% else %}<span class="fw-semibold">{{ notice.title }}</span>{% endif %}
                            </span>
                            <small class="text-muted text-nowrap">{{ notice.createdAt|fa_datetime }}</small>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% embed '_components/_fa_list_page.html.twig' with {
            page: page,
            search_action: path('app_notification_center'),
            filter_keys: ['severity'],
            list_title: 'notification.center.rule_notifications'|trans({}, 'notification'),
            empty: {
                mood: 'happy',
                title: 'notification.center.empty.title'|trans({}, 'notification'),
            },
        } %}
            {% block list_filters %}
                <div class="col-md-3">
                    <label for="notification-severity" class="form-label">{{ 'notification.center.col.severity'|trans({}, 'notification') }}</label>
                    <select class="form-select fa-cyber-input__field" id="notification-severity" name="severity" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                        <option value="">{{ 'notification.severity.all'|trans({}, 'notification') }}</option>
                        {% for sev in ['critical', 'high', 'medium', 'low'] %}
                            <option value="{{ sev }}"{{ app.request.query.get('severity') == sev ? ' selected' : '' }}>{{ ('notification.severity.' ~ sev)|trans({}, 'notification') }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endblock %}
            {% block list_summary %}
                {% if critical_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'notification.summary.critical'|trans({'%count%': critical_count}, 'notification') }}</span>{% endif %}
                {% if high_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'notification.summary.high'|trans({'%count%': high_count}, 'notification') }}</span>{% endif %}
            {% endblock %}
            {% block list_table %}
                {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                    {% block table_head %}
                        <tr>
                            <th scope="col">{{ 'notification.center.col.rule'|trans({}, 'notification') }}</th>
                            <th scope="col">{{ 'notification.center.col.event'|trans({}, 'notification') }}</th>
                            <th scope="col">{{ 'notification.center.col.severity'|trans({}, 'notification') }}</th>
                            <th scope="col">{{ 'notification.center.col.time'|trans({}, 'notification') }}</th>
                        </tr>
                    {% endblock %}
                    {% block table_body %}
                        {% for delivery in page %}
                            {% set payload = delivery.responsePayload ?? {} %}
                            {% set isUnread = lastSeen is null or (delivery.attemptedAt is not null and delivery.attemptedAt > lastSeen) %}
                            {% set sev = payload.severity ?? '' %}
                            <tr>
                                <td>
                                    {% if isUnread %}
                                        <span class="fa-status-pill fa-status-pill--primary me-2">{{ 'notification.center.badge.new'|trans({}, 'notification') }}</span>
                                    {% endif %}
                                    <span class="fw-semibold">{{ payload.rule_name ?? delivery.rule.name ?? '—' }}</span>
                                </td>
                                <td class="text-muted">{{ payload.event_type ?? '—' }}</td>
                                <td>
                                    {% if sev in ['critical', 'high', 'medium', 'low'] %}
                                        {% include '_components/_badge.html.twig' with {
                                            variant: sev == 'critical' ? 'danger' : (sev == 'high' ? 'warning' : (sev == 'medium' ? 'info' : 'secondary')),
                                            content: ('notification.severity.' ~ sev)|trans({}, 'notification')
                                        } %}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted small">{{ delivery.attemptedAt|fa_datetime }}</td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endblock %}
        {% endembed %}
    </div>
{% endblock body %}
