{% extends 'admin/layout.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}

{% block title %}Benutzer: {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.admin'|trans({}, 'nav'), url: path('admin_dashboard') },
            { label: 'nav.users'|trans({}, 'nav'), url: path('user_management_index') },
            { label: user.firstName ~ ' ' ~ user.lastName }
        ]
    } %}

    {{ _fa_page_header.render({
        title: user.firstName ~ ' ' ~ user.lastName,
        subtitle: user.email,
        actions: [
            { label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit', href: path('user_management_edit', {'id': user.id}) },
            { label: 'common.back'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('user_management_index') }
        ]
    }) }}

    {% set _status %}{% if user.isActive %}{% include '_components/_badge.html.twig' with { variant: 'success', icon: 'status-ok', content: 'user.status.active'|trans({}, 'user') } %}{% else %}{% include '_components/_badge.html.twig' with { variant: 'danger', icon: 'status-critical', content: 'user.status.inactive'|trans({}, 'user') } %}{% endif %}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        facts: [
            { label: 'user.label.department'|trans({}, 'user'), value: user.department },
            { label: 'user.label.last_login'|trans({}, 'user'), value: user.lastLoginAt ? user.lastLoginAt|fa_datetime : null },
            { label: 'show.status.created'|trans({}, 'messages'), value: user.createdAt ? user.createdAt|fa_date : null },
        ],
        workflow: workflow_state(user),
    }) }}

    {{ _fa_anchor_bar.render([
        { id: 'basic', label: 'user.section.basic_info'|trans({}, 'user') },
        { id: 'security', label: 'user.section.security_status'|trans({}, 'user') },
        { id: 'roles', label: 'user.section.system_roles'|trans({}, 'user') },
        { id: 'permissions', label: 'user.section.all_permissions'|trans({}, 'user') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: user } only %}

    {# Avatar block kept below header as it is a visual identity element, not part of standard page-header pattern #}
    <div class="d-flex align-items-center mb-4">
        {% if user.profilePicture %}
            <img src="{{ asset(user.profilePicture) }}"
                 alt="{{ user.firstName }} {{ user.lastName }}"
                 class="rounded-circle me-3 profile-avatar profile-avatar-lg">
        {% else %}
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 profile-avatar profile-avatar-lg">
                {{ user.firstName|slice(0, 1)|upper }}{{ user.lastName|slice(0, 1)|upper }}
            </div>
        {% endif %}
    </div>

    <div class="row">
        {# Basic Information #}
        <div class="col-md-6 fa-show-section" id="basic">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0"><i class="fa-icon fa-icon--ui-info" aria-hidden="true"></i> {{ 'user.section.basic_info'|trans({}, 'user') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% embed '_components/_table.html.twig' with {
                        'class': 'table-sm',
                        'noMargin': true
                    } %}
                        {% block table_body %}
                            <tr>
                                <th scope="row" width="40%">{{ 'user.label.profile_picture'|trans({}, 'user') }}</th>
                                <td>
                                    {% if user.profilePicture %}
                                        <img src="{{ asset(user.profilePicture) }}"
                                             alt="{{ user.firstName }} {{ user.lastName }}"
                                             class="rounded-circle profile-avatar profile-avatar-md">
                                    {% else %}
                                        <span class="text-muted">{{ 'user.label.no_profile_picture'|trans({}, 'user') }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row" width="40%">{{ 'user.label.first_name'|trans({}, 'user') }}</th>
                                <td>{{ user.firstName }}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.last_name'|trans({}, 'user') }}</th>
                                <td>{{ user.lastName }}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.email'|trans({}, 'user') }}</th>
                                <td>{{ user.email }}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.department'|trans({}, 'user') }}</th>
                                <td>{{ user.department ?? '—' }}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.position'|trans({}, 'user') }}</th>
                                <td>{{ user.jobTitle ?? '—' }}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.phone'|trans({}, 'user') }}</th>
                                <td>{{ user.phoneNumber ?? '—' }}</td>
                            </tr>
                        {% endblock %}
                    {% endembed %}
                {% endblock %}
            {% endembed %}
        </div>

        {# Security & Status #}
        <div class="col-md-6 fa-show-section" id="security">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0"><i class="fa-icon fa-icon--compliance-shield" aria-hidden="true"></i> {{ 'user.section.security_status'|trans({}, 'user') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% embed '_components/_table.html.twig' with {
                        'class': 'table-sm',
                        'noMargin': true
                    } %}
                        {% block table_body %}
                            <tr>
                                <th scope="row" width="40%">{{ 'user.label.status'|trans({}, 'user') }}</th>
                                <td>
                                    {% if user.isActive %}
                                        {% include '_components/_badge.html.twig' with { variant: 'success', icon: 'status-ok', content: 'user.status.active'|trans({}, 'user') } %}
                                    {% else %}
                                        {% include '_components/_badge.html.twig' with { variant: 'danger', icon: 'status-critical', content: 'user.status.inactive'|trans({}, 'user') } %}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.verified'|trans({}, 'user') }}</th>
                                <td>
                                    {% if user.isVerified %}
                                        {% include '_components/_badge.html.twig' with { variant: 'success', icon: 'status-ok', content: 'user.label.yes'|trans({}, 'user') } %}
                                    {% else %}
                                        {% include '_components/_badge.html.twig' with { variant: 'warning', icon: 'status-warning', content: 'user.label.no'|trans({}, 'user') } %}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.auth_provider'|trans({}, 'user') }}</th>
                                <td>
                                    {% if user.authProvider == 'azure_oauth' %}
                                        <i class="fa-icon fa-icon--asset-application" aria-hidden="true"></i> {{ 'user.auth.azure_oauth'|trans({}, 'user') }}
                                    {% elseif user.authProvider == 'azure_saml' %}
                                        <i class="fa-icon fa-icon--asset-application" aria-hidden="true"></i> {{ 'user.auth.azure_saml'|trans({}, 'user') }}
                                    {% elseif user.authProvider starts with 'sso:' %}
                                        <i class="fa-icon fa-icon--asset-application" aria-hidden="true"></i> {{ 'user.auth.sso'|trans({'%provider%': user.ssoProvider ? user.ssoProvider.name : user.authProvider|slice(4)}, 'user') }}
                                    {% else %}
                                        <i class="fa-icon fa-icon--ui-person" aria-hidden="true"></i> {{ 'user.auth.local'|trans({}, 'user') }}
                                    {% endif %}
                                </td>
                            </tr>
                            {% if user.azureObjectId %}
                                <tr>
                                    <th scope="row">{{ 'user.label.azure_object_id'|trans({}, 'user') }}</th>
                                    <td><code>{{ user.azureObjectId }}</code></td>
                                </tr>
                            {% endif %}
                            <tr>
                                <th scope="row">{{ 'user.label.created_at'|trans({}, 'user') }}</th>
                                <td>{{ user.createdAt|fa_datetime }}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{ 'user.label.last_login'|trans({}, 'user') }}</th>
                                <td>
                                    {% if user.lastLoginAt %}
                                        {{ user.lastLoginAt|fa_datetime }}
                                    {% else %}
                                        <span class="text-muted">{{ 'user.status.never'|trans({}, 'user') }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endblock %}
                    {% endembed %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# SSO binding — set or removed by hand (SsoAccountLinker) #}
    {% set _sso_may_link = sso_link_allowed(user) %}
    {% if user.ssoProvider or _sso_may_link %}
    <section class="fa-section mb-4" id="sso-link">
        <div class="fa-section__header">
            <h2 class="fa-section__title">{{ 'user.sso_link.title'|trans({}, 'user') }}</h2>
        </div>
        <div class="fa-section__body">
            {% if user.ssoProvider %}
                <dl class="row mb-3">
                    <dt class="col-sm-3">{{ 'user.sso_link.provider'|trans({}, 'user') }}</dt>
                    <dd class="col-sm-9">{{ user.ssoProvider.name }}{% if user.ssoProvider.tenant is null %} <span class="text-muted">({{ 'user.sso_link.global'|trans({}, 'user') }})</span>{% endif %}</dd>
                    <dt class="col-sm-3">{{ 'user.sso_link.subject'|trans({}, 'user') }}</dt>
                    <dd class="col-sm-9"><code>{{ user.ssoExternalId }}</code></dd>
                </dl>
                {% if _sso_may_link %}
                    <form method="post" action="{{ path('user_management_sso_unlink', {id: user.id}) }}" class="mb-3"
                          data-controller="ui-actions"
                          data-action="submit->ui-actions#confirm"
                          data-ui-actions-message-param="{{ 'user.sso_link.unlink_confirm'|trans({}, 'user') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('user_sso_unlink_' ~ user.id) }}">
                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">{{ 'user.sso_link.unlink'|trans({}, 'user') }}</button>
                    </form>
                {% endif %}
            {% else %}
                <p class="text-muted">{{ 'user.sso_link.none'|trans({}, 'user') }}</p>
            {% endif %}

            {% if _sso_may_link %}
                {% set _sso_providers = sso_linkable_providers(user) %}
                {% if _sso_providers is empty %}
                    <p class="text-muted mb-0">{{ 'user.sso_link.no_provider'|trans({}, 'user') }}</p>
                {% else %}
                    <form method="post" action="{{ path('user_management_sso_link', {id: user.id}) }}" class="row g-2 align-items-end"
                          data-controller="ui-actions" data-action="submit->ui-actions#submitOnce">
                        <input type="hidden" name="_token" value="{{ csrf_token('user_sso_link_' ~ user.id) }}">
                        <div class="col-md-4">
                            <label class="form-label" for="sso-link-provider">{{ 'user.sso_link.provider'|trans({}, 'user') }}</label>
                            <select class="form-select" id="sso-link-provider" name="provider" required>
                                {% for provider in _sso_providers %}
                                    <option value="{{ provider.id }}"{% if user.ssoProvider and user.ssoProvider.id == provider.id %} selected{% endif %}>{{ provider.name }}{% if provider.tenant is null %} ({{ 'user.sso_link.global'|trans({}, 'user') }}){% endif %}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="sso-link-subject">{{ 'user.sso_link.subject'|trans({}, 'user') }}</label>
                            <input type="text" class="form-control" id="sso-link-subject" name="subject" required maxlength="255"
                                   value="{{ user.ssoExternalId }}" autocomplete="off" aria-describedby="sso-link-subject-help">
                            <div class="form-text" id="sso-link-subject-help">{{ 'user.sso_link.subject_help'|trans({}, 'user') }}</div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">{{ (user.ssoProvider ? 'user.sso_link.relink' : 'user.sso_link.link')|trans({}, 'user') }}</button>
                        </div>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </section>
    {% endif %}

    {# Roles & Permissions #}
    <div class="row">
        <div class="col-md-6 fa-show-section" id="roles">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0"><i class="fa-icon fa-icon--control text-warning" aria-hidden="true"></i> {{ 'user.section.system_roles'|trans({}, 'user') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% if user.roles|length > 0 %}
                        <ul class="list-group">
                            {% for role in user.roles %}
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>
                                            <i class="fa-icon fa-icon--control fa-icon--warning" aria-hidden="true"></i>
                                            {{ role }}
                                        </span>
                                        {% if role == 'ROLE_SUPER_ADMIN' %}
                                            {% include '_components/_badge.html.twig' with { variant: 'danger', content: 'Super Admin' } %}
                                        {% elseif role == 'ROLE_ADMIN' %}
                                            {% include '_components/_badge.html.twig' with { variant: 'warning', content: 'Admin' } %}
                                        {% elseif role == 'ROLE_MANAGER' %}
                                            {% include '_components/_badge.html.twig' with { variant: 'info', content: 'Manager' } %}
                                        {% elseif role == 'ROLE_AUDITOR' %}
                                            {% include '_components/_badge.html.twig' with { variant: 'primary', content: 'Auditor' } %}
                                        {% else %}
                                            {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'User' } %}
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mb-0' } } %}
                            {% block alert_body %}{{ 'user.message.no_system_roles'|trans({}, 'user') }}{% endblock %}
                        {% endembed %}
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-md-6">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0"><i class="fa-icon fa-icon--nav-key" aria-hidden="true"></i> {{ 'user.section.custom_roles'|trans({}, 'user') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% if user.customRoles|length > 0 %}
                        <ul class="list-group">
                            {% for customRole in user.customRoles %}
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>{{ customRole.name }}</strong>
                                            {% if customRole.description %}
                                                <br>
                                                <small class="text-muted">{{ customRole.description }}</small>
                                            {% endif %}
                                        </div>
                                        {% include '_components/_badge.html.twig' with { variant: 'info', content: 'user.label.permissions_count'|trans({'%count%': customRole.permissions|length}, 'user') } %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mb-0' } } %}
                            {% block alert_body %}{{ 'user.message.no_custom_roles_assigned'|trans({}, 'user') }}{% endblock %}
                        {% endembed %}
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# All Permissions #}
    <div class="row">
        <div class="col-md-12 fa-show-section" id="permissions">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0"><i class="fa-icon fa-icon--ui-unlock" aria-hidden="true"></i> {{ 'user.section.all_permissions'|trans({}, 'user') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% set allPermissions = [] %}
                    {% for customRole in user.customRoles %}
                        {% for permission in customRole.permissions %}
                            {% set allPermissions = allPermissions|merge([permission]) %}
                        {% endfor %}
                    {% endfor %}

                    {% if allPermissions|length > 0 %}
                        <div class="row">
                            {% for permission in allPermissions %}
                                <div class="col-md-3 mb-2">
                                    {% include '_components/_badge.html.twig' with { variant: 'secondary', icon: 'check', class: 'w-100', content: permission.name } %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mb-0' } } %}
                            {% block alert_body %}{{ 'user.message.no_specific_permissions'|trans({}, 'user') }}{% endblock %}
                        {% endembed %}
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# Actions #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header">
                <h2 class="mb-0"><i class="fa-icon fa-icon--ui-settings" aria-hidden="true"></i> {{ 'user.section.actions'|trans({}, 'user') }}</h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="btn-group" role="group">
                <a href="{{ path('user_management_edit', {'id': user.id}) }}" class="fa-cyber-btn fa-cyber-btn--primary">
                    <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i> {{ 'common.edit'|trans({}, 'messages') }}
                </a>
                <a href="{{ path('user_management_activity', {'id': user.id}) }}" class="fa-cyber-btn fa-cyber-btn--ghost">
                    <i class="fa-icon fa-icon--nav-list-check" aria-hidden="true"></i> {{ 'user.activity.title'|trans({}, 'user') }}
                </a>
                {% if user.id != app.user.id %}
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <form method="post" action="{{ path('user_management_impersonate', {'id': user.id}) }}" class="d-inline"
                              data-controller="ui-actions"
                              data-action="submit->ui-actions#confirm"
                              data-ui-actions-message-param="{{ 'user.modal.impersonate_confirm'|trans({'%name%': user.firstName ~ ' ' ~ user.lastName}, 'user') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('impersonate_' ~ user.id) }}">
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost">
                                <i class="fa-icon fa-icon--nav-people" aria-hidden="true"></i> {{ 'user.action.impersonate'|trans({}, 'user') }}
                            </button>
                        </form>
                    {% endif %}
                    {% if user.isActive %}
                        <form method="post" action="{{ path('user_management_toggle_active', {'id': user.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-active' ~ user.id) }}">
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--warning">
                                <i class="fa-icon fa-icon--status-pending" aria-hidden="true"></i> {{ 'user.action.deactivate'|trans({}, 'user') }}
                            </button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('user_management_toggle_active', {'id': user.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-active' ~ user.id) }}">
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--success">
                                <i class="fa-icon fa-icon--status-info" aria-hidden="true"></i> {{ 'common.activate'|trans({}, 'messages') }}
                            </button>
                        </form>
                    {% endif %}
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--danger" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="deleteModal">
                        <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}
                    </button>
                {% endif %}
            </div>
        {% endblock %}
    {% endembed %}

    {% include '_components/_fa_show_history.html.twig' with { entity: user } only %}
</div>

{# Delete Confirmation Modal #}
{% if user.id != app.user.id %}
<div class="fa-modal fa-modal--confirm fa-modal--danger" id="deleteModal"
     data-controller="fa-modal" data-fa-modal-mode-value="confirm" data-fa-modal-tone-value="danger"
     role="alertdialog" aria-modal="true" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="fa-modal__backdrop" data-fa-modal-target="backdrop" data-action="click->fa-modal#backdropClick" aria-hidden="true"></div>
    <div class="fa-modal__container" data-fa-modal-target="dialog"><header class="fa-modal__header"><span class="fa-modal__icon" aria-hidden="true"><i class="fa-icon fa-icon--ui-trash"></i></span><div class="fa-modal__heading"><h2  id="deleteModalLabel" class="fa-modal__title">{{ 'user.modal.delete_user'|trans({}, 'user') }}</h2></div><button type="button" class="fa-modal__close" data-action="fa-modal#cancel" aria-label="Close"><i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i></button></header>
            <div class="fa-modal__body">
                {{ 'user.modal.delete_confirm'|trans({'%name%': (user.firstName ~ ' ' ~ user.lastName)|e}, 'user')|raw }}
                <br><br>
                <strong>{{ 'user.modal.delete_warning'|trans({}, 'user') }}</strong>
            </div>
            <footer class="fa-modal__footer">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost" data-action="fa-modal#cancel">{{ 'common.cancel'|trans({}, 'messages') }}</button>
                <form method="post" action="{{ path('user_management_delete', {'id': user.id}) }}" class="d-inline" data-fa-modal-target="form">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger"><i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}</button>
                </form></div>
</div>
</div>
{% endif %}
{% endblock admin_content %}
