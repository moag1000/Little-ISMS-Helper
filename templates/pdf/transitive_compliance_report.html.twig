{# ─────────────────────────────────────────────────────────────────────────
   Transitive Compliance Report PDF — fa-report-doc 5-slot macro
   Audience: auditor (Analysis Report)
   Status:   final
   ─────────────────────────────────────────────────────────────────────── #}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ 'compliance.export_pdf.transitive.title'|trans({}, 'compliance') }}</title>
    <style>
        :root{--surface:#ffffff;--surface-2:#f6f6fa;--border:#dfe3f0;--border-strong:#b9bfd6;--fg-1:#0e0a1f;--fg-2:#4c4a73;--fg-3:#6d6b92;--primary:#0284c7;--primary-strong:#0369a1;--primary-tint:rgba(2,132,199,.10);--accent-tint:rgba(124,58,237,.10);--accent-strong:#6d28d9;--success:#059669;--success-strong:#047857;--success-tint:rgba(5,150,105,.10);--success-glow:rgba(5,150,105,.20);--warning:#d97706;--warning-strong:#b45309;--warning-glow:rgba(217,119,6,.20);--danger:#dc2626;--danger-strong:#b91c1c;--danger-glow:rgba(220,38,38,.20);}
        @page{size:A4 portrait;margin:14mm 12mm 18mm 12mm;}
        body{background:#fff;font-family:'DejaVu Sans',sans-serif;margin:0;padding:0;}
        .report-doc{background:var(--surface);color:var(--fg-1);font-size:10pt;line-height:1.45;max-width:none;margin:0;border:0;border-radius:0;}
        .report-doc__cover{padding:18pt 14pt 12pt;border-bottom:1px solid var(--border);}
        .report-doc__cover-top{display:table;width:100%;}
        .report-doc__brand{display:table-cell;vertical-align:middle;}
        .report-doc__chips{display:table-cell;text-align:right;vertical-align:middle;}
        .report-doc__logo{display:inline-block;width:32pt;height:32pt;border-radius:6pt;background:var(--primary);color:#fff;text-align:center;line-height:32pt;font-weight:700;font-size:18pt;vertical-align:middle;margin-right:8pt;}
        .report-doc__brand-name{font-weight:700;font-size:11pt;color:var(--fg-1);display:inline-block;vertical-align:middle;}
        .report-doc__brand-meta{font-size:8pt;color:var(--fg-3);}
        .report-doc__chip{display:inline-block;padding:2pt 7pt;border-radius:8pt;background:var(--surface-2);color:var(--fg-2);font-size:7pt;font-weight:700;text-transform:uppercase;letter-spacing:.06em;border:1px solid var(--border);margin-left:4pt;}
        .report-doc__chip--status-confidential{background:var(--danger-glow);color:var(--danger-strong);border-color:transparent;}
        .report-doc__chip--audience-vorstand{background:var(--primary-tint);color:var(--primary-strong);border-color:transparent;}
        .report-doc__chip--classification{background:var(--fg-1);color:#fff;border-color:transparent;}
        .report-doc__cover-center{padding:16pt 0 12pt;}
        .report-doc__kicker{font-size:8pt;color:var(--primary);font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 4pt;}
        .report-doc__title{font-size:22pt;font-weight:800;color:var(--fg-1);margin:0 0 6pt;line-height:1.05;}
        .report-doc__sub{font-size:10pt;color:var(--fg-2);margin:0;}
        .report-doc__cover-grid{border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:8pt 0;margin:0;}
        .report-doc__cover-grid>div{display:inline-block;width:31%;margin:0 1% 6pt 0;vertical-align:top;}
        .report-doc__cover-label{font-size:7pt;color:var(--fg-3);text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin:0 0 2pt;}
        .report-doc__cover-value{font-size:9pt;color:var(--fg-1);font-weight:600;margin:0;}
        .report-doc__exec-summary{padding:12pt 14pt;background:var(--surface-2);border-bottom:1px solid var(--border);}
        .report-doc__exec-heading{font-size:13pt;font-weight:800;margin:0 0 8pt;padding-bottom:4pt;border-bottom:2px solid var(--fg-1);}
        .report-doc__kpi-grid{display:table;width:100%;border-spacing:6pt;}
        .report-doc__kpi-tile{display:table-cell;padding:10pt;border:1px solid var(--border);border-radius:4pt;vertical-align:top;background:var(--surface);}
        .report-doc__kpi-tile--success{border-left:3pt solid var(--success);}
        .report-doc__kpi-tile--warning{border-left:3pt solid var(--warning);}
        .report-doc__kpi-tile--danger{border-left:3pt solid var(--danger);}
        .report-doc__kpi-tile--neutral{border-left:3pt solid var(--primary);}
        .report-doc__kpi-label{font-size:7pt;color:var(--fg-3);text-transform:uppercase;letter-spacing:.06em;font-weight:700;margin-bottom:4pt;}
        .report-doc__kpi-value{font-size:18pt;font-weight:800;color:var(--fg-1);margin-bottom:2pt;}
        .report-doc__kpi-trend{font-size:8pt;font-weight:600;}
        .report-doc__kpi-trend--up{color:var(--success-strong);}
        .report-doc__kpi-trend--down{color:var(--danger-strong);}
        .report-doc__tldr{background:var(--surface);border:1px solid var(--border);border-left:3pt solid var(--primary);padding:8pt 10pt;margin:0 0 12pt;}
        .report-doc__tldr-label{font-size:7pt;color:var(--primary-strong);font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin:0 0 6pt;}
        .report-doc__tldr-list{list-style:none;margin:0;padding:0;}
        .report-doc__tldr-item{font-size:9pt;color:var(--fg-1);padding:2pt 0;}
        .report-doc__tldr-item--ok{border-left:2pt solid var(--success);padding-left:6pt;}
        .report-doc__tldr-item--warn{border-left:2pt solid var(--warning);padding-left:6pt;}
        .report-doc__tldr-item--danger{border-left:2pt solid var(--danger);padding-left:6pt;}
        .report-doc__tldr-dot{display:none;}
        .report-doc__data-section{padding:12pt 14pt;border-bottom:1px solid var(--border);page-break-inside:avoid;}
        .report-doc__section-heading{font-size:12pt;font-weight:700;color:var(--fg-1);margin:0 0 8pt;padding-bottom:4pt;border-bottom:2px solid var(--fg-1);}
        .report-doc__section-body{font-size:9pt;color:var(--fg-1);margin:6pt 0;}
        .report-doc__table{width:100%;border-collapse:collapse;font-size:9pt;}
        .report-doc__table th{background:var(--surface-2);color:var(--fg-2);padding:5pt 6pt;border:.5pt solid var(--border-strong);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:7pt;text-align:left;}
        .report-doc__table td{padding:5pt 6pt;border:.5pt solid var(--border);color:var(--fg-1);vertical-align:top;}
        .report-doc__table tbody tr:nth-child(even) td{background:var(--surface-2);}
        .report-doc__table-wrap{margin:8pt 0;}
        .report-doc__appendix{padding:12pt 14pt;background:var(--surface-2);border-bottom:1px solid var(--border);}
        .report-doc__appendix-heading{font-size:12pt;font-weight:700;margin:0 0 8pt;padding-bottom:4pt;border-bottom:2px solid var(--fg-1);}
        .report-doc__appendix-subheading{font-size:9pt;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin:8pt 0 4pt;}
        .report-doc__appendix-body{font-size:8pt;color:var(--fg-2);}
        .report-doc__appendix-sources{padding-left:14pt;font-size:8pt;color:var(--fg-2);}
        .report-doc__footer-disclaimer{padding:12pt 14pt;background:var(--surface);border-top:1px solid var(--border-strong);}
        .report-doc__distribution-label{font-size:7pt;color:var(--fg-3);text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin:0 0 4pt;}
        .report-doc__distribution-list{list-style:none;padding:0;margin:0 0 8pt;font-size:9pt;color:var(--fg-2);}
        .report-doc__distribution-list li{display:inline-block;border-left:2pt solid var(--border);padding:0 8pt;}
        .report-doc__disclaimer-text{font-size:8pt;color:var(--fg-3);padding:8pt;background:var(--surface-2);border-radius:4pt;border:1px solid var(--border);margin:0 0 8pt;}
        .report-doc__footer-meta{font-size:7pt;color:var(--fg-3);}
        .report-doc__footer-brand{font-weight:700;color:var(--fg-2);}
        .report-doc__footer-classification{color:var(--danger-strong);font-weight:700;text-transform:uppercase;}
        .badge{display:inline-block;padding:2pt 5pt;border-radius:3pt;font-size:7pt;font-weight:700;}
        .badge-success{background:var(--success-tint);color:var(--success-strong);}
        .badge-warning{background:rgba(217,119,6,.12);color:var(--warning-strong);}
        .badge-danger{background:rgba(220,38,38,.12);color:var(--danger-strong);}
        .badge-info{background:var(--primary-tint);color:var(--primary-strong);}
    </style>
</head>
<body>
{% import '_components/_fa_report_doc.html.twig' as _fa_report_doc %}

{# ── Build sections array ─────────────────────────────────────────────── #}
{% set _sections = [] %}

{# ── Mapping Quality Distribution ─────────────────────────────────────── #}
{% if total_mappings > 0 %}
    {% set _cell_html10 %}<strong>{{ avg_mapping_quality }}%</strong> ({{ 'compliance.export_pdf.transitive.across'|trans({'%n%': total_mappings}, 'compliance') }}){% endset %}
    {% set _cell_html9 %}<strong>{{ 'compliance.export_pdf.common.avg_quality'|trans({}, 'compliance') }}</strong>{% endset %}
    {% set _cell_html8 %}<strong>{{ quality_distribution.weak }}</strong>{% endset %}
    {% set _cell_html7 %}<span class="badge badge-danger">{{ 'compliance.export_pdf.common.q_weak'|trans({}, 'compliance') }}</span>{% endset %}
    {% set _cell_html6 %}<strong>{{ quality_distribution.medium }}</strong>{% endset %}
    {% set _cell_html5 %}<span class="badge badge-warning">{{ 'compliance.export_pdf.common.q_medium'|trans({}, 'compliance') }}</span>{% endset %}
    {% set _cell_html4 %}<strong>{{ quality_distribution.good }}</strong>{% endset %}
    {% set _cell_html3 %}<span class="badge badge-info">{{ 'compliance.export_pdf.common.q_good'|trans({}, 'compliance') }}</span>{% endset %}
    {% set _cell_html2 %}<strong>{{ quality_distribution.excellent }}</strong>{% endset %}
    {% set _cell_html1 %}<span class="badge badge-success">{{ 'compliance.export_pdf.common.q_excellent'|trans({}, 'compliance') }}</span>{% endset %}
    {% set _mqd_rows = [
        [
            _cell_html1,
            '90-100%',
            _cell_html2,
            (total_mappings > 0 ? ((quality_distribution.excellent / total_mappings * 100)|round(1)) : 0) ~ '%',
            'compliance.export_pdf.common.q_desc_excellent'|trans({}, 'compliance'),
        ],
        [
            _cell_html3,
            '70-89%',
            _cell_html4,
            (total_mappings > 0 ? ((quality_distribution.good / total_mappings * 100)|round(1)) : 0) ~ '%',
            'pdf.framework_comparison.solid_mappings_minor'|trans({}, 'messages'),
        ],
        [
            _cell_html5,
            '50-69%',
            _cell_html6,
            (total_mappings > 0 ? ((quality_distribution.medium / total_mappings * 100)|round(1)) : 0) ~ '%',
            'compliance.export_pdf.common.q_desc_medium'|trans({}, 'compliance'),
        ],
        [
            _cell_html7,
            '&lt;50%',
            _cell_html8,
            (total_mappings > 0 ? ((quality_distribution.weak / total_mappings * 100)|round(1)) : 0) ~ '%',
            'compliance.export_pdf.common.q_desc_weak'|trans({}, 'compliance'),
        ],
        [
            _cell_html9,
            '',
            '',
            _cell_html10,
            '',
        ],
    ] %}

    {% set excellent_good_percentage = total_mappings > 0 ? (((quality_distribution.excellent + quality_distribution.good) / total_mappings * 100)|round(1)) : 0 %}
    {% set _mqd_insight %}<strong>{{ 'compliance.export_pdf.common.quality_assessment_label'|trans({}, 'compliance') }}</strong> {{ 'compliance.export_pdf.common.quality_assessment_text'|trans({'%pct%': excellent_good_percentage}, 'compliance') }}{% endset %}
    {% if quality_distribution.weak > 0 %}
        {% set _mqd_insight = _mqd_insight
            ~ ' ' ~ 'compliance.export_pdf.transitive.weak_hint'|trans({'%n%': quality_distribution.weak}, 'compliance') %}
    {% endif %}

    {% set _body_html_html11 %}<div style="border-left:3pt solid var(--primary);padding:8pt 10pt;margin:8pt 0;background:var(--surface-2);font-size:9pt;">{{ _mqd_insight }}</div>{% endset %}
    {% set _sections = _sections|merge([{
        heading: 'compliance.export_pdf.common.mapping_quality_distribution'|trans({}, 'compliance'),
        table: {
            headers: ['compliance.export_pdf.common.col_quality_level'|trans({}, 'compliance'), 'compliance.export_pdf.common.col_range'|trans({}, 'compliance'), 'compliance.export_pdf.common.col_count'|trans({}, 'compliance'), 'compliance.export_pdf.common.col_percentage'|trans({}, 'compliance'), 'compliance.export_pdf.common.col_assessment'|trans({}, 'compliance')],
            rows: _mqd_rows,
        },
        body_html: _body_html_html11,
    }]) %}
{% endif %}

{# ── Quick Wins - High ROI Opportunities ──────────────────────────────── #}
{% if quick_wins is defined and quick_wins|length > 0 %}
    {% set _qw_rows = [] %}
    {% for rel in quick_wins %}
        {% set _assessment = rel.roi >= 5 ? 'compliance.export_pdf.transitive.assess_top'|trans({}, 'compliance') : 'compliance.export_pdf.transitive.assess_good'|trans({}, 'compliance') %}
        {% set _cell_html16 %}<strong style="color:var(--success-strong);">{{ rel.roi }}</strong>{% endset %}
        {% set _cell_html15 %}<strong style="color:var(--primary-strong);">{{ rel.impact_score }}</strong>{% endset %}
        {% set _cell_html14 %}<strong style="color:var(--success-strong);">{{ rel.coverage }}%</strong>{% endset %}
        {% set _cell_html13 %}<strong>{{ rel.target.code }}</strong>{% endset %}
        {% set _cell_html12 %}<strong>{{ rel.source.code }}</strong>{% endset %}
        {% set _qw_rows = _qw_rows|merge([[
            _cell_html12,
            _cell_html13,
            _cell_html14,
            _cell_html15,
            _cell_html16,
            rel.effort_estimate,
            _assessment,
        ]]) %}
    {% endfor %}

    {% set _body_html_html17 %}<div style="border-left:3pt solid var(--success);padding:8pt 10pt;margin:0 0 8pt;background:var(--success-tint);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.qw_identified'|trans({'%n%': quick_wins|length}, 'compliance') }}</strong> {{ 'compliance.export_pdf.transitive.qw_text'|trans({}, 'compliance') }}</div>{% endset %}
    {% set _sections = _sections|merge([{
        heading: 'compliance.export_pdf.transitive.sec_quick_wins'|trans({}, 'compliance'),
        body_html: _body_html_html17,
        table: {
            headers: [
                'pdf.transitive_compliance.from_framework'|trans({}, 'messages'),
                'pdf.transitive_compliance.to_framework'|trans({}, 'messages'),
                'compliance.export_pdf.common.coverage'|trans({}, 'compliance'), 'compliance.export_pdf.common.impact_score'|trans({}, 'compliance'), 'compliance.export_pdf.common.roi'|trans({}, 'compliance'), 'compliance.export_pdf.transitive.col_effort_hrs'|trans({}, 'compliance'), 'compliance.export_pdf.common.col_assessment'|trans({}, 'compliance'),
            ],
            rows: _qw_rows,
        },
    }]) %}

    {% set _body_html_html1 %}<div style="border-left:3pt solid var(--primary);padding:8pt 10pt;margin:0;background:var(--surface-2);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.savings_label'|trans({}, 'compliance') }}</strong> {{ 'compliance.export_pdf.transitive.savings_text'|trans({'%req%': quick_wins|reduce((carry, rel) => carry + rel.mapped, 0), '%hrs%': quick_wins|reduce((carry, rel) => carry + rel.effort_estimate, 0)}, 'compliance') }}</div>{% endset %}
    {% set _sections = _sections|merge([{
        heading: '',
        body_html: _body_html_html1,
    }]) %}
{% endif %}

{# ── Framework Relationships Matrix ───────────────────────────────────── #}
{% set _rel_rows = [] %}
{% for rel in framework_relationships %}
    {% set _cov_color = rel.coverage >= 80 ? 'var(--success-strong)' : (rel.coverage >= 50 ? 'var(--warning-strong)' : 'var(--danger-strong)') %}
    {% set _prio_badge = '' %}
    {% if rel.priority_multiplier >= 2 %}
        {% set _prio_badge %}<span class="badge badge-danger">{{ 'compliance.export_pdf.common.priority.high'|trans({}, 'compliance') }}</span>{% endset %}
    {% elseif rel.priority_multiplier >= 1.5 %}
        {% set _prio_badge %}<span class="badge badge-warning">{{ 'compliance.export_pdf.common.priority.medium'|trans({}, 'compliance') }}</span>{% endset %}
    {% else %}
        {% set _prio_badge %}<span class="badge badge-info">{{ 'compliance.export_pdf.transitive.prio_normal'|trans({}, 'compliance') }}</span>{% endset %}
    {% endif %}

    {% set _rating = 'compliance.export_pdf.transitive.rating_standard'|trans({}, 'compliance') %}
    {% if rel.is_quick_win %}
        {% set _rating = 'compliance.export_pdf.transitive.rating_quick_win'|trans({}, 'compliance') %}
    {% elseif rel.impact_score >= 50 %}
        {% set _rating = 'compliance.export_pdf.transitive.rating_high_impact'|trans({}, 'compliance') %}
    {% elseif rel.roi >= 2 %}
        {% set _rating = 'compliance.export_pdf.transitive.rating_good_roi'|trans({}, 'compliance') %}
    {% endif %}

    {% set _cell_html22 %}<strong{{ (rel.roi >= 3 ? ' style="color:var(--success-strong);"' : '') }}>{{ rel.roi }}</strong>{% endset %}
    {% set _cell_html21 %}<strong{{ (rel.impact_score >= 50 ? ' style="color:var(--primary-strong);"' : '') }}>{{ rel.impact_score }}</strong>{% endset %}
    {% set _cell_html20 %}<strong style="color:{{ _cov_color }};">{{ rel.coverage }}%</strong>{% endset %}
    {% set _cell_html19 %}<strong>{{ rel.target.code }}</strong>{% endset %}
    {% set _cell_html18 %}<strong>{{ rel.source.code }}</strong>{% endset %}
    {% set _rel_rows = _rel_rows|merge([[
        _cell_html18,
        _cell_html19,
        _cell_html20,
        _cell_html21,
        _cell_html22,
        rel.effort_estimate ~ 'h',
        _prio_badge,
        _rating,
    ]]) %}
{% endfor %}

{% set _body_html_html23 %}<div style="border-left:3pt solid var(--primary);padding:8pt 10pt;margin:8pt 0;background:var(--surface-2);font-size:9pt;"><strong>{{ 'compliance.export_pdf.common.impact_score'|trans({}, 'compliance') }}:</strong> {{ 'compliance.export_pdf.transitive.impact_formula'|trans({}, 'compliance') }}<br><strong>{{ 'compliance.export_pdf.common.roi'|trans({}, 'compliance') }}:</strong> {{ 'compliance.export_pdf.transitive.roi_formula'|trans({}, 'compliance') }}</div>{% endset %}
{% set _sections = _sections|merge([{
    heading: 'compliance.export_pdf.transitive.sec_matrix'|trans({}, 'compliance'),
    table: {
        headers: [
            'pdf.transitive_compliance.from_framework'|trans({}, 'messages'),
            'pdf.transitive_compliance.to_framework'|trans({}, 'messages'),
            'compliance.export_pdf.common.coverage'|trans({}, 'compliance'), 'compliance.export_pdf.common.impact_score'|trans({}, 'compliance'), 'compliance.export_pdf.common.roi'|trans({}, 'compliance'), 'compliance.export_pdf.common.effort'|trans({}, 'compliance'), 'compliance.export_pdf.common.priority'|trans({}, 'compliance'), 'compliance.export_pdf.common.rating'|trans({}, 'compliance'),
        ],
        rows: _rel_rows,
    },
    body_html: _body_html_html23,
}]) %}

{# ── High Coverage Relationships ──────────────────────────────────────── #}
{% set high_coverage = framework_relationships|filter(rel => rel.coverage >= 70) %}
{% if high_coverage|length > 0 %}
    {% set _hc_body %}<div style="border-left:3pt solid var(--primary);padding:8pt 10pt;margin:0 0 8pt;background:var(--surface-2);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.hc_identified'|trans({'%n%': high_coverage|length}, 'compliance') }}</strong> {{ 'compliance.export_pdf.transitive.hc_text'|trans({}, 'compliance') }}</div>{% endset %}
    {% for rel in high_coverage|slice(0, 10) %}
        {% set _hc_body %}{{ _hc_body }}<div style="border-left:3pt solid var(--success);padding:6pt 10pt;margin:4pt 0;background:var(--success-tint);font-size:9pt;"><strong>{{ rel.source.code }} → {{ rel.target.code }}</strong>: {{ 'compliance.export_pdf.common.coverage'|trans({}, 'compliance') }} <strong>{{ rel.coverage }}%</strong> ({{ 'compliance.export_pdf.transitive.hc_of'|trans({'%mapped%': rel.mapped, '%total%': rel.total}, 'compliance') }}). {{ 'compliance.export_pdf.transitive.hc_savings'|trans({'%hours%': (rel.mapped * 1.5)|round}, 'compliance') }}</div>{% endset %}
    {% endfor %}

    {% set _sections = _sections|merge([{
        heading: 'compliance.export_pdf.transitive.sec_high_coverage'|trans({}, 'compliance'),
        body_html: _hc_body,
    }]) %}
{% endif %}

{# ── Strategic Recommendations ────────────────────────────────────────── #}
{% set _rec_body = '' %}

{# Immediate Actions #}
{% if quick_win_count > 0 %}
    {% set _rec_body %}<div style="border-left:3pt solid var(--success);padding:8pt 10pt;margin:0 0 8pt;background:var(--success-tint);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.rec1_qw_title'|trans({}, 'compliance') }}</strong><br>{{ 'compliance.export_pdf.transitive.rec1_qw_text'|trans({'%n%': quick_win_count}, 'compliance') }}<br><strong>{{ 'compliance.export_pdf.transitive.rec1_benefit'|trans({}, 'compliance') }}</strong> {{ 'compliance.export_pdf.transitive.rec1_benefit_text'|trans({'%req%': quick_wins|slice(0, 3)|reduce((carry, rel) => carry + rel.mapped, 0), '%hrs%': quick_wins|slice(0, 3)|reduce((carry, rel) => carry + rel.effort_estimate, 0)}, 'compliance') }}</div>{% endset %}
{% else %}
    {% set _rec_body %}<div style="border-left:3pt solid var(--success);padding:8pt 10pt;margin:0 0 8pt;background:var(--success-tint);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.rec1_title'|trans({}, 'compliance') }}</strong><br>{{ 'compliance.export_pdf.transitive.rec1_none'|trans({}, 'compliance') }}</div>{% endset %}
{% endif %}

{# High-Impact Relationships #}
{% if high_impact_count > 0 %}
    {% set _rec_body %}{{ _rec_body }}<div style="border-left:3pt solid var(--primary);padding:8pt 10pt;margin:0 0 8pt;background:var(--surface-2);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.rec2_title'|trans({}, 'compliance') }}</strong><br>{{ 'compliance.export_pdf.transitive.rec2_text'|trans({'%n%': high_impact_count}, 'compliance') }}</div>{% endset %}
{% else %}
    {% set _rec_body %}{{ _rec_body }}<div style="border-left:3pt solid var(--primary);padding:8pt 10pt;margin:0 0 8pt;background:var(--surface-2);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.rec2_title'|trans({}, 'compliance') }}</strong><br>{{ 'compliance.export_pdf.transitive.rec2_none'|trans({}, 'compliance') }}</div>{% endset %}
{% endif %}

{# Optimization Opportunities #}
{% set low_roi = framework_relationships|filter(rel => rel.roi < 2 and not rel.is_quick_win) %}
{% set _rec_body %}{{ _rec_body }}<div style="border-left:3pt solid var(--primary);padding:8pt 10pt;margin:0 0 8pt;background:var(--surface-2);font-size:9pt;"><strong>{{ 'compliance.export_pdf.transitive.rec3_title'|trans({}, 'compliance') }}</strong><br>{{ 'compliance.export_pdf.transitive.rec3_text'|trans({'%n%': low_roi|length}, 'compliance') }}</div>{% endset %}

{% set _sections = _sections|merge([{
    heading: 'compliance.export_pdf.transitive.sec_recommendations'|trans({}, 'compliance'),
    body_html: _rec_body,
}]) %}

