{% extends 'base.html.twig' %}
{% trans_default_domain 'document' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'evidence_reverification.title'|trans({}, 'document') }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'common.dashboard'|trans({}, 'messages'), url: path('app_dashboard') },
            { label: 'nav.documents'|trans({}, 'nav'), url: path('app_document_index') },
            { label: 'evidence_reverification.title'|trans({}, 'document') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'evidence_reverification.title'|trans({}, 'document'),
        subtitle: 'evidence_reverification.subtitle'|trans({'%count%': open_count}, 'document')
    }) }}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_evidence_reverification_index'),
        filter_keys: ['filter'],
        list_title: 'evidence_reverification.list'|trans({}, 'document'),
        empty: {
            mood: 'happy',
            title: 'evidence_reverification.empty.title'|trans({}, 'document'),
            text: 'evidence_reverification.empty.body'|trans({}, 'document'),
        },
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label for="reverification-filter" class="form-label">{{ 'evidence_reverification.filter.label'|trans({}, 'document') }}</label>
                <select class="form-select fa-cyber-input__field" id="reverification-filter" name="filter" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    {% for key, label in {
                        'open': 'evidence_reverification.filter.open',
                        'mine': 'evidence_reverification.filter.mine',
                        'overdue': 'evidence_reverification.filter.overdue',
                        'all': 'evidence_reverification.filter.all'
                    } %}
                        <option value="{{ key }}" {{ filter == key ? 'selected' : '' }}>{{ label|trans({}, 'document') }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if open_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'evidence_reverification.summary.open'|trans({'%count%': open_count}, 'document') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            <div class="px-3">
                {% for task in page %}
                    {% set status_variant = status_tone('evidence_task', task.isOverdue and task.status not in ['completed', 'skipped'] ? 'overdue' : task.status) %}
                    <div class="d-flex align-items-start gap-3 py-3{{ not loop.last ? ' border-bottom' : '' }}">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <a href="{{ path('app_evidence_reverification_show', {id: task.id}) }}"
                                   class="fw-semibold text-body text-decoration-none">
                                    {{ task.documentVersion.fileName }}
                                </a>
                                <span class="fa-status-pill fa-status-pill--{{ status_variant }}">
                                    {{ ('evidence_reverification.status.' ~ task.status)|trans({}, 'document') }}
                                </span>
                                {% if task.isOverdue %}
                                    <span class="fa-status-pill fa-status-pill--danger">{{ 'evidence_reverification.overdue'|trans({}, 'document') }}</span>
                                {% endif %}
                            </div>
                            <div class="text-muted small">
                                {% if task.control is not null %}
                                    <i class="fa-icon fa-icon--control-shield me-1" aria-hidden="true"></i>
                                    {{ 'evidence_reverification.linked.control'|trans({'%id%': task.control.controlId}, 'document') }}
                                {% endif %}
                                {% if task.complianceFulfillment is not null %}
                                    <i class="fa-icon fa-icon--compliance-shield me-1" aria-hidden="true"></i>
                                    {{ 'evidence_reverification.linked.fulfillment'|trans({'%id%': task.complianceFulfillment.id}, 'document') }}
                                {% endif %}
                                {% if task.dueDate is not null %}
                                    · {{ 'evidence_reverification.due'|trans({}, 'document') }}: {{ task.dueDate|fa_date }}
                                {% endif %}
                                {% if task.assignedTo is not null %}
                                    · {{ 'evidence_reverification.assigned_to'|trans({}, 'document') }}: {{ task.assignedTo.fullName ?? task.assignedTo.email }}
                                {% endif %}
                            </div>
                        </div>
                        {% if task.isOpen() %}
                            <div class="d-flex gap-2">
                                <a href="{{ path('app_evidence_reverification_show', {id: task.id}) }}"
                                   class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                                    {{ 'common.view'|trans({}, 'messages') }}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
