{% extends 'base.html.twig' %}
{% trans_default_domain 'management_review' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'management_review.new'|trans({}, 'management_review') }}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'management_review.title'|trans({}, 'management_review'), url: path('app_management_review_index'), icon: 'audit-trail' },
            { label: 'management_review.new'|trans({}, 'management_review') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'management_review.new'|trans({}, 'management_review'),
        subtitle: 'management_review.iso_clause_93_info'|trans({}, 'management_review'),
        actions: [
            { label: 'common.back'|trans({}, 'messages'), href: path('app_management_review_index'), variant: 'secondary', icon: 'util-arrow-left' }
        ]
    }) }}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    {% include 'management_review/_form_body.html.twig' with {
        form: form,
        title: 'management_review.new'|trans({}, 'management_review'),
        actions: {
            close: { label: 'management_review.action.cancel'|trans({}, 'management_review'), variant: 'ghost' },
            submit: { label: 'management_review.action.create'|trans({}, 'management_review'), variant: 'primary' }
        }
    } %}

    {{ form_end(form) }}
</div>
{% endblock %}
