{# The one ManagementReview form body (outline rail), used full-page by new/edit
   and inside the fa-form-modal frame (modal: true). Caller wraps it in
   form_start/form_end and passes title / actions. Inputs follow ISO 27001:2022
   9.3.2 a–g, outputs 9.3.3 — the field lists come from ManagementReviewType. #}
{% trans_default_domain 'management_review' %}
{% set modal = modal|default(false) %}
{% set title = title|default(review is defined and review and review.title ? review.title : ('management_review.new'|trans({}, 'management_review'))) %}
{% set section_map = form_section_map(form) %}

{% set form_sections = {} %}
{% for key, fields in section_map %}
    {% if key != 'compliance' or is_module_active('compliance') %}
        {% set form_sections = form_sections|merge({ (key): {
            'label': ('management_review.section.' ~ key)|trans({}, 'management_review'),
            'fields': fields
        } }) %}
    {% endif %}
{% endfor %}

{% include '_components/_auto_form.html.twig' with {
    'form': form,
    'layout': 'outline-rail',
    'modal': modal,
    'eyebrow': 'ISO 27001 9.3 · ' ~ 'management_review.title'|trans({}, 'management_review'),
    'title': title,
    'sections': form_sections,
    'col_widths': {
        'title': 8,
        'reviewDate': 4,
        'status': 6,
        'reviewedBy': 6,
        'reviewedByPerson': 6,
        'reviewedByDeputyPersons': 12,
        'participants': 6,
        'personParticipants': 6,
        'topManagementAttended': 12,
        'nextReviewDate': 6,
        'meetingMinutesDocument': 6
    },
    'translation_domain': 'management_review',
    'actions': actions|default({
        'close': { 'label': 'common.cancel'|trans({}, 'messages'), 'variant': 'ghost' },
        'submit': { 'label': 'common.save'|trans({}, 'messages'), 'variant': 'primary' }
    })
} %}
