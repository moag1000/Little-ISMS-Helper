{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
{% import '_components/_lifecycle_actions.html.twig' as _lifecycle_actions %}
{% import '_components/_fa_status_chip.html.twig' as _fa_status_chip %}
{% import '_macros/workflow.html.twig' as _workflow %}
{% trans_default_domain 'management_review' %}

{% block title %}{{ review.title }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {# M-4 — module-gating: Management Review (ISO 27001 Cl. 9.3) #}
    {% if not is_module_active('reviews') %}
        {{ _fa_alert.render({
            variant: 'info',
            icon: 'nav-shield-alert',
            body: 'common.module_not_active'|trans({'%module%': 'Management Review'}, 'messages')
        }) }}
    {% else %}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_management_review_index') }}" data-turbo-action="advance">
                    <i class="fa-icon fa-icon--audit-trail" aria-hidden="true"></i> {{ 'management_review.title'|trans({}, 'management_review') }}
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">{{ review.title }}</li>
        </ol>
    </nav>

    {{ _fa_page_header.render({
        title: review.title
    }) }}

    {% set _openTasks = tasks|filter(t => t.status not in ['done', 'dismissed'])|length %}
    {% set _status %}{{ _fa_status_chip.render({ entity_class: 'App\\Entity\\ManagementReview', status_key: review.status, label: ('management_review.status.' ~ review.status)|trans({}, 'management_review'), size: 'lg' }) }}{% endset %}
    {% set _actions %}{{ _lifecycle_actions.dropdown(review, 'management-review', 'management_review_lifecycle') }}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'management_review.field.review_date'|trans({}, 'management_review'), value: review.reviewDate ? review.reviewDate|fa_date : null },
            { label: 'management_review.task.open_count'|trans({}, 'management_review'), value: tasks is empty ? null : _openTasks ~ ' / ' ~ tasks|length },
            { label: 'management_review.field.next_review_date'|trans({}, 'management_review'), value: review.nextReviewDate ? review.nextReviewDate|fa_date : null },
        ],
        workflow: workflow_state(review),
    }) }}

    {% if review.status == 'planned' and is_granted('ROLE_TOP_MGMT') %}
        {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', icon: 'regulator' } } %}
            {% block alert_body %}
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span>{{ 'management_review.complete.hint'|trans({}, 'management_review') }}</span>
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--success"
                            data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="completeReview">
                        <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i> {{ 'management_review.complete.action'|trans({}, 'management_review') }}
                    </button>
                </div>
            {% endblock %}
        {% endembed %}
        {{ _workflow.decision_modal({
            id: 'completeReview',
            tone: 'success',
            title: 'management_review.complete.action'|trans({}, 'management_review'),
            action: path('app_management_review_complete', {id: review.id}),
            token: csrf_token('mr_complete_' ~ review.id),
            question: 'management_review.complete.question'|trans({}, 'management_review'),
            subject: review.title,
            summary: tasks is empty ? null : 'management_review.complete.summary'|trans({'%count%': tasks|length}, 'management_review'),
            field: { name: 'comment', label: 'management_review.complete.comment'|trans({}, 'management_review') },
        }) }}
    {% endif %}

    {% set _links = entity_links(review) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'management_review.field.basic_info'|trans({}, 'management_review') },
        { id: 'inputs', label: 'management_review.section.inputs'|trans({}, 'management_review') },
        { id: 'outputs', label: 'management_review.section.outputs'|trans({}, 'management_review') },
        { id: 'tasks', label: 'management_review.task.title'|trans({}, 'management_review') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: review } only %}

    {# ISO 27001:2022 9.3.2 a–g, in the order of the norm. #}
    {% set _inputs = [
        { ref: 'a', label: 'previous_review_actions', value: review.previousReviewActions },
        { ref: 'b', label: 'changes_relevant_to_isms', value: review.changesRelevantToISMS },
        { ref: 'c', label: 'interested_party_needs_changes', value: review.interestedPartyNeedsChanges },
        { ref: 'd 1', label: 'non_conformities_status', value: review.nonConformitiesStatus },
        { ref: 'd 1', label: 'corrective_actions_status', value: review.correctiveActionsStatus },
        { ref: 'd 2', label: 'performance_evaluation', value: review.performanceEvaluation },
        { ref: 'd 2', label: 'incidents_review', value: review.incidentsReview },
        { ref: 'd 3', label: 'audit_results', value: review.auditResults },
        { ref: 'd 4', label: 'objectives_review', value: review.objectivesReview },
        { ref: 'e', label: 'feedback_from_interested_parties', value: review.feedbackFromInterestedParties },
        { ref: 'f', label: 'risks_review', value: review.risksReview },
        { ref: 'f', label: 'risk_treatment_effectiveness', value: review.riskTreatmentEffectiveness },
        { ref: 'g', label: 'opportunities_for_improvement', value: review.opportunitiesForImprovement },
    ] %}
    {% set _outputs = [
        { label: 'decisions', value: review.decisions },
        { label: 'resource_needs', value: review.resourceNeeds },
        { label: 'policy_review_outcome', value: review.policyReviewOutcome },
        { label: 'summary', value: review.summary },
    ]|merge(review.actionItems ? [{ label: 'action_items', value: review.actionItems }] : []) %}

    <div class="row">
        <div class="col-lg-8">
            <div id="details" class="fa-show-section">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ 'management_review.field.basic_info'|trans({}, 'management_review') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">{{ 'management_review.field.participants'|trans({}, 'management_review') }}</dt>
                        <dd class="col-sm-8">
                            {% set _names = review.participants|map(p => p.fullName)|merge(review.personParticipants|map(p => p.fullName)) %}
                            {{ _names is empty ? '—' : _names|join(', ') }}
                        </dd>
                        <dt class="col-sm-4 text-muted">{{ 'management_review.field.top_management_attended'|trans({}, 'management_review') }}</dt>
                        <dd class="col-sm-8">{{ (review.topManagementAttended ? 'common.yes' : 'common.no')|trans({}, 'messages') }}</dd>
                        <dt class="col-sm-4 text-muted">{{ 'management_review.field.meeting_minutes_document'|trans({}, 'management_review') }}</dt>
                        <dd class="col-sm-8 mb-0">
                            {% if review.meetingMinutesDocument %}
                                <a href="{{ path('app_document_show', {id: review.meetingMinutesDocument.id}) }}">{{ review.meetingMinutesDocument.originalFilename }}</a>
                            {% else %}—{% endif %}
                        </dd>
                    </dl>
                {% endblock %}
            {% endembed %}
            </div>

            <div id="inputs" class="fa-show-section">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ 'management_review.section.inputs'|trans({}, 'management_review') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% for input in _inputs %}
                        <div class="{{ loop.last ? 'mb-0' : 'mb-3' }}">
                            <div class="text-muted small fw-semibold">
                                <span class="me-1">9.3.2 {{ input.ref }}</span>
                                {{ ('management_review.field.' ~ input.label)|trans({}, 'management_review') }}
                            </div>
                            <p class="mb-0">{{ input.value ? input.value|nl2br : '—' }}</p>
                        </div>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
            </div>

            <div id="outputs" class="fa-show-section">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ 'management_review.section.outputs'|trans({}, 'management_review') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% for output in _outputs %}
                        <div class="mb-3">
                            <div class="text-muted small fw-semibold">{{ ('management_review.field.' ~ output.label)|trans({}, 'management_review') }}</div>
                            <p class="mb-0">{{ output.value ? output.value|nl2br : '—' }}</p>
                        </div>
                    {% endfor %}
                    <div class="text-muted small fw-semibold">{{ 'management_review.decision.title'|trans({}, 'management_review') }}</div>
                    {% if decisions is empty %}
                        <p class="mb-0">{{ 'management_review.decision.none'|trans({}, 'management_review') }}</p>
                    {% else %}
                        <ul class="mb-0">
                            {% for decision in decisions %}
                                <li>
                                    <a href="{{ path('app_management_decision_show', {id: decision.id}) }}">{{ decision.title }}</a>
                                    <span class="text-muted small">— {{ decision.decidedBy ? decision.decidedBy.fullName : '—' }}, {{ decision.decidedAt|fa_date }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endblock %}
            {% endembed %}
            </div>

            <div id="tasks" class="fa-show-section">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ 'management_review.task.title'|trans({}, 'management_review') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% if tasks is empty %}
                        <p class="text-muted">{{ 'management_review.task.empty'|trans({}, 'management_review') }}</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="fa-table">
                                <thead>
                                    <tr>
                                        <th scope="col">{{ 'management_review.task.field.title'|trans({}, 'management_review') }}</th>
                                        <th scope="col">{{ 'management_review.task.field.responsible'|trans({}, 'management_review') }}</th>
                                        <th scope="col">{{ 'management_review.task.field.due'|trans({}, 'management_review') }}</th>
                                        <th scope="col">{{ 'management_review.task.field.status'|trans({}, 'management_review') }}</th>
                                        <th scope="col"><span class="visually-hidden">{{ 'common.actions'|trans({}, 'messages') }}</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for task in tasks %}
                                        {% set _closed = task.status in ['done', 'dismissed'] %}
                                        <tr>
                                            <td>{{ task.title }}</td>
                                            <td>{{ task.responsibleUser ? task.responsibleUser.fullName : (task.responsiblePerson ? task.responsiblePerson.fullName : '—') }}</td>
                                            <td>{{ task.dueDate|fa_date }}</td>
                                            <td>{{ ('planning.action_item.status.' ~ task.status)|trans({}, 'planning') }}</td>
                                            <td class="text-end">
                                                {% if not _closed and is_granted('ROLE_MANAGER') %}
                                                    <form method="post" action="{{ path('app_management_review_task_done', {id: review.id, task: task.id}) }}" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('mr_task_done_' ~ task.id) }}">
                                                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost">{{ 'management_review.task.done'|trans({}, 'management_review') }}</button>
                                                    </form>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                    {% if task_form %}
                        {{ form_start(task_form, { attr: { class: 'row g-2 align-items-end mt-2' } }) }}
                            <div class="col-md-5">{{ form_row(task_form.title) }}</div>
                            <div class="col-md-4">{{ form_row(task_form.responsibleUser) }}</div>
                            <div class="col-md-3">{{ form_row(task_form.dueDate) }}</div>
                            <div class="col-12">
                                <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">{{ 'management_review.task.add'|trans({}, 'management_review') }}</button>
                            </div>
                        {{ form_end(task_form) }}
                    {% endif %}
                {% endblock %}
            {% endembed %}
            </div>
        </div>

        <div class="col-lg-4">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ 'common.actions'|trans({}, 'messages') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    <div class="d-grid gap-2">
                        {% if is_granted('ROLE_MANAGER') %}
                        <a href="{{ path('app_management_review_edit', {id: review.id}) }}"
                           class="fa-cyber-btn fa-cyber-btn--primary"
                           data-turbo-action="advance">
                            <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i> {{ 'common.edit'|trans({}, 'messages') }}
                        </a>
                        {% endif %}

                        {% if is_granted('ROLE_AUDITOR') %}
                        <div>
                            <a href="{{ path('app_management_review_pdf', {id: review.id}) }}"
                               class="fa-cyber-btn fa-cyber-btn--ghost"
                               data-turbo="false">
                                {{ 'management_review.action.pdf'|trans({}, 'management_review') }}
                            </a>
                            {% include '_components/_fa_pdf_locale_switch.html.twig' with {route: 'app_management_review_pdf', route_params: {id: review.id}} only %}
                        </div>
                        {% endif %}

                        <a href="{{ path('app_management_review_index') }}"
                           class="fa-cyber-btn fa-cyber-btn--ghost"
                           data-turbo-action="advance">
                            {{ 'common.back_to_list'|trans({}, 'messages') }}
                        </a>

                        {% if is_granted('ROLE_ADMIN') %}
                        <hr>
                        <button type="button"
                                class="fa-cyber-btn fa-cyber-btn--danger" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="deleteModal">
                            <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}
                        </button>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="h5 mb-0">{{ 'common.metadata'|trans({}, 'messages') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    <dl class="row mb-0 small">
                        <dt class="col-sm-5 text-muted">{{ 'common.created_at'|trans({}, 'messages') }}</dt>
                        <dd class="col-sm-7">{{ review.createdAt|fa_datetime }}</dd>

                        <dt class="col-sm-5 text-muted">{{ 'common.updated_at'|trans({}, 'messages') }}</dt>
                        <dd class="col-sm-7">{{ review.updatedAt|fa_datetime }}</dd>
                    </dl>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: review, lifecycle: 'management-review' } only %}
    {% endif %} {# /M-4 reviews module gate #}
</div>

{# Delete Confirmation Modal #}
{% if is_granted('ROLE_ADMIN') %}
<div class="fa-modal fa-modal--confirm fa-modal--danger" id="deleteModal"
     data-controller="fa-modal" data-fa-modal-mode-value="confirm" data-fa-modal-tone-value="danger"
     role="alertdialog" aria-modal="true" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="fa-modal__backdrop" data-fa-modal-target="backdrop" data-action="click->fa-modal#backdropClick" aria-hidden="true"></div>
    <div class="fa-modal__container" data-fa-modal-target="dialog"><header class="fa-modal__header"><span class="fa-modal__icon" aria-hidden="true"><i class="fa-icon fa-icon--ui-trash"></i></span><div class="fa-modal__heading"><h3 class="fa-modal__title" id="deleteModalLabel">
                    {{ 'management_review.confirm_delete'|trans({}, 'management_review') }}
                </h3></div><button type="button" class="fa-modal__close" data-action="fa-modal#cancel" aria-label="{{ 'common.close'|trans({}, 'messages') }}"><i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i></button></header>
            <div class="fa-modal__body">
                <p>{{ 'management_review.delete_warning'|trans({'%title%': review.title}, 'management_review') }}</p>
                <p class="text-muted"><small>{{ 'common.action_irreversible'|trans({}, 'messages') }}</small></p>
            </div>
            <footer class="fa-modal__footer">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost" data-action="fa-modal#cancel">{{ 'common.cancel'|trans({}, 'messages') }}</button>
                <form method="post" action="{{ path('app_management_review_delete', {id: review.id}) }}" class="d-inline" data-fa-modal-target="form">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ review.id) }}">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
                        <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}
                    </button>
                </form></div>
</div>
</div>
{% endif %}
{% endblock %}
