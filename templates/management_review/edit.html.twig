{% extends 'base.html.twig' %}
{% trans_default_domain 'management_review' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'management_review.edit'|trans({}, 'management_review') }} - {{ review.title }}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'management_review.title'|trans({}, 'management_review'), url: path('app_management_review_index'), icon: 'audit-trail' },
            { label: review.title, url: path('app_management_review_show', {id: review.id}) },
            { label: 'common.edit'|trans({}, 'messages') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'management_review.edit'|trans({}, 'management_review'),
        subtitle: review.title,
        actions: [
            { label: 'common.back'|trans({}, 'messages'), href: path('app_management_review_show', {id: review.id}), variant: 'secondary', icon: 'util-arrow-left' }
        ]
    }) }}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    {% include 'management_review/_form_body.html.twig' with {
        form: form,
        title: review.title,
        actions: {
            close: { label: 'management_review.action.cancel'|trans({}, 'management_review'), variant: 'ghost' },
            submit: { label: 'management_review.action.save'|trans({}, 'management_review'), variant: 'primary' }
        }
    } %}

    {{ form_end(form) }}
</div>
{% endblock %}
