{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'bc_exercises' %}

{% block title %}{{ 'bc_exercises.page.title'|trans({}, 'bc_exercises') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.bcm'|trans({}, 'nav'), url: path('app_bcm_index') },
            { label: 'nav.bc_exercises'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'bc_exercises.page.header'|trans({}, 'bc_exercises'),
        actions: [
            { label: 'bc_exercises.action.add_new'|trans({}, 'bc_exercises'), href: path('app_bc_exercise_new'), variant: 'primary', icon: 'plus', attrs: { 'data-turbo-frame': 'fa-form-modal' } }
        ]
    }) }}
{% set _global_hints = alva_hints('bc_exercise_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {% if upcoming|length > 0 %}
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info' } } %}
        {% block alert_body %}
            <div class="fa-alert__title">{{ 'bc_exercises.section.upcoming'|trans({}, 'bc_exercises') }}</div>
            <ul>
                {% for exercise in upcoming %}
                <li>
                    <a href="{{ path('app_bc_exercise_show', {id: exercise.id}) }}">{{ exercise.name }}</a>
                    - {{ exercise.exerciseDate|fa_date }} ({{ ('bc_exercises.exercise_type.' ~ exercise.exerciseType)|trans({}, 'bc_exercises') }})
                </li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}
    {% endif %}

    {% if incomplete_reports|length > 0 %}
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'warning' } } %}
        {% block alert_body %}
            <div class="fa-alert__title">{{ 'bc_exercises.section.incomplete_reports'|trans({}, 'bc_exercises') }}</div>
            <ul class="mb-0">
                {% for exercise in incomplete_reports %}
                <li>
                    <a href="{{ path('app_bc_exercise_show', {id: exercise.id}) }}">{{ exercise.name }}</a>
                </li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_bc_exercise_index'),
        list_title: 'bc_exercises.page.header'|trans({}, 'bc_exercises'),
        empty: {
            mood: 'sleeping',
            title: 'bc_exercises.message.no_exercises'|trans({}, 'bc_exercises'),
            actions: [
                { label: 'bc_exercises.message.schedule_first'|trans({}, 'bc_exercises'), variant: 'primary', icon: 'plus', href: path('app_bc_exercise_new') }
            ]
        },
        card_attrs: 'data-controller="bulk-actions" data-bulk-actions-endpoint-value="/' ~ app.request.locale ~ '/bc-exercise"',
    } %}
        {% block list_summary %}
            {% if completed_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'bc_exercises.summary.completed'|trans({'%count%': completed_count}, 'bc_exercises') }}</span>{% endif %}
            {% if planned_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'bc_exercises.summary.planned'|trans({'%count%': planned_count}, 'bc_exercises') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with {
                'noMargin': true
            } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'bc_exercises.table.name'|trans({}, 'bc_exercises') }}</th>
                        <th scope="col">{{ 'bc_exercises.table.type'|trans({}, 'bc_exercises') }}</th>
                        <th scope="col">{{ 'bc_exercises.table.date'|trans({}, 'bc_exercises') }}</th>
                        <th scope="col">{{ 'bc_exercises.table.status'|trans({}, 'bc_exercises') }}</th>
                        <th scope="col">{{ 'bc_exercises.table.effectiveness'|trans({}, 'bc_exercises') }}</th>
                        <th scope="col">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="bc-exercise-rows"{% endblock %}
                {% block table_body %}
                    {% for exercise in page %}
                        {% include 'bc_exercise/_row.html.twig' with { exercise: exercise } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}

            {% include '_components/_bulk_action_bar.html.twig' with {
                actions: ['export', 'delete']
            } %}
        {% endblock %}
    {% endembed %}
</div>

{% endblock %}
