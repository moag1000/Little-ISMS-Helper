{#
 # "Review bestätigen" for one record on its detail page (W1): the review
 # reminder links here and the owner confirms in one step. Shown only to who
 # may confirm it (the responsible person, or who may edit without being a
 # read-only reviewer).
 # Params: entity, route (POST route taking {id}).
 # Optional (W6, reviews whose action is "manager OR responsible"):
 #   can          bool, default is_granted('edit', entity)
 #   token_id     CSRF token id, default 'review_confirm_' ~ entity.id
 #   route_params extra route parameters (e.g. the parent id)
 #   label        button text, default "Review bestätigen"
 #}
{# Default = RecordResponsibleVoter::EDIT_OR_RESPONSIBLE, the rule of the confirm actions. #}
{% if can ?? (is_granted('RECORD_RESPONSIBLE', entity) or (is_granted('edit', entity) and (is_granted('ROLE_MANAGER') or not is_granted('ROLE_AUDITOR')))) %}
    <form method="post" action="{{ path(route, {id: entity.id}|merge(route_params ?? {})) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token(token_id ?? ('review_confirm_' ~ entity.id)) }}">
        <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ label ?? 'periodic_review.confirm_one'|trans({}, 'messages') }}</button>
    </form>
{% endif %}
