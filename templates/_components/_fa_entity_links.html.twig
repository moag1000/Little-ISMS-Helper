{#
 # FairyAurora v4 — Verknüpfungen (detail-page skeleton, UI wave E)
 #
 # The evidence chain of a record as the first block of its detail page:
 # Asset → Risiko → Control → Nachweis → Vorfall → Schwachstelle. Data comes
 # from App\Service\Detail\EntityLinks via `entity_links(entity)`; a group
 # without records stays visible, so a gap in the chain is a visible gap.
 #
 # Above the block: a one-line hint when the queue holds suggestions about
 # the record (pending_suggestions(entity), Paket 5), and the "Entwurf
 # vorschlagen" buttons for the drafts the user may ask for (draft_kinds(entity), P6).
 #
 # Usage:
 #   {% include '_components/_fa_entity_links.html.twig' with { entity: risk } only %}
 #}
{% import '_components/_status_pill.html.twig' as _pill %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{# Open suggestions about this record (Paket 5) — one line with a link into the queue. #}
{% set _suggestions = pending_suggestions(entity) %}
{% if _suggestions is not empty %}
    {% set _first = _suggestions|first %}
    {{ _fa_alert.render({
        variant: 'info',
        icon: 'nav-magic',
        class: 'mb-3',
        body: ('suggestions.hint.record'|trans({'%count%': _suggestions|length, '%title%': _first.title}, 'suggestions'))|e
            ~ ' <a href="' ~ path('app_suggestion_index', {subject: _first.subjectClass ~ '#' ~ _first.subjectId})|e('html_attr') ~ '">'
            ~ ('suggestions.hint.open'|trans({}, 'suggestions'))|e ~ '</a>',
    }) }}
{% endif %}
{# Drafts the user may ask for on this record (P6) — rule drafts at once, model drafts in the background; both land in the queue. #}
{% set _drafts = draft_kinds(entity) %}
{% if _drafts is not empty %}
    <div class="fa-entity-links__drafts" data-testid="record-drafts">
        <span class="fa-entity-links__note">{{ 'suggestions.draft.prompt'|trans({}, 'suggestions') }}</span>
        {% for _d in _drafts %}
            <form method="post" action="{{ path('app_suggestion_draft') }}" data-unsaved-guard="off"
                  data-controller="ui-actions" data-action="submit->ui-actions#submitOnce">
                <input type="hidden" name="_token" value="{{ csrf_token('suggestion_draft') }}">
                <input type="hidden" name="kind" value="{{ _d.key }}">
                <input type="hidden" name="class" value="{{ _d.class }}">
                <input type="hidden" name="id" value="{{ _d.id }}">
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" data-testid="draft-{{ _d.key }}">
                    {{ ('suggestions.draft.button.' ~ _d.key)|trans({}, 'suggestions') }}
                </button>
            </form>
        {% endfor %}
    </div>
{% endif %}
{% set _groups = entity_links(entity) %}
{% set _icons = { asset: 'asset', risk: 'risk', control: 'control', evidence: 'evidence', incident: 'incident', vulnerability: 'vulnerability' } %}
{% if _groups is not empty %}
<section id="links" class="fa-entity-links" aria-labelledby="links-title" data-testid="entity-links">
    <h2 id="links-title" class="fa-entity-links__title">{{ 'show.links.title'|trans({}, 'messages') }}</h2>
    <div class="fa-entity-links__grid">
        {% for g in _groups %}
            <div class="fa-entity-links__group" data-testid="links-{{ g.type }}">
                <h3 class="fa-entity-links__head">
                    <i class="fa-icon fa-icon--{{ _icons[g.type] }}" aria-hidden="true"></i>
                    <span>{{ ('show.links.type.' ~ g.type)|trans({}, 'messages') }}</span>
                    <span class="fa-entity-links__count">{{ g.total }}</span>
                </h3>
                {% if g.via %}
                    <p class="fa-entity-links__note">{{ 'show.links.via_controls'|trans({}, 'messages') }}</p>
                {% endif %}
                {% if g.items is empty %}
                    <p class="fa-entity-links__note">{{ 'show.links.none'|trans({}, 'messages') }}</p>
                {% else %}
                    <ul class="fa-entity-links__list">
                        {% for i in g.items %}
                            <li>
                                <a href="{{ path(g.route, {id: i.id}) }}" data-turbo-action="advance">
                                    {%- if i.code %}<code>{{ i.code }}</code> {% endif %}{{ i.label -}}
                                </a>
                                {% if i.meta %}{{ _pill.render(i.meta, i.tone, {size: 'sm'}) }}{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    {% if g.total > g.items|length %}
                        <p class="fa-entity-links__note">{{ 'show.links.more'|trans({'%count%': g.total - g.items|length}, 'messages') }}</p>
                    {% endif %}
                {% endif %}
                {% if g.derive %}
                    <a href="{{ g.derive.anchor ?: path(g.derive.route, g.derive.params) }}" data-testid="derive-{{ g.type }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm fa-entity-links__derive">
                        {{ ('show.links.derive.' ~ g.type)|trans({}, 'messages') }}
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}
