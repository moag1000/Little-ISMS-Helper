{#
 # fa-list-page — the one list skeleton (UI wave C).
 #
 # Order is fixed: filter bar (search + collapsible filters, all GET, shareable)
 # → optional summary chips → table card with count → pager → or the empty state.
 # Page header, breadcrumb and Alva hints stay in the calling template, above the
 # embed. KPI tiles do not belong in a list; a summary line of chips does.
 #
 # Usage (controller passes `page` = App\Util\ListPage::fromRequest(...)):
 #   {% embed '_components/_fa_list_page.html.twig' with {
 #       page: page,
 #       search_action: path('app_vulnerability_index'),
 #       filter_keys: ['view', 'severity'],
 #       list_title: 'vulnerability.list'|trans({}, 'vulnerabilities'),
 #       empty: { title: 'vulnerability.empty'|trans({}, 'vulnerabilities'), actions: [...] },
 #   } %}
 #       {% block list_filters %}<div class="col-md-3">…</div>{% endblock %}
 #       {% block list_summary %}chips…{% endblock %}
 #       {% block list_table %}
 #           (re-import macros here: embed blocks do not see file-scope imports)
 #           <table>… {% for v in page %} … {% endfor %}</table>
 #       {% endblock %}
 #   {% endembed %}
 #
 # Params:
 #   page            App\Util\ListPage (required)
 #   search_action   form action; omit/false to hide the filter bar
 #   show_search     false keeps the filter bar but drops the text search (no `q` support)
 #   search_placeholder, filter_keys   passed to _search_filter_form
 #   list_title      card heading; the count is appended
 #   empty           fa-empty-state config for "nothing recorded yet"
 #   card_attrs      extra attributes on the table card as a map, values escaped
 #                   (e.g. { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': path(…) })
 #}
{% import '_components/_fa_empty_state.html.twig' as _fa_empty_state %}
{% import '_components/_fa_pager.html.twig' as _fa_pager %}
{% set _filtered = page.search is not empty or (filter_keys|default([])|filter(k => app.request.query.get(k) is not null and app.request.query.get(k) != '')|length > 0) %}

{% if search_action|default(false) %}
    {% set _filters_html %}{% block list_filters %}{% endblock %}{% endset %}
    {% include '_components/_search_filter_form.html.twig' with {
        action: search_action,
        show_search: show_search ?? true,
        search_placeholder: search_placeholder|default('ui.filter.search_placeholder'|trans({}, 'ui')),
        filter_keys: filter_keys|default([]),
        filters_html: _filters_html,
        form_id: 'list-filter-form',
    } only %}
{% endif %}

{% set _summary %}{% block list_summary %}{% endblock %}{% endset %}
{% if _summary|trim is not empty %}
    <div class="fa-list-page__summary d-flex flex-wrap gap-2 mb-3">{{ _summary }}</div>
{% endif %}

{% if page.isEmpty %}
    {% if _filtered %}
        {{ _fa_empty_state.render({
            mood: 'curious',
            title: page.search is not empty
                ? 'ui.pager.search_no_match'|trans({'%q%': page.search}, 'ui')
                : 'ui.pager.no_match'|trans({}, 'ui'),
        }) }}
    {% else %}
        {{ _fa_empty_state.render(empty|default({ mood: 'sleeping', title: 'ui.pager.no_match'|trans({}, 'ui') })) }}
    {% endif %}
{% else %}
    <section class="card fa-list-page__card"{% for _name, _value in card_attrs|default({}) %} {{ _name|e('html_attr') }}="{{ _value }}"{% endfor %}>
        {% if list_title|default(false) %}
            <div class="card-header">
                <h2 class="mb-0 h5">{{ list_title }} <span class="text-body-secondary fw-normal">({{ page.total }})</span></h2>
            </div>
        {% endif %}
        <div class="card-body p-0">
            {% block list_table %}{% endblock %}
        </div>
    </section>
    {{ _fa_pager.render(page) }}
{% endif %}
