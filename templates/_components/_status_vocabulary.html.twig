{#
 # One status → tone map per vocabulary (UI wave G, W7). The tables live in
 # App\Twig\StatusVocabulary (status words, severity scale, named vocabularies);
 # statuses without a lifecycle workflow (consents, import rows, compliance
 # results, coverage, health, async jobs, RAG, …) get their pill tone here
 # instead of a local colour map or a ternary chain in each template.
 # Lifecycle entities use _fa_status_chip (tone from the workflow place).
 #
 # Usage:
 #   {% import '_components/_status_vocabulary.html.twig' as _status %}
 #   {{ _status.pill('workflow', instance.status, ('workflow.status.' ~ instance.status)|trans({}, 'workflows')) }}
 #   {{ _status.pill('consent', consent.status, label, { size: 'sm' }) }}
 #
 #   {% set tone = status_tone('coverage', row.status) %}   (tone name only, e.g. for a card border)
 #
 # Unknown vocabulary or status → neutral. Props are those of _status_pill.
 #}
{% macro tone(vocabulary, status) %}
    {{- status_tone(vocabulary, status) -}}
{% endmacro %}

{% macro pill(vocabulary, status, label, props = {}) %}
    {% import '_components/_status_pill.html.twig' as _pill %}
    {{ _pill.render(label, status_tone(vocabulary, status), props) }}
{% endmacro %}
