<div data-controller="command-palette"
     data-command-palette-commands-value="{{ _cmds|json_encode|e('html_attr') }}"
     data-command-palette-search-url-value="{{ path('app_api_search') }}">
    <div class="command-palette-modal" data-command-palette-target="modal"
         role="dialog" aria-modal="true" aria-label="{{ 'ui.global_search.label'|trans({}, 'ui') }}">
        <div class="command-palette-container">
            {% import '_components/_alva.html.twig' as faAlva %}
            <span class="command-palette-alva" aria-hidden="true">{{ faAlva.render('thinking', { size: 24 })|raw }}</span>
            <div class="command-palette-search">
                <i class="fa-icon fa-icon--ui-search command-palette-search-icon" aria-hidden="true"></i>
                <label class="visually-hidden" for="command-palette-input">{{ 'ui.global_search.label'|trans({}, 'ui') }}</label>
                <input
                    type="text"
                    id="command-palette-input"
                    class="command-palette-input"
                    placeholder="{{ 'ui.command_palette.placeholder'|trans({}, 'ui') }}"
                    data-command-palette-target="input"
                    data-action="input->command-palette#search"
                    data-testid="command-palette-input"
                    role="combobox"
                    aria-expanded="true"
                    aria-controls="command-palette-results"
                    autocomplete="off"
                    spellcheck="false"
                >
                <kbd class="command-palette-hint">ESC</kbd>
            </div>

            <div class="command-palette-results" id="command-palette-results" role="listbox"
                 data-command-palette-target="results" aria-live="polite"></div>

            <div class="command-palette-no-results hidden" data-command-palette-target="noResults">
                <i class="fa-icon fa-icon--ui-search" aria-hidden="true"></i>
                <p>{{ 'ui.command_palette.no_results'|trans({}, 'ui') }}</p>
            </div>

            <div class="command-palette-footer">
                <div class="command-palette-shortcuts">
                    <span><kbd>↑</kbd> <kbd>↓</kbd> {{ 'ui.keyboard.navigation'|trans({}, 'ui') }}</span>
                    <span><kbd>↵</kbd> {{ 'ui.keyboard.select'|trans({}, 'ui') }}</span>
                    <span><kbd>ESC</kbd> {{ 'ui.keyboard.close'|trans({}, 'ui') }}</span>
                </div>
            </div>
        </div>
    </div>
</div>
