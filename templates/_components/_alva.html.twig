                            <path d="M0 -2.3 Q0.48 -0.48 2.3 0 Q0.48 0.48 0 2.3 Q-0.48 0.48 -2.3 0 Q-0.48 -0.48 0 -2.3 Z" fill="var(--alva-rim)" opacity="0.95"/>
                        </g>
                    </g>

                    {# Hand ÜBER dem Schaft — greift sichtbar zu #}
                    <ellipse class="fa-alva__hand" cx="50" cy="73" rx="1.85" ry="1.6" fill="var(--alva-fg)"
                             stroke="var(--primary)" stroke-width="0.4" stroke-opacity="0.42" style="transform-origin:50px 73px;"/>
                    <path class="fa-alva__detail" d="M48.65 72.55 Q50 71.45 51.35 72.55" stroke="var(--primary)" stroke-width="0.4" stroke-opacity="0.35" fill="none"/>

                    {# Funkenschweif unterhalb der Spitze #}
                    <circle class="fa-alva__wand-spark" cx="38" cy="88" r="0.6" fill="var(--accent)" style="transform-origin:38px 88px;"/>
                    <circle class="fa-alva__wand-spark fa-alva__wand-spark--2" cx="35.6" cy="90.6" r="0.5" fill="var(--primary)" style="transform-origin:35.6px 90.6px;"/>
                    <circle class="fa-alva__wand-spark fa-alva__wand-spark--3" cx="33.2" cy="93.2" r="0.4" fill="var(--accent)" style="transform-origin:33.2px 93.2px;"/>
                </g>

                {# Schlafend: Arm ruht am Körper, Stab weggelegt #}
                <g class="fa-alva__arm-rest">
                    <path d="M56.6 55.6 Q53.4 59.4 53.8 64.6" stroke="var(--primary)" stroke-width="2.5" stroke-opacity="0.32" stroke-linecap="round" fill="none"/>
                    <path d="M56.6 55.6 Q53.4 59.4 53.8 64.6" stroke="var(--alva-fg)" stroke-width="1.7" stroke-linecap="round" fill="none"/>
                    <circle cx="53.8" cy="65.6" r="1.5" fill="var(--alva-fg)" stroke="var(--primary)" stroke-width="0.4" stroke-opacity="0.42"/>
                </g>
            </g>

            {# Mood-spezifische Decorations (außerhalb Bob-Gruppe) #}
            {# SLEEPING: z z z #}
            <g class="fa-alva__deco fa-alva__deco--sleeping">
                <text class="fa-alva__zzz fa-alva__zzz--1" x="74" y="30" font-size="10" font-weight="600" fill="var(--fg-2)" opacity="0.85" font-family="monospace">z</text>
                <text class="fa-alva__zzz fa-alva__zzz--2" x="82" y="22" font-size="8"  font-weight="600" fill="var(--fg-2)" opacity="0.6" font-family="monospace">z</text>
                <text class="fa-alva__zzz fa-alva__zzz--3" x="88" y="16" font-size="6"  font-weight="600" fill="var(--fg-2)" opacity="0.42" font-family="monospace">z</text>
            </g>

