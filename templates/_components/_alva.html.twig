                            <circle cx="63" cy="38" r="1.4" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="63" cy="38.15" r="0.7" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="63.42" cy="37.55" r="0.42" fill="var(--alva-rim)" opacity="0.9"/>
