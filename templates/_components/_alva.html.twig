            </g>

            {# CELEBRATING: confetti #}
            <g class="fa-alva__deco fa-alva__deco--celebrating">
                <rect x="20" y="18" width="3" height="7" rx="0.6" fill="var(--alva-celebrating)" transform="rotate(20 21 21)"/>
