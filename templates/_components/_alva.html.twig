{#
 # FairyAurora v4 — Alva Character (9-Mood-SVG-Engine), Figur v2
 #
 # Usage:
 #   {% import '_components/_alva.html.twig' as alva %}
 #   {{ alva.render('idle') }}
 #   {{ alva.render('warning', { size: 80 }) }}
 #   {{ alva.render(mood, { size: 120, ariaLabel: 'Alva prüft die Daten' }) }}
 #
 # Moods:
 #   idle | happy | thinking | focused | working | scanning | warning | celebrating | sleeping
 #
 # Aura, Flügel, Körper, Kopf, Arme, Stab, Feenstaub und die mood-spezifischen
 # Decorations sind alle SVG-inline. Die CSS-Klasse .fa-alva--{mood} am Root
 # toggelt Sichtbarkeit + Animationen via assets/styles/alva.css — deshalb
 # kann alva_dock_controller.js den Mood zur Laufzeit per Klassentausch wechseln.
 #
 # Port aus dem Design-System `states/FairyCharacter.jsx` (v2, 2026-07).
 # Was im React-Original aus dem mood-Prop gerechnet wird (Handposition,
 # Armbeuge, Stab-Rotation, Staub-Anzahl), liegt hier als CSS-Custom-Property
 # pro Mood-Klasse — siehe alva.css § "Pro-Mood-Geometrie".
 #}

{% macro render(mood = 'idle', props = {}) %}
    {% set validMoods = ['idle','happy','thinking','focused','working','scanning','warning','celebrating','sleeping'] %}
    {% set m = mood in validMoods ? mood : 'idle' %}
    {% set size = props.size|default(120) %}
    {% set decorative = props.decorative|default(false) %}
    {% set uid = 'a' ~ random(999999) %}
    {# Unter 48px tragen 0.35–0.6px-Konturen nicht mehr — Compact-Modus reduziert
       auf die Silhouette (siehe alva.css § "Compact"). #}
    {% set classAttr = 'fa-alva fa-alva--' ~ m ~ (size < 48 ? ' fa-alva--compact' : '') ~ (props.class is defined ? ' ' ~ props.class : '') %}

    {# Feenstaub-Layout: die 10 Positionen der React-Fassung (dust = 10).
       Wie viele davon sichtbar sind, entscheidet die Mood-Klasse in CSS. #}
    {% set dustParticles = [
        { x: 90.00, y: 58.00, r: 0.50, d: '0s',    c: 'var(--accent)' },
        { x: 57.76, y: 90.95, r: 0.85, d: '0.47s', c: 'var(--primary)' },
        { x: 12.32, y: 53.41, r: 1.20, d: '0.94s', c: 'var(--alva-mood-color)' },
        { x: 65.15, y: 11.70, r: 0.50, d: '1.41s', c: 'var(--accent)' },
        { x: 97.97, y: 63.93, r: 0.85, d: '1.88s', c: 'var(--primary)' },
        { x: 46.38, y: 89.64, r: 1.20, d: '2.35s', c: 'var(--alva-mood-color)' },
        { x: 31.77, y: 44.47, r: 0.50, d: '2.82s', c: 'var(--accent)' },
        { x: 75.28, y: 14.76, r: 0.85, d: '0.09s', c: 'var(--primary)' },
        { x: 103.01, y: 69.55, r: 1.20, d: '0.56s', c: 'var(--alva-mood-color)' },
        { x: 45.15, y: 86.68, r: 0.50, d: '1.03s', c: 'var(--accent)' }
    ] %}

    <div class="{{ classAttr }}"
         style="width:{{ size }}px;height:{{ size }}px;"
         {% if decorative %}aria-hidden="true"
         {% else %}role="img" aria-label="{{ props.ariaLabel|default(('alva.mood.' ~ m)|trans({}, 'messages'))|default('Alva') }}"
         {% endif %}>
        <svg viewBox="0 0 120 120" fill="none" style="display:block;overflow:visible;width:100%;height:100%;">
            <defs>
                <radialGradient id="fcAura-{{ uid }}" cx="50%" cy="55%" r="55%">
                    <stop offset="0%"   class="fa-alva__aura-inner"/>
                    <stop offset="45%"  class="fa-alva__aura-mid"/>
                    <stop offset="100%" class="fa-alva__aura-outer"/>
                </radialGradient>

                {# Irisierende Flügelmembran — Rim → primary → accent → Mood-Tint #}
                <linearGradient id="fcWingL-{{ uid }}" x1="1" y1="0" x2="0" y2="1">
                    <stop offset="0%"   stop-color="var(--alva-rim)"        stop-opacity="0.75"/>
                    <stop offset="34%"  stop-color="var(--primary)"         stop-opacity="0.62"/>
                    <stop offset="68%"  stop-color="var(--accent)"          stop-opacity="0.42"/>
                    <stop offset="100%" stop-color="var(--alva-mood-color)" stop-opacity="0.16"/>
                </linearGradient>
                <linearGradient id="fcWingR-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%"   stop-color="var(--alva-rim)"        stop-opacity="0.75"/>
                    <stop offset="34%"  stop-color="var(--primary)"         stop-opacity="0.62"/>
                    <stop offset="68%"  stop-color="var(--accent)"          stop-opacity="0.42"/>
                    <stop offset="100%" stop-color="var(--alva-mood-color)" stop-opacity="0.16"/>
                </linearGradient>

                {# Körper-Volumen: Rim-Kante links, Schattenseite rechts #}
                <linearGradient id="fcBody-{{ uid }}" x1="0.2" y1="0" x2="0.9" y2="1">
                    <stop offset="0%"   stop-color="var(--alva-rim)" stop-opacity="0.95"/>
                    <stop offset="42%"  stop-color="var(--alva-fg)"/>
                    <stop offset="100%" stop-color="var(--alva-fg-sh)"/>
                </linearGradient>
                <radialGradient id="fcHead-{{ uid }}" cx="38%" cy="30%" r="78%">
                    <stop offset="0%"   stop-color="var(--alva-rim)"/>
                    <stop offset="52%"  stop-color="var(--alva-fg)"/>
                    <stop offset="100%" stop-color="var(--alva-fg-sh)"/>
                </radialGradient>

                {# Shimmer-Sweep über die Flügel #}
                <linearGradient id="fcShim-{{ uid }}" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%"   stop-color="var(--alva-rim)" stop-opacity="0"/>
                    <stop offset="50%"  stop-color="var(--alva-rim)" stop-opacity="0.5"/>
                    <stop offset="100%" stop-color="var(--alva-rim)" stop-opacity="0"/>
                </linearGradient>

                <clipPath id="fcWingClip-{{ uid }}">
                    <path d="M55 50 Q18 28 12 54 Q14 74 44 67 Q52 63 55 52 Z M65 50 Q102 28 108 54 Q106 74 76 67 Q68 63 65 52 Z"/>
                </clipPath>
                <clipPath id="fcClip-{{ uid }}"><rect x="0" y="0" width="120" height="120"/></clipPath>
                <filter id="fcSoft-{{ uid }}" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation="1.6"/>
                </filter>
            </defs>

            {# Aura #}
            <circle class="fa-alva__aura" cx="60" cy="62" r="56" fill="url(#fcAura-{{ uid }})"/>

            {# Kontakt-Glow am Boden — verankert die schwebende Figur #}
            <ellipse class="fa-alva__contact" cx="60" cy="103" rx="17" ry="3.2"
                     fill="var(--alva-mood-color)" opacity="0.2" filter="url(#fcSoft-{{ uid }})"/>

            {# Feenstaub — Anzahl mood-abhängig (CSS blendet die Überzähligen aus) #}
            <g class="fa-alva__dust">
                {% for p in dustParticles %}
                    <circle class="fa-alva__dust-particle" cx="{{ p.x }}" cy="{{ p.y }}" r="{{ p.r }}"
                            fill="{{ p.c }}" style="animation-delay:{{ p.d }};transform-origin:{{ p.x }}px {{ p.y }}px;"/>
                {% endfor %}
            </g>

            {# Scan-Line (nur mood=scanning sichtbar via CSS) #}
            <g class="fa-alva__scan" clip-path="url(#fcClip-{{ uid }})">
                <rect x="0" width="120" height="1.5" fill="var(--alva-mood-color)" opacity="0.9"/>
                <rect x="0" width="120" height="18" fill="var(--alva-mood-color)" opacity="0.12"/>
            </g>

            {# Body-Bob-Gruppe #}
            <g class="fa-alva__bob" style="transform-origin:60px 60px;">
                {# ══ Flügel ══ #}
                <g class="fa-alva__wings" style="transform-origin:60px 58px;">
                    {# Obere Membran #}
                    <path d="M55 50 Q18 28 12 54 Q14 74 44 67 Q52 63 55 52 Z"
                          fill="url(#fcWingL-{{ uid }})" stroke="var(--primary)" stroke-width="0.5" stroke-opacity="0.55"/>
                    <path d="M65 50 Q102 28 108 54 Q106 74 76 67 Q68 63 65 52 Z"
                          fill="url(#fcWingR-{{ uid }})" stroke="var(--primary)" stroke-width="0.5" stroke-opacity="0.55"/>
                    {# Aderwerk #}
                    <g class="fa-alva__veins" stroke="var(--alva-rim)" stroke-opacity="0.38" stroke-width="0.42" fill="none" stroke-linecap="round">
                        <path d="M54 51 Q38 44 20 50"/><path d="M54 53 Q36 53 17 58"/><path d="M54 55 Q38 61 24 66"/>
                        <path d="M66 51 Q82 44 100 50"/><path d="M66 53 Q84 53 103 58"/><path d="M66 55 Q82 61 96 66"/>
                    </g>
                    {# Untere Membran #}
                    <path d="M56 64 Q32 71 30 87 Q39 93 54 82 Q58 76 56 66 Z"
                          fill="url(#fcWingL-{{ uid }})" opacity="0.66" stroke="var(--accent)" stroke-width="0.4" stroke-opacity="0.4"/>
                    <path d="M64 64 Q88 71 90 87 Q81 93 66 82 Q62 76 64 66 Z"
                          fill="url(#fcWingR-{{ uid }})" opacity="0.66" stroke="var(--accent)" stroke-width="0.4" stroke-opacity="0.4"/>
                    <g class="fa-alva__veins" stroke="var(--alva-rim)" stroke-opacity="0.3" stroke-width="0.38" fill="none" stroke-linecap="round">
                        <path d="M55 67 Q42 74 34 84"/><path d="M65 67 Q78 74 86 84"/>
                    </g>
                    {# Shimmer-Sweep #}
                    <g clip-path="url(#fcWingClip-{{ uid }})">
                        <rect class="fa-alva__shimmer" x="-40" y="20" width="26" height="80" fill="url(#fcShim-{{ uid }})"/>
                    </g>
                    {# Flügelspitzen-Lichter #}
                    <circle class="fa-alva__wingtip fa-alva__wingtip--l" cx="24" cy="50" r="1.3" fill="var(--accent)" opacity="0.85"/>
                    <circle class="fa-alva__wingtip fa-alva__wingtip--r" cx="96" cy="50" r="1.3" fill="var(--accent)" opacity="0.85"/>
                </g>

                {# ══ Körper ══ — helle Familie in beiden Themes via --alva-fg #}
                <path d="M60 44 Q64.8 46 64.8 54 Q63.2 58 63.2 62 Q64.8 66 64.2 74 Q62 80.5 60 82.5 Q58 80.5 55.8 74 Q55.2 66 56.8 62 Q56.8 58 55.2 54 Q55.2 46 60 44 Z"
                      fill="url(#fcBody-{{ uid }})" stroke="var(--primary)" stroke-width="0.35" stroke-opacity="0.3"/>
                {# Rim-Light links #}
                <path class="fa-alva__rim" d="M57.4 47 Q55.4 52 56.6 61 Q55.6 68 57 78"
                      stroke="var(--alva-rim)" stroke-opacity="0.55" stroke-width="0.6" fill="none" stroke-linecap="round"/>
                {# Rock-Abschluss — beendet den Körper statt ihn auslaufen zu lassen #}
                <path d="M56.6 70 Q54.4 77 53.2 82.6 Q56.6 84.4 60 84.6 Q63.4 84.4 66.8 82.6 Q65.6 77 63.4 70 Q60 71.6 56.6 70 Z"
                      fill="url(#fcBody-{{ uid }})" stroke="var(--primary)" stroke-width="0.32" stroke-opacity="0.28"/>
                <path class="fa-alva__detail" d="M53.2 82.6 Q60 85.4 66.8 82.6" stroke="var(--accent)" stroke-width="0.5" stroke-opacity="0.5" fill="none"/>
                {# Gürtel-Akzent #}
                <path class="fa-alva__detail" d="M56.6 62 Q60 63.4 63.4 62" stroke="var(--accent)" stroke-width="0.7" stroke-opacity="0.65" fill="none" stroke-linecap="round"/>
                <circle class="fa-alva__detail" cx="60" cy="62.9" r="0.75" fill="var(--accent)" opacity="0.9"/>

                {# ══ Rechter Arm ══ — ruht; Kontur + Füllung, sonst geht er auf den Flügeln unter #}
                <path d="M63.4 55.6 Q67.2 59.4 67.4 64.8" stroke="var(--primary)" stroke-width="2.5" stroke-opacity="0.32" stroke-linecap="round" fill="none"/>
                <path d="M63.4 55.6 Q67.2 59.4 67.4 64.8" stroke="var(--alva-fg)" stroke-width="1.7" stroke-linecap="round" fill="none"/>
                <circle cx="67.5" cy="65.8" r="1.5" fill="var(--alva-fg)" stroke="var(--primary)" stroke-width="0.4" stroke-opacity="0.42"/>

                {# ══ Kopf ══ #}
                <g class="fa-alva__head" style="transform-origin:60px 39px;">
                    {# Haar hinten #}
                    <path d="M52 40 Q50 32 55 28 Q60 25.4 65 28 Q70 32 68 40 Q66 34 60 32.6 Q54 34 52 40 Z" fill="var(--primary)" opacity="0.5"/>
                    <ellipse cx="60" cy="39" rx="7.8" ry="8.7" fill="url(#fcHead-{{ uid }})" stroke="var(--primary)" stroke-width="0.35" stroke-opacity="0.32"/>
                    {# Haar vorn: Pony + vier Strähnen #}
                    <path d="M52.6 36.5 Q54 30.4 60 29.6 Q66 30.4 67.4 36.5 Q64.6 32.8 60 33.4 Q55.4 32.8 52.6 36.5 Z" fill="var(--primary)" opacity="0.72"/>
                    <path class="fa-alva__strand" d="M52.4 37 Q49.6 32.4 48.4 27.6" stroke="var(--primary)" stroke-width="0.85" stroke-linecap="round" fill="none" opacity="0.7"/>
                    <path class="fa-alva__strand" d="M67.6 37 Q70.4 32.4 71.6 27.6" stroke="var(--primary)" stroke-width="0.85" stroke-linecap="round" fill="none" opacity="0.7"/>
                    <path class="fa-alva__strand" d="M50.8 39.6 Q47.8 37.6 46.6 33.8" stroke="var(--primary)" stroke-width="0.6" stroke-linecap="round" fill="none" opacity="0.5"/>
                    <path class="fa-alva__strand" d="M69.2 39.6 Q72.2 37.6 73.4 33.8" stroke="var(--primary)" stroke-width="0.6" stroke-linecap="round" fill="none" opacity="0.5"/>
                    {# Diadem — Bogen + Edelstein + zwei Fassungspunkte #}
                    <path d="M53.6 32.2 Q60 28.8 66.4 32.2" stroke="var(--accent)" stroke-width="0.75" stroke-linecap="round" fill="none" opacity="0.85"/>
                    <circle cx="60" cy="29.6" r="1.05" fill="var(--accent)"/>
                    <circle class="fa-alva__gem" cx="60" cy="29.6" r="2.1" fill="var(--accent)" opacity="0.28" style="transform-origin:60px 29.6px;"/>
                    <circle class="fa-alva__detail" cx="55.2" cy="31.2" r="0.5" fill="var(--alva-rim)" opacity="0.85"/>
                    <circle class="fa-alva__detail" cx="64.8" cy="31.2" r="0.5" fill="var(--alva-rim)" opacity="0.85"/>

                    {# Gesichter pro Mood — alle gerendert, CSS zeigt das aktive #}
                    {# IDLE / default #}
                    <g class="fa-alva__face fa-alva__face--idle">
                        <path d="M54.8 34.8 Q57 33.7 59.2 34.7" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <path d="M60.8 34.7 Q63 33.7 65.2 34.8" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <g class="fa-alva__eye" style="transform-origin:57px 38px;">
                            <ellipse cx="57" cy="38.9" rx="1.95" ry="0.73" fill="var(--accent)" opacity="0.1"/>
                            <circle cx="57" cy="38" r="1.45" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="57" cy="38.15" r="0.73" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="57.42" cy="37.55" r="0.44" fill="var(--alva-rim)" opacity="0.9"/>
                            <circle cx="56.6" cy="38.5" r="0.23" fill="var(--alva-rim)" opacity="0.54"/>
                        </g>
                        <g class="fa-alva__eye fa-alva__eye--r" style="transform-origin:63px 38px;">
                            <ellipse cx="63" cy="38.9" rx="1.95" ry="0.73" fill="var(--accent)" opacity="0.1"/>
                            <circle cx="63" cy="38" r="1.45" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="63" cy="38.15" r="0.73" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="63.42" cy="37.55" r="0.44" fill="var(--alva-rim)" opacity="0.9"/>
                            <circle cx="62.6" cy="38.5" r="0.23" fill="var(--alva-rim)" opacity="0.54"/>
                        </g>
                        <ellipse cx="53.6" cy="40.4" rx="1.9" ry="1.2" fill="var(--alva-celebrating)" opacity="0.26"/>
                        <ellipse cx="66.4" cy="40.4" rx="1.9" ry="1.2" fill="var(--alva-celebrating)" opacity="0.26"/>
                        <path d="M57.3 42.3 Q60 43.9 62.7 42.3" stroke="var(--alva-ink)" stroke-width="0.7" stroke-linecap="round" fill="none" opacity="0.85"/>
                    </g>
                    {# THINKING #}
                    <g class="fa-alva__face fa-alva__face--thinking">
                        <path d="M54.8 34.6 Q57 33.6 59 34.4" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <path d="M61 34.4 Q63 33.2 65.2 34" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <g class="fa-alva__eye" style="transform-origin:57px 37.6px;">
                            <ellipse cx="57" cy="38.5" rx="1.95" ry="0.73" fill="var(--accent)" opacity="0.1"/>
                            <circle cx="57" cy="37.6" r="1.45" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="57" cy="37.75" r="0.73" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="57.42" cy="37.15" r="0.44" fill="var(--alva-rim)" opacity="0.9"/>
                        </g>
                        <g class="fa-alva__eye fa-alva__eye--r" style="transform-origin:63px 37.6px;">
                            <ellipse cx="63" cy="38.5" rx="1.95" ry="0.73" fill="var(--accent)" opacity="0.1"/>
                            <circle cx="63" cy="37.6" r="1.45" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="63" cy="37.75" r="0.73" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="63.42" cy="37.15" r="0.44" fill="var(--alva-rim)" opacity="0.9"/>
                        </g>
                        <circle cx="60" cy="42.6" r="0.75" fill="var(--alva-ink)" opacity="0.72"/>
                    </g>
                    {# WARNING #}
                    <g class="fa-alva__face fa-alva__face--warning">
                        <path d="M54.6 34 Q57 32.8 59.2 34.2" stroke="var(--primary)" stroke-width="0.6" stroke-linecap="round" fill="none" opacity="0.7"/>
                        <path d="M60.8 34.2 Q63 32.8 65.4 34" stroke="var(--primary)" stroke-width="0.6" stroke-linecap="round" fill="none" opacity="0.7"/>
                        <g>
                            <ellipse cx="57" cy="38.9" rx="2.2" ry="0.85" fill="var(--accent)" opacity="0.1"/>
                            <circle cx="57" cy="38" r="1.7" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="57" cy="38.15" r="0.85" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="57.42" cy="37.55" r="0.51" fill="var(--alva-rim)" opacity="0.9"/>
                        </g>
                        <g>
                            <ellipse cx="63" cy="38.9" rx="2.2" ry="0.85" fill="var(--accent)" opacity="0.1"/>
                            <circle cx="63" cy="38" r="1.7" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="63" cy="38.15" r="0.85" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="63.42" cy="37.55" r="0.51" fill="var(--alva-rim)" opacity="0.9"/>
                        </g>
                        <line x1="58" y1="42.7" x2="62" y2="42.7" stroke="var(--alva-ink)" stroke-width="0.8" stroke-linecap="round"/>
                    </g>
                    {# HAPPY / CELEBRATING #}
                    <g class="fa-alva__face fa-alva__face--happy">
                        <path d="M54.6 34.8 Q57 33.4 59.2 34.6" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <path d="M60.8 34.6 Q63 33.4 65.4 34.8" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <path d="M55.2 38.6 Q57 36.8 58.8 38.6" stroke="var(--alva-ink)" stroke-width="0.95" stroke-linecap="round" fill="none"/>
                        <path d="M61.2 38.6 Q63 36.8 64.8 38.6" stroke="var(--alva-ink)" stroke-width="0.95" stroke-linecap="round" fill="none"/>
                        <path d="M56.4 41.6 Q60 44.8 63.6 41.6" stroke="var(--alva-ink)" stroke-width="0.9" stroke-linecap="round" fill="none"/>
                        <path d="M57.6 42.6 Q60 44.2 62.4 42.6" fill="var(--alva-celebrating)" opacity="0.35"/>
                        <ellipse cx="53.6" cy="40.4" rx="1.9" ry="1.2" fill="var(--alva-celebrating)" opacity="0.38"/>
                        <ellipse cx="66.4" cy="40.4" rx="1.9" ry="1.2" fill="var(--alva-celebrating)" opacity="0.38"/>
                    </g>
                    {# FOCUSED — schmale, entschlossene Augen #}
                    <g class="fa-alva__face fa-alva__face--focused">
                        <path d="M54.4 34.6 Q57 33.2 59.4 34.8" stroke="var(--primary)" stroke-width="0.62" stroke-linecap="round" fill="none" opacity="0.72"/>
                        <path d="M60.6 34.8 Q63 33.2 65.6 34.6" stroke="var(--primary)" stroke-width="0.62" stroke-linecap="round" fill="none" opacity="0.72"/>
                        <path d="M55 38.2 L59 38.2" stroke="var(--alva-ink)" stroke-width="1.25" stroke-linecap="round"/>
                        <path d="M61 38.2 L65 38.2" stroke="var(--alva-ink)" stroke-width="1.25" stroke-linecap="round"/>
                        <circle cx="57.4" cy="37.9" r="0.28" fill="var(--alva-rim)" opacity="0.8"/>
                        <circle cx="63.4" cy="37.9" r="0.28" fill="var(--alva-rim)" opacity="0.8"/>
                        <path d="M58.5 42.4 Q60 42.9 61.5 42.4" stroke="var(--alva-ink)" stroke-width="0.7" stroke-linecap="round" fill="none"/>
                    </g>
                    {# SCANNING — Iris im Mood-Cyan + pulsende Ringe #}
                    <g class="fa-alva__face fa-alva__face--scanning">
                        <path d="M54.8 34.6 Q57 33.6 59.2 34.6" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <path d="M60.8 34.6 Q63 33.6 65.2 34.6" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <g>
                            <ellipse cx="57" cy="38.9" rx="1.95" ry="0.73" fill="var(--alva-mood-color)" opacity="0.1"/>
                            <circle cx="57" cy="38" r="1.45" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="57" cy="38.15" r="0.73" fill="var(--alva-mood-color)" opacity="0.5"/>
                            <circle cx="57.42" cy="37.55" r="0.44" fill="var(--alva-rim)" opacity="0.9"/>
