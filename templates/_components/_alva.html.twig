                            <circle cx="63" cy="38" r="1.45" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="63" cy="38.15" r="0.73" fill="var(--alva-mood-color)" opacity="0.5"/>
                            <circle cx="63.42" cy="37.55" r="0.44" fill="var(--alva-rim)" opacity="0.9"/>
                        </g>
                        <circle class="fa-alva__scan-ring" cx="57" cy="38" r="2.4" stroke="var(--alva-mood-color)" stroke-width="0.3" fill="none" opacity="0.65" style="transform-origin:57px 38px;"/>
                        <circle class="fa-alva__scan-ring fa-alva__scan-ring--r" cx="63" cy="38" r="2.4" stroke="var(--alva-mood-color)" stroke-width="0.3" fill="none" opacity="0.65" style="transform-origin:63px 38px;"/>
                        <path d="M57.3 42.3 Q60 43.3 62.7 42.3" stroke="var(--alva-ink)" stroke-width="0.7" stroke-linecap="round" fill="none" opacity="0.85"/>
                    </g>
                    {# WORKING #}
                    <g class="fa-alva__face fa-alva__face--working">
                        <path d="M54.8 34.8 Q57 33.8 59.2 34.6" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <path d="M60.8 34.6 Q63 33.8 65.2 34.8" stroke="var(--primary)" stroke-width="0.55" stroke-linecap="round" fill="none" opacity="0.55"/>
                        <g class="fa-alva__eye" style="transform-origin:57px 38px;">
                            <ellipse cx="57" cy="38.9" rx="1.9" ry="0.7" fill="var(--accent)" opacity="0.1"/>
                            <circle cx="57" cy="38" r="1.4" fill="var(--alva-ink)" opacity="0.94"/>
                            <circle cx="57" cy="38.15" r="0.7" fill="var(--accent)" opacity="0.5"/>
                            <circle cx="57.42" cy="37.55" r="0.42" fill="var(--alva-rim)" opacity="0.9"/>
                        </g>
                        <g class="fa-alva__eye fa-alva__eye--r" style="transform-origin:63px 38px;">
