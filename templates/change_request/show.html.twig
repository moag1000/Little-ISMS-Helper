{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
{% import '_components/_fa_status_chip.html.twig' as _fa_status_chip %}
{% import '_components/_lifecycle_actions.html.twig' as _lifecycle_actions %}
{% trans_default_domain 'change_requests' %}

{% block title %}{{ change_request.changeNumber }}{% endblock %}

{% block body %}
<div class="container">
    {# M-4 — module-gating: Change Management (ISO 27001 A.8.32) #}
    {% if not is_module_active('change_requests') %}
        {{ _fa_alert.render({
            variant: 'info',
            icon: 'nav-shield-alert',
            body: 'common.module_not_active'|trans({'%module%': 'Change Management'}, 'messages')
        }) }}
    {% else %}
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.change_requests'|trans({}, 'nav'), url: path('app_change_request_index') },
            { label: change_request.changeNumber }
        ]
    } %}

    {{ _fa_page_header.render({
        badge: { icon: 'util-refresh', label: change_request.changeNumber },
        title: change_request.title,
        actions: [
            { label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit', href: path('app_change_request_edit', {id: change_request.id}) },
            { label: 'common.back'|trans({}, 'messages'), variant: 'ghost', href: path('app_change_request_index') }
        ]
    }) }}

    {% set _status %}{{ _fa_status_chip.render({ entity_class: 'App\\Entity\\ChangeRequest', status_key: change_request.status }) }}{% endset %}
    {% set _actions %}{{ _lifecycle_actions.dropdown(change_request, 'change-request', 'change_request_lifecycle') }}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'show.status.priority'|trans({}, 'messages'), value: change_request.priority },
            { label: 'show.status.type'|trans({}, 'messages'), value: change_request.changeType },
            { label: 'change_request.field.requested_by'|trans({}, 'change_requests'), value: change_request.requestedBy },
            { label: 'change_request.field.planned_implementation'|trans({}, 'change_requests'), value: change_request.plannedImplementationDate ? change_request.plannedImplementationDate|fa_date : null },
        ],
        workflow: workflow_state(change_request),
    }) }}

    {% set _links = entity_links(change_request) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: change_request } only %}

    {# Inline POST-delete kept below header (cannot be expressed via _fa_page_header GET-only actions) #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="d-flex justify-content-end mb-3">
            <form method="post" action="{{ path('app_change_request_delete', {id: change_request.id}) }}" class="d-inline"
                  data-controller="ui-actions"
                  data-action="submit->ui-actions#confirm"
                  data-ui-actions-message-param="{{ 'change_request.confirm.delete'|trans({}, 'change_requests') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ change_request.id) }}">
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger"><i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}</button>
            </form>
        </div>
    {% endif %}

    <div id="details" class="fa-show-section">
    {% embed '_components/_card.html.twig' %}
        {% block card_header %}
            <div class="card-header">
                <h2>{{ 'change_request.details.title'|trans({}, 'change_requests') }}</h2>
                <div>
                    <span class="fa-status-pill fa-status-pill--neutral">{{ ('change_request.change_type.' ~ change_request.changeType)|trans({}, 'change_requests') }}</span>
                    <span class="fa-status-pill fa-status-pill--{{ pill_tone_severity(change_request.priority) }}">{{ ('change_request.priority.' ~ change_request.priority)|trans({}, 'change_requests') }}</span>
                </div>
            </div>
        {% endblock %}
        {% block card_body %}
            {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info' } } %}
                {% block alert_body %}<strong>{{ 'change_request.field.complexity_score'|trans({}, 'change_requests') }} {{ change_request.getComplexityScore() }}</strong>{% endblock %}
            {% endembed %}

            <div class="detail-grid">
                <div class="detail-item">
                    <span class="label">{{ 'change_request.field.requested_by'|trans({}, 'change_requests') }}</span>
                    <span class="value">{{ change_request.requestedBy }}</span>
                </div>
                <div class="detail-item">
                    <span class="label">{{ 'change_request.field.requested_date'|trans({}, 'change_requests') }}</span>
                    <span class="value">{{ change_request.requestedDate|fa_date }}</span>
                </div>
                <div class="detail-item">
                    <span class="label">{{ 'change_request.field.planned_implementation'|trans({}, 'change_requests') }}</span>
                    <span class="value">{{ change_request.plannedImplementationDate ? change_request.plannedImplementationDate|fa_date : ('change_request.status.not_scheduled'|trans({}, 'change_requests')) }}</span>
                </div>
            </div>

            <div class="detail-section">
                <h3>{{ 'change_request.section.description'|trans({}, 'change_requests') }}</h3>
                <p>{{ change_request.description|nl2br }}</p>
            </div>

            <div class="detail-section">
                <h3>{{ 'change_request.section.justification'|trans({}, 'change_requests') }}</h3>
                <p>{{ change_request.justification|nl2br }}</p>
            </div>

            {% if change_request.ismsImpact %}
            <div class="detail-section alert-info">
                <h3>{{ 'change_request.section.impact'|trans({}, 'change_requests') }}</h3>
                <p>{{ change_request.ismsImpact|nl2br }}</p>
            </div>
            {% endif %}

            {% if change_request.riskAssessment %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.risk_assessment'|trans({}, 'change_requests') }}</h3>
                <p>{{ change_request.riskAssessment|nl2br }}</p>
            </div>
            {% endif %}

            {% if change_request.implementationPlan %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.plan'|trans({}, 'change_requests') }}</h3>
                <p>{{ change_request.implementationPlan|nl2br }}</p>
            </div>
            {% endif %}

            {% if change_request.rollbackPlan %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.rollback_plan'|trans({}, 'change_requests') }}</h3>
                <p>{{ change_request.rollbackPlan|nl2br }}</p>
            </div>
            {% endif %}

            {% if change_request.testingRequirements %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.testing_requirements'|trans({}, 'change_requests') }}</h3>
                <p>{{ change_request.testingRequirements|nl2br }}</p>
            </div>
            {% endif %}

            {% if change_request.approvedBy %}
            <div class="detail-section alert-success">
                <h3>{{ 'change_request.section.approval_info'|trans({}, 'change_requests') }}</h3>
                <p><strong>{{ 'change_request.field.approved_by'|trans({}, 'change_requests') }}</strong> {{ change_request.approvedBy }}</p>
                <p><strong>{{ 'change_request.field.approval_date'|trans({}, 'change_requests') }}</strong> {{ change_request.approvedDate|fa_datetime }}</p>
                {% if change_request.approvalComments %}
                <p><strong>{{ 'change_request.field.comments'|trans({}, 'change_requests') }}</strong> {{ change_request.approvalComments }}</p>
                {% endif %}
            </div>
            {% endif %}

            {% if change_request.implementedBy %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.implementation'|trans({}, 'change_requests') }}</h3>
                <p><strong>{{ 'change_request.field.implemented_by'|trans({}, 'change_requests') }}</strong> {{ change_request.implementedBy }}</p>
                <p><strong>{{ 'change_request.field.implementation_date'|trans({}, 'change_requests') }}</strong> {{ change_request.actualImplementationDate|fa_date }}</p>
                {% if change_request.implementationNotes %}
                <p><strong>{{ 'change_request.field.notes'|trans({}, 'change_requests') }}</strong> {{ change_request.implementationNotes|nl2br }}</p>
                {% endif %}
            </div>
            {% endif %}

            {% if change_request.verifiedBy %}
            <div class="detail-section alert-success">
                <h3>{{ 'change_request.section.verification'|trans({}, 'change_requests') }}</h3>
                <p><strong>{{ 'change_request.field.verified_by'|trans({}, 'change_requests') }}</strong> {{ change_request.verifiedBy }}</p>
                <p><strong>{{ 'change_request.field.verification_date'|trans({}, 'change_requests') }}</strong> {{ change_request.verifiedDate|fa_date }}</p>
                {% if change_request.verificationResults %}
                <p><strong>{{ 'change_request.field.results'|trans({}, 'change_requests') }}</strong> {{ change_request.verificationResults|nl2br }}</p>
                {% endif %}
            </div>
            {% endif %}

            {% if change_request.status == 'closed' %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.closure'|trans({}, 'change_requests') }}</h3>
                <p><strong>{{ 'change_request.field.closed_date'|trans({}, 'change_requests') }}</strong> {{ change_request.closedDate|fa_date }}</p>
                {% if change_request.closureNotes %}
                <p><strong>{{ 'change_request.field.notes'|trans({}, 'change_requests') }}</strong> {{ change_request.closureNotes }}</p>
                {% endif %}
            </div>
            {% endif %}

            {% if change_request.affectedAssets|length > 0 %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.affected_assets'|trans({'%count%': change_request.affectedAssets|length}, 'change_requests') }}</h3>
                <ul>
                    {% for asset in change_request.affectedAssets %}
                    <li><a href="{{ path('app_asset_show', {id: asset.id}) }}">{{ asset.name }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if change_request.affectedControls|length > 0 %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.affected_controls'|trans({'%count%': change_request.affectedControls|length}, 'change_requests') }}</h3>
                <ul>
                    {% for control in change_request.affectedControls %}
                    <li><a href="{{ path('app_soa_show', {id: control.id}) }}">{% include '_components/_iso_reference_label.html.twig' with { control: control } only %}</a></li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if change_request.associatedRisks|length > 0 %}
            <div class="detail-section">
                <h3>{{ 'change_request.section.associated_risks'|trans({'%count%': change_request.associatedRisks|length}, 'change_requests') }}</h3>
                <ul>
                    {% for risk in change_request.associatedRisks %}
                    <li><a href="{{ path('app_risk_show', {id: risk.id}) }}">{{ risk.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        {% endblock %}
    {% endembed %}
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: change_request, lifecycle: 'change-request' } only %}
    {% endif %} {# /M-4 change_requests module gate #}
</div>
{% endblock %}
