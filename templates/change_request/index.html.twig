{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'change_requests' %}

{% block title %}{{ 'change_request.title'|trans({}, 'change_requests') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.change_requests'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'change_request.page.title'|trans({}, 'change_requests'),
        actions: [
            { label: 'change_request.action.create'|trans({}, 'change_requests'), href: path('app_change_request_new'), variant: 'primary', icon: 'plus', attrs: {'data-turbo-frame': 'fa-form-modal'} }
        ]
    }) }}
{% set _global_hints = alva_hints('change_request_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_change_request_index'),
        list_title: 'change_request.list.title'|trans({}, 'change_requests'),
        empty: {
            mood: 'sleeping',
            title: 'change_request.empty.message'|trans({}, 'change_requests'),
            actions: [
                { label: 'change_request.empty.create_first'|trans({}, 'change_requests'), variant: 'primary', icon: 'plus', href: path('app_change_request_new') }
            ]
        },
        card_attrs: 'data-controller="bulk-actions" data-bulk-actions-endpoint-value="/' ~ app.request.locale ~ '/change-request"',
    } %}
        {% block list_summary %}
            {% if statistics.pending_approval|default(0) > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'change_request.summary.pending_approval'|trans({'%count%': statistics.pending_approval}, 'change_requests') }}</span>{% endif %}
            {% if statistics.in_implementation|default(0) > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'change_request.summary.in_implementation'|trans({'%count%': statistics.in_implementation}, 'change_requests') }}</span>{% endif %}
            {% if statistics.overdue|default(0) > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'change_request.summary.overdue'|trans({'%count%': statistics.overdue}, 'change_requests') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with {
                'noMargin': true
            } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'change_request.table.change_number'|trans({}, 'change_requests') }}</th>
                        <th scope="col">{{ 'change_request.table.title'|trans({}, 'change_requests') }}</th>
                        <th scope="col">{{ 'change_request.table.type'|trans({}, 'change_requests') }}</th>
                        <th scope="col">{{ 'change_request.table.priority'|trans({}, 'change_requests') }}</th>
                        <th scope="col">{{ 'change_request.table.status'|trans({}, 'change_requests') }}</th>
                        <th scope="col">{{ 'change_request.table.complexity'|trans({}, 'change_requests') }}</th>
                        <th scope="col">{{ 'change_request.table.requested'|trans({}, 'change_requests') }}</th>
                        <th scope="col">{{ 'change_request.table.actions'|trans({}, 'change_requests') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="change-request-rows"{% endblock %}
                {% block table_body %}
                    {% set workflowStates = workflow_states(page) %}
                    {% for change in page %}
                        {% include 'change_request/_row.html.twig' with { change: change } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}

            {% include '_components/_bulk_action_bar.html.twig' with {
                actions: ['export', 'delete']
            } %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
