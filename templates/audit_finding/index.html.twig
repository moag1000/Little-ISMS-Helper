{% extends 'base.html.twig' %}
{% trans_default_domain 'audits' %}

{% block title %}{{ 'audit_finding.page.title'|trans({}, 'audits') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'audits.page.title'|trans({}, 'audits'), url: path('app_audit_index') },
        { label: 'audit_finding.page.title'|trans({}, 'audits') }
    ]
} %}
{{ _fa_page_header.render({
    title: 'audit_finding.page.title'|trans({}, 'audits'),
    subtitle: 'audit_finding.page.subtitle'|trans({}, 'audits'),
    actions: [
        { label: 'audit_finding.action.new'|trans({}, 'audits'), href: path('app_audit_finding_new'), variant: 'primary', icon: 'plus', attrs: {'data-turbo-frame': 'fa-form-modal'} }
    ]|merge(is_granted('ROLE_MANAGER') ? [{ label: 'filtered_export.button.label'|trans({}, 'filtered_export'), href: path('app_filtered_export_entity', { entityType: 'audit_finding', format: 'xlsx' }) ~ (app.request.queryString ? '?' ~ app.request.queryString : ''), variant: 'ghost', icon: 'nav-file-earmark-spreadsheet', attrs: {'data-turbo-prefetch': 'false', 'data-turbo': 'false'} }] : [])
}) }}
    {% include '_components/_focus_filter_notice.html.twig' with { focus: focus|default(null), count: page.total } %}
{% set _global_hints = alva_hints('audit_finding_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

<div class="container-fluid py-4">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_audit_finding_index'),
    filter_keys: ['status', 'severity', 'focus'],
    list_title: 'audit_finding.page.title'|trans({}, 'audits'),
    empty: {
        mood: 'celebrating',
        title: 'audit_finding.message.no_findings'|trans({}, 'audits'),
        text: 'audit_finding.empty.body'|trans({}, 'audits'),
        norm_ref: 'ISO 27001 Klausel 9.2 · ISO 19011',
        actions: [
            { label: 'audit_finding.action.new'|trans({}, 'audits'), variant: 'primary', icon: 'plus', href: path('app_audit_finding_new'), attrs: {'data-turbo-frame': 'fa-form-modal'} }
        ],
        help_link: 'audit_finding.help.empty_link'|trans({}, 'audits')
    },
} %}
    {% block list_filters %}
        <div class="col-md-4">
            <label for="status" class="form-label">{{ 'audit_finding.field.status'|trans({}, 'audits') }}</label>
            <select name="status" id="status" class="form-select fa-cyber-input__field" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                {% for st in ['open', 'in_progress', 'resolved', 'verified', 'closed'] %}
                    <option value="{{ st }}" {% if selected_status == st %}selected{% endif %}>{{ ('audit_finding.status.' ~ st)|trans({}, 'audits') }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4">
            <label for="severity" class="form-label">{{ 'audit_finding.field.severity'|trans({}, 'audits') }}</label>
            <select name="severity" id="severity" class="form-select fa-cyber-input__field" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="">{{ 'common.all'|trans({}, 'messages') }}</option>
                {% for sv in ['critical', 'high', 'medium', 'low'] %}
                    <option value="{{ sv }}" {% if selected_severity == sv %}selected{% endif %}>{{ ('audit_finding.severity.' ~ sv)|trans({}, 'audits') }}</option>
                {% endfor %}
            </select>
        </div>
    {% endblock %}
    {% block list_summary %}
        {% if critical_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'audit_finding.summary.critical'|trans({'%count%': critical_count}, 'audits') }}</span>{% endif %}
        {% if high_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'audit_finding.summary.high'|trans({'%count%': high_count}, 'audits') }}</span>{% endif %}
        {% if overdue_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'audit_finding.summary.overdue'|trans({'%count%': overdue_count}, 'audits') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        <table class="fa-table fa-table--hover">
            <thead class="fa-table__head">
                <tr>
                    <th scope="col" class="fa-table__th">{{ 'audit_finding.field.title'|trans({}, 'audits') }}</th>
                    <th scope="col" class="fa-table__th">{{ 'audit_finding.field.type'|trans({}, 'audits') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--center">{{ 'audit_finding.field.severity'|trans({}, 'audits') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--center">{{ 'audit_finding.field.status'|trans({}, 'audits') }}</th>
                    <th scope="col" class="fa-table__th">{{ 'audit_finding.field.audit'|trans({}, 'audits') }}</th>
                    <th scope="col" class="fa-table__th">{{ 'audit_finding.field.due_date'|trans({}, 'audits') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--actions">{{ 'common.actions'|trans({}, 'messages') }}</th>
                </tr>
            </thead>
            <tbody class="fa-table__body" id="audit-finding-rows">
                {% set workflowStates = workflow_states(page) %}
                {% for f in page %}
                    {% include 'audit_finding/_row.html.twig' with { finding: f } %}
                {% endfor %}
            </tbody>
        </table>
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
