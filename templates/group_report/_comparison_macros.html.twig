{# Tables of the Organisationsvergleich — one markup for page and PDF.
   Cells are KPI-catalog items ({value, unit, status, na}); kpi_value formats them
   like every dashboard tile. Traffic light: good / warning / danger of the
   organisation's own KPI thresholds, shown with the report-doc status chips. #}

{% macro cell(item) %}
    {%- set _chip = item is null ? null : ({good: 'final', warning: 'draft', danger: 'confidential'}[item.status ?? ''] ?? null) -%}
    {%- if item is null -%}
        <span class="text-body-secondary">–</span>
    {%- elseif _chip -%}
        <span class="report-doc__chip report-doc__chip--status-{{ _chip }}">{{ item|kpi_value }}</span>
    {%- else -%}
        {{ item|kpi_value }}
    {%- endif -%}
{% endmacro %}

{% macro group_cell(item) %}
    {%- if item is null -%}
        <span class="text-body-secondary">–</span>
    {%- else -%}
        <strong>{{ item.mode == 'avg' ? 'Ø ' : 'Σ ' }}{{ item|kpi_value }}</strong>
    {%- endif -%}
{% endmacro %}

{% macro kpi_table(comparison) %}
    {% import _self as _self_cmp %}
    {% if comparison.columns is empty %}
        <p class="text-body-secondary">{{ 'group_report.comparison.kpis.empty'|trans({}, 'group_report') }}</p>
    {% else %}
        {% set _groups = [] %}
        {% for column in comparison.columns %}
            {% if _groups is empty or (_groups|last).group != column.group %}
                {% set _groups = _groups|merge([{group: column.group, span: 1}]) %}
            {% else %}
                {% set _last = _groups|last %}
                {% set _groups = _groups|slice(0, _groups|length - 1)|merge([{group: _last.group, span: _last.span + 1}]) %}
            {% endif %}
        {% endfor %}
        <div class="report-doc__table-wrap">
            <table class="report-doc__table report-doc__table--comparison">
                <caption class="visually-hidden">{{ 'group_report.comparison.kpis.title'|trans({}, 'group_report') }}</caption>
                <thead>
                    <tr>
                        <th scope="col" rowspan="2">{{ 'group_report.comparison.col.organisation'|trans({}, 'group_report') }}</th>
                        {% for g in _groups %}
                            <th scope="colgroup" colspan="{{ g.span }}">{{ ('dashboard.management_kpis.' ~ g.group ~ '.title')|trans({}, 'dashboard') }}</th>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for column in comparison.columns %}
                            <th scope="col" class="text-end">{{ ('dashboard.kpi.' ~ column.key)|trans({}, 'dashboard') }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in comparison.rows %}
                        <tr>
                            <td><strong>{{ row.tenant.name }}</strong> <code>{{ row.tenant.code }}</code></td>
                            {% for column in comparison.columns %}
                                <td class="text-end">{{ _self_cmp.cell(row.kpis[column.key] ?? null) }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td><strong>{{ 'group_report.comparison.group_row'|trans({}, 'group_report') }}</strong></td>
                        {% for column in comparison.columns %}
                            <td class="text-end">{{ _self_cmp.group_cell(comparison.group[column.key] ?? null) }}</td>
                        {% endfor %}
                    </tr>
                </tfoot>
            </table>
        </div>
    {% endif %}
{% endmacro %}

{% macro framework_table(comparison) %}
    {% import _self as _self_cmp %}
    {% if comparison.frameworks is empty %}
        <p class="text-body-secondary">{{ 'group_report.comparison.frameworks.empty'|trans({}, 'group_report') }}</p>
    {% else %}
        <div class="report-doc__table-wrap">
            <table class="report-doc__table report-doc__table--comparison">
                <caption class="visually-hidden">{{ 'group_report.comparison.frameworks.title'|trans({}, 'group_report') }}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{ 'group_report.comparison.col.organisation'|trans({}, 'group_report') }}</th>
                        {% for framework in comparison.frameworks %}
                            <th scope="col" class="text-end">{{ framework.label }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in comparison.rows %}
                        <tr>
                            <td><strong>{{ row.tenant.name }}</strong> <code>{{ row.tenant.code }}</code></td>
                            {% for framework in comparison.frameworks %}
                                <td class="text-end">{{ _self_cmp.cell(row.frameworks[framework.key] ?? null) }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td><strong>{{ 'group_report.comparison.group_row'|trans({}, 'group_report') }}</strong></td>
                        {% for framework in comparison.frameworks %}
                            <td class="text-end">{{ _self_cmp.group_cell(comparison.group['fw:' ~ framework.key] ?? null) }}</td>
                        {% endfor %}
                    </tr>
                </tfoot>
            </table>
        </div>
    {% endif %}
{% endmacro %}
