{% extends 'base.html.twig' %}
{% trans_default_domain 'audit_program' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'audit_program.page.title'|trans }}{% endblock %}

{% block body %}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'nav.audit_programs'|trans({}, 'nav') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'audit_program.page.title'|trans,
    subtitle: 'audit_program.page.subtitle'|trans,
    actions: is_granted('ROLE_MANAGER') ? [
        { label: 'audit_program.action.new'|trans, href: path('app_audit_program_new', {_locale: app.request.locale}), variant: 'primary', icon: 'plus', attrs: {'data-turbo-frame': 'fa-form-modal'} }
    ] : []
}) }}

<div class="container-fluid py-4">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_audit_program_index', {_locale: app.request.locale}),
    list_title: 'audit_program.page.title'|trans({}, 'audit_program'),
    empty: {
        mood: 'sleeping',
        title: 'audit_program.empty.title'|trans({}, 'audit_program'),
        text: 'audit_program.empty.body'|trans({}, 'audit_program'),
        actions: is_granted('ROLE_MANAGER') ? [
            { label: 'audit_program.action.new'|trans({}, 'audit_program'), variant: 'primary', icon: 'plus', href: path('app_audit_program_new', {_locale: app.request.locale}), attrs: {'data-turbo-frame': 'fa-form-modal'} }
        ] : []
    },
} %}
    {% block list_summary %}
        {% if (status_counts.active ?? 0) > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'audit_program.summary.active'|trans({'%count%': status_counts.active}, 'audit_program') }}</span>{% endif %}
        {% if (status_counts.planning ?? 0) > 0 %}<span class="fa-status-pill fa-status-pill--neutral">{{ 'audit_program.summary.planning'|trans({'%count%': status_counts.planning}, 'audit_program') }}</span>{% endif %}
        {% if (status_counts.completed ?? 0) > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'audit_program.summary.completed'|trans({'%count%': status_counts.completed}, 'audit_program') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        <div class="row g-3 p-3" id="audit-program-rows">
            {% for program in page %}
                {% include 'audit_program/_row.html.twig' with { program: program } %}
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
