{% extends 'base.html.twig' %}
{% trans_default_domain 'bc_plans' %}

{% block title %}{{ 'bc_plans.page.title'|trans({}, 'bc_plans') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.bcm'|trans({}, 'nav'), url: path('app_bcm_index') },
            { label: 'nav.bc_plans'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'bc_plans.page.header'|trans({}, 'bc_plans'),
        subtitle: 'bc_plans.page.subtitle'|trans({}, 'bc_plans'),
        actions: [
            { label: 'bc_plans.action.add_new'|trans({}, 'bc_plans'), href: path('app_bc_plan_new'), variant: 'primary', icon: 'plus', attrs: { 'data-turbo-frame': 'fa-form-modal' } }
        ]
    }) }}
{% set _global_hints = alva_hints('business_continuity_plan_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {% if overdue_tests|length > 0 %}
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'warning' } } %}
        {% block alert_body %}
            <div class="fa-alert__title">{{ 'bc_plans.alert.overdue_tests'|trans({}, 'bc_plans') }}</div>
            <ul class="mb-0">
                {% for plan in overdue_tests %}
                <li>
                    <a href="{{ path('app_bc_plan_show', {id: plan.id}) }}">{{ plan.name }}</a>
                    - {{ 'bc_plans.field.next_test'|trans({}, 'bc_plans') }}: {{ plan.nextTestDate ? plan.nextTestDate|locale_date : ('bc_plans.message.not_scheduled'|trans({}, 'bc_plans')) }}
                </li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}
    {% endif %}

    {% if overdue_reviews|length > 0 %}
    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'warning' } } %}
        {% block alert_body %}
            <div class="fa-alert__title">{{ 'bc_plans.alert.overdue_reviews'|trans({}, 'bc_plans') }}</div>
            <ul class="mb-0">
                {% for plan in overdue_reviews %}
                <li>
                    <a href="{{ path('app_bc_plan_show', {id: plan.id}) }}">{{ plan.name }}</a>
                    - {{ 'bc_plans.field.next_review'|trans({}, 'bc_plans') }}: {{ plan.nextReviewDate ? plan.nextReviewDate|locale_date : ('bc_plans.message.not_scheduled'|trans({}, 'bc_plans')) }}
                </li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_bc_plan_index'),
        list_title: 'bc_plans.page.header'|trans({}, 'bc_plans'),
        empty: {
            mood: 'thinking',
            title: 'bc_plans.empty.title'|trans({}, 'bc_plans'),
            text: 'bc_plans.empty.body'|trans({}, 'bc_plans'),
            norm_ref: 'ISO 22301 Klausel 8.4 · ISO 27001 A.5.30',
            actions: [
                { label: 'bc_plans.action.create_first'|trans({}, 'bc_plans'), variant: 'primary', icon: 'plus', href: path('app_bc_plan_new') }
            ],
            help_link: 'bc_plans.help.empty_link'|trans({}, 'bc_plans')
        },
        card_attrs: 'data-controller="bulk-actions" data-bulk-actions-endpoint-value="/' ~ app.request.locale ~ '/business-continuity-plan"',
    } %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with {
                'noMargin': true
            } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'bc_plans.table.name'|trans({}, 'bc_plans') }}</th>
                        <th scope="col">{{ 'bc_plans.table.business_process'|trans({}, 'bc_plans') }}</th>
                        <th scope="col">{{ 'bc_plans.table.owner'|trans({}, 'bc_plans') }}</th>
                        <th scope="col">{{ 'bc_plans.table.status'|trans({}, 'bc_plans') }}</th>
                        <th scope="col">{{ 'bc_plans.table.readiness'|trans({}, 'bc_plans') }}</th>
                        <th scope="col">{{ 'bc_plans.table.last_tested'|trans({}, 'bc_plans') }}</th>
                        <th scope="col">{{ 'bc_plans.table.actions'|trans({}, 'bc_plans') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="bc-plan-rows"{% endblock %}
                {% block table_body %}
                    {% for plan in page %}
                        {% include 'business_continuity_plan/_row.html.twig' with { bc_plan: plan } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}

            {% include '_components/_bulk_action_bar.html.twig' with {
                actions: ['export', 'delete']
            } %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
