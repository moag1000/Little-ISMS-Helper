{#
 # Workflow-related Twig macros for SLA timelines and workflow components
 #}

{#
 # SLA Visual Timeline Macro
 #
 # Displays a visual progress bar showing time elapsed and urgency level
 # for workflow SLA deadlines with color-coded indicators.
 #
 # @param deadline DateTime The deadline/due date for the SLA
 # @param label string The label for the timeline (optional)
 # @param slaHours int The total SLA hours allocated (optional, used for calculation)
 # @param startTime DateTime The start time for SLA calculation (optional, defaults to 'now')
 # @param compact bool Whether to use compact mode (for widgets/tables)
 #}
{% macro sla_timeline(deadline, label = null, slaHours = null, startTime = null, compact = false) %}
    {% if deadline %}
        {# Calculate time remaining #}
        {% set now = date() %}
        {% set totalSeconds = deadline.timestamp - now.timestamp %}
        {% set totalMinutes = (totalSeconds / 60)|round %}
        {% set totalHours = (totalSeconds / 3600)|round(1) %}
        {% set isOverdue = totalSeconds < 0 %}

        {# Calculate percentage elapsed #}
        {% if slaHours and startTime %}
            {% set slaSeconds = slaHours * 3600 %}
            {% set elapsedSeconds = now.timestamp - startTime.timestamp %}
            {% set percentElapsed = ((elapsedSeconds / slaSeconds) * 100)|round %}
        {% else %}
            {# Estimate based on deadline if no start time provided #}
            {% if totalHours > 168 %}
                {# More than 7 days - assume low urgency #}
                {% set percentElapsed = 25 %}
            {% elseif totalHours > 48 %}
                {# 2-7 days - moderate progress #}
                {% set percentElapsed = 50 %}
            {% elseif totalHours > 24 %}
                {# 1-2 days - high progress #}
                {% set percentElapsed = 70 %}
            {% elseif totalHours > 2 %}
                {# 2-24 hours - very high progress #}
                {% set percentElapsed = 85 %}
            {% elseif not isOverdue %}
                {# Less than 2 hours - critical #}
                {% set percentElapsed = 95 %}
            {% else %}
                {# Overdue #}
                {% set percentElapsed = 100 %}
            {% endif %}
        {% endif %}

        {# Clamp percentage to 0-100 range #}
        {% set percentElapsed = percentElapsed < 0 ? 0 : (percentElapsed > 100 ? 100 : percentElapsed) %}

        {# Determine color class and status based on percentage elapsed #}
        {% if isOverdue %}
            {% set colorClass = 'sla-overdue' %}
            {% set statusText = 'sla.overdue'|trans({}, 'workflows') %}
            {% set statusIcon = 'status-warning' %}
        {% elseif percentElapsed >= 80 %}
            {% set colorClass = 'sla-critical' %}
            {% set statusText = 'sla.critical'|trans({}, 'workflows') %}
            {% set statusIcon = 'nav-clock-history' %}
        {% elseif percentElapsed >= 50 %}
            {% set colorClass = 'sla-at-risk' %}
            {% set statusText = 'sla.at_risk'|trans({}, 'workflows') %}
            {% set statusIcon = 'status-pending' %}
        {% else %}
            {% set colorClass = 'sla-on-track' %}
            {% set statusText = 'sla.on_track'|trans({}, 'workflows') %}
            {% set statusIcon = 'status-ok' %}
        {% endif %}

        {# Format time remaining display #}
        {% if isOverdue %}
            {% set absHours = (totalHours * -1) %}
            {% if absHours < 24 %}
                {% set timeDisplay = absHours|round(1) ~ 'sla.hours_short'|trans({}, 'workflows') ~ ' ' ~ 'sla.overdue'|trans({}, 'workflows') %}
            {% else %}
                {% set days = (absHours / 24)|round(1) %}
                {% set timeDisplay = days ~ 'sla.days_short'|trans({}, 'workflows') ~ ' ' ~ 'sla.overdue'|trans({}, 'workflows') %}
            {% endif %}
        {% else %}
            {% if totalHours < 1 %}
                {% set timeDisplay = totalMinutes ~ 'sla.minutes_short'|trans({}, 'workflows') %}
            {% elseif totalHours < 24 %}
                {% set hours = totalHours|round(1) %}
                {% set timeDisplay = hours ~ 'sla.hours_short'|trans({}, 'workflows') %}
            {% else %}
                {% set days = (totalHours / 24)|round(1) %}
                {% set timeDisplay = days ~ 'sla.days_short'|trans({}, 'workflows') %}
            {% endif %}
        {% endif %}

        {% if compact %}
            {# Compact mode for widgets and tables #}
            <div class="sla-timeline-compact {{ colorClass }}"
                 role="status"
                 aria-label="{{ label ?? 'sla.progress_label'|trans({}, 'workflows') }}: {{ percentElapsed }}% {{ 'sla.elapsed'|trans({}, 'workflows') }}, {{ timeDisplay }} {{ 'sla.remaining'|trans({}, 'workflows') }}"
                 title="{{ deadline|date('d.m.Y H:i') }}">
                <div class="sla-progress-mini">
                    <div class="sla-progress-bar-mini {{ colorClass }}" style="width: {{ percentElapsed }}%"></div>
                </div>
                <div class="sla-info-mini">
                    <i class="fa-icon fa-icon--{{ statusIcon }}" aria-hidden="true"></i>
                    <span class="sla-time-mini">{{ timeDisplay }}</span>
                </div>
            </div>
        {% else %}
            {# Full mode for detail pages #}
            <div class="sla-timeline {{ colorClass }}"
                 role="region"
                 aria-label="{{ label ?? 'sla.progress_label'|trans({}, 'workflows') }}">
                {% if label %}
                    <div class="sla-label">
                        {{ label }}
                        {% include '_components/_badge.html.twig' with {
                            variant: colorClass,
                            icon: statusIcon,
                            class: 'ms-2',
                            content: statusText
                        } %}
                    </div>
                {% endif %}

                <div class="sla-progress-container">
                    <div class="sla-progress-track">
                        <div class="sla-progress-bar {{ colorClass }}"
                             style="width: {{ percentElapsed }}%"
                             role="progressbar"
                             aria-valuenow="{{ percentElapsed }}"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                    <div class="sla-progress-label">
                        <span class="sla-percentage">{{ percentElapsed }}% {{ 'sla.elapsed'|trans({}, 'workflows') }}</span>
                    </div>
                </div>

                <div class="sla-footer">
                    <div class="sla-time-remaining">
                        <i class="fa-icon fa-icon--ui-clock" aria-hidden="true"></i>
                        <strong>{{ timeDisplay }}</strong> {{ 'sla.time_remaining'|trans({}, 'workflows') }}
                    </div>
                    <div class="sla-deadline" title="{{ 'workflow.field.due_date'|trans({}, 'workflows') }}">
                        <i class="fa-icon fa-icon--ui-calendar-event" aria-hidden="true"></i>
                        <span>{{ deadline|fa_datetime }}</span>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endmacro %}

{#
 # Workflow Inline Actions Macro
 #
 # Displays workflow status with quick action buttons (Approve/Reject) directly
 # in entity show pages, avoiding the need to navigate to the workflow page.
 #
 # @param workflowInstance WorkflowInstance The workflow instance
 # @param entity object The parent entity (Incident, Document, etc.)
 # @param canApprove bool Whether current user can approve this workflow
 # @param compact bool Whether to use compact mode (default: false)
 #}
{% macro inline_actions(workflowInstance, entity, canApprove = false, compact = false) %}
    {% if workflowInstance %}
        {% set currentStep = workflowInstance.currentStep %}
        {% set dueDate = workflowInstance.dueDate %}
        {% set isOverdue = workflowInstance.isOverdue %}

        <div class="workflow-inline-actions {% if not compact %}p-3 bg-body-secondary rounded border{% else %}p-2{% endif %}">
            <div class="d-flex justify-content-between align-items-start {% if compact %}flex-column flex-md-row{% endif %} gap-2">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i>
                        <strong>{{ workflowInstance.workflow.name }}</strong>

                        {% import '_components/_status_vocabulary.html.twig' as _status %}
                        {{ _status.pill('workflow', workflowInstance.status, ('workflow.status.' ~ workflowInstance.status)|trans({}, 'workflows')) }}

                        {% if isOverdue %}
                            {% include '_components/_badge.html.twig' with {
                                variant: 'danger',
                                icon: 'status-warning',
                                content: 'workflow.badge.overdue'|trans({}, 'workflows')
                            } %}
                        {% endif %}
                    </div>

                    {% if currentStep %}
                        <div class="small text-muted mb-1">
                            <i class="fa-icon fa-icon--util-arrow-right" aria-hidden="true"></i>
                            {{ 'workflow.field.current_step'|trans({}, 'workflows') }}: {{ currentStep.name }}
                        </div>
                    {% endif %}

                    {% if dueDate and not compact %}
                        <div class="mt-2">
                            {{ _self.sla_timeline(dueDate, null, null, workflowInstance.startedAt, true) }}
                        </div>
                    {% endif %}
                </div>

                <div class="btn-group" role="group">
                    {% if canApprove and workflowInstance.status in ['pending', 'in_progress'] %}
                        {{ _self.decision_buttons(workflowInstance.id, compact) }}
                    {% endif %}

                    <a href="{{ path('app_workflow_instance_show', {id: workflowInstance.id}) }}"
                       class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost"
                       title="{{ 'workflow.action.view_full_workflow'|trans({}, 'workflows') }}">
                        <i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i>
                        {% if not compact %}{{ 'workflow.action.view_full_workflow'|trans({}, 'workflows') }}{% endif %}
                    </a>
                </div>
            </div>
        </div>

        {% if canApprove and workflowInstance.status in ['pending', 'in_progress'] %}
            {{ _self.decision_modals(workflowInstance.id, workflowInstance.workflow.name, entity is defined and entity ? (entity.title ?? entity.name ?? entity.referenceNumber ?? null) : null) }}
        {% endif %}
    {% endif %}
{% endmacro %}

{#
 # Approve / reject buttons for one workflow instance. They open the modals
 # rendered by decision_modals() with the same id — render both.
 #}
{% macro decision_buttons(instanceId, compact = false) %}
    <button type="button"
            class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--success"
            data-controller="fa-modal-dispatcher"
            data-action="click->fa-modal-dispatcher#open"
            data-fa-modal-id="approveWorkflow{{ instanceId }}"
            title="{{ 'workflow.widget.action.approve'|trans({}, 'workflows') }}">
        <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
        {% if not compact %}{{ 'workflow.widget.action.approve'|trans({}, 'workflows') }}{% endif %}
    </button>
    <button type="button"
            class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--danger"
            data-controller="fa-modal-dispatcher"
            data-action="click->fa-modal-dispatcher#open"
            data-fa-modal-id="rejectWorkflow{{ instanceId }}"
            title="{{ 'workflow.widget.action.reject'|trans({}, 'workflows') }}">
        <i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i>
        {% if not compact %}{{ 'workflow.widget.action.reject'|trans({}, 'workflows') }}{% endif %}
    </button>
{% endmacro %}

{#
 # Approve / reject confirm modals for one workflow instance — used by My Day,
 # the workflow pages, the home widget and inline_actions(). After the
 # decision the controller returns to the page it came from.
 #
 # @param instanceId   int
 # @param workflowName string
 # @param subject      string|null name of the record the decision is about
 # @param summary      string|null business line (e.g. risk in euro), shown under the subject
 #}
{% macro decision_modals(instanceId, workflowName, subject = null, summary = null) %}
    {{ _self.decision_modal({
        id: 'approveWorkflow' ~ instanceId,
        tone: 'success',
        title: 'workflow.widget.action.approve'|trans({}, 'workflows'),
        action: path('app_workflow_instance_approve', {id: instanceId}),
        token: csrf_token('approve' ~ instanceId),
        question: 'workflow.widget.confirm.approve'|trans({'%workflow%': workflowName}, 'workflows'),
        subject: subject,
        summary: summary,
        field: { name: 'comments', label: 'workflow.widget.field.comments'|trans({}, 'workflows') },
    }) }}
    {{ _self.decision_modal({
        id: 'rejectWorkflow' ~ instanceId,
        tone: 'danger',
        title: 'workflow.widget.action.reject'|trans({}, 'workflows'),
        action: path('app_workflow_instance_reject', {id: instanceId}),
        token: csrf_token('reject' ~ instanceId),
        question: 'workflow.widget.confirm.reject'|trans({'%workflow%': workflowName}, 'workflows'),
        subject: subject,
        summary: summary,
        field: {
            name: 'comments', label: 'workflow.widget.field.reason'|trans({}, 'workflows'), required: true, rows: 4,
            help: 'workflow.widget.help.rejection_reason'|trans({}, 'workflows'),
        },
    }) }}
{% endmacro %}

{#
 # The one decision dialog (approve / reject with comment or reason) for
 # workflows, four-eyes requests and risk acceptances. On phones fa-modal.css
 # turns it into a bottom sheet with full-width buttons.
 #
 # @param o.id       string  modal id, opened via fa-modal-dispatcher data-fa-modal-id
 # @param o.tone     'success'|'danger'|'neutral'
 # @param o.icon     icon name (optional, default by tone)
 # @param o.submit_variant fa-cyber-btn variant of the submit button (optional, default tone)
 # @param o.title    string
 # @param o.action   string  form action URL (POST)
 # @param o.token    string  CSRF token value (field _token)
 # @param o.question string|null
 # @param o.intro    string|null  muted explanation above the field
 # @param o.subject  string|null  record the decision is about
 # @param o.summary  string|null  business line under the subject
 # @param o.field    {name, label, required?, rows?, minlength?, help?, placeholder?}
 # @param o.hidden   map name => value of extra hidden fields (optional)
 # @param o.submit_label / o.cancel_label  button texts (optional)
 #}
{% macro decision_modal(o) %}
    {% set approve = o.tone == 'success' %}
    {% set field = o.field %}
    {% set icon = o.icon ?? (approve ? 'status-ok' : 'status-critical') %}
    <div class="fa-modal fa-modal--confirm fa-modal--{{ o.tone }}"
         id="{{ o.id }}"
         data-controller="fa-modal" data-fa-modal-mode-value="confirm" data-fa-modal-tone-value="{{ o.tone }}"
         role="{{ o.tone == 'neutral' ? 'dialog' : 'alertdialog' }}" aria-modal="true"
         aria-labelledby="{{ o.id }}-label" aria-hidden="true">
        <div class="fa-modal__backdrop" data-fa-modal-target="backdrop" data-action="click->fa-modal#backdropClick" aria-hidden="true"></div>
        <div class="fa-modal__container" data-fa-modal-target="dialog">
            <form method="post" action="{{ o.action }}" data-fa-modal-target="form">
                <input type="hidden" name="_token" value="{{ o.token }}">
                {% for name, value in o.hidden ?? {} %}
                    <input type="hidden" name="{{ name }}" value="{{ value }}">
                {% endfor %}
                <header class="fa-modal__header">
                    <span class="fa-modal__icon" aria-hidden="true"><i class="fa-icon fa-icon--{{ icon }}"></i></span>
                    <div class="fa-modal__heading">
                        <h2 class="fa-modal__title" id="{{ o.id }}-label">{{ o.title }}</h2>
                    </div>
                    <button type="button" class="fa-modal__close" data-action="fa-modal#cancel" aria-label="{{ 'common.close'|trans({}, 'messages') }}"><i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i></button>
                </header>
                <div class="fa-modal__body">
                    {% if o.question ?? null %}
                        <p class="mb-3">{{ o.question }}</p>
                    {% endif %}
                    {% if o.subject ?? null %}
                        <p class="{{ (o.summary ?? null) ? 'mb-1' : 'mb-3' }}"><strong>{{ 'workflow.field.related_entity'|trans({}, 'workflows') }}:</strong> {{ o.subject }}</p>
                    {% endif %}
                    {% if o.summary ?? null %}
                        <p class="mb-3 small text-muted">{{ o.summary }}</p>
                    {% endif %}
                    {% if o.intro ?? null %}
                        <p class="text-muted small mb-3">{{ o.intro }}</p>
                    {% endif %}
                    <label for="{{ o.id }}-{{ field.name }}" class="form-label">
                        {{ field.label }}{% if field.required ?? false %} <span class="text-danger">*</span>{% endif %}
                    </label>
                    <textarea class="form-control fa-cyber-input__field" id="{{ o.id }}-{{ field.name }}" name="{{ field.name }}"
                              rows="{{ field.rows ?? 3 }}"{% if field.placeholder ?? null %} placeholder="{{ field.placeholder }}"{% endif %}{% if field.minlength ?? false %} minlength="{{ field.minlength }}"{% endif %}{% if field.required ?? false %} required{% endif %}></textarea>
                    {% if field.help ?? null %}
                        <div class="form-text">{{ field.help }}</div>
                    {% endif %}
                </div>
                <footer class="fa-modal__footer">
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost" data-action="fa-modal#cancel">
                        {{ o.cancel_label ?? 'common.cancel'|trans({}, 'messages') }}
                    </button>
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--{{ o.submit_variant ?? o.tone }}">
                        <i class="fa-icon fa-icon--{{ o.icon is defined ? o.icon : (approve ? 'ui-check' : 'ui-close') }}" aria-hidden="true"></i>
                        {{ o.submit_label ?? o.title }}
                    </button>
                </footer>
            </form>
        </div>
    </div>
{% endmacro %}
