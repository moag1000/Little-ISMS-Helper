{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_chip.html.twig' as _fa_status_chip %}
{% import '_components/_lifecycle_actions.html.twig' as _lifecycle_actions %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
{% trans_default_domain 'consent' %}

{% block title %}{{ consent.dataSubjectIdentifier }} - {{ 'consent.header.title'|trans({}, 'consent') }}{% endblock %}

{% block body %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.consents'|trans({}, 'nav'), url: path('app_consent_index') },
            { label: consent.dataSubjectIdentifier }
        ]
    } %}

    {% set hint = alva_hint(consent) %}
    {% if hint %}{{ _fa_alva_hint.render(hint) }}{% endif %}

    {% set _show_actions = [] %}
    {% if is_granted('ROLE_USER') and (consent.status == 'pending_verification' or consent.status == 'active') %}
        {% set _show_actions = _show_actions|merge([{ label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit', href: path('app_consent_edit', {id: consent.id}) }]) %}
    {% endif %}
    {% set _show_actions = _show_actions|merge([{ label: 'common.back_to_list'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('app_consent_index') }]) %}
    {{ _fa_page_header.render({
        title: consent.dataSubjectIdentifier,
        actions: _show_actions
    }) }}

    {# Modal-triggers (verify/revoke) and POST-delete kept below header (cannot be expressed via _fa_page_header GET-only actions) #}
    {% set _can_revoke = consent.status == 'active' and is_granted('lifecycle.consent_lifecycle.revoke', consent) %}
    {% set _has_secondary_actions = (is_granted('ROLE_DPO') and not consent.verifiedBy) or _can_revoke or is_granted('ROLE_ADMIN') %}
    {% if _has_secondary_actions %}
        <div class="d-flex justify-content-end gap-2 mb-3">
            {% if is_granted('ROLE_DPO') and not consent.verifiedBy %}
                <button class="fa-cyber-btn fa-cyber-btn--success" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="verifyModal">
                    <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ 'consent.action.verify'|trans({}, 'consent') }}
                </button>
            {% endif %}
            {% if _can_revoke %}
                <button class="fa-cyber-btn fa-cyber-btn--warning" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="revokeModal">
                    <i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i> {{ 'consent.action.document_revocation'|trans({}, 'consent') }}
                </button>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('app_consent_delete', {id: consent.id}) }}" class="d-inline"
                      data-controller="ui-actions"
                      data-action="submit->ui-actions#confirm"
                      data-ui-actions-message-param="{{ 'consent.delete.confirm'|trans({}, 'consent') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consent.id) }}">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
                        <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}
                    </button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    {% set _status %}{{ _fa_status_chip.render({ entity_class: 'App\\Entity\\Consent', status_key: consent.status }) }}{% endset %}
    {% set _actions %}{{ _lifecycle_actions.dropdown(consent, 'consent', 'consent_lifecycle') }}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'consent.field.granted_at'|trans({}, 'consent'), value: consent.grantedAt ? consent.grantedAt|fa_date : null },
            { label: 'show.status.valid_until'|trans({}, 'messages'), value: consent.expiresAt ? consent.expiresAt|fa_date : null },
            { label: 'consent.verified'|trans({}, 'consent'), value: consent.verifiedBy ? consent.verifiedBy : null },
        ],
        workflow: workflow_state(consent),
    }) }}

    {% set _links = entity_links(consent) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: consent } only %}

    <div id="details" class="fa-show-section">
    {# Data Subject Section #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--user" aria-hidden="true"></i>
                    {{ 'consent.section.data_subject'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.data_subject'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ consent.dataSubjectIdentifier }}</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.identifier_type'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ ('consent.identifier_type.' ~ consent.identifierType)|trans({}, 'consent') }}</span>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endembed %}

    {# Processing Activity Section #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--ui-settings" aria-hidden="true"></i>
                    {{ 'consent.section.processing_activity'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.processing_activity'|trans({}, 'consent') }}:</span>
                        <span class="value">
                            {% if consent.processingActivity %}
                                {{ consent.processingActivity.name|default(consent.processingActivity) }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.purposes'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ consent.purposes|default('—') }}</span>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endembed %}

    {# Consent Grant Section #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                    {{ 'consent.section.consent_grant'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="row">
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.granted_at'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ consent.grantedAt|fa_datetime }}</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.consent_method'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ ('consent.method.' ~ consent.consentMethod)|trans({}, 'consent') }}</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.consent_channel'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ ('consent.channel.' ~ consent.consentChannel)|trans({}, 'consent') }}</span>
                    </div>
                </div>
            </div>
            {% if consent.consentText %}
            <div class="row mt-3">
                <div class="col-md-12">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.consent_text'|trans({}, 'consent') }}:</span>
                        <div class="value bg-body-secondary p-3 rounded mt-2">
                            {{ consent.consentText }}
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {# Proof Documentation Section #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--nav-file-pdf" aria-hidden="true"></i>
                    {{ 'consent.section.proof_documentation'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            {% if consent.proofDocument %}
            <div class="detail-item">
                <span class="label">{{ 'consent.field.proof_document'|trans({}, 'consent') }}:</span>
                <span class="value">
                    <a href="{{ consent.proofDocument }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" target="_blank" rel="noopener noreferrer">
                        <i class="fa-icon fa-icon--nav-download" aria-hidden="true"></i> {{ 'common.download'|trans({}, 'messages') }}
                    </a>
                </span>
            </div>
            {% else %}
            {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', icon: 'status-info', class: 'mb-0' } } %}
                {% block alert_body %}{{ 'consent.no_proof_document'|trans({}, 'consent') }}{% endblock %}
            {% endembed %}
            {% endif %}
        {% endblock %}
    {% endembed %}

    {# Expiry Section #}
    {% if consent.expiresAt %}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--ui-calendar-event" aria-hidden="true"></i>
                    {{ 'consent.section.expiry'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="detail-item">
                <span class="label">{{ 'consent.field.expires_at'|trans({}, 'consent') }}:</span>
                <span class="value">{{ consent.expiresAt|fa_date }}</span>
            </div>
        {% endblock %}
    {% endembed %}
    {% endif %}

    {# DPO Verification Section #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--compliance-shield" aria-hidden="true"></i>
                    {{ 'consent.section.dpo_verification'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            {% if consent.verifiedBy %}
            {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'success', icon: 'status-ok', class: 'mb-0' } } %}
                {% block alert_body %}<div class="d-flex align-items-center"> <i class="fa-icon fa-icon--status-ok me-2" aria-hidden="true"></i> <div> <strong>{{ 'consent.verified'|trans({}, 'consent') }}</strong> <br> <small>{{ 'consent.verified_by_user'|trans({'%user%': consent.verifiedBy}, 'consent') }}</small> {% if consent.verifiedAt %} <br> <small>{{ consent.verifiedAt|fa_datetime }}</small> {% endif %} </div> </div>{% endblock %}
            {% endembed %}
            {% else %}
            {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'warning', icon: 'status-warning', class: 'mb-0' } } %}
                {% block alert_body %}{{ 'consent.not_verified'|trans({}, 'consent') }}{% endblock %}
            {% endembed %}
            {% endif %}
        {% endblock %}
    {% endembed %}

    {# Revocation Section #}
    {% if consent.revokedAt %}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i>
                    {{ 'consent.section.revocation'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'danger', class: 'mb-0' } } %}
                {% block alert_body %}<strong>{{ 'consent.revoked'|trans({}, 'consent') }}</strong> <br> <small>{{ 'consent.revoked_at'|trans({'%date%': consent.revokedAt|fa_datetime}, 'consent') }}</small> {% if consent.revocationReason %} <br> <small>{{ 'consent.revocation_reason'|trans({}, 'consent') }}: {{ consent.revocationReason }}</small> {% endif %}{% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
    {% endif %}

    {# Notes Section #}
    {% if consent.notes %}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--ui-flag" aria-hidden="true"></i>
                    {{ 'consent.section.notes'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="bg-body-secondary p-3 rounded">
                {{ consent.notes }}
            </div>
        {% endblock %}
    {% endembed %}
    {% endif %}

    {# Metadata Section #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header bg-body-secondary">
                <h2 class="mb-0">
                    <i class="fa-icon fa-icon--ui-info" aria-hidden="true"></i>
                    {{ 'consent.section.metadata'|trans({}, 'consent') }}
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.id'|trans({}, 'consent') }}:</span>
                        <span class="value"><code>{{ consent.id }}</code></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.created_at'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ consent.createdAt|fa_datetime }}</span>
                    </div>
                </div>
                {% if consent.updatedAt %}
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="label">{{ 'consent.field.updated_at'|trans({}, 'consent') }}:</span>
                        <span class="value">{{ consent.updatedAt|fa_datetime }}</span>
                    </div>
                </div>
                {% endif %}
            </div>
        {% endblock %}
    {% endembed %}
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: consent, lifecycle: 'consent' } only %}
</div>

{# Verify Modal — fa-modal--confirm/success #}
<div class="fa-modal fa-modal--confirm fa-modal--success" id="verifyModal"
     data-controller="fa-modal" data-fa-modal-mode-value="confirm" data-fa-modal-tone-value="success"
     role="alertdialog" aria-modal="true" aria-labelledby="verifyModalLabel" aria-hidden="true">
    <div class="fa-modal__backdrop" data-fa-modal-target="backdrop" data-action="click->fa-modal#backdropClick" aria-hidden="true"></div>
    <div class="fa-modal__container" data-fa-modal-target="dialog">
        <header class="fa-modal__header">
            <span class="fa-modal__icon" aria-hidden="true"><i class="fa-icon fa-icon--status-ok"></i></span>
            <div class="fa-modal__heading">
                <h2 class="fa-modal__title" id="verifyModalLabel">{{ 'consent.action.verify'|trans({}, 'consent') }}</h2>
            </div>
            <button type="button" class="fa-modal__close" data-action="fa-modal#cancel" aria-label="{{ 'common.close'|trans({}, 'messages') }}"><i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i></button>
        </header>
        <form method="post" action="{{ path('app_consent_verify', {id: consent.id}) }}" data-fa-modal-target="form">
            <input type="hidden" name="_token" value="{{ csrf_token('verify' ~ consent.id) }}">
            <div class="fa-modal__body">
                <p>{{ 'consent.verify.confirmation'|trans({}, 'consent') }}</p>
                <p class="text-muted small">{{ 'consent.verify.hint'|trans({}, 'consent') }}</p>
            </div>
            <footer class="fa-modal__footer">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost" data-action="fa-modal#cancel">{{ 'common.cancel'|trans({}, 'messages') }}</button>
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--success">
                    <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ 'consent.action.verify'|trans({}, 'consent') }}
                </button>
            </footer>
        </form>
    </div>
</div>

{# Revoke Modal — fa-modal--confirm/danger #}
<div class="fa-modal fa-modal--confirm fa-modal--danger" id="revokeModal"
     data-controller="fa-modal" data-fa-modal-mode-value="confirm" data-fa-modal-tone-value="danger"
     role="alertdialog" aria-modal="true" aria-labelledby="revokeModalLabel" aria-hidden="true">
    <div class="fa-modal__backdrop" data-fa-modal-target="backdrop" data-action="click->fa-modal#backdropClick" aria-hidden="true"></div>
    <div class="fa-modal__container" data-fa-modal-target="dialog">
        <header class="fa-modal__header">
            <span class="fa-modal__icon" aria-hidden="true"><i class="fa-icon fa-icon--status-warning"></i></span>
            <div class="fa-modal__heading">
                <h2 class="fa-modal__title" id="revokeModalLabel">{{ 'consent.action.document_revocation'|trans({}, 'consent') }}</h2>
            </div>
            <button type="button" class="fa-modal__close" data-action="fa-modal#cancel" aria-label="{{ 'common.close'|trans({}, 'messages') }}"><i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i></button>
        </header>
        <form method="post" action="{{ path('app_consent_revoke', {id: consent.id}) }}" data-fa-modal-target="form">
            <input type="hidden" name="_token" value="{{ csrf_token('revoke' ~ consent.id) }}">
            <div class="fa-modal__body">
                <div class="mb-3">
                    <label for="revocationReason" class="form-label">{{ 'consent.field.revocation_reason'|trans({}, 'consent') }}</label>
                    <textarea class="form-control fa-cyber-input__field" id="revocationReason" name="revocationReason" rows="3" required></textarea>
                </div>
                <p class="text-muted small">{{ 'consent.revoke.hint'|trans({}, 'consent') }}</p>
            </div>
            <footer class="fa-modal__footer">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost" data-action="fa-modal#cancel">{{ 'common.cancel'|trans({}, 'messages') }}</button>
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
                    <i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i> {{ 'consent.action.document_revocation'|trans({}, 'consent') }}
                </button>
            </footer>
        </form>
    </div>
</div>

<style>
.detail-item {
    margin-bottom: 1rem;
}

.detail-item:last-child {
    margin-bottom: 0;
}

.detail-item .label {
    font-weight: 500;
    color: var(--fg-3);
    font-size: 0.875rem;
    display: block;
    margin-bottom: 0.25rem;
}

.detail-item .value {
    color: var(--fg);
    font-size: 1rem;
}

.card-header.bg-body-secondary {
    background-color: var(--surface-2) !important;
}
</style>

{% endblock %}
