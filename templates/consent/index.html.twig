{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'consent' %}
{% block title %}{{ 'consent.header.title'|trans({}, 'consent') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{# Breadcrumb Navigation #}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'consent.breadcrumb'|trans({}, 'consent') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'consent.header.title'|trans({}, 'consent'),
    subtitle: 'consent.header.subtitle'|trans({}, 'consent'),
    actions: [
        { label: 'consent.header.action.new'|trans({}, 'consent'), href: path('app_consent_new'), variant: 'primary', icon: 'plus', attrs: { 'data-turbo-frame': 'fa-form-modal' } }
    ]
}) }}
{% set _global_hints = alva_hints('consent_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

<div class="container-fluid py-4">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_consent_index'),
    filter_keys: ['status', 'verified'],
    list_title: 'consent.list.all_consents'|trans({}, 'consent'),
    empty: {
        mood: 'sleeping',
        title: 'consent.empty.title'|trans({}, 'consent'),
        text: 'consent.empty.description'|trans({}, 'consent'),
        actions: [{ label: 'consent.header.action.new'|trans({}, 'consent'), href: path('app_consent_new'), variant: 'primary' }],
    },
    card_attrs: { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': '/' ~ app.request.locale ~ '/consent' },
} %}
    {% block list_filters %}
        {% import '_components/_fa_filter_select.html.twig' as _fa_filter_select %}
        <div class="col-md-4">
            {{ _fa_filter_select.render({
                name: 'status',
                label: 'consent.field.status'|trans({}, 'consent'),
                values: ['pending_verification', 'active', 'revoked', 'expired', 'rejected'],
                prefix: 'consent.status.',
                domain: 'consent',
                selected: app.request.query.get('status'),
                all_label: 'consent.filter.all_status'|trans({}, 'consent')
            }) }}
        </div>
        <div class="col-md-4">
            <label for="filter-verified" class="form-label">{{ 'consent.field.verified'|trans({}, 'consent') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-verified" name="verified">
                <option value="">{{ 'consent.filter.all_verified'|trans({}, 'consent') }}</option>
                <option value="verified" {{ app.request.query.get('verified') == 'verified' ? 'selected' : '' }}>{{ 'consent.filter.verified'|trans({}, 'consent') }}</option>
                <option value="unverified" {{ app.request.query.get('verified') == 'unverified' ? 'selected' : '' }}>{{ 'consent.filter.unverified'|trans({}, 'consent') }}</option>
            </select>
        </div>
    {% endblock %}
    {% block list_summary %}
        {% if active_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'consent.summary.active'|trans({'%count%': active_count}, 'consent') }}</span>{% endif %}
        {% if pending_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'consent.summary.pending'|trans({'%count%': pending_count}, 'consent') }}</span>{% endif %}
        {% if revoked_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'consent.summary.revoked'|trans({'%count%': revoked_count}, 'consent') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        {% embed '_components/_table.html.twig' with {
            'class': 'table-hover table-bulk-selectable mb-0',
            'noMargin': true,
            'responsive': true
        } %}
            {% block table_head %}
                <tr>
                    <th scope="col" class="bulk-select-column">
                        <input type="checkbox"
                               class="form-check-input"
                               data-action="bulk-actions#selectAll"
                               data-bulk-actions-target="selectAllCheckbox"
                               aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                    </th>
                    <th scope="col">{{ 'consent.field.id'|trans({}, 'consent') }}</th>
                    <th scope="col">{{ 'consent.field.data_subject'|trans({}, 'consent') }}</th>
                    <th scope="col">{{ 'consent.field.processing_activity'|trans({}, 'consent') }}</th>
                    <th scope="col">{{ 'consent.field.status'|trans({}, 'consent') }}</th>
                    <th scope="col">{{ 'consent.field.granted_at'|trans({}, 'consent') }}</th>
                    <th scope="col" class="text-center">{{ 'consent.field.verified'|trans({}, 'consent') }}</th>
                    <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
                </tr>
            {% endblock %}
            {% block table_body_attrs %}id="consent-rows"{% endblock %}
            {% block table_body %}
                {% for consent in page %}
                    {% include 'consent/_row.html.twig' with { consent: consent } %}
                {% endfor %}
            {% endblock %}
        {% endembed %}
        {% include '_components/_bulk_action_bar.html.twig' with { actions: ['export', 'delete'] } %}
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
