{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% trans_default_domain 'data_subject_request' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}

{% block title %}{{ 'dsr.page.index_title'|trans({}, 'data_subject_request') }}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'dsr.breadcrumb.privacy'|trans({}, 'data_subject_request'), icon: 'nav-shield-lock' },
            { label: 'dsr.breadcrumb.data_subject_requests'|trans({}, 'data_subject_request') }
        ]
    } only %}

    {{ _fa_page_header.render({
        title: 'dsr.page.index_title'|trans({}, 'data_subject_request'),
        subtitle: 'dsr.page.index_subtitle'|trans({}, 'data_subject_request'),
        actions: [
            { label: 'dsr.action.new'|trans({}, 'data_subject_request'), variant: 'primary', icon: 'plus', href: path('app_data_subject_request_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }
        ]
    }) }}
{% set _global_hints = alva_hints('data_subject_request_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}


    {# Overdue Alert #}
    {% if overdue_count > 0 %}
        {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'danger', dismissible: true } } %}
            {% block alert_body %}
                <div class="fa-alert__title">{{ 'dsr.alert.overdue_title'|trans({}, 'data_subject_request') }}</div>
                <p class="fa-alert__message">{{ 'dsr.alert.overdue_text'|trans({'%count%': overdue_count}, 'data_subject_request') }}</p>
                <a href="{{ path('app_data_subject_request_index', {status: 'overdue'}) }}" class="fa-alert__link">
                    {{ 'dsr.alert.view_overdue'|trans({}, 'data_subject_request') }}
                </a>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_data_subject_request_index'),
        filter_keys: ['status', 'type'],
        list_title: 'dsr.table.title'|trans({}, 'data_subject_request'),
        empty: {
            mood: 'sleeping',
            title: 'dsr.empty.title'|trans({}, 'data_subject_request'),
            text: 'dsr.empty.message'|trans({}, 'data_subject_request'),
            actions: [{ label: 'dsr.action.new'|trans({}, 'data_subject_request'), href: path('app_data_subject_request_new'), variant: 'primary' }],
        },
        card_attrs: { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': '/' ~ app.request.locale ~ '/data-subject-request' },
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label for="filter-status" class="form-label">{{ 'dsr.filter.label'|trans({}, 'data_subject_request') }}</label>
                <select class="form-select fa-cyber-input__field" id="filter-status" name="status">
                    <option value="">{{ 'dsr.filter.all'|trans({}, 'data_subject_request') }}</option>
                    {% for st in ['received', 'identity_verification', 'in_progress', 'extended', 'completed', 'rejected', 'overdue'] %}
                        <option value="{{ st }}" {{ current_status == st ? 'selected' : '' }}>{{ ('dsr.status.' ~ st)|trans({}, 'data_subject_request') }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <label for="filter-type" class="form-label">{{ 'dsr.filter.type_label'|trans({}, 'data_subject_request') }}</label>
                <select class="form-select fa-cyber-input__field" id="filter-type" name="type">
                    <option value="">{{ 'dsr.filter.all_types'|trans({}, 'data_subject_request') }}</option>
                    {% for ty in ['access', 'rectification', 'erasure', 'restriction', 'portability', 'objection', 'automated_decision'] %}
                        <option value="{{ ty }}" {{ current_type == ty ? 'selected' : '' }}>{{ ('dsr.type.' ~ ty)|trans({}, 'data_subject_request') }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if open_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'dsr.summary.open'|trans({'%count%': open_count}, 'data_subject_request') }}</span>{% endif %}
            {% if avg_response_time is not null %}<span class="fa-status-pill fa-status-pill--neutral">{{ 'dsr.summary.avg_response'|trans({'%days%': avg_response_time}, 'data_subject_request') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_fa_table.html.twig' with { hover: true, sortable: true } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column fa-table__th">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col" class="fa-table__th fa-table__th--sortable" data-sort-key="id" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort keydown.space->fa-table-sort#sort">{{ 'dsr.table.id'|trans({}, 'data_subject_request') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'dsr.table.type'|trans({}, 'data_subject_request') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'dsr.table.data_subject'|trans({}, 'data_subject_request') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'dsr.table.status'|trans({}, 'data_subject_request') }}</th>
                        <th scope="col" class="fa-table__th fa-table__th--sortable" data-sort-key="received" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort keydown.space->fa-table-sort#sort">{{ 'dsr.table.received'|trans({}, 'data_subject_request') }}</th>
                        <th scope="col" class="fa-table__th fa-table__th--sortable" data-sort-key="deadline" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort keydown.space->fa-table-sort#sort">{{ 'dsr.table.deadline'|trans({}, 'data_subject_request') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'dsr.table.assigned_to'|trans({}, 'data_subject_request') }}</th>
                        <th scope="col" class="fa-table__th fa-table__th--actions">{{ 'dsr.table.actions'|trans({}, 'data_subject_request') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="data-subject-request-rows"{% endblock %}
                {% block table_body %}
                    {% set workflowStates = workflow_states(page) %}
                    {% for dsr in page %}
                        {% include 'data_subject_request/_row.html.twig' with { dsr: dsr } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
            {% include '_components/_bulk_action_bar.html.twig' with { actions: ['export', 'delete'] } %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
