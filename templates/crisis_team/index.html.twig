{% extends 'base.html.twig' %}
{% trans_default_domain 'crisis_team' %}

{% block title %}{{ 'crisis_team.title'|trans({}, 'crisis_team') }}{% endblock %}
{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
<div class="container-fluid py-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.bcm'|trans({}, 'nav'), url: path('app_bcm_index') },
            { label: 'nav.crisis_team'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'crisis_team.title'|trans({}, 'crisis_team'),
        actions: [
            { label: 'crisis_team.new'|trans({}, 'crisis_team'), href: path('app_crisis_team_new'), variant: 'primary', icon: 'plus', attrs: {'data-turbo-frame': 'fa-form-modal'} }
        ]
    }) }}
{% set _global_hints = alva_hints('crisis_team_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_crisis_team_index'),
        list_title: 'crisis_team.title'|trans({}, 'crisis_team'),
        empty: {
            mood: 'sleeping',
            title: 'crisis_team.empty'|trans({}, 'crisis_team'),
            actions: [{ label: 'crisis_team.new'|trans({}, 'crisis_team'), href: path('app_crisis_team_new'), variant: 'primary' }],
        },
    } %}
        {% block list_summary %}
            {% if active_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'crisis_team.summary.active'|trans({'%count%': active_count}, 'crisis_team') }}</span>{% endif %}
            {% if operational_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'crisis_team.summary.operational'|trans({'%count%': operational_count}, 'crisis_team') }}</span>{% endif %}
            {% if strategic_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'crisis_team.summary.strategic'|trans({'%count%': strategic_count}, 'crisis_team') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                {% block table_head %}
                    <tr>
                        <th scope="col">{{ 'crisis_team.field.team_name'|trans({}, 'crisis_team') }}</th>
                        <th scope="col">{{ 'crisis_team.field.team_type'|trans({}, 'crisis_team') }}</th>
                        <th scope="col">{{ 'crisis_team.field.team_leader'|trans({}, 'crisis_team') }}</th>
                        <th scope="col">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="crisis-team-rows"{% endblock %}
                {% block table_body %}
                    {% for team in page %}
                        {% include 'crisis_team/_row.html.twig' with { team: team } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
