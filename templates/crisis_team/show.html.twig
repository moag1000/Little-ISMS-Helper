{% extends 'base.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
{% trans_default_domain 'crisis_team' %}
{% block title %}{{ crisis_team.teamName }}{% endblock %}
{% block body %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.bcm'|trans({}, 'nav'), url: path('app_bcm_index') },
            { label: 'nav.crisis_team'|trans({}, 'nav'), url: path('app_crisis_team_index') },
            { label: crisis_team.teamName }
        ]
    } %}

    {% set hint = alva_hint(crisis_team) %}
    {% if hint %}{{ _fa_alva_hint.render(hint) }}{% endif %}

    {{ _fa_page_header.render({
        title: crisis_team.teamName,
        actions: [
            { label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit',     href: path('app_crisis_team_edit',  {id: crisis_team.id}) },
            { label: 'common.back'|trans({}, 'messages'), variant: 'ghost',   icon: 'util-arrow-left', href: path('app_crisis_team_index') }
        ]
    }) }}

    {% set _status %}{% include '_components/_badge.html.twig' with { variant: crisis_team.isActive ? 'success' : 'secondary', content: (crisis_team.isActive ? 'show.status.active' : 'show.status.inactive')|trans({}, 'messages') } %}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        facts: [
            { label: 'show.status.type'|trans({}, 'messages'), value: ('crisis_team.type.' ~ crisis_team.teamType)|trans({}, 'crisis_team') },
            { label: 'crisis_team.field.team_leader'|trans({}, 'crisis_team'), value: crisis_team.teamLeader ? crisis_team.teamLeader.email : null },
        ],
        workflow: workflow_state(crisis_team),
    }) }}

    {% set _links = entity_links(crisis_team) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: crisis_team } only %}

    <div id="details" class="fa-show-section">
    {% embed '_components/_card.html.twig' %}
        {% block card_body %}
            <dl class="row">
                <dt class="col-sm-3">{{ ('crisis_team.type.' ~ crisis_team.teamType)|trans({}, 'crisis_team') }}</dt><dd class="col-sm-9">{% include '_components/_badge.html.twig' with { variant: 'primary', content: ('crisis_team.type.' ~ crisis_team.teamType)|trans({}, 'crisis_team') } %}</dd>
                <dt class="col-sm-3">{{ 'crisis_team.field.is_active'|trans({}, 'crisis_team') }}</dt><dd class="col-sm-9">{% include '_components/_badge.html.twig' with { variant: crisis_team.isActive ? 'success' : 'danger', content: crisis_team.isActive ? 'yes'|trans({}, 'messages') : 'no'|trans({}, 'messages') } %}</dd>
                {% if crisis_team.teamLeader %}<dt class="col-sm-3">{{ 'crisis_team.field.team_leader'|trans({}, 'crisis_team') }}</dt><dd class="col-sm-9">{{ crisis_team.teamLeader.email }}</dd>{% endif %}
                {% set _on_call = current_on_call(crisis_team.tenant.crisisTeamOnCall) %}
                {% if _on_call %}
                    <dt class="col-sm-3">{{ 'admin.tenant_settings.crisis_team_on_call'|trans({}, 'admin') }}</dt>
                    <dd class="col-sm-9">
                        {{ _on_call.primary|default('—') }}
                        {% if _on_call.deputy|default %}<span class="text-muted">({{ 'admin.tenant_settings.json_builder.on_call_deputy'|trans({}, 'admin') }}: {{ _on_call.deputy }})</span>{% endif %}
                        <span class="text-muted">· {{ _on_call.date|date('d.m.Y') }}</span>
                    </dd>
                {% endif %}
                {% if crisis_team.description %}<dt class="col-sm-3">{{ 'crisis_team.field.description'|trans({}, 'crisis_team') }}</dt><dd class="col-sm-9">{{ crisis_team.description|nl2br }}</dd>{% endif %}
            </dl>
        {% endblock %}
    {% endembed %}
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: crisis_team } only %}
</div>
{% endblock %}
