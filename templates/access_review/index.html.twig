{% extends 'base.html.twig' %}
{% trans_default_domain 'access_review' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}

{% block title %}{{ 'access_review.title'|trans({}, 'access_review') }}{% endblock %}

{% block body %}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'access_review.title'|trans({}, 'access_review') }
    ]
} %}

{{ _fa_page_header.render({
    title:   'access_review.title'|trans({}, 'access_review'),
    subtitle: 'access_review.subtitle'|trans({}, 'access_review'),
    actions: [
        { label: 'access_review.new_campaign'|trans({}, 'access_review'), variant: 'primary', icon: 'plus',
          href: path('app_access_review_new', {_locale: app.request.locale}) }
    ]
}) }}

<div class="container-fluid py-2">
    {{ _fa_alert.render({
        variant: 'info',
        title: 'access_review.tooltip.title'|trans({}, 'access_review'),
        body: 'access_review.tooltip.body'|trans({}, 'access_review') ~ ' ' ~ 'access_review.tooltip.norm'|trans({}, 'access_review'),
        class: 'mb-3',
    }) }}
</div>

<div class="container-fluid py-2">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_access_review_index', {_locale: app.request.locale}),
    filter_keys: [],
    list_title: 'access_review.table_caption'|trans({}, 'access_review'),
    empty: {
        mood: 'search',
        title: 'access_review.empty.title'|trans({}, 'access_review'),
        text: 'access_review.empty.body'|trans({}, 'access_review'),
        actions: [
            { label: 'access_review.new_campaign'|trans({}, 'access_review'), variant: 'primary', icon: 'plus',
              href: path('app_access_review_new', {_locale: app.request.locale}) }
        ]
    },
} %}
    {% block list_summary %}
        {% if open_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'access_review.summary.open'|trans({'%count%': open_count}, 'access_review') }}</span>{% endif %}
        {% if closed_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'access_review.summary.closed'|trans({'%count%': closed_count}, 'access_review') }}</span>{% endif %}
        {% if overdue_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'access_review.summary.overdue'|trans({'%count%': overdue_count}, 'access_review') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        {% import '_components/_fa_progress.html.twig' as _fa_progress %}
        {% import '_components/_fa_table.html.twig' as _fa_table %}
        {% set tableRows = [] %}
        {% for c in page %}
            {% set decidedCount = c.totalCount - c.pendingCount %}
            {% set pct = c.totalCount > 0 ? ((decidedCount / c.totalCount) * 100)|round : 0 %}
            {% set progressCell %}
                <div style="min-width:90px">
                    <div class="d-flex justify-content-between mb-1 small">
                        <span>{{ decidedCount }}/{{ c.totalCount }}</span>
                        <span>{{ pct }}%</span>
                    </div>
                    {{ _fa_progress.render({ value: pct, tone: pct == 100 ? 'success' : 'primary', showText: false }) }}
                </div>
            {% endset %}
            {% set _content_html3 %}<a class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost" href="{{ path('app_access_review_show', {_locale: app.request.locale, id: c.id}) }}">{{ 'common.view'|trans({}, 'messages') }}</a>{% endset %}
            {% set _content_html2 %}<span class="fa-status-pill fa-status-pill--{{ lifecycle_tone('App\\Entity\\AccessReviewCampaign', c.status) }}">{{ ('access_review.status.' ~ c.status)|trans({}, 'access_review') }}</span>{% endset %}
            {% set _content_html1 %}<a href="{{ path('app_access_review_show', {_locale: app.request.locale, id: c.id}) }}">{{ c.name }}</a>{% endset %}
            {% set tableRows = tableRows|merge([{ cells: [
                { value: _content_html1 },
                { value: ('access_review.scope.' ~ c.scope)|trans({}, 'access_review') },
                { value: c.dueDate|fa_date },
                { value: _content_html2 },
                { value: c.totalCount ~ ' (' ~ c.pendingCount ~ ' ' ~ 'access_review.field.pending'|trans({}, 'access_review') ~ ')' },
                { value: progressCell },
                { value: _content_html3 }
            ] }]) %}
        {% endfor %}

        {{ _fa_table.render({
            caption: 'access_review.table_caption'|trans({}, 'access_review'),
            headers: [
                { label: 'access_review.field.name'|trans({}, 'access_review') },
                { label: 'access_review.field.scope'|trans({}, 'access_review') },
                { label: 'access_review.field.due_date'|trans({}, 'access_review') },
                { label: 'access_review.field.status'|trans({}, 'access_review') },
                { label: 'access_review.field.items'|trans({}, 'access_review') },
                { label: 'access_review.progress.tile_decided'|trans({}, 'access_review') },
                { label: 'common.actions'|trans({}, 'messages') }
            ],
            rows: tableRows
        }) }}
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
