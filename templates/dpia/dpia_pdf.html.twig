{% trans_default_domain 'privacy'%}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ 'dpia.pdf_doc.page_title'|trans({'%ref%': dpia.referenceNumber}, 'privacy') }}</title>
    <style>
        :root {
            --primary:       var(--primary);
            --surface:       var(--surface);
            --surface-2:     var(--surface-2);
            --fg:            #0f172a;
            --fg-2:          var(--fg-2);
            --fg-3:          var(--fg-3);
            --border:        var(--border);
            --success:       var(--success);
            --success-tint:  var(--success-tint);
            --danger:        var(--danger);
            --danger-tint:   var(--danger-tint);
            --warning:       var(--warning);
            --warning-tint:  var(--warning-tint);
            --info-tint:     var(--info-tint);
            --info-text:     var(--info-text);
        }

        @page {
            margin: 2cm;
            @bottom-right {
                content: "{{ 'pdf.doc_base.page'|trans({}, 'messages') }} " counter(page) " {{ 'pdf.doc_base.of'|trans({}, 'messages') }} " counter(pages);
            }
        }
        body {
            font-family: Arial, sans-serif;
            font-size: 10pt;
            line-height: 1.4;
        }
        h1 {
            font-size: 18pt;
            color: var(--bg);
            border-bottom: 3px solid transparent;
            border-image: linear-gradient(90deg, var(--primary) 0%, var(--accent) 50%, var(--accent) 100%) 1;
            padding-bottom: 10px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }
        h2 {
            font-size: 14pt;
            color: var(--primary);
            margin-top: 25px;
            margin-bottom: 10px;
            page-break-after: avoid;
            border-bottom: 2px solid var(--primary);
            padding-bottom: 5px;
            padding-left: 10pt;
            border-left: 4px solid var(--accent);
        }
        h3 {
            font-size: 12pt;
            color: var(--surface);
            margin-top: 15px;
            margin-bottom: 8px;
            font-weight: bold;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
            page-break-inside: avoid;
        }
        th {
            background: linear-gradient(90deg, var(--bg) 0%, var(--surface) 100%);
            color: var(--primary);
            font-weight: bold;
            padding: 8px;
            text-align: left;
            border: 1px solid var(--border);
            text-transform: uppercase;
            letter-spacing: 0.3pt;
        }
        td {
            padding: 8px;
            border: 1px solid var(--border);
            vertical-align: top;
        }
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 9pt;
            font-weight: bold;
            margin-right: 5px;
            letter-spacing: 0.3pt;
            border: 1.5pt solid transparent;
        }
        .badge-danger {
            background: linear-gradient(135deg, var(--danger) 0%, var(--danger) 100%);
            border-color: var(--danger);
            color: var(--surface);
        }
        .badge-warning {
            background: linear-gradient(135deg, var(--warning) 0%, var(--warning) 100%);
            border-color: var(--warning);
            color: var(--surface);
        }
        .badge-success {
            background: linear-gradient(135deg, var(--success) 0%, var(--success) 100%);
            border-color: var(--success);
            color: var(--surface);
        }
        .badge-info {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
            border-color: var(--primary-hover);
            color: var(--surface);
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .metadata {
            background: linear-gradient(135deg, var(--bg) 0%, var(--border) 100%);
            padding: 10px;
            margin-bottom: 20px;
            font-size: 9pt;
            border: 2px solid var(--border);
            border-left: 4px solid var(--primary);
        }
        ul {
            margin: 5px 0;
            padding-left: 20px;
        }
        li {
            margin-bottom: 3px;
        }
        .section {
            page-break-inside: avoid;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ 'dpia.pdf_doc.title'|trans({}, 'privacy') }}</h1>
        <p style="font-size: 11pt; color: var(--fg-2);">{{ 'dpia.pdf_doc.subtitle'|trans({}, 'privacy') }}</p>
        <p style="font-size: 14pt; font-weight: bold; margin-top: 10px;">{{ dpia.title }}</p>
        <p style="font-size: 11pt;">{{ dpia.referenceNumber }} - {{ 'dpia.pdf_doc.version'|trans({'%version%': dpia.version}, 'privacy') }}</p>
    </div>

    <div class="metadata">
        <strong>{{ 'dpia.pdf_doc.status'|trans({}, 'privacy') }}:</strong> {{ ('dpia.status.' ~ dpia.status)|trans({}, 'privacy') }}
        {% if dpia.approvalDate %}
            | <strong>{{ 'dpia.pdf_doc.approved'|trans({}, 'privacy') }}</strong> {{ dpia.approvalDate|fa_date }}
        {% endif %}
        | <strong>{{ 'dpia.pdf_doc.generated'|trans({}, 'privacy') }}</strong> {{ "now"|fa_datetime(true) }}<br>
        {% if dpia.conductor %}
            <strong>{{ 'dpia.pdf_doc.conductor'|trans({}, 'privacy') }}</strong> {{ dpia.conductor.firstName }} {{ dpia.conductor.lastName }}<br>
        {% endif %}
        {% if dpia.approver %}
            <strong>{{ 'dpia.pdf_doc.approver'|trans({}, 'privacy') }}</strong> {{ dpia.approver.firstName }} {{ dpia.approver.lastName }}<br>
        {% endif %}
        <strong>{{ 'dpia.pdf_doc.completeness'|trans({}, 'privacy') }}</strong> {{ dpia.completenessPercentage }}%
    </div>

    {# Risk Assessment Summary #}
    <div class="section">
        <h2>{{ 'dpia.pdf_doc.risk_summary'|trans({}, 'privacy') }}</h2>
        <table>
            <tr>
                <th scope="col" style="width: 30%;">{{ 'dpia.pdf_doc.assessment'|trans({}, 'privacy') }}</th>
                <th scope="col">{{ 'dpia.pdf_doc.value'|trans({}, 'privacy') }}</th>
            </tr>
            {% if dpia.riskLevel %}
                <tr>
                    <td>{{ 'dpia.pdf_doc.initial_risk'|trans({}, 'privacy') }}</td>
                    <td>
                        {% set risk_class = {'low': 'success', 'medium': 'info', 'high': 'warning', 'critical': 'danger'}[dpia.riskLevel] %}
                        <span class="badge badge-{{ risk_class }}">{{ ('privacy.risk_level.' ~ dpia.riskLevel)|trans({}, 'privacy') }}</span>
                    </td>
                </tr>
            {% endif %}
            {% if dpia.residualRiskLevel %}
                <tr>
                    <td>{{ 'dpia.pdf_doc.residual_risk'|trans({}, 'privacy') }}</td>
                    <td>
                        {% set risk_class = {'low': 'success', 'medium': 'info', 'high': 'warning', 'critical': 'danger'}[dpia.residualRiskLevel] %}
                        <span class="badge badge-{{ risk_class }}">{{ ('privacy.risk_level.' ~ dpia.residualRiskLevel)|trans({}, 'privacy') }}</span>
                        {% if dpia.isResidualRiskAcceptable %}
                            <span class="badge badge-success">{{ 'dpia.pdf_doc.acceptable'|trans({}, 'privacy') }}</span>
                        {% else %}
                            <span class="badge badge-danger">{{ 'dpia.pdf_doc.requires_consultation'|trans({}, 'privacy') }}</span>
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
            {% if dpia.likelihood %}
                <tr>
                    <td>{{ 'dpia.pdf_doc.likelihood'|trans({}, 'privacy') }}</td>
                    <td>{{ ('privacy.likelihood.' ~ dpia.likelihood)|trans({}, 'privacy') }}</td>
                </tr>
            {% endif %}
            {% if dpia.impact %}
                <tr>
                    <td>{{ 'dpia.pdf_doc.impact'|trans({}, 'privacy') }}</td>
                    <td>{{ ('privacy.impact.' ~ dpia.impact)|trans({}, 'privacy') }}</td>
                </tr>
            {% endif %}
        </table>
    </div>

    {# Art. 35(7)(a) - Description of Processing #}
    <div class="section">
        <h2>{{ 'dpia.pdf.art_35_7a_description'|trans({}, 'privacy')}}</h2>

        <h3>{{ 'dpia.pdf_doc.processing_description'|trans({}, 'privacy') }}</h3>
        <p>{{ dpia.processingDescription|nl2br }}</p>

        <h3>{{ 'dpia.pdf.purposes_processing'|trans({}, 'privacy')}}</h3>
        <p>{{ dpia.processingPurposes|nl2br }}</p>

        <table>
            <tr>
                <th scope="col" style="width: 30%;">{{ 'dpia.pdf_doc.category'|trans({}, 'privacy') }}</th>
                <th scope="col">{{ 'dpia.pdf_doc.details'|trans({}, 'privacy') }}</th>
            </tr>
            <tr>
                <td>{{ 'dpia.pdf_doc.data_categories'|trans({}, 'privacy') }}</td>
                <td>
                    <ul>
                        {% for category in dpia.dataCategories %}
                            <li>{{ ('dpia.pdf_doc.data_category.' ~ category)|trans({}, 'privacy') }}</li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
            <tr>
                <td>{{ 'dpia.pdf_doc.subject_categories'|trans({}, 'privacy') }}</td>
                <td>
                    <ul>
                        {% for category in dpia.dataSubjectCategories %}
                            <li>{{ ('privacy.data_subject.' ~ category)|trans({}, 'privacy') }}</li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
            {% if dpia.estimatedDataSubjects %}
                <tr>
                    <td>{{ 'dpia.pdf_doc.estimated_subjects'|trans({}, 'privacy') }}</td>
                    <td>{{ dpia.estimatedDataSubjects }}</td>
                </tr>
            {% endif %}
            {% if dpia.dataRetentionPeriod %}
                <tr>
                    <td>{{ 'dpia.pdf_doc.retention_period'|trans({}, 'privacy') }}</td>
                    <td>{{ dpia.dataRetentionPeriod }}</td>
                </tr>
            {% endif %}
        </table>

        {% if dpia.dataFlowDescription %}
            <h3>{{ 'dpia.pdf_doc.data_flow'|trans({}, 'privacy') }}</h3>
            <p>{{ dpia.dataFlowDescription|nl2br }}</p>
        {% endif %}
    </div>

    {# Art. 35(7)(b) - Necessity and Proportionality #}
    <div class="section">
        <h2>{{ 'dpia.pdf.art_35_7b_assessment'|trans({}, 'privacy')}}</h2>

        <h3>{{ 'dpia.pdf_doc.necessity'|trans({}, 'privacy') }}</h3>
        <p>{{ dpia.necessityAssessment|nl2br }}</p>

        <h3>{{ 'dpia.pdf_doc.proportionality'|trans({}, 'privacy') }}</h3>
        <p>{{ dpia.proportionalityAssessment|nl2br }}</p>

        <table>
            <tr>
                <th scope="col" style="width: 30%;">{{ 'dpia.pdf_doc.legal_compliance'|trans({}, 'privacy') }}</th>
                <th scope="col">{{ 'dpia.pdf_doc.details'|trans({}, 'privacy') }}</th>
            </tr>
            <tr>
                <td>{{ 'dpia.pdf_doc.legal_basis'|trans({}, 'privacy') }}</td>
                <td><strong>{{ ('privacy.legal_basis.' ~ dpia.legalBasis)|trans({}, 'privacy') }}</strong></td>
            </tr>
            {% if dpia.legislativeCompliance %}
                <tr>
                    <td>{{ 'dpia.pdf_doc.legislative_compliance'|trans({}, 'privacy') }}</td>
                    <td>{{ dpia.legislativeCompliance|nl2br }}</td>
                </tr>
            {% endif %}
        </table>
    </div>

    {# Art. 35(7)(c) - Risk Assessment #}
    <div class="section">
        <h2>{{ 'dpia.pdf.art_35_7c_risks'|trans({}, 'privacy')}}</h2>

        {% if dpia.identifiedRisks|length > 0 %}
            <h3>{{ 'dpia.pdf_doc.identified_risks'|trans({}, 'privacy') }}</h3>
            <table>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">{{ 'dpia.pdf_doc.risk'|trans({}, 'privacy') }}</th>
                </tr>
                {% for risk in dpia.identifiedRisks %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>
                            {% if risk.title is defined %}
                                <strong>{{ risk.title }}</strong><br>
                            {% endif %}
                            {% if risk.description is defined %}
                                {{ risk.description }}<br>
                            {% endif %}
                            {% if risk.likelihood is defined and risk.impact is defined %}
                                {{ 'dpia.pdf_doc.likelihood_impact'|trans({'%likelihood%': ('privacy.likelihood.' ~ risk.likelihood)|trans({}, 'privacy'), '%impact%': ('privacy.impact.' ~ risk.impact)|trans({}, 'privacy')}, 'privacy') }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if dpia.dataSubjectRisks %}
            <h3>{{ 'dpia.pdf.specific_risks'|trans({}, 'privacy')}}</h3>
            <p>{{ dpia.dataSubjectRisks|nl2br }}</p>
        {% endif %}
    </div>

    {# Art. 35(7)(d) - Measures to Address Risks #}
    <div class="section">
        <h2>{{ 'dpia.pdf.art_35_7d_measures'|trans({}, 'privacy')}}</h2>

        <h3>{{ 'dpia.pdf_doc.technical_measures'|trans({}, 'privacy') }}</h3>
        <p>{{ dpia.technicalMeasures|nl2br }}</p>

        <h3>{{ 'dpia.pdf_doc.organizational_measures'|trans({}, 'privacy') }}</h3>
        <p>{{ dpia.organizationalMeasures|nl2br }}</p>

        {% if dpia.implementedControls|length > 0 %}
            <h3>{{ 'dpia.pdf_doc.iso_controls'|trans({}, 'privacy') }}</h3>
            <ul>
                {% for control in dpia.implementedControls %}
                    <li>{{ control.controlId }} - {{ control.name }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if dpia.complianceMeasures %}
            <h3>{{ 'dpia.pdf_doc.compliance_measures'|trans({}, 'privacy') }}</h3>
            <p>{{ dpia.complianceMeasures|nl2br }}</p>
        {% endif %}

        {% if dpia.residualRiskAssessment %}
            <h3>{{ 'dpia.pdf_doc.residual_assessment'|trans({}, 'privacy') }}</h3>
            <p>{{ dpia.residualRiskAssessment|nl2br }}</p>
        {% endif %}
    </div>

    {# Standard-Datenschutzmodell (SDM 3.1) — DSK Gewährleistungsziele #}
    {% set sdm = dpia.sdmAssessment ?? {} %}
    {% if sdm|length > 0 or dpia.sdmAssessmentSummary %}
    <div class="section">
        <h2>{{ 'privacy.sdm.title'|trans({}, 'privacy') }}</h2>
        <p>
            <strong>{{ 'privacy.sdm.coverage'|trans({}, 'privacy') }}:</strong> {{ dpia.sdmCoveragePercent }}%
            {% if dpia.sdmHighestRiskLevel %}
                · <strong>{{ 'privacy.sdm.highest_risk'|trans({}, 'privacy') }}:</strong>
                {% set sdm_risk_class = {'low': 'success', 'medium': 'warning', 'high': 'danger'}[dpia.sdmHighestRiskLevel] ?? 'secondary' %}
                <span class="badge badge-{{ sdm_risk_class }}">{{ ('privacy.sdm.risk_level.' ~ dpia.sdmHighestRiskLevel)|trans({}, 'privacy') }}</span>
            {% endif %}
        </p>
        <table>
            <tr>
                <th scope="col" style="width: 25%;">{{ 'dpia.pdf_doc.goal'|trans({}, 'privacy') }}</th>
                <th scope="col" style="width: 12%;">{{ 'dpia.pdf_doc.sdm_risk'|trans({}, 'privacy') }}</th>
                <th scope="col">{{ 'dpia.pdf_doc.sdm_rationale'|trans({}, 'privacy') }}</th>
            </tr>
            {% for goal in [
                'verfuegbarkeit', 'integritaet', 'vertraulichkeit', 'transparenz',
                'intervenierbarkeit', 'nichtverkettung', 'datenminimierung'
            ] %}
                {% set entry = sdm[goal] ?? null %}
                <tr>
                    <td><strong>{{ ('privacy.sdm.goal.' ~ goal)|trans({}, 'privacy') }}</strong></td>
                    <td>
                        {% if entry and entry.risk_level is defined and entry.risk_level %}
                            {% set goal_class = {'low': 'success', 'medium': 'warning', 'high': 'danger'}[entry.risk_level] ?? 'secondary' %}
                            <span class="badge badge-{{ goal_class }}">{{ ('privacy.sdm.risk_level.' ~ entry.risk_level)|trans({}, 'privacy') }}</span>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>{{ entry and entry.rationale is defined ? entry.rationale : '' }}</td>
                </tr>
            {% endfor %}
        </table>
        {% if dpia.sdmAssessmentSummary %}
            <h3>{{ 'privacy.sdm.summary'|trans({}, 'privacy') }}</h3>
            <p>{{ dpia.sdmAssessmentSummary|nl2br }}</p>
        {% endif %}
    </div>
    {% endif %}

    {# Stakeholder Consultation #}
    <div class="section">
        <h2>{{ 'dpia.pdf_doc.stakeholder_consultation'|trans({}, 'privacy') }}</h2>

        <table>
            <tr>
                <th scope="col" style="width: 30%;">{{ 'dpia.pdf_doc.consultation'|trans({}, 'privacy') }}</th>
                <th scope="col">{{ 'dpia.pdf_doc.status'|trans({}, 'privacy') }}</th>
            </tr>
            <tr>
                <td>{{ 'dpia.pdf_doc.dpo_consultation'|trans({}, 'privacy') }}</td>
                <td>
                    {% if dpia.dpoConsultationDate %}
                        <span class="badge badge-success">{{ 'dpia.pdf_doc.completed'|trans({}, 'privacy') }}</span> {{ dpia.dpoConsultationDate|fa_date }}
                        {% if dpia.dataProtectionOfficer %}
                            <br><strong>{{ 'dpia.pdf_doc.dpo'|trans({}, 'privacy') }}:</strong> {{ dpia.dataProtectionOfficer.firstName }} {{ dpia.dataProtectionOfficer.lastName }}
                        {% endif %}
                        {% if dpia.dpoAdvice %}
                            <br><strong>{{ 'dpia.pdf_doc.advice'|trans({}, 'privacy') }}</strong> {{ dpia.dpoAdvice }}
                        {% endif %}
                    {% else %}
                        <span class="badge badge-warning">{{ 'dpia.pdf_doc.pending'|trans({}, 'privacy') }}</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>{{ 'dpia.pdf_doc.subjects_consulted'|trans({}, 'privacy') }}</td>
                <td>
                    {% if dpia.dataSubjectsConsulted %}
                        <span class="badge badge-success">{{ 'dpia.pdf_doc.yes'|trans({}, 'privacy') }}</span>
                        {% if dpia.dataSubjectConsultationDetails %}
                            <br>{{ dpia.dataSubjectConsultationDetails }}
                        {% endif %}
                    {% else %}
                        <span class="badge badge-info">{{ 'dpia.pdf_doc.no'|trans({}, 'privacy') }}</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>{{ 'dpia.pdf_doc.supervisory_authority'|trans({}, 'privacy') }}</td>
                <td>
                    {% if dpia.requiresSupervisoryConsultation %}
                        {% if dpia.supervisoryConsultationDate %}
                            <span class="badge badge-success">{{ 'dpia.pdf_doc.completed'|trans({}, 'privacy') }}</span> {{ dpia.supervisoryConsultationDate|fa_date }}
                            {% if dpia.supervisoryAuthorityFeedback %}
                                <br><strong>{{ 'dpia.pdf_doc.feedback'|trans({}, 'privacy') }}</strong> {{ dpia.supervisoryAuthorityFeedback }}
                            {% endif %}
                        {% else %}
                            <span class="badge badge-danger">{{ 'dpia.pdf_doc.required_pending'|trans({}, 'privacy') }}</span>
                        {% endif %}
                    {% else %}
                        <span class="badge badge-info">{{ 'dpia.pdf_doc.not_required'|trans({}, 'privacy') }}</span>
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>

    {# Review Information #}
    {% if dpia.lastReviewDate or dpia.nextReviewDate %}
        <div class="section">
            <h2>{{ 'dpia.pdf_doc.review_information'|trans({}, 'privacy') }}</h2>

            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'dpia.pdf_doc.review'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'dpia.pdf_doc.date'|trans({}, 'privacy') }}</th>
                </tr>
                {% if dpia.lastReviewDate %}
                    <tr>
                        <td>{{ 'dpia.pdf_doc.last_review_date'|trans({}, 'privacy') }}</td>
                        <td>{{ dpia.lastReviewDate|fa_date }}</td>
                    </tr>
                {% endif %}
                {% if dpia.nextReviewDate %}
                    <tr>
                        <td>{{ 'dpia.pdf.next_review_date'|trans({}, 'privacy')}}</td>
                        <td>{{ dpia.nextReviewDate|fa_date }}</td>
                    </tr>
                {% endif %}
                {% if dpia.reviewFrequencyMonths %}
                    <tr>
                        <td>{{ 'dpia.pdf_doc.review_frequency'|trans({}, 'privacy') }}</td>
                        <td>{{ 'dpia.pdf_doc.every_months'|trans({'%count%': dpia.reviewFrequencyMonths}, 'privacy') }}</td>
                    </tr>
                {% endif %}
            </table>
        </div>
    {% endif %}

    {# Approval Information #}
    {% if dpia.status == 'approved' %}
        <div class="section">
            <h2>{{ 'dpia.pdf_doc.approval_information'|trans({}, 'privacy') }}</h2>

            <table>
                <tr>
                    <th scope="col" style="width: 30%;">{{ 'dpia.pdf_doc.field'|trans({}, 'privacy') }}</th>
                    <th scope="col">{{ 'dpia.pdf_doc.value'|trans({}, 'privacy') }}</th>
                </tr>
                <tr>
                    <td>{{ 'dpia.pdf_doc.status'|trans({}, 'privacy') }}</td>
                    <td><span class="badge badge-success">{{ 'dpia.status.approved'|trans({}, 'privacy') }}</span></td>
                </tr>
                {% if dpia.approver %}
                    <tr>
                        <td>{{ 'dpia.pdf.approved_by'|trans({}, 'privacy')}}</td>
                        <td>{{ dpia.approver.firstName }} {{ dpia.approver.lastName }}</td>
                    </tr>
                {% endif %}
                {% if dpia.approvalDate %}
                    <tr>
                        <td>{{ 'dpia.pdf_doc.approval_date'|trans({}, 'privacy') }}</td>
                        <td>{{ dpia.approvalDate|fa_date }}</td>
                    </tr>
                {% endif %}
                {% if dpia.approvalComments %}
                    <tr>
                        <td>{{ 'dpia.pdf_doc.comments'|trans({}, 'privacy') }}</td>
                        <td>{{ dpia.approvalComments }}</td>
                    </tr>
                {% endif %}
            </table>
        </div>
    {% endif %}

    <div style="page-break-before: always;"></div>

    <h2>{{ 'dpia.pdf_doc.declaration'|trans({}, 'privacy') }}</h2>
    <p>{{ 'dpia.pdf.footer_text'|trans({}, 'privacy')}}</p>

    <p style="margin-top: 40px;">
        <strong>{{ 'dpia.pdf_doc.signature'|trans({}, 'privacy') }}</strong> ____________________________<br>
        <strong>{{ 'dpia.pdf_doc.date_label'|trans({}, 'privacy') }}</strong> ____________________________<br>
        <strong>{{ 'dpia.pdf_doc.name_position'|trans({}, 'privacy') }}</strong> ____________________________
    </p>
</body>
</html>
