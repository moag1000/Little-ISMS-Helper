{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'privacy' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% block title %}{{ 'dpia.index.title'|trans({}, 'privacy')}}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.privacy'|trans({}, 'nav'), url: path('app_processing_activity_index') },
            { label: 'nav.dpia'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'dpia.index.page_title'|trans({}, 'privacy'),
        subtitle: 'dpia.index.page_subtitle'|trans({}, 'privacy'),
        actions: [
            { label: 'dpia.index.button_dashboard'|trans({}, 'privacy'), variant: 'ghost', icon: 'nav-dashboard', href: path('app_dpia_dashboard') },
            { label: 'dpia.index.button_new_dpia'|trans({}, 'privacy'), variant: 'primary', icon: 'plus', href: path('app_dpia_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }
        ]
    }) }}
{% set _global_hints = alva_hints('dpia_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}


    {# Overall Compliance Score #}
    {% embed '_components/_card.html.twig' with {class: 'mb-4 text-center'} %}
        {% block card_body %}
            <div class="text-muted mb-2 fw-semibold">{{ 'dpia.index.compliance_score'|trans({}, 'privacy') }}</div>
            {% set score = compliance_score.overall_score %}
            <div class="display-1 mb-0
                {% if score >= 80 %}text-success
                {% elseif score >= 60 %}text-warning
                {% else %}text-danger{% endif %}">
                {{ score }}%
            </div>
            <p class="text-muted mt-2">
                {{ compliance_score.approved_dpias }} {{ 'dpia.index.of'|trans({}, 'privacy') }} {{ compliance_score.total_dpias }} {{ 'dpia.index.dpias_approved'|trans({}, 'privacy') }}
                {% if compliance_score.due_for_review > 0 %}
                    · {{ compliance_score.due_for_review }} {{ 'dpia.index.due_for_review'|trans({}, 'privacy') }}
                {% endif %}
            </p>
        {% endblock %}
    {% endembed %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_dpia_index'),
        filter_keys: ['filter'],
        list_title: 'dpia.index.dpias_list'|trans({}, 'privacy'),
        empty: {
            mood: 'sleeping',
            title: 'dpia.index.none'|trans({}, 'privacy'),
            actions: [{ label: 'dpia.index.create_first_dpia'|trans({}, 'privacy'), variant: 'primary', icon: 'plus', href: path('app_dpia_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }],
        },
        card_attrs: { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': '/' ~ app.request.locale ~ '/dpia' },
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label for="filter-status" class="form-label">{{ 'dpia.index.filter_dpias'|trans({}, 'privacy') }}</label>
                <select class="form-select fa-cyber-input__field" id="filter-status" name="filter">
                    <option value="">{{ 'dpia.index.all'|trans({}, 'privacy') }} ({{ statistics.total }})</option>
                    <option value="draft" {{ current_filter == 'draft' ? 'selected' : '' }}>{{ 'dpia.index.draft'|trans({}, 'privacy') }} ({{ statistics.draft }})</option>
                    <option value="in_review" {{ current_filter == 'in_review' ? 'selected' : '' }}>{{ 'dpia.index.in_review'|trans({}, 'privacy') }} ({{ statistics.in_review }})</option>
                    <option value="approved" {{ current_filter == 'approved' ? 'selected' : '' }}>{{ 'dpia.index.approved_filter'|trans({}, 'privacy') }} ({{ statistics.approved }})</option>
                    <option value="high_risk" {{ current_filter == 'high_risk' ? 'selected' : '' }}>{{ 'dpia.index.high_risk_filter'|trans({}, 'privacy') }} ({{ statistics.high_risk }})</option>
                    <option value="incomplete" {{ current_filter == 'incomplete' ? 'selected' : '' }}>{{ 'dpia.index.incomplete'|trans({}, 'privacy') }}</option>
                    <option value="awaiting_dpo" {{ current_filter == 'awaiting_dpo' ? 'selected' : '' }}>{{ 'dpia.index.awaiting_dpo'|trans({}, 'privacy') }} ({{ statistics.awaiting_dpo_consultation }})</option>
                    <option value="requires_supervisory" {{ current_filter == 'requires_supervisory' ? 'selected' : '' }}>{{ 'dpia.index.requires_supervisory'|trans({}, 'privacy') }} ({{ statistics.requires_supervisory_consultation }})</option>
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% set _approved = dpias|filter(d => d.status == 'approved')|length %}
            {% set _in_review = dpias|filter(d => d.status == 'in_review')|length %}
            {% set _high_risk = dpias|filter(d => d.riskLevel in ['high', 'critical'])|length %}
            {% if _approved > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'dpia.index.summary.approved'|trans({'%count%': _approved}, 'privacy') }}</span>{% endif %}
            {% if _in_review > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'dpia.index.summary.in_review'|trans({'%count%': _in_review}, 'privacy') }}</span>{% endif %}
            {% if _high_risk > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'dpia.index.summary.high_risk'|trans({'%count%': _high_risk}, 'privacy') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'dpia.index.reference'|trans({}, 'privacy') }}</th>
                        <th scope="col">{{ 'dpia.index.title_col'|trans({}, 'privacy') }}</th>
                        <th scope="col">{{ 'dpia.index.status'|trans({}, 'privacy') }}</th>
                        <th scope="col">{{ 'dpia.index.risk_level'|trans({}, 'privacy') }}</th>
                        <th scope="col">{{ 'dpia.index.residual_risk'|trans({}, 'privacy') }}</th>
                        <th scope="col">{{ 'dpia.index.completeness'|trans({}, 'privacy') }}</th>
                        <th scope="col">{{ 'dpia.index.dpo'|trans({}, 'privacy') }}</th>
                        <th scope="col">{{ 'dpia.index.actions'|trans({}, 'privacy') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="dpia-rows"{% endblock %}
                {% block table_body %}
                    {% set workflowStates = workflow_states(page) %}
                    {% for dpia in page %}
                        {% include 'dpia/_row.html.twig' with { dpia: dpia } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
            {% include '_components/_bulk_action_bar.html.twig' with { actions: ['export', 'delete'] } %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
