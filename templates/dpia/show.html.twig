{% extends 'base.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_chip.html.twig' as _fa_status_chip %}
{% import '_components/_lifecycle_actions.html.twig' as _lifecycle_actions %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
{% import '_components/_lifecycle_pending_banner.html.twig' as _lifecycle_pending_banner %}
{% trans_default_domain 'privacy' %}

{% block title %}{{ 'dpia.show.page_title'|trans({'%ref%': dpia.referenceNumber}, 'privacy') }}{% endblock %}

{% block body %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.privacy'|trans({}, 'nav'), icon: 'shield-check' },
            { label: 'nav.dpia'|trans({}, 'nav'), url: path('app_dpia_index') },
            { label: dpia.referenceNumber }
        ]
    } %}

    {% set hint = alva_hint(dpia) %}
    {% if hint %}{{ _fa_alva_hint.render(hint) }}{% endif %}

    {{ _fa_page_header.render({
        badge:    { icon: 'nav-clipboard-check', label: dpia.referenceNumber },
        title:    dpia.title,
        subtitle: 'Version ' ~ dpia.version,
        actions: [
            { label: 'dpia.action.export_pdf'|trans({}, 'privacy'), variant: 'success', icon: 'nav-file-pdf',   href: path('app_dpia_export_pdf', {id: dpia.id}) },
            { label: 'common.back_to_list'|trans({}, 'messages'),   variant: 'ghost',   icon: 'util-arrow-left', href: path('app_dpia_index') }
        ]
    }) }}
    {% include '_components/_fa_pdf_locale_switch.html.twig' with {route: 'app_dpia_export_pdf', route_params: {id: dpia.id}} only %}

    {# Z.0 — Workflow pending action banner #}
    {{ _lifecycle_pending_banner.render(workflow_info|default({})) }}

    {% set _status %}{{ _fa_status_chip.render({ entity_class: 'App\\Entity\\DataProtectionImpactAssessment', status_key: dpia.status }) }}{% endset %}
    {% set _actions %}{{ _lifecycle_actions.dropdown(dpia, 'dpia', 'dpia_lifecycle') }}{% if dpia.status == 'approved' %}{% include '_components/_review_confirm_button.html.twig' with {
        entity: dpia, route: 'app_dpia_complete_review', token_id: 'complete-review' ~ dpia.id,
        can: is_granted('ROLE_MANAGER') or is_granted('RECORD_RESPONSIBLE', dpia),
    } only %}{% endif %}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'dpia.show.field.conductor'|trans({}, 'privacy'), value: dpia.conductor ? dpia.conductor.firstName ~ ' ' ~ dpia.conductor.lastName : null },
            { label: 'show.status.next_review'|trans({}, 'messages'), value: dpia.nextReviewDate ? dpia.nextReviewDate|fa_date : null },
            { label: 'show.status.version'|trans({}, 'messages'), value: dpia.version },
            { label: 'dpia.index.completeness'|trans({}, 'privacy'), value: dpia.completenessPercentage ~ '%' },
        ],
        workflow: workflow_state(dpia),
    }) }}

    {% set _links = entity_links(dpia) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
        { id: 'risk', label: 'dpia.show.section.risk_assessment'|trans({}, 'privacy') },
        { id: 'processing', label: 'dpia.new.section_processing_operations'|trans({}, 'privacy') },
        { id: 'measures', label: 'dpia.new.section_measures'|trans({}, 'privacy') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
        { id: 'comments', label: 'show.anchor.comments'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: dpia } only %}

    {# Status & Workflow Actions #}
    <div id="details" class="fa-show-section">
    {% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
        {% block card_header %}
            <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--policy" aria-hidden="true"></i> {{ 'dpia.show.section.status_workflow'|trans({}, 'privacy') }}</h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <div class="row">
                <div class="col-md-6">
                    <p><strong>{{ 'dpia.index.completeness'|trans({}, 'privacy') }}:</strong> {{ dpia.completenessPercentage }}%</p>
                    {% if dpia.conductor %}
                        <p><strong>{{ 'dpia.show.field.conductor'|trans({}, 'privacy') }}:</strong> {{ dpia.conductor.firstName }} {{ dpia.conductor.lastName }}</p>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    {% if dpia.approver %}
                        <p><strong>{{ 'dpia.show.field.approver'|trans({}, 'privacy') }}:</strong> {{ dpia.approver.firstName }} {{ dpia.approver.lastName }}</p>
                        <p><strong>{{ 'dpia.show.field.approval_date'|trans({}, 'privacy') }}:</strong> {{ dpia.approvalDate|fa_date }}</p>
                    {% endif %}
                    {% if dpia.nextReviewDate %}
                        <p><strong>{{ 'dpia.form.next_review_date'|trans({}, 'privacy') }}:</strong> {{ dpia.nextReviewDate|fa_date }}</p>
                    {% endif %}
                </div>
            </div>

            {# Workflow Actions #}
            <div class="mt-3">
                {% if dpia.status == 'draft' and dpia.isComplete %}
                    <form action="{{ path('app_dpia_submit_for_review', {id: dpia.id}) }}" method="post" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit' ~ dpia.id) }}">
                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">
                            <i class="fa-icon fa-icon--ui-send" aria-hidden="true"></i> {{ 'dpia.action.submit_for_review'|trans({}, 'privacy') }}
                        </button>
                    </form>
                {% endif %}

                {% if dpia.status in ['draft', 'requires_revision'] %}
                    <a href="{{ path('app_dpia_edit', {id: dpia.id}) }}" class="fa-cyber-btn fa-cyber-btn--ghost">
                        <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i> {{ 'dpia.action.edit'|trans({}, 'privacy') }}
                    </a>
                {% endif %}

                {% if is_granted('ROLE_MANAGER') and dpia.status == 'in_review' %}
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--success" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="approveModal">
                        <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ 'dpia.action.approve'|trans({}, 'privacy') }}
                    </button>
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--danger" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="rejectModal">
                        <i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i> {{ 'dpia.action.reject'|trans({}, 'privacy') }}
                    </button>
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--warning" data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open" data-fa-modal-id="revisionModal">
                        <i class="fa-icon fa-icon--ui-refresh" aria-hidden="true"></i> {{ 'dpia.action.request_revision'|trans({}, 'privacy') }}
                    </button>
                {% endif %}

                {% if dpia.status == 'requires_revision' %}
                    <form action="{{ path('app_dpia_reopen', {id: dpia.id}) }}" method="post" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('reopen' ~ dpia.id) }}">
                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">
                            <i class="fa-icon fa-icon--nav-collection" aria-hidden="true"></i> {{ 'dpia.action.reopen'|trans({}, 'privacy') }}
                        </button>
                    </form>
                {% endif %}

                <form action="{{ path('app_dpia_clone', {id: dpia.id}) }}" method="post" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('clone' ~ dpia.id) }}">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost">
                        <i class="fa-icon fa-icon--ui-copy" aria-hidden="true"></i> {{ 'dpia.action.clone'|trans({}, 'privacy') }}
                    </button>
                </form>

                {% if is_granted('ROLE_MANAGER') %}
                    <form action="{{ path('app_dpia_delete', {id: dpia.id}) }}" method="post" class="d-inline"
                          data-controller="ui-actions"
                          data-action="submit->ui-actions#confirm"
                          data-ui-actions-message-param="{{ 'dpia.confirm.delete'|trans({}, 'privacy') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dpia.id) }}">
                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
                            <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}
                        </button>
                    </form>
                {% endif %}
            </div>
        {% endblock %}
    {% endembed %}

    </div>

    {# Risk Assessment #}
    <div id="risk" class="row mb-4 fa-show-section">
        <div class="col-md-6">
            {% embed '_components/_card.html.twig' %}
                {% block card_header %}
                    <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i> {{ 'dpia.show.section.risk_assessment'|trans({}, 'privacy') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% if dpia.riskLevel %}
                        <p><strong>{{ 'dpia.show.field.initial_risk'|trans({}, 'privacy') }}:</strong>
                            {% set risk_class = pill_tone_severity(dpia.riskLevel|default('')) %}
                            {% include '_components/_badge.html.twig' with { variant: risk_class, content: ('dpia.risk_level.' ~ dpia.riskLevel)|trans({}, 'privacy') } %}
                        </p>
                    {% endif %}
                    {% if dpia.residualRiskLevel %}
                        <p><strong>{{ 'dpia.index.residual_risk'|trans({}, 'privacy') }}:</strong>
                            {% set risk_class = pill_tone_severity(dpia.residualRiskLevel|default('')) %}
                            {% include '_components/_badge.html.twig' with { variant: risk_class, content: ('dpia.risk_level.' ~ dpia.residualRiskLevel)|trans({}, 'privacy') } %}
                        </p>
                        {% if dpia.isResidualRiskAcceptable %}
                            <p class="text-success"><i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ 'dpia.show.risk.acceptable'|trans({}, 'privacy') }}</p>
                        {% else %}
                            <p class="text-danger"><i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i> {{ 'dpia.show.risk.requires_consultation'|trans({}, 'privacy') }}</p>
                        {% endif %}
                    {% endif %}
                {% endblock %}
            {% endembed %}

            {% set sdm = dpia.sdmAssessment ?? {} %}
            {% if sdm|length > 0 or dpia.sdmAssessmentSummary %}
            <div class="mt-3">
                {% embed '_components/_card.html.twig' %}
                    {% block card_header %}
                        <div class="card-header"><h2 class="h5 mb-0">
                            <i class="fa-icon fa-icon--nav-shield" aria-hidden="true"></i>
                            {{ 'privacy.sdm.title'|trans({}, 'privacy') }}
                        </h2></div>
                    {% endblock %}
                    {% block card_body %}
                        <p class="text-muted small mb-3">{{ 'privacy.sdm.description'|trans({}, 'privacy') }}</p>
                        <p class="mb-2">
                            <strong>{{ 'privacy.sdm.coverage'|trans({}, 'privacy') }}:</strong>
                            {{ dpia.sdmCoveragePercent }}%
                            {% if dpia.sdmHighestRiskLevel %}
                                · <strong>{{ 'privacy.sdm.highest_risk'|trans({}, 'privacy') }}:</strong>
                                                                {% include '_components/_badge.html.twig' with { variant: pill_tone_severity(dpia.sdmHighestRiskLevel), content: ('privacy.sdm.risk_level.' ~ dpia.sdmHighestRiskLevel)|trans({}, 'privacy') } %}
                            {% endif %}
                        </p>
                        <ul class="list-unstyled small mb-2">
                            {% for goal in [
                                'verfuegbarkeit', 'integritaet', 'vertraulichkeit', 'transparenz',
                                'intervenierbarkeit', 'nichtverkettung', 'datenminimierung'
                            ] %}
                                {% set entry = sdm[goal] ?? null %}
                                <li class="mb-1">
                                    <strong>{{ ('privacy.sdm.goal.' ~ goal)|trans({}, 'privacy') }}:</strong>
                                    {% if entry and entry.risk_level is defined and entry.risk_level %}
                                        {% include '_components/_badge.html.twig' with { variant: pill_tone_severity(entry.risk_level|default('')), content: ('privacy.sdm.risk_level.' ~ entry.risk_level)|trans({}, 'privacy') } %}
                                        {% if entry.rationale is defined and entry.rationale %}
                                            <span class="text-muted">— {{ entry.rationale }}</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                        {% if dpia.sdmAssessmentSummary %}
                            <p class="mb-0"><strong>{{ 'privacy.sdm.summary'|trans({}, 'privacy') }}:</strong>
                                {{ dpia.sdmAssessmentSummary|nl2br }}
                            </p>
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            </div>
            {% endif %}
        </div>

        <div class="col-md-6">
            {% embed '_components/_card.html.twig' %}
                {% block card_header %}
                    <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--group" aria-hidden="true"></i> {{ 'dpia.show.section.consultations'|trans({}, 'privacy') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    <p><strong>{{ 'dpia.show.field.dpo_consultation'|trans({}, 'privacy') }}:</strong>
                        {% if dpia.dpoConsultationDate %}
                            <span class="text-success"><i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ dpia.dpoConsultationDate|fa_date }}</span>
                        {% else %}
                            <span class="text-muted">{{ 'dpia.show.not_yet_consulted'|trans({}, 'privacy') }}</span>
                        {% endif %}
                    </p>
                    {% if not dpia.dpoConsultationDate and is_granted('ROLE_MANAGER') %}
                        <form method="post" action="{{ path('app_dpia_dpo_consultation', {id: dpia.id}) }}" class="mb-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('dpo' ~ dpia.id) }}">
                            <label for="dpo_advice_{{ dpia.id }}" class="form-label small">{{ 'dpia.show.dpo_advice_label'|trans({}, 'privacy') }}</label>
                            <textarea name="dpo_advice" id="dpo_advice_{{ dpia.id }}" rows="3" required
                                      class="form-control form-control-sm fa-cyber-input__field mb-2"></textarea>
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                                {{ 'dpia.show.record_dpo_consultation'|trans({}, 'privacy') }}
                            </button>
                        </form>
                    {% endif %}
                    <p><strong>{{ 'dpia.show.field.supervisory_consultation'|trans({}, 'privacy') }}:</strong>
                        {% if dpia.requiresSupervisoryConsultation %}
                            {% if dpia.supervisoryConsultationDate %}
                                <span class="text-success"><i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ dpia.supervisoryConsultationDate|fa_date }}</span>
                            {% else %}
                                <span class="text-warning"><i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i> {{ 'dpia.show.required_not_completed'|trans({}, 'privacy') }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">{{ 'dpia.show.not_required'|trans({}, 'privacy') }}</span>
                        {% endif %}
                    </p>
                    {% if dpia.requiresSupervisoryConsultation and not dpia.supervisoryConsultationDate and is_granted('ROLE_MANAGER') %}
                        <form method="post" action="{{ path('app_dpia_supervisory_consultation', {id: dpia.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('supervisory' ~ dpia.id) }}">
                            <label for="supervisory_feedback_{{ dpia.id }}" class="form-label small">{{ 'dpia.show.supervisory_feedback_label'|trans({}, 'privacy') }}</label>
                            <textarea name="supervisory_feedback" id="supervisory_feedback_{{ dpia.id }}" rows="3" required
                                      class="form-control form-control-sm fa-cyber-input__field mb-2"></textarea>
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                                {{ 'dpia.show.record_supervisory_consultation'|trans({}, 'privacy') }}
                            </button>
                        </form>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# Processing Description #}
    <div id="processing" class="fa-show-section">
    {% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
        {% block card_header %}
            <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--ui-info" aria-hidden="true"></i> {{ 'dpia.new.section_processing_operations'|trans({}, 'privacy') }}</h2>
            </div>
        {% endblock %}
        {% block card_body %}
            {% if dpia.processingDescription %}
                <h3 class="h6">{{ 'dpia.form.processing_description'|trans({}, 'privacy') }}:</h3>
                <p>{{ dpia.processingDescription|nl2br }}</p>
            {% endif %}
            {% if dpia.processingPurposes %}
                <h3 class="h6">{{ 'dpia.form.processing_purposes'|trans({}, 'privacy') }}:</h3>
                <p>{{ dpia.processingPurposes|nl2br }}</p>
            {% endif %}
            {% if dpia.dataCategories|length > 0 %}
                <h3 class="h6">{{ 'dpia.form.data_categories'|trans({}, 'privacy') }}:</h3>
                <p>{{ dpia.dataCategories|join(', ') }}</p>
            {% endif %}
        {% endblock %}
    {% endembed %}

    </div>

    {# Measures #}
    <div id="measures" class="fa-show-section">
    {% embed '_components/_card.html.twig' with {class: 'mb-4'} %}
        {% block card_header %}
            <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--compliance-shield" aria-hidden="true"></i> {{ 'dpia.new.section_measures'|trans({}, 'privacy') }}</h2>
            </div>
        {% endblock %}
        {% block card_body %}
            {% if dpia.technicalMeasures %}
                <h3 class="h6">{{ 'dpia.form.technical_measures'|trans({}, 'privacy') }}:</h3>
                <p>{{ dpia.technicalMeasures|nl2br }}</p>
            {% endif %}
            {% if dpia.organizationalMeasures %}
                <h3 class="h6">{{ 'dpia.form.organizational_measures'|trans({}, 'privacy') }}:</h3>
                <p>{{ dpia.organizationalMeasures|nl2br }}</p>
            {% endif %}
        {% endblock %}
    {% endembed %}

    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: dpia, lifecycle: 'dpia' } only %}

    {# Comment-Thread adoption (C7 macro). #}
    <div id="comments" class="fa-show-section">
    {% include '_components/_isms_comment_thread.html.twig' with {
        comments: comments|default([]),
        entityType: 'DataProtectionImpactAssessment',
        entityId: dpia.id,
        showForm: true,
        formAction: path('app_comment_post', {entityType: 'DataProtectionImpactAssessment', entityId: dpia.id}),
        csrfToken: csrf_token('isms-comment')
    } only %}
    </div>
</div>

{# Approve / reject / revision: the one decision dialog (UI wave H). #}
{% import '_macros/workflow.html.twig' as _workflow %}
{{ _workflow.decision_modal({
    id: 'approveModal', tone: 'success',
    title: 'dpia.modal.approve_title'|trans({}, 'privacy'),
    submit_label: 'dpia.action.approve'|trans({}, 'privacy'),
    action: path('app_dpia_approve', {id: dpia.id}),
    token: csrf_token('approve' ~ dpia.id),
    subject: dpia.title,
    field: { name: 'approval_comments', label: 'dpia.modal.approval_comments'|trans({}, 'privacy') },
}) }}
{{ _workflow.decision_modal({
    id: 'rejectModal', tone: 'danger',
    title: 'dpia.modal.reject_title'|trans({}, 'privacy'),
    submit_label: 'dpia.action.reject'|trans({}, 'privacy'),
    action: path('app_dpia_reject', {id: dpia.id}),
    token: csrf_token('reject' ~ dpia.id),
    subject: dpia.title,
    field: { name: 'rejection_reason', label: 'dpia.modal.rejection_reason'|trans({}, 'privacy'), required: true },
}) }}
{{ _workflow.decision_modal({
    id: 'revisionModal', tone: 'warning', icon: 'status-warning',
    title: 'dpia.modal.revision_title'|trans({}, 'privacy'),
    submit_label: 'dpia.action.request_revision'|trans({}, 'privacy'),
    action: path('app_dpia_request_revision', {id: dpia.id}),
    token: csrf_token('revision' ~ dpia.id),
    subject: dpia.title,
    field: { name: 'revision_reason', label: 'dpia.modal.revision_reason'|trans({}, 'privacy'), required: true },
}) }}
{% endblock %}
