{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% trans_default_domain 'training' %}
{% import '_macros/inheritance_badge.html.twig' as inheritance %}

{% block title %}{{ 'training.title'|trans({}, 'training') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'training.title'|trans({}, 'training') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'training.title'|trans({}, 'training'),
    subtitle: participantFilter|default(null) ? 'training.filter.participant'|trans({'%name%': participantFilter.fullName}, 'training') : null,
    actions: (participantFilter|default(null) and is_granted('ROLE_MANAGER') ? [
        { label: 'training.prefill.board_action'|trans({}, 'training'), variant: 'primary', href: path('app_training_new', {forBoard: 1}) }
    ] : [])|merge(is_granted('ROLE_USER') ? [
        { label: 'training.new'|trans({}, 'training'), variant: participantFilter|default(null) ? 'ghost' : 'primary', icon: 'plus', href: path('app_training_new'), attrs: {'data-turbo-frame': 'fa-form-modal'} }
    ] : [])
}) }}
{% set _global_hints = alva_hints('training_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}


<div class="container-fluid py-4">

    {# Upcoming Trainings Section #}
    {% if upcoming|length > 0 %}
    {% embed '_components/_card.html.twig' with {class: 'mb-4', borderColor: 'info'} %}
        {% block card_header %}
            <div class="card-header">
                <h2 class="mb-0"><i class="fa-icon fa-icon--ui-calendar-event text-info" aria-hidden="true"></i> {{ 'training.upcoming_trainings'|trans({}, 'training') }}</h2>
            </div>
        {% endblock %}
        {% block card_body %}
            {% embed '_components/_table.html.twig' with {
                'noMargin': false
            } %}
                {% import '_macros/inheritance_badge.html.twig' as inheritance %}
                {% block table_head %}
                    <tr>
                        <th scope="col">{{ 'training.title'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.type_label'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.scheduled_date'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.delivery_method'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.mandatory'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body %}
                    {% for training in upcoming %}
                    <tr>
                        <td>
                            <strong>{{ training.title }}</strong>
                            {{ inheritance.small_badge(training, currentTenant) }}
                            {% if training.mandatory %}
                            {% include '_components/_badge.html.twig' with { variant: 'warning', icon: 'status-critical', content: 'training.mandatory_label'|trans({}, 'training'), class: 'ms-1' } %}
                            {% endif %}
                        </td>
                        <td>
                            {% include '_components/_badge.html.twig' with { variant: 'secondary', content: ('training.type.' ~ training.trainingType)|trans({}, 'training') } %}
                        </td>
                        <td>
                            <i class="fa-icon fa-icon--ui-clock" aria-hidden="true"></i>
                            {{ training.scheduledDate|fa_date }}
                        </td>
                        <td>{{ ('training.delivery.' ~ training.deliveryMethod)|trans({}, 'training') }}</td>
                        <td>
                            {% if training.mandatory %}
                            <span class="text-warning"><i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ 'common.yes'|trans({}, 'messages') }}</span>
                            {% else %}
                            <span class="text-muted">{{ 'common.no'|trans({}, 'messages') }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_training_show', {id: training.id}) }}"
                               class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm"
                               data-turbo-action="advance">
                                <i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i> {{ 'common.view'|trans({}, 'messages') }}
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_training_index'),
        filter_keys: ['view'],
        list_title: 'training.all_trainings'|trans({}, 'training'),
        empty: {
            mood: 'sleeping',
            title: 'training.no_trainings'|trans({}, 'training'),
            actions: is_granted('ROLE_USER') ? [
                { label: 'training.create_first'|trans({}, 'training'), variant: 'primary', icon: 'plus', href: path('app_training_new') }
            ] : []
        },
        card_attrs: { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': '/' ~ app.request.locale ~ '/training' },
    } %}
        {% block list_filters %}
            {% if currentTenant %}
            <div class="col-md-4">
                <label for="view-filter" class="form-label">{{ 'common.view'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="view-filter" name="view" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="own" {{ inheritanceInfo.currentView == 'own' ? 'selected' : '' }}>{{ 'corporate.view.own_only'|trans({}, 'messages') }}</option>
                    {% if inheritanceInfo.hasParent %}
                    <option value="inherited" {{ inheritanceInfo.currentView == 'inherited' ? 'selected' : '' }}>{{ 'corporate.view.including_inherited'|trans({}, 'messages') }}</option>
                    {% endif %}
                    {% if inheritanceInfo.hasSubsidiaries %}
                    <option value="subsidiaries" {{ inheritanceInfo.currentView == 'subsidiaries' ? 'selected' : '' }}>{{ 'corporate.view.including_subsidiaries'|trans({}, 'messages') }}</option>
                    {% endif %}
                </select>
            </div>
            {% endif %}
        {% endblock %}
        {% block list_summary %}
            {% if statistics.upcoming > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'training.summary.upcoming'|trans({'%count%': statistics.upcoming}, 'training') }}</span>{% endif %}
            {% if statistics.completed > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'training.summary.completed'|trans({'%count%': statistics.completed}, 'training') }}</span>{% endif %}
            {% if statistics.mandatory > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'training.summary.mandatory'|trans({'%count%': statistics.mandatory}, 'training') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with {
                'variant': 'striped',
                'class': 'table-bulk-selectable'
            } %}
                {% import '_macros/inheritance_badge.html.twig' as inheritance %}
                {% block table_body_attrs %}id="training-rows"{% endblock %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'training.title'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.type_label'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.scheduled_date'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.duration'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.status_label'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'training.participants_count'|trans({}, 'training') }}</th>
                        <th scope="col">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body %}
                    {% set workflowStates = workflow_states(page) %}
                    {% for training in page %}
                    {% include 'training/_row.html.twig' with { training: training, currentTenant: currentTenant } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}

            {# Bulk Action Bar #}
            {% include '_components/_bulk_action_bar.html.twig' with {
                actions: ['export', 'assign', 'delete']
            } %}
        {% endblock %}
    {% endembed %}
</div>

{# Delete Modals #}
{% for training in page %}
<div class="fa-modal fa-modal--confirm fa-modal--danger" id="deleteModal{{ training.id }}"
     data-controller="fa-modal" data-fa-modal-mode-value="confirm" data-fa-modal-tone-value="danger"
     role="alertdialog" aria-modal="true" aria-labelledby="deleteModal{{ training.id }}Label" aria-hidden="true">
    <div class="fa-modal__backdrop" data-fa-modal-target="backdrop" data-action="click->fa-modal#backdropClick" aria-hidden="true"></div>
    <div class="fa-modal__container" data-fa-modal-target="dialog"><header class="fa-modal__header"><span class="fa-modal__icon" aria-hidden="true"><i class="fa-icon fa-icon--ui-trash"></i></span><div class="fa-modal__heading"><h3 class="fa-modal__title" id="deleteModalLabel{{ training.id }}">
                    {{ 'training.confirm_delete'|trans({}, 'training') }}
                </h3></div><button type="button" class="fa-modal__close" data-action="fa-modal#cancel" aria-label="{{ 'action.close'|trans({}, 'messages') }}"><i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i></button></header>
            <div class="fa-modal__body">
                <p>{{ 'training.delete_warning'|trans({'%title%': training.title}, 'training') }}</p>
                <p class="text-muted"><small>{{ 'common.action_irreversible'|trans({}, 'messages') }}</small></p>
            </div>
            <footer class="fa-modal__footer">
                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost" data-action="fa-modal#cancel">{{ 'common.cancel'|trans({}, 'messages') }}</button>
                <form method="post" action="{{ path('app_training_delete', {id: training.id}) }}" class="d-inline" data-fa-modal-target="form">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ training.id) }}">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
                        <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'common.delete'|trans({}, 'messages') }}
                    </button>
                </form></div>
</div>
</div>
{% endfor %}
{% endblock %}
