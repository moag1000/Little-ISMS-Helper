{% extends 'base.html.twig' %}
{% import '_components/_status_vocabulary.html.twig' as _vocab %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
{% import '_components/_lifecycle_actions.html.twig' as _lifecycle_actions %}
{% trans_default_domain 'threat' %}

{% block title %}{{ threat.title }} - {{ 'threat.title.index'|trans({}, 'threat') }}{% endblock %}

{% block body %}
<div class="container">
    {# M-4 — module-gating: Threat Intelligence (MITRE ATT&CK + STIX) #}
    {% if not is_module_active('vulnerability_intel') %}
        {% import '_components/_fa_alert.html.twig' as _fa_alert %}
        {{ _fa_alert.render({
            variant: 'info',
            icon: 'nav-shield-alert',
            body: 'common.module_not_active'|trans({'%module%': 'Threat Intel'}, 'messages')
        }) }}
    {% else %}
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'threat.title.index'|trans({}, 'threat'), url: path('app_threat_intelligence_index'), icon: 'nav-shield-alert' },
            { label: threat.title }
        ]
    } %}

    {% set _show_actions = [] %}
    {% if is_granted('ROLE_MANAGER') %}
        {% set _show_actions = _show_actions|merge([{ label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit', href: path('app_threat_intelligence_edit', {id: threat.id}) }]) %}
    {% endif %}
    {% set _show_actions = _show_actions|merge([{ label: 'common.back_to_list'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('app_threat_intelligence_index') }]) %}
    {{ _fa_page_header.render({
        title: threat.title,
        actions: _show_actions
    }) }}

    {% set _status %}
        {{ _vocab.pill('threat', threat.status, ('status_type.' ~ threat.status)|trans({}, 'threat')) }}
    {% endset %}
    {% set _actions %}{{ _lifecycle_actions.dropdown(threat, 'threat-intelligence', 'threat_intelligence_lifecycle') }}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'show.status.severity'|trans({}, 'messages'), value: threat.severity ? ('severity.' ~ threat.severity)|trans({}, 'threat') : null },
            { label: 'show.status.owner'|trans({}, 'messages'), value: threat.effectiveAssignedTo },
            { label: 'show.status.detected'|trans({}, 'messages'), value: threat.detectionDate ? threat.detectionDate|fa_date : null },
            { label: 'show.status.type'|trans({}, 'messages'), value: threat.threatType ? ('type.' ~ threat.threatType)|trans({}, 'threat') : null },
        ],
        workflow: workflow_state(threat),
    }) }}

    {% set _links = entity_links(threat) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: threat } only %}

    {# Inline POST-delete kept below header (cannot be expressed via _fa_page_header GET-only actions) #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="d-flex justify-content-end mb-3">
            <form method="post" action="{{ path('app_threat_intelligence_delete', {id: threat.id}) }}" class="d-inline"
                  data-controller="ui-actions"
                  data-action="submit->ui-actions#confirm"
                  data-ui-actions-message-param="{{ 'threat.confirm.delete'|trans({}, 'threat') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ threat.id) }}">
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
                    <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i>
                    {{ 'common.delete'|trans({}, 'messages') }}
                </button>
            </form>
        </div>
    {% endif %}

    <div id="details" class="fa-show-section">
    {% embed '_components/_card.html.twig' %}
        {% block card_header %}
            <div class="card-header">
                <h2>{{ 'threat.title.show'|trans({}, 'threat') }}</h2>
            </div>
        {% endblock %}
        {% block card_body %}
            {% include '_components/_detail_group.html.twig' with {
                items: [
                    { label: 'threat.field.threat_type'|trans({}, 'threat'),   value: ('type.' ~ threat.threatType)|trans({}, 'threat') },
                    { label: 'threat.field.severity'|trans({}, 'threat'),      value: ('severity.' ~ threat.severity)|trans({}, 'threat') },
                    { label: 'threat.field.status'|trans({}, 'threat'),        value: ('status_type.' ~ threat.status)|trans({}, 'threat') },
                    { label: 'threat.field.detection_date'|trans({}, 'threat'),value: threat.detectionDate ? threat.detectionDate|fa_date : null },
                    { label: 'threat.field.mitigation_date'|trans({}, 'threat'),value: threat.mitigationDate ? threat.mitigationDate|fa_date : null },
                    { label: 'threat.field.cvss_score'|trans({}, 'threat'),    value: threat.cvssScore },
                    { label: 'threat.field.cve_id'|trans({}, 'threat'),        value: threat.cveId },
                    { label: 'threat.field.source'|trans({}, 'threat'),        value: threat.source },
                    { label: 'threat.field.affects_organization'|trans({}, 'threat'), value: threat.affectsOrganization ? 'choice.yes'|trans({}, 'threat') : 'choice.no'|trans({}, 'threat') }
                ]
            } only %}

            {% if threat.description %}
                <div class="detail-section">
                    <h3>{{ 'common.description'|trans({}, 'messages') }}</h3>
                    <p>{{ threat.description|nl2br }}</p>
                </div>
            {% endif %}

            {# Assignment section #}
            <div class="detail-section">
                <h3>{{ 'threat.section.assignment'|trans({}, 'threat') }}</h3>
                {% include '_components/_detail_group.html.twig' with {
                    items: [
                        { label: 'threat.field.assigned_to_user'|trans({}, 'threat'), value: threat.effectiveAssignedTo, dataReuse: true },
                        { label: 'threat.field.assigned_deputy_persons'|trans({}, 'threat'), value: threat.allAssignedOwners|join(', ') ?: null }
                    ]
                } only %}
            </div>

            {% if threat.mitigationRecommendations %}
                <div class="detail-section">
                    <h3>{{ 'threat.field.mitigation_recommendations'|trans({}, 'threat') }}</h3>
                    <div class="instruction-box">{{ threat.mitigationRecommendations|nl2br }}</div>
                </div>
            {% endif %}

            {% if threat.actionsTaken %}
                <div class="detail-section">
                    <h3>{{ 'threat.field.actions_taken'|trans({}, 'threat') }}</h3>
                    <div class="instruction-box">{{ threat.actionsTaken|nl2br }}</div>
                </div>
            {% endif %}

            {% if threat.references %}
                <div class="detail-section">
                    <h3>{{ 'threat.field.references'|trans({}, 'threat') }}</h3>
                    <div class="instruction-box">{{ threat.references|nl2br }}</div>
                </div>
            {% endif %}

            {# Affected Assets #}
            {% if threat.affectedAssets|length > 0 %}
                <div class="detail-section">
                    <h3>{{ 'threat.field.affected_assets'|trans({}, 'threat') }} ({{ threat.affectedAssets|length }})</h3>
                    <ul class="list-unstyled">
                        {% for asset in threat.affectedAssets %}
                            <li>
                                <a href="{{ path('app_asset_show', {id: asset.id}) }}">{{ asset.name }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# Resulting Incidents #}
            {% if threat.resultingIncidents|length > 0 %}
                <div class="detail-section">
                    <h3>{{ 'threat.section.resulting_incidents'|trans({}, 'threat') }} ({{ threat.resultingIncidents|length }})</h3>
                    <ul class="list-unstyled">
                        {% for incident in threat.resultingIncidents %}
                            <li>
                                <a href="{{ path('app_incident_show', {id: incident.id}) }}">{{ incident.title }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="detail-section text-muted small">
                {% if threat.createdAt %}
                    {{ 'common.created_at'|trans({}, 'messages') }}: {{ threat.createdAt|fa_datetime }}
                {% endif %}
                {% if threat.updatedAt %}
                    &mdash; {{ 'common.updated_at'|trans({}, 'messages') }}: {{ threat.updatedAt|fa_datetime }}
                {% endif %}
            </div>
        {% endblock %}
    {% endembed %}
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: threat, lifecycle: 'threat-intelligence' } only %}
    {% endif %} {# /M-4 vulnerability_intel module gate #}
</div>

<style>
.instruction-box {
    padding: 1rem;
    background: var(--bs-tertiary-bg);
    color: var(--bs-body-color);
    border-left: 3px solid var(--primary);
    border-radius: 4px;
    white-space: pre-wrap;
}
</style>
{% endblock %}
