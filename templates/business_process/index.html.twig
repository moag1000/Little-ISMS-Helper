{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'business_process' %}
{% import '_macros/inheritance_badge.html.twig' as inheritance %}

{% block title %}{{ 'business_process.index.title'|trans({}, 'business_process') }}{% endblock %}

{% block body %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
<div class="container-fluid">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.bcm'|trans({}, 'nav'), url: path('app_bcm_index') },
            { label: 'nav.business_processes'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'business_process.index.page_title'|trans({}, 'business_process'),
        actions: [
            { label: 'business_process.index.new_process'|trans({}, 'business_process'), href: path('app_business_process_new'), variant: 'primary', icon: 'plus', attrs: {'data-turbo-frame': 'fa-form-modal'} }
        ]|merge(is_granted('ROLE_MANAGER') ? [{ label: 'filtered_export.button.label'|trans({}, 'filtered_export'), href: path('app_filtered_export_entity', { entityType: 'business_process', format: 'xlsx' }) ~ (app.request.queryString ? '?' ~ app.request.queryString : ''), variant: 'ghost', icon: 'nav-file-earmark-spreadsheet' }] : [])
    }) }}
{% set _global_hints = alva_hints('business_process_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    <div>

    {# Notifications Container for Turbo Streams #}
    <div id="notifications" class="mb-3"></div>

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_business_process_index'),
        filter_keys: ['view', 'criticality'],
        list_title: 'business_process.index.table.title'|trans({}, 'business_process'),
        empty: {
            mood: 'thinking',
            title: 'business_process.empty.title'|trans({}, 'business_process'),
            text: 'business_process.empty.body'|trans({}, 'business_process'),
            norm_ref: 'ISO 27001 A.5.30 · ISO 22301 Klausel 8.2.2',
            actions: [
                { label: 'business_process.action.create_first'|trans({}, 'business_process'), variant: 'primary', icon: 'plus', href: path('app_business_process_new') }
            ],
            help_link: 'business_process.help.empty_link'|trans({}, 'business_process')
        },
    } %}
        {% block list_filters %}
            {% if currentTenant %}
            <div class="col-md-4">
                <label for="view-filter" class="form-label">{{ 'common.view'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="view-filter" name="view" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="own" {{ inheritanceInfo.currentView == 'own' ? 'selected' : '' }}>{{ 'corporate.view.own_only'|trans({}, 'tenant') }}</option>
                    {% if inheritanceInfo.hasParent %}
                    <option value="inherited" {{ inheritanceInfo.currentView == 'inherited' ? 'selected' : '' }}>{{ 'corporate.view.including_inherited'|trans({}, 'tenant') }}</option>
                    {% endif %}
                    {% if inheritanceInfo.hasSubsidiaries %}
                    <option value="subsidiaries" {{ inheritanceInfo.currentView == 'subsidiaries' ? 'selected' : '' }}>{{ 'corporate.view.including_subsidiaries'|trans({}, 'tenant') }}</option>
                    {% endif %}
                </select>
            </div>
            {% endif %}
            <div class="col-md-4">
                <label for="filter-criticality" class="form-label">{{ 'bcm.table.criticality'|trans({}, 'bcm') }}</label>
                <select class="form-select fa-cyber-input__field" id="filter-criticality" name="criticality" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="">{{ 'bcm.filter.all_criticality'|trans({}, 'bcm') }}</option>
                    {% for _c in ['critical', 'high', 'medium', 'low'] %}
                        <option value="{{ _c }}" {{ current_criticality == _c ? 'selected' : '' }}>{{ ('bcm.criticality.' ~ _c)|trans({}, 'bcm') }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if critical_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'business_process.summary.critical'|trans({'%count%': critical_count}, 'business_process') }}</span>{% endif %}
            {% if with_risks_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'business_process.summary.with_risks'|trans({'%count%': with_risks_count}, 'business_process') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                {% import '_macros/inheritance_badge.html.twig' as inheritance %}
                {% block table_head %}
                    <tr>
                        <th scope="col">{{ 'business_process.index.table.name'|trans({}, 'business_process') }}</th>
                        <th scope="col">{{ 'business_process.index.table.owner'|trans({}, 'business_process') }}</th>
                        <th scope="col">{{ 'business_process.index.table.criticality'|trans({}, 'business_process') }}</th>
                        <th scope="col">{{ 'business_process.index.table.rto'|trans({}, 'business_process') }}</th>
                        <th scope="col">{{ 'business_process.index.table.rpo'|trans({}, 'business_process') }}</th>
                        <th scope="col">{{ 'business_process.index.table.mtpd'|trans({}, 'business_process') }}</th>
                        <th scope="col">{{ 'business_process.index.table.impact_score'|trans({}, 'business_process') }}</th>
                        <th scope="col">{{ 'business_process.index.table.actions'|trans({}, 'business_process') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="business-processes-table-body"{% endblock %}
                {% block table_body %}
                    {% for process in page %}
                        {% include 'business_process/_row.html.twig' with { business_process: process, currentTenant: currentTenant } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
    </div>
</div>
{% endblock %}
