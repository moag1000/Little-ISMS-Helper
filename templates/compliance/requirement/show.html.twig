{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}

{% block title %}{{ requirement.requirementId }} - {{ requirement.title }}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {# M-4 — module-gating: Compliance Requirements (depends on compliance module) #}
    {% if not is_module_active('compliance') %}
        {{ _fa_alert.render({
            variant: 'info',
            icon: 'nav-shield-alert',
            body: 'common.module_not_active'|trans({'%module%': 'Compliance'}, 'messages')
        }) }}
    {% else %}
    {# Breadcrumb Navigation #}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_compliance_index') }}">Compliance</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_compliance_framework', {id: requirement.framework.id}) }}">{{ requirement.framework.code }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_compliance_requirement_index') }}?framework={{ requirement.framework.id }}">Requirements</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ requirement.requirementId }}</li>
        </ol>
    </nav>

    {{ _fa_page_header.render({
        badge: { icon: 'nav-list-check', label: requirement.framework.code },
        title: requirement.requirementId,
        subtitle: requirement.title,
        actions: ((is_granted('ADMIN_GLOBAL_OP') or (requirement.uploadTenant is not null and is_granted('ROLE_MANAGER'))) ? [
            { label: 'common.edit'|trans({}, 'messages'), variant: 'primary', icon: 'ui-edit', href: path('app_compliance_requirement_edit', {id: requirement.id}) }
        ] : [])|merge([
            { label: 'common.back_to_list'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('app_compliance_requirement_index') ~ '?framework=' ~ requirement.framework.id }
        ])
    }) }}

    {% import '_components/_status_pill.html.twig' as _pill %}
    {% set _status %}{% if fulfillment %}{{ _pill.render(('lifecycle.' ~ fulfillment.status)|trans({}, 'lifecycle'), fulfillment.statusEnum ? fulfillment.statusEnum.pillVariant : 'neutral') }}{% endif %}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        facts: [
            { label: 'show.status.priority'|trans({}, 'messages'), value: requirement.priority },
            { label: 'show.status.progress'|trans({}, 'messages'), value: fulfillment ? fulfillment.fulfillmentPercentage ~ ' %' : null },
            { label: 'show.status.owner'|trans({}, 'messages'), value: fulfillment ? fulfillment.effectiveResponsiblePerson : null },
            { label: 'show.status.next_review'|trans({}, 'messages'), value: fulfillment and fulfillment.nextReviewDate ? fulfillment.nextReviewDate|fa_date : null },
        ],
        workflow: workflow_state(requirement),
    }) }}

    {% set _links = entity_links(requirement) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'compliance.requirement.details'|trans({}, 'compliance') },
        { id: 'evidence', label: 'compliance.requirement.evidence.anchor'|trans({}, 'compliance') },
        { id: 'fulfillment', label: 'show.anchor.fulfillment'|trans({}, 'messages') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: requirement } only %}

    <div class="row">
        <div class="col-md-8">
            <div id="details" class="fa-show-section">
            {# Main Information #}
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0"><i class="fa-icon fa-icon--nav-list-check" aria-hidden="true"></i> {{ 'compliance.requirement.details'|trans({}, 'compliance') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    <p class="lead fw-bold">{{ requirement.title }}</p>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p><strong>Framework:</strong>
                                <a href="{{ path('app_compliance_framework', {id: requirement.framework.id}) }}">
                                    {{ requirement.framework.name }}
                                </a>
                            </p>
                            <p><strong>Requirement ID:</strong> <code>{{ requirement.requirementId }}</code></p>
                            <p><strong>Category:</strong> {{ requirement.category|default('—') }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Priority:</strong>
                                <span class="{{ badge_priority(requirement.priority) }}">{{ requirement.priority }}</span>
                            </p>
                            <p><strong>Type:</strong> {% include '_components/_badge.html.twig' with { variant: 'info', content: requirement.requirementType } %}</p>
                            <p><strong>Applicable:</strong>
                                {% if fulfillment.applicable %}
                                    {% include '_components/_badge.html.twig' with { variant: 'success', content: 'common.yes'|trans({}, 'messages') } %}
                                    {% if is_inherited %}<small class="text-muted">(inherited)</small>{% endif %}
                                {% else %}
                                    {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'common.no'|trans({}, 'messages') } %}
                                    {% if is_inherited %}<small class="text-muted">(inherited)</small>{% endif %}
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <hr>

                    <p class="fw-bold">Description</p>
                    <p class="text-muted">{{ requirement.description }}</p>

                    {% if fulfillment.applicabilityJustification %}
                        <p class="fw-bold mt-3">Applicability Justification {% if is_inherited %}<small class="text-muted">(from parent tenant)</small>{% endif %}</p>
                        <p class="text-muted">{{ fulfillment.applicabilityJustification }}</p>
                    {% endif %}

                    {% if fulfillment.evidenceDescription %}
                        <p class="fw-bold mt-3">Evidence Description {% if is_inherited %}<small class="text-muted">(from parent tenant)</small>{% endif %}</p>
                        <p class="text-muted">{{ fulfillment.evidenceDescription }}</p>
                    {% endif %}
                {% endblock %}
            {% endembed %}
            </div>

            {# MRIS — Reifegrad-Tracking pro MHC (nur für MRIS-v1.5 Framework) #}
            {% if is_mris and mris and is_module_active('mris') %}
                <div data-tour="mris-maturity-table">
                {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                    {% block card_header %}
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h2 class="mb-0">
                                <i class="fa-icon fa-icon--nav-bar-chart" aria-hidden="true"></i>
                                {{ 'compliance.requirement.mris.title'|trans({}, 'compliance') }}
                            </h2>
                            {% if mris.gapStatus == 'gap' %}
                                {% include '_components/_badge.html.twig' with { variant: 'warning', content: ('compliance.requirement.mris.status.gap'|trans({}, 'compliance')) ~ ' (' ~ mris.delta ~ ')' } %}
                            {% elseif mris.gapStatus == 'on_target' %}
                                {% include '_components/_badge.html.twig' with { variant: 'success', content: 'compliance.requirement.mris.status.on_target'|trans({}, 'compliance') } %}
                            {% elseif mris.gapStatus == 'exceeded' %}
                                {% include '_components/_badge.html.twig' with { variant: 'info', content: 'compliance.requirement.mris.status.exceeded'|trans({}, 'compliance') } %}
                            {% else %}
                                {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'compliance.requirement.mris.status.unset'|trans({}, 'compliance') } %}
                            {% endif %}
                        </div>
                    {% endblock %}
                    {% block card_body %}
                        <p class="text-muted small mb-3">
                            {{ 'compliance.requirement.mris.intro'|trans({}, 'compliance') }}
                            <br>
                            <em>{{ 'compliance.requirement.mris.source'|trans({}, 'compliance') }}</em>
                        </p>

                        {% embed '_components/_fa_table.html.twig' with { compact: true } %}
                            {% block table_head %}
                                <tr>
                                    <th scope="col" class="fa-table__th">{{ 'compliance.requirement.mris.stage'|trans({}, 'compliance') }}</th>
                                    <th scope="col" class="fa-table__th fa-table__th--center">{{ 'compliance.requirement.mris.current'|trans({}, 'compliance') }}</th>
                                    <th scope="col" class="fa-table__th fa-table__th--center">{{ 'compliance.requirement.mris.target'|trans({}, 'compliance') }}</th>
                                </tr>
                            {% endblock %}
                            {% block table_body %}
                                {% for stage in mris.stages %}
                                    <tr class="fa-table__row">
                                        <td class="fa-table__cell"><code>{{ stage }}</code></td>
                                        <td class="fa-table__cell fa-table__cell--center">
                                            {% if mris.current == stage %}
                                                <i class="fa-icon fa-icon--ui-check text-warning" aria-label="{{ 'compliance.requirement.aria.current'|trans({}, 'compliance') }}"></i>
                                            {% endif %}
                                        </td>
                                        <td class="fa-table__cell fa-table__cell--center">
                                            {% if mris.target == stage %}
                                                <i class="fa-icon fa-icon--nav-bullseye text-success" aria-label="{{ 'compliance.requirement.aria.target'|trans({}, 'compliance') }}"></i>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endblock %}
                        {% endembed %}

                        <form method="post" action="{{ path('app_compliance_requirement_mris_maturity', {id: requirement.id}) }}" class="row g-2 align-items-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('mris_maturity_' ~ requirement.id) }}">
                            <div class="col-md-5">
                                <label for="maturity_current" class="form-label small">{{ 'compliance.requirement.mris.set_current'|trans({}, 'compliance') }}</label>
                                <select id="maturity_current" name="maturity_current" class="form-select form-select-sm fa-cyber-input__field">
                                    <option value="">—</option>
                                    {% for stage in mris.stages %}
                                        <option value="{{ stage }}" {{ mris.current == stage ? 'selected' : '' }}>{{ stage }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label for="maturity_target" class="form-label small">{{ 'compliance.requirement.mris.set_target'|trans({}, 'compliance') }}</label>
                                <select id="maturity_target" name="maturity_target" class="form-select form-select-sm fa-cyber-input__field">
                                    <option value="">—</option>
                                    {% for stage in mris.stages %}
                                        <option value="{{ stage }}" {{ mris.target == stage ? 'selected' : '' }}>{{ stage }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm w-100">
                                    {{ 'compliance.requirement.mris.save'|trans({}, 'compliance') }}
                                </button>
                            </div>
                        </form>

                        {% if mris.reviewedAt %}
                            <p class="text-muted small mb-0 mt-2">
                                {{ 'compliance.requirement.mris.last_review'|trans({}, 'compliance') }}: {{ mris.reviewedAt|fa_datetime }}
                            </p>
                        {% endif %}
                    {% endblock %}
                {% endembed %}
                </div>
            {% endif %}

            {# The organisation's controls behind the requirement (what the rule reads) #}
            {% if rule_controls|length > 0 %}
                {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                    {% block card_header %}
                        <div class="card-header">
                            <h2 class="mb-0"><i class="fa-icon fa-icon--ui-link" aria-hidden="true"></i> {{ 'compliance.requirement.controls_title'|trans({'%count%': rule_controls|length}, 'compliance') }}</h2>
                        </div>
                    {% endblock %}
                    {% block card_body %}
                        {% embed '_components/_table.html.twig' with {
                            'class': 'table-sm',
                            'noMargin': true,
                            'responsive': true
                        } %}
                            {% block table_head %}
                                <tr>
                                    <th scope="col">{{ 'compliance.requirement.mapped_col.control_id'|trans({}, 'compliance') }}</th>
                                    <th scope="col">{{ 'compliance.requirement.mapped_col.name'|trans({}, 'compliance') }}</th>
                                    <th scope="col">{{ 'compliance.requirement.mapped_col.status'|trans({}, 'compliance') }}</th>
                                    <th scope="col">{{ 'compliance.requirement.mapped_col.progress'|trans({}, 'compliance') }}</th>
                                </tr>
                            {% endblock %}
                            {% block table_body %}
                                {% for control in rule_controls %}
                                    <tr>
                                        <td><a aria-label="{{ (control.isoReference|default(control.controlId|default('')) ~ ' ' ~ control.name|default(''))|trim }}" href="{{ path('app_soa_show', {id: control.id}) }}">{% include '_components/_iso_reference_label.html.twig' with { control: control, show_name: false } only %}</a></td>
                                        <td>{{ control.name }}</td>
                                        <td>
                                            {% include '_components/_badge.html.twig' with { variant: 'secondary', content: control.implementationStatus } %}
                                        </td>
                                        <td>{{ control.implementationPercentage|default(0) }}%</td>
                                    </tr>
                                {% endfor %}
                            {% endblock %}
                        {% endembed %}
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {# Evidence: on the requirement, its fulfilment and the controls behind it #}
            <div id="evidence" class="fa-show-section">
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0"><i class="fa-icon fa-icon--nav-file-check" aria-hidden="true"></i> {{ 'compliance.requirement.evidence.title'|trans({'%count%': evidence|length}, 'compliance') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% if evidence is empty %}
                        <p class="text-body-secondary mb-0">{{ 'compliance.requirement.evidence.empty'|trans({}, 'compliance') }}</p>
                    {% else %}
                        <ul class="list-unstyled mb-0">
                            {% for row in evidence %}
                                <li class="d-flex justify-content-between flex-wrap gap-2 py-1 border-bottom">
                                    <a href="{{ path('app_document_show', {id: row.document.id}) }}">{{ row.document.originalFilename|default(row.document.filename) }}</a>
                                    <span class="small text-body-secondary">
                                        {% for source in row.sources %}
                                            {{ ('compliance.requirement.evidence.source.' ~ source.type)|trans({'%ref%': source.ref}, 'compliance') }}{% if not loop.last %} · {% endif %}
                                        {% endfor %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endblock %}
            {% endembed %}
            </div>

            {# Cross-Framework Equivalents #}
            {% if cross_framework_equivalents is defined and cross_framework_equivalents|length > 0 %}
                {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                    {% block card_header %}
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h2 class="mb-0"><i class="fa-icon fa-icon--ui-link" aria-hidden="true"></i> {{ 'compliance.requirement.equivalents.title'|trans({}, 'compliance') }}</h2>
                            <span class="fa-status-pill fa-status-pill--neutral">{{ cross_framework_equivalents|length }} {{ 'compliance.requirement.equivalents.frameworks'|trans({}, 'compliance') }}</span>
                        </div>
                    {% endblock %}
                    {% block card_body %}
                        {# re-import inside embed — embed creates new Twig scope (CLAUDE.md pitfall #10) #}
                        {% import '_components/_fa_entity_badge.html.twig' as _fa_entity_badge %}
                        <div class="p-3">
                            <p class="text-muted small mb-3">{{ 'compliance.requirement.equivalents.intro'|trans({}, 'compliance') }}</p>
                            {% for frameworkCode, entries in cross_framework_equivalents %}
                                <div class="mb-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="fa-status-pill fa-status-pill--neutral fa-status-pill--sm me-2">{{ frameworkCode }}</span>
                                        <span class="text-muted small">{{ entries|length }} {{ 'compliance.requirement.equivalents.controls'|trans({}, 'compliance') }}</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for entry in entries %}
                                            {% set otherReq = entry.requirement %}
                                            {% set mappingPct = entry.mapping.finalPercentage %}
                                            {% set badgeVariant = mappingPct >= 100 ? 'success' : (mappingPct >= 50 ? 'warning' : 'neutral') %}
                                            <a href="{{ path('app_compliance_requirement_show', {id: otherReq.id, _locale: app.request.locale}) }}"
                                               class="fa-status-pill fa-status-pill--{{ badgeVariant }} text-decoration-none"
                                               title="{{ otherReq.title }}{% if entry.direction == 'reverse' %} ({{ 'compliance.requirement.equivalents.reverse'|trans({}, 'compliance') }}){% endif %}">
                                                <code>{{ otherReq.requirementId }}</code>
                                                <span class="ms-1">{{ mappingPct }}%</span>
                                                {% if entry.direction == 'reverse' %}
                                                    <i class="fa-icon fa-icon--ui-arrow-left ms-1" aria-hidden="true"></i>
                                                {% endif %}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                            <p class="text-muted small mt-2 mb-0"><em>{{ 'compliance.requirement.equivalents.legend'|trans({}, 'compliance') }}</em></p>
                        </div>
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {# Detailed Sub-Requirements #}
            {% if requirement.detailedRequirements|length > 0 %}
                {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                    {% block card_header %}
                        <div class="card-header">
                            <h2 class="mb-0"><i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i> Detailed Sub-Requirements ({{ requirement.detailedRequirements|length }})</h2>
                        </div>
                    {% endblock %}
                    {% block card_body %}
                        <ul class="list-group">
                            {% for subReq in requirement.detailedRequirements %}
                                {% set subFulfillment = sub_requirement_fulfillments[subReq.id] %}
                                {% set subPct = subFulfillment ? subFulfillment.fulfillmentPercentage : 0 %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>{{ subReq.requirementId }}</strong> - {{ subReq.title }}
                                        <br>
                                        <small class="text-muted">{{ subReq.description|u.truncate(100, '...') }}</small>
                                    </div>
                                    <div>
                                        <span class="{{ badge_completion(subPct) }} rounded-pill">
                                            {{ subPct }}%
                                        </span>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>

        <div class="col-md-4">
            <div id="fulfillment" class="fa-show-section">
            {# Fulfilment: rule over the organisation's data (Paket 3) #}
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0">{{ 'compliance.fulfillment_rule.card_title'|trans({}, 'compliance') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% include 'compliance/requirement/_fulfillment_card.html.twig' %}
                {% endblock %}
            {% endembed %}

            {# Metadata #}
            {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
                {% block card_header %}
                    <div class="card-header">
                        <h2 class="mb-0">{{ 'compliance.fulfillment_rule.meta.title'|trans({}, 'compliance') }}</h2>
                    </div>
                {% endblock %}
                {% block card_body %}
                    {% import '_components/_status_pill.html.twig' as pill %}
                    <dl class="small mb-0">
                        <dt>{{ 'compliance.fulfillment_rule.meta.responsible'|trans({}, 'compliance') }}</dt>
                        <dd>{{ fulfillment.effectiveResponsiblePerson ?: '—' }}</dd>
                        <dt>{{ 'compliance.fulfillment_rule.meta.last_review'|trans({}, 'compliance') }}</dt>
                        <dd>{{ fulfillment.lastReviewDate|fa_date }}</dd>
                        <dt>{{ 'compliance.fulfillment_rule.meta.next_review'|trans({}, 'compliance') }}</dt>
                        <dd>{{ fulfillment.nextReviewDate|fa_date }}
                            {% if fulfillment.isOverdueForReview() %}{{ pill.render('compliance.fulfillment_rule.meta.overdue'|trans({}, 'compliance'), 'danger', {size: 'sm'}) }}{% endif %}
                        </dd>
                        <dt>{{ 'compliance.fulfillment_rule.meta.computed_at'|trans({}, 'compliance') }}</dt>
                        <dd>{{ fulfillment.derivedAt|fa_datetime }}</dd>
                        <dt>{{ 'compliance.fulfillment_rule.meta.last_updated_by'|trans({}, 'compliance') }}</dt>
                        <dd>{{ fulfillment.lastUpdatedBy ? fulfillment.lastUpdatedBy.fullName|default(fulfillment.lastUpdatedBy.email) : '—' }}</dd>
                    </dl>
                    {# Periodic review (deadline type fulfillment_review, ISO 27001 9.1): the reminder links here. #}
                    {% if fulfillment and fulfillment.id and (is_granted('ROLE_MANAGER') or is_granted('RECORD_RESPONSIBLE', fulfillment)) %}
                        <form method="post" action="{{ path('app_compliance_fulfillment_review', {id: requirement.id}) }}" class="mt-3 d-flex flex-wrap gap-2 align-items-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('fulfillment_review_' ~ requirement.id) }}">
                            <div>
                                <label class="form-label small mb-1" for="fulfillment-next-review">{{ 'compliance.fulfillment_rule.field.next_review'|trans({}, 'compliance') }}</label>
                                <input type="date" class="form-control form-control-sm" id="fulfillment-next-review" name="next_review"
                                       min="{{ 'tomorrow'|date('Y-m-d') }}" value="{{ '+12 months'|date('Y-m-d') }}">
                            </div>
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm">{{ 'compliance.fulfillment_rule.action.confirm_review'|trans({}, 'compliance') }}</button>
                        </form>
                    {% endif %}
                {% endblock %}
            {% endembed %}

            {% if is_granted('ADMIN_GLOBAL_OP') or (requirement.uploadTenant is not null and is_granted('ROLE_ADMIN')) %}
{# Delete Button #}
            {% embed '_components/_card.html.twig' with { 'class': 'border-danger' } %}
                {% block card_header %}
                    <div class="card-header"><h2 class="mb-0"><i class="fa-icon fa-icon--status-warning text-danger" aria-hidden="true"></i> {{ 'common.danger_zone'|trans({}, 'messages') }}</h2></div>
                {% endblock %}
                {% block card_body %}
                    <form method="post" action="{{ path('app_compliance_requirement_delete', {id: requirement.id}) }}"
                          data-controller="ui-actions"
                          data-action="submit->ui-actions#confirm"
                          data-ui-actions-message-param="{{ 'compliance.requirement.confirm.delete'|trans({}, 'compliance') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ requirement.id) }}">
                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger fa-cyber-btn--sm w-100">
                            <i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'compliance.action.delete_requirement'|trans({}, 'compliance') }}
                        </button>
                    </form>
                {% endblock %}
            {% endembed %}
{% endif %}
        </div>
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: requirement } only %}
    {% endif %} {# /M-4 compliance module gate #}
</div>
{% endblock %}
