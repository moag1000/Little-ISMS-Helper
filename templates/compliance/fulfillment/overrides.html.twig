{% extends 'base.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'compliance.fulfillment_rule.overrides.title'|trans({}, 'compliance') }}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.compliance'|trans({}, 'nav'), url: path('app_compliance_index') },
            { label: 'compliance.fulfillment_rule.overrides.title'|trans({}, 'compliance') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'compliance.fulfillment_rule.overrides.title'|trans({}, 'compliance'),
        subtitle: 'compliance.fulfillment_rule.overrides.subtitle'|trans({}, 'compliance'),
    }) }}

    {% if legacyWithRule > 0 and is_granted('ROLE_MANAGER') %}
        <div class="d-flex justify-content-end mb-3">
            <form method="post" action="{{ path('app_compliance_fulfillment_follow_rule_all') }}"
                  data-controller="ui-actions"
                  data-action="submit->ui-actions#confirm"
                  data-ui-actions-message-param="{{ 'compliance.fulfillment_rule.overrides.follow_rule_all_confirm'|trans({'%count%': legacyWithRule}, 'compliance') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('fulfillment_follow_rule_all') }}">
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm">
                    {{ 'compliance.fulfillment_rule.overrides.follow_rule_all'|trans({'%count%': legacyWithRule}, 'compliance') }}
                </button>
            </form>
        </div>
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_compliance_fulfillment_overrides'),
        filter_keys: ['filter'],
        list_title: 'compliance.fulfillment_rule.overrides.list'|trans({}, 'compliance'),
        empty: { mood: 'happy', title: 'compliance.fulfillment_rule.overrides.empty'|trans({}, 'compliance') },
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label class="form-label" for="override-filter">{{ 'compliance.fulfillment_rule.overrides.filter.label'|trans({}, 'compliance') }}</label>
                <select name="filter" id="override-filter" class="form-select fa-cyber-input__field">
                    <option value="">{{ 'compliance.fulfillment_rule.overrides.filter.all'|trans({}, 'compliance') }}</option>
                    {% for f in filters %}
                        <option value="{{ f }}" {% if filter == f %}selected{% endif %}>{{ ('compliance.fulfillment_rule.overrides.filter.' ~ f)|trans({}, 'compliance') }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if counts.legacy > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'compliance.fulfillment_rule.overrides.summary.legacy'|trans({'%count%': counts.legacy}, 'compliance') }}</span>{% endif %}
            {% if counts.due > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'compliance.fulfillment_rule.overrides.summary.due'|trans({'%count%': counts.due}, 'compliance') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_fa_table.html.twig' %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="fa-table__th">{{ 'compliance.fulfillment_rule.overrides.col.requirement'|trans({}, 'compliance') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'compliance.fulfillment_rule.overrides.col.value'|trans({}, 'compliance') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'compliance.fulfillment_rule.overrides.col.rule'|trans({}, 'compliance') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'compliance.fulfillment_rule.overrides.col.reason'|trans({}, 'compliance') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'compliance.fulfillment_rule.overrides.col.review_due'|trans({}, 'compliance') }}</th>
                        <th scope="col" class="fa-table__th fa-table__th--actions"><span class="visually-hidden">{{ 'compliance.fulfillment_rule.overrides.col.actions'|trans({}, 'compliance') }}</span></th>
                    </tr>
                {% endblock %}
                {% block table_body %}
                    {% import '_components/_status_pill.html.twig' as pill %}
                    {% for f in page %}
                        {% set r = f.requirement %}
                        <tr class="fa-table__row">
                            <td class="fa-table__cell">
                                <div class="small text-body-secondary">{{ r.framework.code }}</div>
                                <a href="{{ path('app_compliance_requirement_show', {id: r.id}) }}"><code>{{ r.requirementId }}</code> {{ r.title }}</a>
                            </td>
                            <td class="fa-table__cell">{{ f.fulfillmentPercentage }} %</td>
                            <td class="fa-table__cell">{{ f.derivedPercentage is not null ? f.derivedPercentage ~ ' %' : '—' }}</td>
                            <td class="fa-table__cell">
                                {{ pill.render(('compliance.fulfillment_rule.source.override_' ~ f.overrideSource)|trans({}, 'compliance'), status_tone('override_source', f.overrideSource), {size: 'sm'}) }}
                                <div class="small">{{ f.overrideReason ?: ('compliance.fulfillment_rule.override.reason_' ~ f.overrideSource)|trans({}, 'compliance') }}</div>
                            </td>
                            <td class="fa-table__cell">
                                {{ f.overrideReviewDue|fa_date }}
                                {% if f.isOverrideReviewDue() %}{{ pill.render('compliance.fulfillment_rule.override.due'|trans({}, 'compliance'), 'danger', {size: 'sm'}) }}{% endif %}
                            </td>
                            <td class="fa-table__cell fa-table__cell--actions">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" href="{{ path('app_compliance_requirement_show', {id: r.id}) }}">{{ 'compliance.fulfillment_rule.overrides.review'|trans({}, 'compliance') }}</a>
                                    {% if f.derivedPercentage is not null and is_granted('ROLE_MANAGER') %}
                                        <form method="post" action="{{ path('app_compliance_fulfillment_follow_rule', {id: r.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('fulfillment_follow_rule_' ~ r.id) }}">
                                            <input type="hidden" name="back" value="list">
                                            {% if filter %}<input type="hidden" name="filter" value="{{ filter }}">{% endif %}
                                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ 'compliance.fulfillment_rule.action.follow_rule'|trans({'%value%': f.derivedPercentage}, 'compliance') }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
