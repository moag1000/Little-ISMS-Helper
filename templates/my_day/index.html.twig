{% extends 'base.html.twig' %}
{% trans_default_domain 'my_day' %}

{% block title %}{{ 'my_day.title'|trans({}, 'my_day') }}{% endblock %}

{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_feature_card.html.twig' as _fa_feature_card %}
{% import '_components/_fa_empty_state.html.twig' as _fa_empty_state %}
{% import '_components/_status_pill.html.twig' as pill %}
{% import '_macros/workflow.html.twig' as workflow_macros %}

{% block body %}
{# Category metadata — single source for both the KPI tiles and the accordion
   sections. tone drives the tile colour AND whether the section auto-expands
   (danger = urgent → open by default; everything else collapsed to a counter,
   so a junior is not faced with 20 open lists). Display density is the global
   body[data-density] toggle. #}
{% set meta = {
    'workflows_pending':                  { icon: 'ui-undo',                tone: 'warning' },
    'management_decisions_pending':       { icon: 'regulator',              tone: 'warning' },
    'risk_acceptance_pending':            { icon: 'nav-shield-alert',       tone: 'warning' },
    'location_gaps':                      { icon: 'nav-location',           tone: 'warning' },
    'workflows_overdue':                  { icon: 'status-critical',        tone: 'danger'  },
    'four_eyes':                          { icon: 'nav-people',             tone: 'warning' },
    'acknowledgements':                   { icon: 'ui-check',               tone: 'primary' },
    'findings':                           { icon: 'ui-search',              tone: 'warning' },
    'dsrs':                               { icon: 'file-person',            tone: 'danger'  },
    'corrective_actions_overdue':         { icon: 'ui-hourglass',           tone: 'danger'  },
    'risk_acceptance_expiring':           { icon: 'nav-shield-alert',       tone: 'warning' },
    'documents_review_overdue':           { icon: 'nav-file-earmark-text',  tone: 'danger'  },
    'trainings_pending':                  { icon: 'nav-mortarboard',        tone: 'primary' },
    'incidents_open_assigned':            { icon: 'status-critical',        tone: 'danger'  },
    'data_breaches_open':                 { icon: 'nav-shield-alert',       tone: 'warning' },
    'reporting_duties':                   { icon: 'status-critical',        tone: 'danger'  },
    'vulnerabilities_due':                { icon: 'bug',                    tone: 'warning' },
    'change_requests_pending_approval':   { icon: 'util-refresh',           tone: 'primary' },
    'management_review_upcoming':         { icon: 'nav-clipboard-data',     tone: 'primary' },
    'recurring_duties':                   { icon: 'nav-calendar-check',           tone: 'warning' },
    'evidence_reverification_due':        { icon: 'nav-clipboard-check',    tone: 'danger'  },
    'control_effectiveness_overdue':      { icon: 'ui-search',              tone: 'danger'  },
    'supplier_reassessment_due':          { icon: 'nav-truck',              tone: 'warning' },
    'dpia_review_overdue':                { icon: 'file-person',            tone: 'danger'  },
    'bc_plan_review_overdue':             { icon: 'util-refresh',           tone: 'warning' },
    'risk_review_overdue':                { icon: 'nav-shield-alert',       tone: 'warning' },
    'risk_acceptance_no_expiry':          { icon: 'nav-shield-alert',       tone: 'danger'  },
    'documents_pending_approval_for_me':  { icon: 'nav-file-check',         tone: 'warning' },
    'wizard_overdue':                     { icon: 'ui-hourglass',           tone: 'warning' },
    'framework_gaps_critical':            { icon: 'nav-bar-chart',          tone: 'danger'  },
    'alva_hints':                         { icon: 'ui-stars',               tone: 'warning' },
    'register_review':                    { icon: 'nav-list-ordered',       tone: 'warning' },
    'competence_gaps':                    { icon: 'nav-stars',              tone: 'warning' },
} %}
{# Ordered category list. Items come from inbox.<key>; the three CM-only buckets
   default to [] when the aggregator did not provide them. Approvals and
   four-eyes requests come first: they are decided right here. #}
{% set order = ['management_decisions_pending','workflows_pending','risk_acceptance_pending','workflows_overdue','four_eyes','reporting_duties','alva_hints','acknowledgements','findings','dsrs','corrective_actions_overdue','location_gaps','risk_acceptance_expiring','risk_acceptance_no_expiry','risk_review_overdue','documents_review_overdue','evidence_reverification_due','control_effectiveness_overdue','supplier_reassessment_due','dpia_review_overdue','bc_plan_review_overdue','trainings_pending','incidents_open_assigned','data_breaches_open','vulnerabilities_due','change_requests_pending_approval','management_review_upcoming','recurring_duties','documents_pending_approval_for_me','wizard_overdue','framework_gaps_critical'] %}
{# Build the active list and the zero counter in one pass — avoids relying on a
   lazy |filter iterator being consumed twice. #}
{# Jargon categories that get a hover-tooltip (junior aid) — the ones a 9001-
   background user would not recognise. The plain ones (trainings, incidents …)
   need none. #}
{% set hinted = ['four_eyes','dsrs','risk_acceptance_expiring','risk_acceptance_no_expiry','wizard_overdue','framework_gaps_critical','reporting_duties','data_breaches_open','evidence_reverification_due','control_effectiveness_overdue'] %}
{# Buckets of deadline sources the list above does not know yet are appended,
   so a new source shows up without a template change. #}
{% set order = order|merge((inbox.deadline_buckets ?? [])|filter(k => k not in order)) %}
{% set activeCategories = [] %}
{% set zeroCount = 0 %}
{% for key in order %}
    {% set items = attribute(inbox, key) ?? [] %}
    {% if items|length > 0 %}
        {# Triage sort: overdue/sooner-due first; items without a date sink to the bottom. #}
        {% set items = items|sort((a, b) => (a.due_date ? a.due_date|date('U') : 99999999999) <=> (b.due_date ? b.due_date|date('U') : 99999999999)) %}
        {% set activeCategories = activeCategories|merge([{
            key: key,
            anchor: key|replace({'_': '-'}),
            icon: meta[key].icon ?? 'nav-calendar-check',
            tone: meta[key].tone ?? (items|filter(i => i.tone == 'danger')|length > 0 ? 'danger' : 'warning'),
            items: items,
            count: items|length,
        }]) %}
    {% else %}
        {% set zeroCount = zeroCount + 1 %}
    {% endif %}
{% endfor %}

<div class="fa-aurora-surface my-day">
    {{ _fa_page_header.render({
        title:    'my_day.title'|trans({}, 'my_day'),
        subtitle: 'my_day.subtitle'|trans({'%generated_at%': inbox.generated_at|fa_datetime}, 'my_day'),
        actions: [
            { label: 'my_day.action.standard_dashboard'|trans({}, 'my_day'), variant: 'ghost', icon: 'nav-home', href: path('app_dashboard') }
        ]
    }) }}

    {% if inbox.total == 0 %}
        <div class="my-4">
            {{ _fa_empty_state.render({
                mood: 'happy',
                title: 'my_day.empty.title'|trans({}, 'my_day'),
                text: 'my_day.empty.text'|trans({}, 'my_day'),
            }) }}
        </div>
    {% else %}

    {# KPI tiles — only categories WITH open actions are shown prominently.
       Zero-action categories are folded into one quiet line below, so the
       page leads with what actually needs doing (no 20-tile green wall). #}
    {# Phones: one scrollable strip of jump chips instead of a tile per category,
       so the first decision is on the first screen. #}
    <nav class="my-day-jump d-sm-none" aria-label="{{ 'my_day.jump.label'|trans({}, 'my_day') }}">
        {% for c in activeCategories %}
            <a href="#{{ c.anchor }}" class="fa-filter-chip my-day-jump__chip my-day-jump__chip--{{ c.tone }}">
                {{ ('my_day.kpi.' ~ c.key)|trans({}, 'my_day') }}
                <span class="my-day-jump__count">{{ c.count }}</span>
            </a>
        {% endfor %}
    </nav>
    <div class="kpi-grid d-none d-sm-grid grid-responsive-250 gap-4 my-2rem">
        {% for c in activeCategories %}
            {{ _fa_feature_card.render({
                icon: c.icon,
                label: ('my_day.kpi.' ~ c.key)|trans({}, 'my_day'),
                value: c.count,
                variant: c.tone,
                href: '#' ~ c.anchor,
            }) }}
        {% endfor %}
    </div>
    {% if zeroCount > 0 %}
        <p class="text-muted small mb-4 d-none d-sm-block">
            <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
            {{ 'my_day.tiles.all_clear'|trans({'%count%': zeroCount}, 'my_day') }}
        </p>
    {% endif %}

    {# Accordion sections. Urgent (danger) categories open by default so the ISB
       sees them immediately; the rest stay collapsed to a title + counter so a
       junior gets a compact overview and expands only what they want. Native
       <details> — keyboard-accessible, works without JavaScript. #}
    {% for c in activeCategories %}
        {% set hasHigh = c.items|filter(i => i.priority == 'high')|length > 0 %}
        <details class="fa-section my-day-section mb-3" id="{{ c.anchor }}"{{ (c.tone == 'danger' or hasHigh or c.key in ['management_decisions_pending', 'workflows_pending', 'risk_acceptance_pending', 'four_eyes']) ? ' open' : '' }}>
            <summary class="fa-section__header my-day-section__summary">
                <span class="fa-section__title d-flex align-items-center gap-2">
                    <i class="fa-icon fa-icon--{{ c.icon }}" aria-hidden="true"></i>
                    {{ ('my_day.section.' ~ c.key)|trans({}, 'my_day') }}
                    {% if c.key in hinted %}
                        <i class="fa-icon fa-icon--nav-info-circle text-muted my-day-section__hint-icon d-none d-sm-inline"
                           title="{{ ('my_day.hint.' ~ c.key)|trans({}, 'my_day') }}" aria-label="{{ ('my_day.hint.' ~ c.key)|trans({}, 'my_day') }}"></i>
                    {% endif %}
                    {{ pill.render(c.count, c.tone == 'danger' ? c.tone : 'neutral', {class: 'ms-1'}) }}
                </span>
            </summary>
            <div class="fa-section__body">
                {% if c.key in hinted %}
                    <p class="small text-muted mb-2 d-sm-none">{{ ('my_day.hint.' ~ c.key)|trans({}, 'my_day') }}</p>
                {% endif %}
                <div class="list-group">
                    {% for item in c.items %}
                        {% set entityIcon = {
                            'workflow': 'ui-refresh', 'four_eyes': 'nav-people', 'acknowledgement': 'ui-check',
                            'audit_finding': 'ui-search', 'dsr': 'ui-file-person', 'corrective_action': 'ui-hourglass',
                            'risk_acceptance': 'nav-shield-alert', 'document_review': 'nav-document', 'training': 'nav-mortarboard',
                            'incident': 'status-critical', 'data_breach': 'nav-shield-alert', 'vulnerability': 'util-bug',
                            'audit_checklist': 'nav-clipboard-check', 'change_request': 'ui-refresh', 'management_review': 'nav-clipboard-data',
                            'document_pending_approval': 'nav-file-check', 'wizard_overdue': 'ui-hourglass', 'framework_gap': 'nav-bar-chart',
                            'evidence_reverification': 'nav-clipboard-check', 'control': 'ui-search', 'supplier': 'nav-truck',
                            'dpia': 'ui-file-person', 'bc_plan': 'util-refresh', 'risk_review': 'nav-shield-alert', 'alva_hint': 'ui-stars',
                            'policy_ack': 'ui-check', 'internal_audit': 'nav-clipboard-check', 'audit_program': 'nav-clipboard-check',
                            'risk_treatment': 'nav-shield-alert', 'risk_treatment_plan': 'nav-shield-alert', 'risk_acceptance_no_expiry': 'nav-shield-alert',
                            'control_review': 'ui-search', 'control_effectiveness': 'ui-search', 'control_implementation': 'ui-search',
                            'supplier_assessment': 'nav-truck', 'bc_plan_review': 'util-refresh', 'bc_plan_test': 'util-refresh',
                            'dpia_review': 'ui-file-person', 'processing_activity_review': 'ui-file-person', 'change_approval': 'ui-refresh',
                            'capa_effectiveness_review': 'ui-hourglass', 'training_refresh': 'nav-mortarboard', 'access_review': 'nav-people',
                            'certificate_expiry': 'nav-file-check', 'isms_objective': 'nav-bar-chart', 'isms_context_review': 'nav-clipboard-data',
                            'interested_party_communication': 'nav-people', 'nis2_registration': 'nav-file-check'
                        } %}
                        {% set canDecideWorkflow = item.decision.decidable ?? false %}
                        {% set canDecideFourEyes = (item.four_eyes_id ?? null) %}
                        <div class="list-group-item my-day-item">
                            <div class="my-day-item__main">
                                <a href="{{ item.link }}" class="fw-bold my-day-item__title">
                                    {% if entityIcon[item.entity_type] is defined %}
                                        <i class="fa-icon fa-icon--{{ entityIcon[item.entity_type] }}" aria-hidden="true"></i>
                                    {% endif %}
                                    {{ item.title }}
                                </a>
                                <small class="text-muted d-block">{{ item.subtitle }}</small>
                                {% if item.due_date %}
                                    {% set secsLeft = item.due_date|date('U') - 'now'|date('U') %}
                                    {% set overdue = secsLeft < 0 %}
                                    {% if item.hours_countdown ?? false %}
                                        {# Statutory hour deadlines (GDPR Art. 33, NIS-2 24/72 h) count hours. #}
                                        {% set hoursLeft = (secsLeft / 3600)|round(0, 'floor') %}
                                        <small class="d-block fw-semibold {{ overdue ? 'text-danger' : (hoursLeft < 24 ? 'text-danger' : 'text-warning') }}">
                                            {% if overdue %}{{ 'my_day.item.sla_breached'|trans({}, 'my_day') }}
                                            {% else %}{{ 'my_day.item.hours_left'|trans({'%hours%': hoursLeft}, 'my_day') }}{% endif %}
                                        </small>
                                    {% else %}
                                        {% set daysAbs = (secsLeft / 86400)|abs|round(0, 'floor') %}
                                        <small class="d-block {{ overdue ? 'text-danger fw-semibold' : 'text-muted' }}">
                                            {{ item.due_date|fa_date }} —
                                            {% if overdue %}{{ 'my_day.item.overdue_by'|trans({'%days%': daysAbs}, 'my_day') }}
                                            {% else %}{{ 'my_day.item.due_in'|trans({'%days%': daysAbs}, 'my_day') }}{% endif %}
                                        </small>
                                    {% endif %}
                                {% endif %}
                            </div>
                            <div class="my-day-item__side">
                                {% if item.badge %}
                                    {% set pillTone = pill_tone_bs(item.tone) %}
                                    {{ pill.render(item.badge, pillTone) }}
                                {% endif %}
                                {% if item.priority == 'high' %}
                                    {{ pill.render('my_day.priority.high'|trans({}, 'my_day'), 'danger') }}
                                {% elseif item.priority == 'medium' %}
                                    {{ pill.render('my_day.priority.medium'|trans({}, 'my_day'), 'warning') }}
                                {% endif %}
                                {% if canDecideWorkflow %}
                                    <span class="my-day-item__actions">{{ workflow_macros.decision_buttons(item.decision.id) }}</span>
                                {% elseif canDecideFourEyes %}
                                    <span class="my-day-item__actions">{% include 'four_eyes/_decision_buttons.html.twig' with { requestId: item.four_eyes_id } only %}</span>
                                {% elseif item.management_decision_id ?? false %}
                                    <span class="my-day-item__actions">{% include 'management_decision/_decide_buttons.html.twig' with { decision: { id: item.management_decision_id } } only %}</span>
                                {% elseif item.acceptance_risk_id ?? false %}
                                    {# Same two buttons and dialogs as a workflow approval #}
                                    <span class="my-day-item__actions">
                                        <button type="button" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--success"
                                                data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open"
                                                data-fa-modal-id="approveAcceptance{{ item.acceptance_risk_id }}">
                                            <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
                                            {{ 'risk.acceptance.pending.approve'|trans({}, 'risk') }}
                                        </button>
                                        <button type="button" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--danger"
                                                data-controller="fa-modal-dispatcher" data-action="click->fa-modal-dispatcher#open"
                                                data-fa-modal-id="rejectAcceptance{{ item.acceptance_risk_id }}">
                                            <i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i>
                                            {{ 'risk.acceptance.pending.reject'|trans({}, 'risk') }}
                                        </button>
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {# Overdue reviews: jump to the filtered list, where "Review bestätigen" confirms several at once. #}
                {% set _reviewList = { risk_review_overdue: 'app_risk_index', control_review_due: 'app_soa_index', documents_review_overdue: 'app_document_index', supplier_reassessment_due: 'app_supplier_index' }[c.key] ?? null %}
                {# Everybody reminded confirms their own records there (PeriodicReviewService::mayConfirm()). #}
                {% if _reviewList %}
                    <div class="mt-2 d-grid d-sm-block">
                        <a href="{{ path(_reviewList, { review_overdue: '1' }) }}" class="fa-cyber-btn fa-cyber-btn--ghost">{{ 'my_day.action.review_in_list'|trans({}, 'my_day') }}</a>
                    </div>
                {% endif %}
            </div>
        </details>
    {% endfor %}

    {# Decision dialogs live outside the <details> sections: a dialog inside a
       collapsed section would not be displayed. #}
    {% for c in activeCategories|filter(c => c.key in ['management_decisions_pending', 'workflows_pending', 'risk_acceptance_pending', 'four_eyes']) %}
        {% for item in c.items %}
            {% if item.management_decision_id ?? false %}
                {% include 'management_decision/_decide_modals.html.twig' with { decision: { id: item.management_decision_id, title: item.title, type: { normReference: item.subtitle } }, back: 'my_day' } only %}
            {% elseif item.decision.decidable ?? false %}
                {{ workflow_macros.decision_modals(item.decision.id, item.decision.name, item.title, item.decision.summary ?? null) }}
            {% elseif item.acceptance_risk_id ?? false %}
                {% include 'risk/_acceptance_decide_modals.html.twig' with { riskId: item.acceptance_risk_id, subject: item.title, summary: item.subtitle, back: 'my_day' } only %}
            {% elseif (item.four_eyes_id ?? null) %}
                {% include 'four_eyes/_reject_modal.html.twig' with { requestId: item.four_eyes_id } only %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    {% endif %}
</div>

<style>
/* My-Day accordion — collapsed sections show only the summary (title + count).
   Density-aware spacing comes from the global body[data-density] tokens. */
.my-day-section { border: 1px solid var(--border); border-radius: var(--radius-md, .5rem); overflow: hidden; scroll-margin-top: 4.5rem; }
.my-day-section__summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .75rem 1rem; min-height: 44px; }
.my-day-section__summary::-webkit-details-marker { display: none; }
.my-day-section__summary::after { content: '\203A'; font-size: 1.25rem; line-height: 1; color: var(--fg-2); transition: transform .15s ease; }
.my-day-section[open] > .my-day-section__summary::after { transform: rotate(90deg); }
.my-day-section__summary:hover { background: var(--surface-2); }
.my-day-section__hint-icon { font-size: .8em; }
body[data-density='compact'] .my-day-section__summary { padding: .4rem .75rem; }
/* One row per item: what it is on the left, status and the decision on the
   right. On a phone the decision drops below the text with full-size buttons. */
.my-day-item { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: .5rem 1rem; }
.my-day-item__main { flex: 1 1 18rem; min-width: 0; }
.my-day-item__title { color: var(--fg); text-decoration: none; overflow-wrap: anywhere; }
.my-day-item__title:hover { text-decoration: underline; }
.my-day-item__side { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: .4rem; }
.my-day-item__actions { display: inline-flex; flex-wrap: wrap; gap: .4rem; }
.my-day-item__actions form { display: inline; }
/* Phone jump strip: one row, scrolls sideways, each chip jumps to its section. */
.my-day-jump { display: flex; gap: .5rem; overflow-x: auto; margin: 1rem 0 1.25rem; padding-bottom: .25rem; scrollbar-width: none; }
.my-day-jump::-webkit-scrollbar { display: none; }
.my-day-jump__chip { flex: 0 0 auto; display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; white-space: nowrap; text-decoration: none; }
.my-day-jump__count { font-weight: 700; font-variant-numeric: tabular-nums; }
.my-day-jump__chip--danger .my-day-jump__count { color: var(--danger); }
.my-day-jump__chip--warning .my-day-jump__count { color: var(--warning); }
@media (max-width: 575.98px) {
    .my-day .list-group-item { padding: .75rem; }
    .my-day-item__side { justify-content: flex-start; width: 100%; }
    /* Decision buttons share the row and are thumb-sized. */
    .my-day-item__actions { display: flex; width: 100%; }
    .my-day-item__actions > .fa-cyber-btn,
    .my-day-item__actions > form { flex: 1 1 0; }
    .my-day-item__actions .fa-cyber-btn { min-height: 44px; width: 100%; justify-content: center; }
}
</style>
{% endblock %}
