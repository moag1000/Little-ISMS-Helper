{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'patches' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'patch.title'|trans({}, 'patches') }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.patches'|trans({}, 'nav') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'patch.title'|trans({}, 'patches'),
        actions: [
            { label: 'patch.new'|trans({}, 'patches'), variant: 'primary', icon: 'plus', href: path('app_patch_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }
        ]
    }) }}
{% set _global_hints = alva_hints('patch_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('app_patch_index'),
        filter_keys: ['view'],
        list_title: 'patch.list'|trans({}, 'patches'),
        empty: { mood: 'sleeping', title: 'patch.empty'|trans({}, 'patches') },
        card_attrs: { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': '/' ~ app.request.locale ~ '/patch' },
    } %}
        {% block list_filters %}
            {% if currentTenant %}
            <div class="col-md-4">
                <label for="view-filter" class="form-label">{{ 'common.view'|trans({}, 'messages') }}</label>
                <select class="form-select fa-cyber-input__field" id="view-filter" name="view" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value="own" {{ inheritanceInfo.currentView == 'own' ? 'selected' : '' }}>{{ 'corporate.view.own_only'|trans({}, 'messages') }}</option>
                    {% if inheritanceInfo.hasParent %}
                    <option value="inherited" {{ inheritanceInfo.currentView == 'inherited' ? 'selected' : '' }}>{{ 'corporate.view.including_inherited'|trans({}, 'messages') }}</option>
                    {% endif %}
                    {% if inheritanceInfo.hasSubsidiaries %}
                    <option value="subsidiaries" {{ inheritanceInfo.currentView == 'subsidiaries' ? 'selected' : '' }}>{{ 'corporate.view.including_subsidiaries'|trans({}, 'messages') }}</option>
                    {% endif %}
                </select>
            </div>
            {% endif %}
        {% endblock %}
        {% block list_summary %}
            {% if pending_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'patch.summary.pending'|trans({'%count%': pending_count}, 'patches') }}</span>{% endif %}
            {% if deployed_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'patch.summary.deployed'|trans({'%count%': deployed_count}, 'patches') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_table.html.twig' with { 'noMargin': true } %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="bulk-select-column">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-action="bulk-actions#selectAll"
                                   data-bulk-actions-target="selectAllCheckbox"
                                   aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                        </th>
                        <th scope="col">{{ 'patch.field.patch_id'|trans({}, 'patches') }}</th>
                        <th scope="col">{{ 'patch.field.title'|trans({}, 'patches') }}</th>
                        <th scope="col">{{ 'patch.field.patch_type'|trans({}, 'patches') }}</th>
                        <th scope="col">{{ 'patch.field.status'|trans({}, 'patches') }}</th>
                        <th scope="col">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body_attrs %}id="patch-rows"{% endblock %}
                {% block table_body %}
                    {% for patch in page %}
                        {% include 'patch/_row.html.twig' with { patch: patch, currentTenant: currentTenant } %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
            {% include '_components/_bulk_action_bar.html.twig' with { actions: ['export', 'delete'] } %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
