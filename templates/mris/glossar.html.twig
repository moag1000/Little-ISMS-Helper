{% extends 'base.html.twig' %}
{% trans_default_domain 'mris' %}

{% block title %}{{ 'mris.glossar.title'|trans({}, 'mris') }}{% endblock %}

{% block body %}
<div class="container">

    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.dashboard'|trans({}, 'nav'), url: path('app_dashboard') },
            { label: 'mris.glossar.title'|trans({}, 'mris') }
        ]
    } only %}

    <div class="page-header mb-4" data-tour="mris-glossar">
        <div>
            <h1>
                <i class="fa-icon fa-icon--nav-journal" aria-hidden="true"></i>
                {{ 'mris.glossar.title'|trans({}, 'mris') }}
            </h1>
            <p class="text-muted small mb-0">
                {{ 'mris.glossar.intro'|trans({}, 'mris') }}<br>
                <em>{{ 'mris.glossar.source'|trans({}, 'mris') }}</em>
            </p>
        </div>
    </div>

    {% if entries|length == 0 %}
        {# Empty State — kein Eintrag im Glossar gefunden. #}
        {% embed '_components/_card.html.twig' with { 'class': 'text-center' } %}
            {% block card_body %}
                <i class="fa-icon display-4 text-muted fa-icon--nav-journal" aria-hidden="true"></i>
                <h2 class="h5 mt-3">{{ 'mris.glossar.empty_title'|trans({}, 'mris') }}</h2>
                <p class="text-muted small mb-0">
                    {{ 'mris.glossar.empty_text'|trans({}, 'mris')|raw }}
                </p>
            {% endblock %}
        {% endembed %}
    {% else %}
        <div data-controller="filter">
            {% embed '_components/_card.html.twig' %}
                {% block card_body %}
                    <div class="row g-2 align-items-center mb-3">
                        <div class="col-md-8">
                            <label for="mris-glossar-search" class="form-label small mb-1">
                                <i class="fa-icon fa-icon--ui-search" aria-hidden="true"></i>
                                {{ 'mris.glossar.search_label'|trans({}, 'mris') }}
                            </label>
                            <input type="search"
                                   id="mris-glossar-search"
                                   class="form-control fa-cyber-input__field"
                                   placeholder="{{ 'mris.glossar.search_placeholder'|trans({}, 'mris') }}"
                                   data-filter-target="searchInput"
                                   data-action="input->filter#filterRows">
                        </div>
                        <div class="col-md-4 text-md-end">
                            <span class="text-muted small">
                                {{ 'mris.glossar.entry_count'|trans({'%count%': entries|length}, 'mris') }}
                            </span>
                            <button type="button"
                                    class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost ms-2"
                                    data-action="filter#reset">
                                <i class="fa-icon fa-icon--ui-refresh" aria-hidden="true"></i>
                                {{ 'mris.glossar.reset'|trans({}, 'mris') }}
                            </button>
                        </div>
                    </div>

                    {% embed '_components/_fa_table.html.twig' %}
                        {% block table_head %}
                            <tr>
                                <th scope="col" class="fa-table__th" style="width: 18%;">
                                    {{ 'mris.glossar.col.term'|trans({}, 'mris') }}
                                </th>
                                <th scope="col" class="fa-table__th" style="width: 38%;">
                                    {{ 'mris.glossar.col.definition'|trans({}, 'mris') }}
                                </th>
                                <th scope="col" class="fa-table__th" style="width: 26%;">
                                    {{ 'mris.glossar.col.analogy'|trans({}, 'mris') }}
                                </th>
                                <th scope="col" class="fa-table__th" style="width: 18%;">
                                    {{ 'mris.glossar.col.source'|trans({}, 'mris') }}
                                </th>
                            </tr>
                        {% endblock %}
                        {% block table_body %}
                            {% for entry in entries %}
                                <tr class="fa-table__row" data-filter-target="filterableRow">
                                    <td class="fa-table__cell">
                                        <strong>{{ entry.term }}</strong>
                                        {% if entry.key %}
                                            <div>
                                                <code class="small text-muted">{{ entry.key }}</code>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="fa-table__cell small">
                                        {{ entry.definition }}
                                    </td>
                                    <td class="fa-table__cell small text-muted">
                                        {% if entry.analogy_9001 %}
                                            {{ entry.analogy_9001 }}
                                        {% else %}
                                            <span class="fst-italic">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="fa-table__cell small">
                                        {% if entry.source %}
                                            {{ entry.source }}
                                        {% else %}
                                            <span class="text-muted fst-italic">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            <tr class="fa-table__row" data-filter-target="noResults" style="display: none;">
                                <td colspan="4" class="fa-table__empty">
                                    <i class="fa-icon fa-icon--ui-search" aria-hidden="true"></i>
                                    {{ 'mris.glossar.no_results'|trans({}, 'mris') }}
                                </td>
                            </tr>
                        {% endblock %}
                    {% endembed %}
                {% endblock %}
            {% endembed %}
        </div>
    {% endif %}

    <footer class="text-center text-muted small mt-4 pt-3 border-top">
        {{ 'mris.glossar.footer_source'|trans({}, 'mris') }}
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener" target="_blank">{{ 'mris.license.cc_by_40'|trans({}, 'mris') }}</a>.
    </footer>

</div>
{% endblock %}
