{% extends 'base.html.twig' %}
{% trans_default_domain 'mris' %}

{% block title %}{{ 'mris.wizard.ai_risk.page_title'|trans({}, 'mris') }}{% endblock %}

{% block body %}
<div class="container">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans({}, 'nav') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_mris_kpis') }}">{{ 'mris.wizard.common.breadcrumb_kpis'|trans({}, 'mris') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'mris.wizard.ai_risk.breadcrumb'|trans({}, 'mris') }}</li>
        </ol>
    </nav>

    <div class="page-header mb-4">
        <div>
            <h1>
                <i class="fa-icon fa-icon--nav-cpu" aria-hidden="true"></i>
                {{ matrix.title|default('mris.wizard.ai_risk.title'|trans({}, 'mris')) }}
            </h1>
            <p class="text-muted small mb-0">
                {{ matrix.intro|default('mris.wizard.ai_risk.intro'|trans({}, 'mris')) }}
            </p>
        </div>
    </div>

    {% if fallback_used %}
        <div class="fa-alert fa-alert--info small">
            <i class="fa-icon fa-icon--ui-info" aria-hidden="true"></i>
            <strong>{{ 'mris.wizard.common.note_label'|trans({}, 'mris') }}</strong>
            {{ 'mris.wizard.common.fallback_notice'|trans({}, 'mris')|raw }}
        </div>
    {% endif %}

    {# 4-Step-Decision-Flow als nummerierte Karten. #}
    {% if matrix.decision_flow is defined and matrix.decision_flow|length > 0 %}
        <h2 class="h5 mt-2 mb-3">
            <i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i>
            {{ 'mris.wizard.ai_risk.flow_heading'|trans({}, 'mris') }}
        </h2>
        <div class="row g-3 mb-4">
            {% for step in matrix.decision_flow %}
                <div class="col-md-6 col-lg-3">
                    {% embed '_components/_card.html.twig' with { 'class': 'h-100' } %}
                        {% block card_body %}
                            <div class="d-flex align-items-start mb-2">
                                <span class="fa-status-pill fa-status-pill--primary fa-status-pill--lg me-2">
                                    {{ step.no }}
                                </span>
                                <h3 class="h6 mb-0">{{ step.title }}</h3>
                            </div>
                            <p class="small mb-0">{{ step.detail }}</p>
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# 12-Tools-Tabelle. #}
    <h2 class="h5 mt-2 mb-3">
        <i class="fa-icon fa-icon--nav-grid" aria-hidden="true"></i>
        {{ 'mris.wizard.ai_risk.tools_heading'|trans({}, 'mris') }}
    </h2>

    {% embed '_components/_card.html.twig' %}
        {% block card_body %}
            {% embed '_components/_fa_table.html.twig' %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="fa-table__th" style="width: 22%;">{{ 'mris.wizard.ai_risk.col.tool'|trans({}, 'mris') }}</th>
                        <th scope="col" class="fa-table__th" style="width: 16%;">{{ 'mris.wizard.ai_risk.col.class'|trans({}, 'mris') }}</th>
                        <th scope="col" class="fa-table__th" style="width: 24%;">{{ 'mris.wizard.ai_risk.col.reference'|trans({}, 'mris') }}</th>
                        <th scope="col" class="fa-table__th" style="width: 38%;">{{ 'mris.wizard.ai_risk.col.rationale'|trans({}, 'mris') }}</th>
                    </tr>
                {% endblock %}
                {% block table_body %}
                    {% for tool in matrix.tools %}
                        {% set classKey = tool.class|default('minimal')|lower %}
                        {% set badgeVariant =
                            classKey == 'prohibited' ? 'dark'
                            : (classKey == 'high' ? 'danger'
                            : (classKey == 'limited' ? 'warning'
                            : 'success')) %}
                        <tr class="fa-table__row">
                            <td class="fa-table__cell"><strong>{{ tool.tool }}</strong></td>
                            <td class="fa-table__cell">
                                {% include '_components/_badge.html.twig' with {
                                    variant: badgeVariant,
                                    content: tool.class_label|default(('mris.wizard.ai_risk.class.' ~ classKey)|trans({}, 'mris'))
                                } %}
                            </td>
                            <td class="fa-table__cell small">{{ tool.ai_act_ref|default('—') }}</td>
                            <td class="fa-table__cell small">{{ tool.rationale|default('—') }}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}

    {% if matrix.norm_refs is defined and matrix.norm_refs|length > 0 %}
        {% embed '_components/_card.html.twig' with { 'class': 'mt-4' } %}
            {% block card_header %}
                <div class="card-header">
                    <h2 class="h6 mb-0">
                        <i class="fa-icon fa-icon--ui-star" aria-hidden="true"></i>
                        {{ 'mris.wizard.common.norm_refs'|trans({}, 'mris') }}
                    </h2>
                </div>
            {% endblock %}
            {% block card_body %}
                <ul class="small mb-0">
                    {% for ref in matrix.norm_refs %}
                        <li>{{ ref }}</li>
                    {% endfor %}
                </ul>
            {% endblock %}
        {% endembed %}
    {% endif %}

    <footer class="text-center text-muted small mt-4 pt-3 border-top">
        {{ 'mris.wizard.common.source'|trans({}, 'mris') }}
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener" target="_blank">{{ 'mris.license.cc_by_40'|trans({}, 'mris') }}</a>.
    </footer>

</div>
{% endblock %}
