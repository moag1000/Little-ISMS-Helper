{% extends 'base.html.twig' %}
{% trans_default_domain 'mris' %}

{% block title %}{{ 'mris.wizard.maturity.page_title'|trans({}, 'mris') }}{% endblock %}

{% block body %}
<div class="container">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans({}, 'nav') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_mris_kpis') }}">{{ 'mris.wizard.common.breadcrumb_kpis'|trans({}, 'mris') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'mris.wizard.maturity.breadcrumb'|trans({}, 'mris') }}</li>
        </ol>
    </nav>

    <div class="page-header mb-4">
        <div>
            <h1>
                <i class="fa-icon fa-icon--nav-bar-chart" aria-hidden="true"></i>
                {{ matrix.title|default('mris.wizard.maturity.title'|trans({}, 'mris')) }}
            </h1>
            <p class="text-muted small mb-0">
                {{ matrix.intro|default('mris.wizard.maturity.intro'|trans({}, 'mris')) }}
            </p>
        </div>
    </div>

    {% if fallback_used %}
        <div class="fa-alert fa-alert--info">
            <i class="fa-icon fa-icon--ui-info" aria-hidden="true"></i>
            <strong>{{ 'mris.wizard.common.note_label'|trans({}, 'mris') }}</strong>
            {{ 'mris.wizard.common.fallback_notice'|trans({}, 'mris')|raw }}
        </div>
    {% endif %}

    {# Legende der drei Reifegrade — Bootstrap badges, gleicher Token wie SoA. #}
    <div class="mb-3 small">
        {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'Initial' } %}
        <span class="text-muted">{{ 'mris.wizard.maturity.legend_initial'|trans({}, 'mris') }}</span>
        &nbsp;·&nbsp;
        {% include '_components/_badge.html.twig' with { variant: 'info', content: 'Defined' } %}
        <span class="text-muted">{{ 'mris.wizard.maturity.legend_defined'|trans({}, 'mris') }}</span>
        &nbsp;·&nbsp;
        {% include '_components/_badge.html.twig' with { variant: 'success', content: 'Managed' } %}
        <span class="text-muted">{{ 'mris.wizard.maturity.legend_managed'|trans({}, 'mris') }}</span>
    </div>

    {# Akkordeon je MHC. Bootstrap 5.3 collapse — kein Custom-JS noetig. #}
    <div class="accordion" id="mrisMaturityAccordion">
        {% for mhc in matrix.mhcs %}
            {% set itemId = 'mhc-' ~ loop.index %}
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-{{ itemId }}">
                    <button class="accordion-button{% if not loop.first %} collapsed{% endif %}"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse-{{ itemId }}"
                            aria-expanded="{{ loop.first ? 'true' : 'false' }}"
                            aria-controls="collapse-{{ itemId }}">
                        <code class="me-2">{{ mhc.code }}</code>
                        <strong>{{ mhc.name }}</strong>
                    </button>
                </h2>
                <div id="collapse-{{ itemId }}"
                     class="accordion-collapse collapse{% if loop.first %} show{% endif %}"
                     aria-labelledby="heading-{{ itemId }}"
                     data-bs-parent="#mrisMaturityAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">
                            {% for levelKey, levelLabel in {
                                'initial': 'Initial',
                                'defined': 'Defined',
                                'managed': 'Managed'
                            } %}
                                {% set variant = levelKey == 'managed' ? 'success' : (levelKey == 'defined' ? 'info' : 'secondary') %}
                                <div class="col-md-4">
                                    {% embed '_components/_card.html.twig' with { 'class': 'h-100' } %}
                                        {% block card_body %}
                                            <div class="mb-2">
                                                {% include '_components/_badge.html.twig' with { variant: variant, content: levelLabel } %}
                                            </div>
                                            {% set evidences = mhc.levels[levelKey]|default([]) %}
                                            {% if evidences|length > 0 %}
                                                <ul class="small mb-0 ps-3">
                                                    {% for evidence in evidences %}
                                                        <li>{{ evidence }}</li>
                                                    {% endfor %}
                                                </ul>
                                            {% else %}
                                                <p class="small text-muted fst-italic mb-0">{{ 'mris.wizard.maturity.no_evidence'|trans({}, 'mris') }}</p>
                                            {% endif %}
                                        {% endblock %}
                                    {% endembed %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if matrix.norm_refs is defined and matrix.norm_refs|length > 0 %}
        {% embed '_components/_card.html.twig' with { 'class': 'mt-4' } %}
            {% block card_header %}
                <div class="card-header">
                    <h2 class="h6 mb-0">
                        <i class="fa-icon fa-icon--ui-star" aria-hidden="true"></i>
                        {{ 'mris.wizard.common.norm_refs'|trans({}, 'mris') }}
                    </h2>
                </div>
            {% endblock %}
            {% block card_body %}
                <ul class="small mb-0">
                    {% for ref in matrix.norm_refs %}
                        <li>{{ ref }}</li>
                    {% endfor %}
                </ul>
            {% endblock %}
        {% endembed %}
    {% endif %}

    <footer class="text-center text-muted small mt-4 pt-3 border-top">
        {{ 'mris.wizard.common.source'|trans({}, 'mris') }}
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener" target="_blank">{{ 'mris.license.cc_by_40'|trans({}, 'mris') }}</a>.
    </footer>

</div>
{% endblock %}
