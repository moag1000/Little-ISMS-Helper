{% extends 'base.html.twig' %}
{% trans_default_domain 'mris' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}

{% block title %}{{ 'mris.page.kpi_breadcrumb'|trans({}, 'mris') }}{% endblock %}

{% block body %}
<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">{{ 'nav.dashboard'|trans({}, 'nav') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'mris.page.kpi_breadcrumb'|trans({}, 'mris') }}</li>
        </ol>
    </nav>

    <div class="page-header mb-4">
        <div>
            <h1>
                <i class="fa-icon fa-icon--nav-dashboard" aria-hidden="true"></i>
                {{ 'mris.page.kpi_title'|trans({}, 'mris') }}
            </h1>
            <p class="text-muted small mb-0">
                {{ 'mris.page.kpi_intro'|trans({}, 'mris') }}<br>
                <em>{{ 'mris.page.source'|trans({}, 'mris') }}</em>
            </p>
        </div>
    </div>

    <div class="row g-3">
        {% for kpi in kpis %}
            <div class="col-md-6 col-lg-3">
                {% embed '_components/_card.html.twig' with { 'class': 'h-100' } %}
                    {% block card_body %}
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <code class="small text-muted">{{ kpi.mhc }}</code>
                            {% if kpi.computable %}
                                {% include '_components/_badge.html.twig' with { variant: 'success', content: 'mris.badge.auto'|trans({}, 'mris') } %}
                            {% else %}
                                {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'mris.badge.manual'|trans({}, 'mris') } %}
                            {% endif %}
                        </div>
                        <h2 class="h6 mb-2">{{ kpi.name }}</h2>
                        {% if kpi.value is not null %}
                            <p class="display-6 mb-1">
                                {{ kpi.value }}
                                <small class="fs-6 text-muted">{{ kpi.unit }}</small>
                            </p>
                        {% else %}
                            <p class="text-muted fst-italic mb-1">{{ 'mris.state.no_data'|trans({}, 'mris') }}</p>
                        {% endif %}
                        <p class="small text-muted mb-0">{{ kpi.source }}</p>
                    {% endblock %}
                {% endembed %}
            </div>
        {% endfor %}
    </div>

    <section class="mt-4" aria-labelledby="mris-wizards-title">
        <h2 id="mris-wizards-title" class="h6 text-muted mb-2">{{ 'mris.page.wizards_title'|trans({}, 'mris') }}</h2>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_mris_wizard_pure_friction') }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                <i class="fa-icon fa-icon--nav-sliders" aria-hidden="true"></i> {{ 'mris.wizard.pure_friction.breadcrumb'|trans({}, 'mris') }}
            </a>
            <a href="{{ path('app_mris_wizard_maturity_evidence') }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                <i class="fa-icon fa-icon--nav-list-check" aria-hidden="true"></i> {{ 'mris.wizard.maturity_evidence.breadcrumb'|trans({}, 'mris') }}
            </a>
            <a href="{{ path('app_mris_wizard_ai_risk_class') }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                <i class="fa-icon fa-icon--nav-robot" aria-hidden="true"></i> {{ 'mris.wizard.ai_risk_class.breadcrumb'|trans({}, 'mris') }}
            </a>
        </div>
    </section>

    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', class: 'mt-4 small' } } %}
        {% block alert_body %}
        <strong>{{ 'mris.page.note_label'|trans({}, 'mris') }}</strong>
        {{ 'mris.kpi_help.manual_note_pending'|trans({}, 'mris') }}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
