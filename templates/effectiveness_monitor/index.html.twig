{% extends 'base.html.twig' %}
{% trans_default_domain 'control' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_feature_card.html.twig' as _fa_feature_card %}

{% block title %}{{ 'effectiveness_monitor.page.title'|trans({}, 'control') }}{% endblock %}

{% block body %}

{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'nav.soa'|trans({}, 'nav'), url: path('app_soa_index') },
        { label: 'effectiveness_monitor.page.title'|trans({}, 'control') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'effectiveness_monitor.page.title'|trans({}, 'control'),
    subtitle: 'effectiveness_monitor.page.subtitle'|trans({}, 'control'),
    actions: []
}) }}

{% if noTenant %}
    <div class="fa-alert fa-alert--warning" role="alert">
        <i class="fa-icon fa-icon--status-warning fa-alert__icon" aria-hidden="true"></i>
        <div class="fa-alert__body">
            <p class="fa-alert__message">{{ 'effectiveness_monitor.no_tenant'|trans({}, 'control') }}</p>
        </div>
    </div>
{% else %}

{# ── KPI Cards ─────────────────────────────────────────────────────────── #}
<div class="grid grid-responsive-200 mb-4" style="gap: var(--space-4);">

    {{ _fa_feature_card.render({
        label:   'effectiveness_monitor.kpi.overdue'|trans({}, 'control'),
        value:   stats.overdue,
        unit:    '',
        variant: stats.overdue > 0 ? 'danger' : 'success',
        icon:    'status-warning',
        hint:    stats.overduePct ~ '% ' ~ 'effectiveness_monitor.kpi.of_applicable'|trans({}, 'control')
    }) }}

    {{ _fa_feature_card.render({
        label:   'effectiveness_monitor.kpi.due_soon'|trans({}, 'control'),
        value:   stats.dueSoon,
        unit:    '',
        variant: stats.dueSoon > 0 ? 'warning' : 'primary',
        icon:    'nav-clock-history',
        hint:    stats.dueSoonPct ~ '% ' ~ 'effectiveness_monitor.kpi.of_applicable'|trans({}, 'control')
    }) }}

    {{ _fa_feature_card.render({
        label:   'effectiveness_monitor.kpi.recently_checked'|trans({}, 'control'),
        value:   stats.recentlyChecked,
        unit:    '',
        variant: 'success',
        icon:    'status-ok',
        hint:    stats.recentlyCheckedPct ~ '% ' ~ 'effectiveness_monitor.kpi.of_applicable'|trans({}, 'control')
    }) }}

    {{ _fa_feature_card.render({
        label:   'effectiveness_monitor.kpi.never_checked'|trans({}, 'control'),
        value:   stats.neverChecked,
        unit:    '',
        variant: stats.neverChecked > 0 ? 'danger' : 'primary',
        icon:    'question-circle',
        hint:    stats.neverCheckedPct ~ '% ' ~ 'effectiveness_monitor.kpi.of_applicable'|trans({}, 'control')
    }) }}

</div>

{# ── Filter Bar ───────────────────────────────────────────────────────── #}
<form method="GET" action="{{ path('app_effectiveness_monitor') }}" class="d-flex flex-wrap gap-2 align-items-end mb-4">
    <div>
        <label for="category-filter" class="form-label small mb-1">
            {{ 'effectiveness_monitor.filter.category'|trans({}, 'control') }}
        </label>
        <select id="category-filter" name="category" class="form-select form-select-sm" style="min-width: 160px;">
            <option value="">{{ 'effectiveness_monitor.filter.all_categories'|trans({}, 'control') }}</option>
            <option value="5." {% if categoryFilter == '5.' %}selected{% endif %}>A.5 — {{ 'effectiveness_monitor.category.organisational'|trans({}, 'control') }}</option>
            <option value="6." {% if categoryFilter == '6.' %}selected{% endif %}>A.6 — {{ 'effectiveness_monitor.category.people'|trans({}, 'control') }}</option>
            <option value="7." {% if categoryFilter == '7.' %}selected{% endif %}>A.7 — {{ 'effectiveness_monitor.category.physical'|trans({}, 'control') }}</option>
            <option value="8." {% if categoryFilter == '8.' %}selected{% endif %}>A.8 — {{ 'effectiveness_monitor.category.technological'|trans({}, 'control') }}</option>
        </select>
    </div>
    <div>
        <label for="threshold-months" class="form-label small mb-1">
            {{ 'effectiveness_monitor.filter.threshold'|trans({}, 'control') }}
        </label>
        <select id="threshold-months" name="threshold" class="form-select form-select-sm">
            <option value="6"  {% if thresholdMonths == 6  %}selected{% endif %}>6 {{ 'effectiveness_monitor.filter.months'|trans({}, 'control') }}</option>
            <option value="12" {% if thresholdMonths == 12 %}selected{% endif %}>12 {{ 'effectiveness_monitor.filter.months'|trans({}, 'control') }}</option>
            <option value="18" {% if thresholdMonths == 18 %}selected{% endif %}>18 {{ 'effectiveness_monitor.filter.months'|trans({}, 'control') }}</option>
            <option value="24" {% if thresholdMonths == 24 %}selected{% endif %}>24 {{ 'effectiveness_monitor.filter.months'|trans({}, 'control') }}</option>
        </select>
    </div>
    <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm">
        <i class="fa-icon fa-icon--ui-search" aria-hidden="true"></i>
        {{ 'effectiveness_monitor.filter.apply'|trans({}, 'control') }}
    </button>
    {% if categoryFilter %}
        <a href="{{ path('app_effectiveness_monitor', {threshold: thresholdMonths}) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
            {{ 'effectiveness_monitor.filter.clear'|trans({}, 'control') }}
        </a>
    {% endif %}
</form>

{# ── Overdue Controls Table ───────────────────────────────────────────── #}
<section class="mb-5" aria-labelledby="overdue-heading">
    <h2 id="overdue-heading" class="h5 mb-3">
        <i class="fa-icon fa-icon--status-warning text-danger" aria-hidden="true"></i>
        {{ 'effectiveness_monitor.section.overdue'|trans({}, 'control') }}
        <span class="fa-status-pill fa-status-pill--danger ms-1">{{ overdueControls|length }}</span>
    </h2>

    {% embed '_components/_fa_table.html.twig' with { sortable: true, stickyHead: true, rowClick: false } %}
        {% block table_head %}
                <tr>
                    <th scope="col" class="fa-table__th" data-sort-key="controlId">{{ 'effectiveness_monitor.table.control_id'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th" data-sort-key="name">{{ 'effectiveness_monitor.table.name'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th" data-sort-key="category">{{ 'effectiveness_monitor.table.category'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--sortable" data-sort-key="lastChecked" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort">{{ 'effectiveness_monitor.table.last_checked'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--num fa-table__th--sortable" data-sort-key="overdueDays" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort">{{ 'effectiveness_monitor.table.overdue_days'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th" data-sort-key="owner">{{ 'effectiveness_monitor.table.owner'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th" data-sort-key="status">{{ 'effectiveness_monitor.table.status'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--actions"></th>
                </tr>
        {% endblock %}
        {% block table_body %}
            {% for row in overdueControls %}
                    <tr class="fa-table__row">
                        <td class="fa-table__cell"><code>{{ row.control.controlId }}</code></td>
                        <td class="fa-table__cell">{{ row.control.name }}</td>
                        <td class="fa-table__cell"><span class="fa-status-pill fa-status-pill--neutral">{{ row.control.category ?? '—' }}</span></td>
                        <td class="fa-table__cell">{% if row.lastChecked %}{{ row.lastChecked|fa_date }}{% else %}<span class="fa-status-pill fa-status-pill--danger">{{ 'effectiveness_monitor.label.never'|trans({}, 'control') }}</span>{% endif %}</td>
                        <td class="fa-table__cell fa-table__cell--num">{{ row.overdueDays ? row.overdueDays ~ ' ' ~ 'effectiveness_monitor.label.days'|trans({}, 'control') : '—' }}</td>
                        <td class="fa-table__cell">{{ row.control.effectiveResponsiblePerson ?? '—' }}</td>
                        <td class="fa-table__cell"><span class="fa-status-pill fa-status-pill--{{ row.control.implementationStatus == 'implemented' ? 'success' : (row.control.implementationStatus == 'in_progress' ? 'warning' : 'neutral') }}">{{ row.control.implementationStatus ?? '—' }}</span></td>
                        <td class="fa-table__cell"><a href="{{ path('app_soa_show', {id: row.control.id}) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" aria-label="{{ 'effectiveness_monitor.action.view'|trans({}, 'control') }}"><i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i></a></td>
                    </tr>
            {% else %}
                    <tr><td class="fa-table__empty" colspan="8">{{ 'effectiveness_monitor.empty.no_overdue'|trans({}, 'control') }}</td></tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
</section>

{# ── Due Soon Table ───────────────────────────────────────────────────── #}
<section class="mb-5" aria-labelledby="due-soon-heading">
    <h2 id="due-soon-heading" class="h5 mb-3">
        <i class="fa-icon fa-icon--nav-clock-history text-warning" aria-hidden="true"></i>
        {{ 'effectiveness_monitor.section.due_soon'|trans({}, 'control') }}
        <span class="fa-status-pill fa-status-pill--warning ms-1">{{ upcomingControls|length }}</span>
    </h2>

    {% embed '_components/_fa_table.html.twig' with { sortable: true, rowClick: false } %}
        {% block table_head %}
                <tr>
                    <th scope="col" class="fa-table__th">{{ 'effectiveness_monitor.table.control_id'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th">{{ 'effectiveness_monitor.table.name'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--sortable" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort">{{ 'effectiveness_monitor.table.next_due'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--num fa-table__th--sortable" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort">{{ 'effectiveness_monitor.table.days_until_due'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th">{{ 'effectiveness_monitor.table.owner'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--actions"></th>
                </tr>
        {% endblock %}
        {% block table_body %}
            {% for row in upcomingControls %}
                    <tr class="fa-table__row">
                        <td class="fa-table__cell"><code>{{ row.control.controlId }}</code></td>
                        <td class="fa-table__cell">{{ row.control.name }}</td>
                        <td class="fa-table__cell">{{ row.nextDue|fa_date }}</td>
                        <td class="fa-table__cell fa-table__cell--num">{{ row.daysUntilDue }} {{ 'effectiveness_monitor.label.days'|trans({}, 'control') }}</td>
                        <td class="fa-table__cell">{{ row.control.effectiveResponsiblePerson ?? '—' }}</td>
                        <td class="fa-table__cell"><a href="{{ path('app_soa_show', {id: row.control.id}) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" aria-label="{{ 'common.view'|trans({}, 'messages') }}"><i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i></a></td>
                    </tr>
            {% else %}
                    <tr><td class="fa-table__empty" colspan="6">{{ 'effectiveness_monitor.empty.no_due_soon'|trans({}, 'control') }}</td></tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
</section>

{# ── Recently Checked Table ──────────────────────────────────────────── #}
<details class="mb-5">
    <summary class="h5 mb-3 cursor-pointer">
        <i class="fa-icon fa-icon--status-ok text-success" aria-hidden="true"></i>
        {{ 'effectiveness_monitor.section.recently_checked'|trans({}, 'control') }}
        <span class="fa-status-pill fa-status-pill--success ms-1">{{ recentlyChecked|length }}</span>
    </summary>

    {% embed '_components/_fa_table.html.twig' with { compact: true, rowClick: false } %}
        {% block table_head %}
                <tr>
                    <th scope="col" class="fa-table__th">{{ 'effectiveness_monitor.table.control_id'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th">{{ 'effectiveness_monitor.table.name'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--sortable" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort">{{ 'effectiveness_monitor.table.last_checked'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--num">{{ 'effectiveness_monitor.table.days_since'|trans({}, 'control') }}</th>
                    <th scope="col" class="fa-table__th fa-table__th--actions"></th>
                </tr>
        {% endblock %}
        {% block table_body %}
            {% for row in recentlyChecked %}
                    <tr class="fa-table__row">
                        <td class="fa-table__cell"><code>{{ row.control.controlId }}</code></td>
                        <td class="fa-table__cell">{{ row.control.name }}</td>
                        <td class="fa-table__cell">{{ row.lastChecked|fa_date }}</td>
                        <td class="fa-table__cell fa-table__cell--num">{{ row.daysSinceCheck }} {{ 'effectiveness_monitor.label.days'|trans({}, 'control') }}</td>
                        <td class="fa-table__cell"><a href="{{ path('app_soa_show', {id: row.control.id}) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" aria-label="{{ 'common.view'|trans({}, 'messages') }}"><i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i></a></td>
                    </tr>
            {% else %}
                    <tr><td class="fa-table__empty" colspan="5">{{ 'effectiveness_monitor.empty.no_recent'|trans({}, 'control') }}</td></tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
</details>

{% endif %}{# end !noTenant #}

{% endblock %}
