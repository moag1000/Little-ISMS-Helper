{% extends 'base.html.twig' %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% trans_default_domain 'incident' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% block title %}{{ 'incident.header.title'|trans({}, 'incident') }}{% endblock %}

{% block body %}
{# Breadcrumb Navigation #}
{% include '_components/_breadcrumb.html.twig' with {
    breadcrumbs: [
        { label: 'incident.breadcrumb'|trans({}, 'incident') }
    ]
} %}

{{ _fa_page_header.render({
    title: 'incident.header.title'|trans({}, 'incident'),
    subtitle: 'incident.header.subtitle'|trans({}, 'incident'),
    actions: [
        { label: 'incident.header.action.report'|trans({}, 'incident'), variant: 'danger', icon: 'status-critical', href: path('app_incident_new'), attrs: { 'data-turbo-frame': 'fa-form-modal' } }
    ]|merge(is_granted('ROLE_MANAGER') ? [{ label: 'filtered_export.button.label'|trans({}, 'filtered_export'), href: path('app_filtered_export_entity', { entityType: 'incident', format: 'xlsx' }) ~ (app.request.queryString ? '?' ~ app.request.queryString : ''), variant: 'ghost', icon: 'nav-file-earmark-spreadsheet' }] : [])
}) }}
    {% include '_components/_focus_filter_notice.html.twig' with { focus: focus|default(null), count: page.total } %}
{% set _global_hints = alva_hints('incident_index') %}
{% if _global_hints|length > 0 %}
    {% for _h in _global_hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}
{% endif %}


<div class="container-fluid py-4">
{% embed '_components/_fa_list_page.html.twig' with {
    page: page,
    search_action: path('app_incident_index'),
    filter_keys: ['view', 'status', 'severity', 'category', 'data_breach_only', 'nis2_only', 'location', 'focus'],
    list_title: 'incident.list.title'|trans({}, 'incident'),
    empty: {
        mood: 'sleeping',
        title: 'incident.empty.title'|trans({}, 'incident'),
        text: 'incident.empty.description'|trans({}, 'incident'),
        norm_ref: 'ISO 27001 A.5.24-28',
        actions: [{ label: 'incident.header.action.report'|trans({}, 'incident'), href: path('app_incident_new'), variant: 'danger' }],
    },
    card_attrs: { 'data-controller': 'bulk-actions', 'data-bulk-actions-endpoint-value': '/' ~ app.request.locale ~ '/incident' },
} %}
    {% block list_filters %}
        {% if app.request.query.getInt('location') > 0 %}
            <input type="hidden" name="location" value="{{ app.request.query.getInt('location') }}">
        {% endif %}
        {% if currentTenant %}
        <div class="col-md-3">
            <label for="view-filter" class="form-label">{{ 'common.view'|trans({}, 'messages') }}</label>
            <select class="form-select fa-cyber-input__field" id="view-filter" name="view" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                <option value="own" {{ inheritanceInfo.currentView == 'own' ? 'selected' : '' }}>{{ 'corporate.view.own_only'|trans({}, 'tenant') }}</option>
                {% if inheritanceInfo.hasParent %}
                <option value="inherited" {{ inheritanceInfo.currentView == 'inherited' ? 'selected' : '' }}>{{ 'corporate.view.including_inherited'|trans({}, 'tenant') }}</option>
                {% endif %}
                {% if inheritanceInfo.hasSubsidiaries %}
                <option value="subsidiaries" {{ inheritanceInfo.currentView == 'subsidiaries' ? 'selected' : '' }}>{{ 'corporate.view.including_subsidiaries'|trans({}, 'tenant') }}</option>
                {% endif %}
                {% if inheritanceInfo.isAdmin %}
                <option value="orphaned" {{ inheritanceInfo.currentView == 'orphaned' ? 'selected' : '' }}>{{ 'corporate.view.orphaned'|trans({}, 'tenant') }}</option>
                <option value="all" {{ inheritanceInfo.currentView == 'all' ? 'selected' : '' }}>{{ 'corporate.view.all_tenants'|trans({}, 'tenant') }}</option>
                {% endif %}
            </select>
        </div>
        {% endif %}
        <div class="col-md-3">
            <label for="filter-status" class="form-label">{{ 'incident.field.status'|trans({}, 'incident') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-status" name="status">
                <option value="">{{ 'incident.filter.all_status'|trans({}, 'incident') }}</option>
                <option value="reported" {{ app.request.query.get('status') == 'reported' ? 'selected' : '' }}>{{ 'incident.status.reported'|trans({}, 'incident') }}</option>
                <option value="in_investigation" {{ app.request.query.get('status') == 'in_investigation' ? 'selected' : '' }}>{{ 'incident.status.in_investigation'|trans({}, 'incident') }}</option>
                <option value="in_resolution" {{ app.request.query.get('status') == 'in_resolution' ? 'selected' : '' }}>{{ 'incident.status.in_resolution'|trans({}, 'incident') }}</option>
                <option value="resolved" {{ app.request.query.get('status') == 'resolved' ? 'selected' : '' }}>{{ 'incident.status.resolved'|trans({}, 'incident') }}</option>
                <option value="closed" {{ app.request.query.get('status') == 'closed' ? 'selected' : '' }}>{{ 'incident.status.closed'|trans({}, 'incident') }}</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="filter-severity" class="form-label">{{ 'incident.field.severity'|trans({}, 'incident') }}</label>
            <select class="form-select fa-cyber-input__field" id="filter-severity" name="severity">
                <option value="">{{ 'incident.filter.all_severity'|trans({}, 'incident') }}</option>
                <option value="critical" {{ app.request.query.get('severity') == 'critical' ? 'selected' : '' }}>{{ 'incident.severity.critical'|trans({}, 'incident') }}</option>
                <option value="high" {{ app.request.query.get('severity') == 'high' ? 'selected' : '' }}>{{ 'incident.severity.high'|trans({}, 'incident') }}</option>
                <option value="medium" {{ app.request.query.get('severity') == 'medium' ? 'selected' : '' }}>{{ 'incident.severity.medium'|trans({}, 'incident') }}</option>
                <option value="low" {{ app.request.query.get('severity') == 'low' ? 'selected' : '' }}>{{ 'incident.severity.low'|trans({}, 'incident') }}</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="filter-flags" class="form-label">{{ 'common.filter'|trans({}, 'messages') }}</label>
            <div class="d-flex gap-3 pt-1">
                {% if is_module_active('privacy') %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="data_breach_only" value="1" id="filter-data-breach"
                           {{ app.request.query.get('data_breach_only') == '1' ? 'checked' : '' }}>
                    <label class="form-check-label" for="filter-data-breach">
                        {{ 'incident.field.data_breach_occurred'|trans({}, 'incident') }}
                    </label>
                </div>
                {% endif %}
                {% if is_module_active('nis2_dora') %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="nis2_only" value="1" id="filter-nis2"
                           {{ app.request.query.get('nis2_only') == '1' ? 'checked' : '' }}>
                    <label class="form-check-label" for="filter-nis2">NIS2</label>
                </div>
                {% endif %}
            </div>
        </div>
    {% endblock %}
    {% block list_summary %}
        {% if critical_count > 0 %}<span class="fa-status-pill fa-status-pill--danger">{{ 'incident.summary.critical'|trans({'%count%': critical_count}, 'incident') }}</span>{% endif %}
        {% if open_count > 0 %}<span class="fa-status-pill fa-status-pill--warning">{{ 'incident.summary.open'|trans({'%count%': open_count}, 'incident') }}</span>{% endif %}
        {% if data_breach_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'incident.summary.data_breach'|trans({'%count%': data_breach_count}, 'incident') }}</span>{% endif %}
        {% if nis2_count > 0 %}<span class="fa-status-pill fa-status-pill--primary">{{ 'incident.summary.nis2'|trans({'%count%': nis2_count}, 'incident') }}</span>{% endif %}
    {% endblock %}
    {% block list_table %}
        {% embed '_components/_table.html.twig' with {
            'class': 'table-hover table-bulk-selectable mb-0',
            'noMargin': true,
            'responsive': true
        } %}
            {% block table_head %}
                <tr>
                    <th scope="col" class="bulk-select-column">
                        <input type="checkbox"
                               class="form-check-input"
                               data-action="bulk-actions#selectAll"
                               data-bulk-actions-target="selectAllCheckbox"
                               aria-label="{{ 'bulk_actions.select_all'|trans({}, 'messages') }}">
                    </th>
                    <th scope="col">{{ 'incident.field.title'|trans({}, 'incident') }}</th>
                    <th scope="col">{{ 'incident.field.category'|trans({}, 'incident') }}</th>
                    <th scope="col" class="text-center">{{ 'incident.field.severity'|trans({}, 'incident') }}</th>
                    <th scope="col">{{ 'incident.field.status'|trans({}, 'incident') }}</th>
                    <th scope="col">{{ 'incident.field.detected_at'|trans({}, 'incident') }}</th>
                    <th scope="col" class="text-center">{{ 'incident.field.affected_assets'|trans({}, 'incident') }}</th>
                    <th scope="col" class="text-center">{{ 'incident.field.data_breach_occurred'|trans({}, 'incident') }}</th>
                    <th scope="col" class="text-center">{{ 'common.actions'|trans({}, 'messages') }}</th>
                </tr>
            {% endblock %}
            {% block table_body %}
                <tbody id="incident-rows">
                {% set workflowStates = workflow_states(page) %}
                {% for incident in page %}
                    {% include 'incident/_row.html.twig' with { incident: incident } %}
                {% endfor %}
                </tbody>
            {% endblock %}
        {% endembed %}

        {% include '_components/_bulk_action_bar.html.twig' with { actions: ['export', 'delete'] } %}
    {% endblock %}
{% endembed %}
</div>
{% endblock %}
