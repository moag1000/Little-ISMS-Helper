{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_status_vocabulary.html.twig' as _status %}

{% block title %}{{ 'incident.bcm_impact_page.title'|trans({}, 'incident') }} · {{ incident.incidentNumber }}{% endblock %}

{% block body %}
{% set _p = 'incident.bcm_impact_page.' %}
<div class="container-fluid mt-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.incidents'|trans({}, 'nav'), url: path('app_incident_index') },
            { label: incident.incidentNumber, url: path('app_incident_show', {id: incident.id}) },
            { label: (_p ~ 'title')|trans({}, 'incident') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: (_p ~ 'title')|trans({}, 'incident'),
        subtitle: incident.title,
        badge: { label: incident.incidentNumber },
        actions: [
            { label: (_p ~ 'back')|trans({}, 'incident'), href: path('app_incident_show', {id: incident.id}), variant: 'ghost', icon: 'util-arrow-left' },
            { label: (_p ~ 'download_pdf')|trans({}, 'incident'), href: path('app_incident_bcm_impact_report', {id: incident.id}), variant: 'primary', icon: 'nav-file-pdf', attrs: { 'data-turbo': 'false' } }
        ]
    }) }}

    {% set _level = analysis.recovery_priority.level %}
    {% set _levelLabel = (_p ~ 'level.' ~ _level)|trans({}, 'incident') %}
    {% set _levelTone = _status.tone('recovery_priority', _level)|trim %}

    {# Executive summary #}
    <div class="row mb-4">
        <div class="col-md-3">
            {% embed '_components/_card.html.twig' %}
                {% block card_body %}
                    <div class="text-center">
                        <div class="text-muted mb-2 fw-semibold">{{ 'incident.bcm_impact_page.kpi.affected_processes'|trans({}, 'incident') }}</div>
                        <div class="fs-2 mb-0">{{ analysis.affected_processes.total_count }}</div>
                        {% if analysis.affected_processes.critical_count > 0 %}
                            {% import '_components/_status_pill.html.twig' as _pill %}
                            <div class="mt-2">{{ _pill.render(analysis.affected_processes.critical_count ~ ' ' ~ ('incident.bcm_impact_page.kpi.critical_suffix'|trans({}, 'incident')), 'danger') }}</div>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-md-3">
            {% embed '_components/_card.html.twig' %}
                {% block card_body %}
                    <div class="text-center">
                        <div class="text-muted mb-2 fw-semibold">{{ 'incident.bcm_impact_page.kpi.financial_impact'|trans({}, 'incident') }}</div>
                        <div class="fs-2 mb-0">{{ analysis.financial_impact.total_eur|number_format(0, ',', '.') }} €</div>
                        <small class="text-muted">{{ 'incident.bcm_impact_page.kpi.per_hour'|trans({'%amount%': analysis.financial_impact.per_hour_eur|number_format(2, ',', '.')}, 'incident') }}</small>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-md-3">
            {% embed '_components/_card.html.twig' %}
                {% block card_body %}
                    {% import '_components/_status_vocabulary.html.twig' as _status %}
                    <div class="text-center">
                        <div class="text-muted mb-2 fw-semibold">{{ 'incident.bcm_impact_page.kpi.recovery_priority'|trans({}, 'incident') }}</div>
                        <div class="fs-3 mb-0">{{ _status.pill('recovery_priority', _level, _levelLabel) }}</div>
                        <small class="text-muted">{{ analysis.recovery_priority.most_critical_process }}</small>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-md-3">
            {% embed '_components/_card.html.twig' %}
                {% block card_body %}
                    <div class="text-center">
                        <div class="text-muted mb-2 fw-semibold">{{ 'incident.bcm_impact_page.kpi.rto_compliance'|trans({}, 'incident') }}</div>
                        {% if analysis.rto_compliance.is_compliant %}
                            <div class="fs-3 mb-0 text-success"><i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> {{ 'incident.bcm_impact_page.kpi.rto_compliant'|trans({}, 'incident') }}</div>
                        {% else %}
                            <div class="fs-3 mb-0 text-danger"><i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i> {{ 'incident.bcm_impact_page.kpi.rto_violations'|trans({'%count%': analysis.rto_compliance.violations_count}, 'incident') }}</div>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# Downtime #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--ui-clock" aria-hidden="true"></i> {{ 'incident.bcm_impact_page.downtime.title'|trans({}, 'incident') }}</h2></div>
        {% endblock %}
        {% block card_body %}
            {% import '_components/_status_pill.html.twig' as _pill %}
            <div class="row">
                <div class="col-md-6">
                    <p><strong>{{ 'incident.bcm_impact_page.downtime.detected'|trans({}, 'incident') }}:</strong> {{ analysis.downtime.detected_at|fa_datetime }}</p>
                    {% if analysis.downtime.resolved_at %}
                        <p><strong>{{ 'incident.bcm_impact_page.downtime.resolved'|trans({}, 'incident') }}:</strong> {{ analysis.downtime.resolved_at|fa_datetime }}</p>
                    {% else %}
                        <p><strong>{{ 'incident.bcm_impact_page.downtime.status'|trans({}, 'incident') }}:</strong> {{ _pill.render('incident.bcm_impact_page.downtime.ongoing'|trans({}, 'incident'), 'warning') }}</p>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <p><strong>{{ 'incident.bcm_impact_page.downtime.total'|trans({}, 'incident') }}:</strong> {{ 'incident.bcm_impact_page.downtime.hours'|trans({'%count%': analysis.downtime.actual_hours}, 'incident') }}</p>
                    {% if analysis.downtime.is_estimated %}
                        <p class="text-muted"><small><i class="fa-icon fa-icon--status-info" aria-hidden="true"></i> {{ 'incident.bcm_impact_page.downtime.estimated'|trans({}, 'incident') }}</small></p>
                    {% endif %}
                </div>
            </div>
        {% endblock %}
    {% endembed %}

    {# Affected processes #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
        {% block card_header %}
            <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i> {{ 'incident.bcm_impact_page.processes.title'|trans({}, 'incident') }}</h2></div>
        {% endblock %}
        {% block card_body %}
            {% import '_components/_fa_alert.html.twig' as _fa_alert %}
            {% if analysis.affected_processes.processes|length > 0 %}
                {% embed '_components/_table.html.twig' with {
                    'class': 'table-hover',
                    'noMargin': true,
                    'responsive': true
                } %}
                    {% block table_head %}
                        <tr>
                            <th scope="col">{{ 'incident.bcm_impact_page.processes.process'|trans({}, 'incident') }}</th>
                            <th scope="col">{{ 'incident.bcm_impact_page.processes.criticality'|trans({}, 'incident') }}</th>
                            <th scope="col">{{ 'incident.bcm_impact_page.processes.rto'|trans({}, 'incident') }}</th>
                            <th scope="col">{{ 'incident.bcm_impact_page.processes.financial_impact'|trans({}, 'incident') }}</th>
                            <th scope="col">{{ 'incident.bcm_impact_page.processes.impact_severity'|trans({}, 'incident') }}</th>
                            <th scope="col">{{ 'incident.bcm_impact_page.processes.compliance'|trans({}, 'incident') }}</th>
                        </tr>
                    {% endblock %}
                    {% block table_body %}
                        {% import '_components/_status_pill.html.twig' as _pill %}
                        {% for process in analysis.affected_processes.processes %}
                            <tr>
                                <td>
                                    <strong>{{ process.process_name }}</strong><br>
                                    <small class="text-muted">{{ 'incident.bcm_impact_page.processes.owner'|trans({'%owner%': process.process_owner ?: '—'}, 'incident') }}</small>
                                </td>
                                <td>{{ _pill.render(('business_process.criticality.' ~ (process.criticality ?: 'unknown'))|trans({}, 'business_process'), pill_tone_severity(process.criticality|default(''))) }}</td>
                                <td>
                                    {{ process.bia_data.rto_hours }} h
                                    {% if process.rto_violated %}
                                        <br>{{ _pill.render('incident.bcm_impact_page.processes.violated'|trans({'%hours%': process.rto_compliance.excess_hours}, 'incident'), 'danger') }}
                                    {% endif %}
                                </td>
                                <td>{{ process.financial_impact|number_format(2, ',', '.') }} €</td>
                                <td>{{ _pill.render(('incident.severity.' ~ process.impact_severity)|trans({}, 'incident'), pill_tone_severity(process.impact_severity|default(''))) }}</td>
                                <td>
                                    {% if process.rto_violated %}
                                        <span class="text-danger"><i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i> {{ process.rto_compliance.compliance_percentage }} %</span>
                                    {% else %}
                                        <span class="text-success"><i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i> 100 %</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% else %}
                {{ _fa_alert.render({ variant: 'info', icon: 'status-info', body: 'incident.bcm_impact_page.processes.empty'|trans({}, 'incident') }) }}
            {% endif %}
        {% endblock %}
    {% endembed %}

    {# Recovery priority #}
    {% embed '_components/_card.html.twig' with { 'class': 'mb-4', 'variant': 'bordered', 'borderColor': _levelTone } %}
        {% block card_header %}
            {% import '_components/_status_vocabulary.html.twig' as _status %}
            <div class="fa-section__header card-header">
                <h2 class="fa-section__title h5 mb-0">
                    <i class="fa-icon fa-icon--ui-lightbulb" aria-hidden="true"></i>
                    {{ 'incident.bcm_impact_page.priority.title'|trans({}, 'incident') }}
                    <span class="ms-1">{{ _status.pill('recovery_priority', _level, _levelLabel) }}</span>
                </h2>
            </div>
        {% endblock %}
        {% block card_body %}
            <p><strong>{{ 'incident.bcm_impact_page.priority.reasoning'|trans({}, 'incident') }}:</strong> {{ analysis.recovery_priority.reasoning }}</p>

            <h3 class="h6 mt-3">{{ 'incident.bcm_impact_page.priority.actions'|trans({}, 'incident') }}</h3>
            <ul>
                {% for action in analysis.recovery_priority.recommended_actions %}
                    <li>{{ action }}</li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}

    {# Recommendations #}
    {% if analysis.recommendations|length > 0 %}
        {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
            {% block card_header %}
                <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--nav-list-check" aria-hidden="true"></i> {{ 'incident.bcm_impact_page.recommendations.title'|trans({}, 'incident') }}</h2></div>
            {% endblock %}
            {% block card_body %}
                {% for recommendation in analysis.recommendations %}
                    {% set _tone = pill_tone_severity(recommendation.priority) %}
                    {% embed '_components/_fa_alert.html.twig' with { props: { variant: _tone in ['danger', 'warning'] ? _tone : 'info', class: 'mb-3' } } %}
                        {% block alert_body %}
                            <div class="fw-bold mb-2">{{ recommendation.title }}</div>
                            <p>{{ recommendation.description }}</p>
                            <p class="mb-0"><strong>{{ 'incident.bcm_impact_page.recommendations.action'|trans({}, 'incident') }}:</strong> {{ recommendation.action }}</p>
                        {% endblock %}
                    {% endembed %}
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endif %}

    {# Historical context #}
    {% if analysis.historical_context.total_past_incidents > 0 %}
        {% embed '_components/_card.html.twig' with { 'class': 'mb-4' } %}
            {% block card_header %}
                <div class="card-header"><h2 class="h5 mb-0"><i class="fa-icon fa-icon--nav-calendar-check" aria-hidden="true"></i> {{ 'incident.bcm_impact_page.history.title'|trans({}, 'incident') }}</h2></div>
            {% endblock %}
            {% block card_body %}
                <div class="row">
                    <div class="col-md-3">
                        <p><strong>{{ 'incident.bcm_impact_page.history.incidents'|trans({}, 'incident') }}:</strong> {{ analysis.historical_context.total_past_incidents }}</p>
                    </div>
                    <div class="col-md-3">
                        <p><strong>{{ 'incident.bcm_impact_page.history.downtime'|trans({}, 'incident') }}:</strong> {{ 'incident.bcm_impact_page.downtime.hours'|trans({'%count%': analysis.historical_context.total_past_downtime_hours}, 'incident') }}</p>
                    </div>
                    <div class="col-md-3">
                        <p><strong>{{ 'incident.bcm_impact_page.history.loss'|trans({}, 'incident') }}:</strong> {{ analysis.historical_context.total_past_financial_loss_eur|number_format(2, ',', '.') }} €</p>
                    </div>
                    <div class="col-md-3">
                        <p><strong>{{ 'incident.bcm_impact_page.history.rto_violations'|trans({}, 'incident') }}:</strong> {{ analysis.historical_context.processes_with_rto_violations }}</p>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
    {% endif %}
</div>
{% endblock %}
