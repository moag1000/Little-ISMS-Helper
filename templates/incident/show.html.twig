{% extends 'base.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_deadline_counter.html.twig' as _fa_deadline_counter %}
{% import '_components/_fa_status_chip.html.twig' as _fa_status_chip %}
{% import '_components/_fa_icon.html.twig' as _fa_icon %}
{% import '_components/_lifecycle_actions.html.twig' as _lifecycle_actions %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}
{% trans_default_domain 'incident' %}
{% import '_macros/workflow.html.twig' as workflow_macros %}
{% import '_components/_status_pill.html.twig' as pill %}

{% block title %}{{ incident.title }}{% endblock %}

{% block body %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.incidents'|trans({}, 'nav'), url: path('app_incident_index') },
            { label: incident.title }
        ]
    } %}

    {% set _show_actions = [
        { label: 'incident.action.edit'|trans({}, 'incident'), variant: 'primary', icon: 'ui-edit', href: path('app_incident_edit', {id: incident.id}) }
    ] %}
    {% if is_nis2_active() and incident.requiresNis2Reporting %}
        {% set _show_actions = _show_actions|merge([{ label: 'incident.action.download_nis2_report'|trans({}, 'incident'), variant: 'accent', icon: 'nav-file-pdf', href: path('app_incident_nis2_report', {id: incident.id}), attrs: { 'data-turbo': 'false' } }]) %}
    {% endif %}
    {% set _show_actions = _show_actions|merge([{ label: 'incident.action.back_to_list'|trans({}, 'incident'), variant: 'ghost', icon: 'util-arrow-left', href: path('app_incident_index') }]) %}
    {{ _fa_page_header.render({
        title: incident.title,
        actions: _show_actions
    }) }}

    {# DSGVO Art. 33 72h-deadline counter surfaced prominently — M-4 gated by privacy module #}
    {% if is_module_active('privacy') and incident.dataBreachOccurred and incident.detectedAt %}
        {% set sla72h = incident.detectedAt|date_modify('+72 hours') %}
        <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
            {{ _fa_deadline_counter.render({
                deadline_at: sla72h,
                label: 'incident.deadline.gdpr_art33'|trans({}, 'incident')
            }) }}
        </div>
        {% set _hint = alva_hint(incident) %}
        {% if _hint %}
            {% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
            {{ _fa_alva_hint.render(_hint) }}
        {% endif %}
    {% endif %}

    {# Detail skeleton (UI wave E): status band → anchor bar → links → sections → history → comments #}
    {% set _status %}{{ _fa_status_chip.render({ entity_class: 'App\\Entity\\Incident', status_key: incident.status.value|default(incident.status) }) }}{% endset %}
    {% set _actions %}{{ _lifecycle_actions.dropdown(incident, 'incident', 'incident_lifecycle') }}{% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'show.status.severity'|trans({}, 'messages'), value: incident.severity ? incident.severity.value|upper : null },
            { label: 'show.status.detected'|trans({}, 'messages'), value: incident.detectedAt ? incident.detectedAt|fa_date : null },
            { label: 'incident.field.assigned_to'|trans({}, 'incident'), value: incident.assignedTo },
        ],
        workflow: workflow_state(incident),
    }) }}

    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages') },
        { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
        { id: 'nis2-reporting', label: 'incident.nis2_timeline.title'|trans({}, 'incident'), show: is_nis2_active() and incident.requiresNis2Reporting and incident.detectedAt },
        { id: 'dora-reporting', label: 'incident.reporting.dora_title'|trans({}, 'incident'), show: is_module_active('nis2_dora') and reporting_duties(incident)|filter(d => d.type.value starts with 'dora_')|length > 0 },
        { id: 'bcm-impact', label: 'incident.section.bcm_impact'|trans({}, 'incident'), show: is_module_active('bcm') },
        { id: 'incident-risk-links', label: 'incident.link.section_title'|trans({}, 'incident') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages'), count: totalAuditLogs|default(0) },
        { id: 'comments', label: 'show.anchor.comments'|trans({}, 'messages'), count: comments|default([])|length },
    ]) }}

    {# NIS2 MUS-export dropdown + POST-delete kept below header (cannot be expressed via _fa_page_header GET-only actions) #}
    {% if (is_nis2_active() and incident.requiresNis2Reporting) or is_granted('ROLE_ADMIN') %}
        <div class="d-flex justify-content-end gap-2 mb-3 flex-wrap">
            {% if is_nis2_active() and incident.requiresNis2Reporting %}
                <div class="btn-group" role="group" aria-label="{{ 'incident.action.mus_export_group'|trans({}, 'incident') }}">
                    <button type="button" class="fa-cyber-btn fa-cyber-btn--info dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" data-turbo="false">
                        <i class="fa-icon fa-icon--asset-cloud" aria-hidden="true"></i> {{ 'incident.action.mus_export'|trans({}, 'incident') }}
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_nis2_mus_export_early_warning', {id: incident.id}) }}" data-turbo="false">{{ 'incident.action.mus_early_warning'|trans({}, 'incident') }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_nis2_mus_export_detailed_notification', {id: incident.id}) }}" data-turbo="false">{{ 'incident.action.mus_detailed_notification'|trans({}, 'incident') }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_nis2_mus_export_final_report', {id: incident.id}) }}" data-turbo="false">{{ 'incident.action.mus_final_report'|trans({}, 'incident') }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_nis2_mus_export_bundle', {id: incident.id}) }}" data-turbo="false">{{ 'incident.action.mus_bundle'|trans({}, 'incident') }}</a></li>
                    </ul>
                </div>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('app_incident_delete', {id: incident.id}) }}" class="d-inline"
                      data-controller="ui-actions"
                      data-action="submit->ui-actions#confirm"
                      data-ui-actions-message-param="{{ 'incident.confirm.delete'|trans({}, 'incident') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ incident.id) }}">
                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger"><i class="fa-icon fa-icon--ui-trash" aria-hidden="true"></i> {{ 'incident.action.delete'|trans({}, 'incident') }}</button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    {# Workflow Status Section #}
    {% if workflowStatus.has_active_workflow %}
        {% set escalationLevel = workflowStatus.escalation_level %}
        {% set isDataBreach = escalationLevel == 'data_breach' %}

        {# Determine alert level based on escalation #}
        {% set alertClass = {
            'low': 'info',
            'medium': 'warning',
            'high': 'warning',
            'critical': 'danger',
            'data_breach': 'danger'
        }[escalationLevel] ?? 'info' %}

        <div class="fa-alert fa-alert--{{ alertClass }} workflow-status-alert" role="alert">
            <div class="workflow-status-header">
                <div class="workflow-status-title">
                    {# Dynamic workflow-state icon — Aurora mask (status-warning for data breach, nav-gear for default). #}
                    {{ _fa_icon.render(isDataBreach ? 'status-warning' : 'nav-gear') }}
                    <strong>
                        {% if isDataBreach %}
                            {{ 'incident.workflow.data_breach_active'|trans({}, 'incident') }}
                        {% else %}
                            {{ 'incident.workflow.active'|trans({}, 'incident') }}
                        {% endif %}
                    </strong>
                </div>
                {% include '_components/_badge.html.twig' with { variant: alertClass, content: ('incident.workflow.escalation.' ~ escalationLevel)|trans({}, 'incident') } %}
            </div>

            <div class="workflow-status-content">
                <div class="workflow-info-grid">
                    <div class="workflow-info-item">
                        <span class="label">{{ 'workflow.field.status'|trans({}, 'workflows') }}:</span>
                        <span class="value">{{ workflowStatus.workflow_status|upper }}</span>
                    </div>
                    <div class="workflow-info-item">
                        <span class="label">{{ 'workflow.field.current_step'|trans({}, 'workflows') }}:</span>
                        <span class="value">{{ workflowStatus.current_step ?? '—' }}</span>
                    </div>
                    {% if workflowStatus.due_date %}
                        <div class="workflow-info-item">
                            <span class="label">{{ 'workflow.field.due_date'|trans({}, 'workflows') }}:</span>
                            <div class="mt-2">
                                {{ workflow_macros.sla_timeline(workflowStatus.due_date, null, null, null, false) }}
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# M-4 — module-gating: GDPR 72h deadline only when privacy module is active #}
                {% if is_module_active('privacy') and isDataBreach and workflowStatus.due_date %}
                    <div class="gdpr-deadline-warning">
                        <i class="fa-icon fa-icon--status-pending" aria-hidden="true"></i>
                        <strong>{{ 'incident.workflow.gdpr_72h_deadline'|trans({}, 'incident') }}</strong>
                        {% set hoursRemaining = ((workflowStatus.due_date.timestamp - "now"|date('U')) / 3600)|round(1) %}
                        {% if workflowStatus.is_overdue %}
                            <span class="text-danger">{{ 'workflow.badge.overdue'|trans({}, 'workflows') }}!</span>
                        {% else %}
                            <span>{{ 'incident.timeline.hours_remaining'|trans({'%hours%': hoursRemaining}, 'incident') }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                {# Replaced with inline workflow actions macro #}
                {{ workflow_macros.inline_actions(workflowStatus.workflow_instance, incident, canApproveWorkflow ?? false, false) }}
            </div>
        </div>
    {% endif %}

    {% include '_components/_fa_entity_links.html.twig' with { entity: incident } only %}

    <div id="details" class="fa-show-section">
    {% embed '_components/_card.html.twig' %}
        {% block card_header %}
            {% import '_components/_status_pill.html.twig' as pill %}
            <div class="card-header">
                <h2 class="h5">Incident #{{ incident.incidentNumber }}</h2>
                <div class="badges">
                    {{ pill.render(incident.severity.value|upper, pill_tone_severity(incident.severity)) }}
                    {{ pill.render(incident.status.value|upper|replace({'_': ' '}), pill_tone_status(incident.status)) }}
                    {% if is_nis2_active() and incident.requiresNis2Reporting %}
                        {% set nis2Status = incident.nis2ComplianceStatus %}
                        {{ pill.render(('incident.nis2_compliance.' ~ nis2Status)|trans({}, 'incident'), pill_tone_nis2(nis2Status), { icon: 'certificate' }) }}
                    {% endif %}
                </div>
            </div>
        {% endblock %}
        {% block card_body %}
            {% import 'incident/_reporting.html.twig' as _rep %}
            {# Standardised via _detail_group component #}
            {% set incidentItems = [
                { label: 'incident.field.category'|trans({}, 'incident'), value: incident.category|upper|replace({'_': ' '}) },
                { label: 'incident.field.detected'|trans({}, 'incident'), value: incident.detectedAt|fa_datetime },
                { label: 'incident.field.reported_by'|trans({}, 'incident'), value: incident.effectiveReportedBy ?? incident.reportedBy ?? '—' },
                { label: 'incident.field.responsible_person'|trans({}, 'incident'), value: incident.effectiveResponsiblePersonName ?? '—' }
            ] %}
            {% if incident.occurredAt %}
                {% set incidentItems = incidentItems|merge([{ label: 'incident.field.occurred'|trans({}, 'incident'), value: incident.occurredAt|fa_datetime }]) %}
            {% endif %}
            {% include '_components/_detail_group.html.twig' with { items: incidentItems } only %}

            {# NIS2 Article 23 Reporting Timeline #}
            {% if is_nis2_active() and incident.requiresNis2Reporting and incident.detectedAt %}
                <div id="nis2-reporting" class="detail-section nis2-timeline-section fa-show-section">
                    <h3 class="h5">
                        <i class="fa-icon fa-icon--nav-calendar-check" aria-hidden="true"></i>
                        {{ 'incident.nis2_timeline.title'|trans({}, 'incident') }}
                    </h3>
                    <p class="text-muted">{{ 'incident.nis2_timeline.description'|trans({}, 'incident') }}</p>
                    {{ _rep.assessment(incident) }}
                    {% include '_components/_tenant_reporting_contacts.html.twig' with { authorities: incident.tenant.supervisoryAuthorities, csirts: incident.tenant.csirtEndpoints } only %}

                    <div class="timeline-container">
                        {# Stage 1: Early Warning (24h) #}
                        <div class="timeline-stage {% if incident.earlyWarningReportedAt %}completed{% elseif incident.isEarlyWarningOverdue %}overdue{% else %}pending{% endif %}">
                            <div class="timeline-icon">
                                {% if incident.earlyWarningReportedAt %}
                                    <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                                {% elseif incident.isEarlyWarningOverdue %}
                                    <i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i>
                                {% else %}
                                    <i class="fa-icon fa-icon--status-pending" aria-hidden="true"></i>
                                {% endif %}
                            </div>
                            <div class="timeline-content">
                                <div class="fw-bold fs-6">{{ 'incident.timeline.early_warning'|trans({}, 'incident') }}</div>
                                <p class="timeline-deadline">
                                    <strong>{{ 'incident.timeline.deadline'|trans({}, 'incident') }}:</strong>
                                    {{ incident.earlyWarningDeadline|fa_datetime }}
                                </p>
                                {% if incident.earlyWarningReportedAt %}
                                    <div class="timeline-completed">
                                        <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                                        {{ 'incident.timeline.reported_at'|trans({}, 'incident') }}:
                                        <strong>{{ incident.earlyWarningReportedAt|fa_datetime }}</strong>
                                    </div>
                                {% elseif incident.isEarlyWarningOverdue %}
                                    <div class="timeline-overdue">
                                        <i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i>
                                        {{ 'incident.timeline.overdue'|trans({}, 'incident') }}
                                    </div>
                                {% else %}
                                    <div class="timeline-countdown">
                                        {% set hoursRemaining = incident.hoursUntilEarlyWarningDeadline %}
                                        <i class="fa-icon fa-icon--status-pending" aria-hidden="true"></i>
                                        {{ 'incident.timeline.hours_remaining'|trans({'%hours%': hoursRemaining}, 'incident') }}
                                    </div>
                                {% endif %}
                                {% if not incident.earlyWarningReportedAt %}{{ _rep.mark(incident, 'earlyWarningReportedAt') }}{% endif %}
                            </div>
                        </div>

                        {# Stage 2: Detailed Notification (72h) #}
                        <div class="timeline-stage {% if incident.detailedNotificationReportedAt %}completed{% elseif incident.isDetailedNotificationOverdue %}overdue{% else %}pending{% endif %}">
                            <div class="timeline-icon">
                                {% if incident.detailedNotificationReportedAt %}
                                    <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                                {% elseif incident.isDetailedNotificationOverdue %}
                                    <i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i>
                                {% else %}
                                    <i class="fa-icon fa-icon--status-pending fa-icon--muted" aria-hidden="true"></i>
                                {% endif %}
                            </div>
                            <div class="timeline-content">
                                <div class="fw-bold fs-6">{{ 'incident.timeline.detailed_notification'|trans({}, 'incident') }}</div>
                                <p class="timeline-deadline">
                                    <strong>{{ 'incident.timeline.deadline'|trans({}, 'incident') }}:</strong>
                                    {{ incident.detailedNotificationDeadline|fa_datetime }}
                                </p>
                                {% if incident.detailedNotificationReportedAt %}
                                    <div class="timeline-completed">
                                        <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                                        {{ 'incident.timeline.reported_at'|trans({}, 'incident') }}:
                                        <strong>{{ incident.detailedNotificationReportedAt|fa_datetime }}</strong>
                                    </div>
                                {% elseif incident.isDetailedNotificationOverdue %}
                                    <div class="timeline-overdue">
                                        <i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i>
                                        {{ 'incident.timeline.overdue'|trans({}, 'incident') }}
                                    </div>
                                {% else %}
                                    <div class="timeline-countdown">
                                        {% set hoursRemaining = incident.hoursUntilDetailedNotificationDeadline %}
                                        <i class="fa-icon fa-icon--status-pending" aria-hidden="true"></i>
                                        {{ 'incident.timeline.hours_remaining'|trans({'%hours%': hoursRemaining}, 'incident') }}
                                    </div>
                                {% endif %}
                                {% if not incident.detailedNotificationReportedAt %}{{ _rep.mark(incident, 'detailedNotificationReportedAt') }}{% endif %}
                            </div>
                        </div>

                        {# Stage 3: Final Report (1 month) #}
                        <div class="timeline-stage {% if incident.finalReportSubmittedAt %}completed{% elseif incident.isFinalReportOverdue %}overdue{% else %}pending{% endif %}">
                            <div class="timeline-icon">
                                {% if incident.finalReportSubmittedAt %}
                                    <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                                {% elseif incident.isFinalReportOverdue %}
                                    <i class="fa-icon fa-icon--status-critical" aria-hidden="true"></i>
                                {% else %}
                                    <i class="fa-icon fa-icon--status-pending fa-icon--muted" aria-hidden="true"></i>
                                {% endif %}
                            </div>
                            <div class="timeline-content">
                                <div class="fw-bold fs-6">{{ 'incident.timeline.final_report'|trans({}, 'incident') }}</div>
                                <p class="timeline-deadline">
                                    <strong>{{ 'incident.timeline.deadline'|trans({}, 'incident') }}:</strong>
                                    {{ incident.finalReportDeadline|fa_datetime }}
                                </p>
                                {% if incident.finalReportSubmittedAt %}
                                    <div class="timeline-completed">
                                        <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                                        {{ 'incident.timeline.reported_at'|trans({}, 'incident') }}:
                                        <strong>{{ incident.finalReportSubmittedAt|fa_datetime }}</strong>
                                    </div>
                                {% elseif incident.isFinalReportOverdue %}
                                    <div class="timeline-overdue">
                                        <i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i>
                                        {{ 'incident.timeline.overdue'|trans({}, 'incident') }}
                                    </div>
                                {% else %}
                                    <div class="timeline-countdown">
                                        {% set daysRemaining = incident.daysUntilFinalReportDeadline %}
                                        <i class="fa-icon fa-icon--status-pending" aria-hidden="true"></i>
                                        {{ 'incident.timeline.days_remaining'|trans({'%days%': daysRemaining}, 'incident') }}
                                    </div>
                                {% endif %}
                                {% if not incident.finalReportSubmittedAt %}{{ _rep.mark(incident, 'finalReportSubmittedAt') }}{% endif %}
                            </div>
                        </div>
                    </div>

                    {# NIS2 Impact Assessment #}
                    <div class="nis2-impact-grid">
                        {% if incident.nis2Category %}
                            <div class="impact-item">
                                <span class="label">{{ 'incident.field.nis2_category'|trans({}, 'incident') }}:</span>
                                <span class="value">{{ ('incident.nis2_category.' ~ incident.nis2Category)|trans({}, 'incident') }}</span>
                            </div>
                        {% endif %}
                        <div class="impact-item">
                            <span class="label">{{ 'incident.field.nis2_suspected_malicious'|trans({}, 'incident') }}:</span>
                            <span class="value">{{ ('incident.suspected_malicious.' ~ (incident.nis2SuspectedMalicious is same as(true) ? 'suspected' : (incident.nis2SuspectedMalicious is same as(false) ? 'not_suspected' : 'unknown')))|trans({}, 'incident') }}</span>
                        </div>
                        <div class="impact-item">
                            <span class="label">{{ 'incident.field.cross_border_impact'|trans({}, 'incident') }}:</span>
                            <span class="value">
                                {% if incident.isCrossBorderImpact %}
                                    {% include '_components/_badge.html.twig' with { variant: 'danger', content: 'common.yes'|trans({}, 'messages') } %}
                                {% else %}
                                    {% include '_components/_badge.html.twig' with { variant: 'secondary', content: 'common.no'|trans({}, 'messages') } %}
                                {% endif %}
                            </span>
                        </div>
                        {% if incident.affectedUsersCount %}
                            <div class="impact-item">
                                <span class="label">{{ 'incident.field.affected_users_count'|trans({}, 'incident') }}:</span>
                                <span class="value"><strong>{{ incident.affectedUsersCount|number_format }}</strong></span>
                            </div>
                        {% endif %}
                        {% if incident.estimatedFinancialImpact %}
                            <div class="impact-item">
                                <span class="label">{{ 'incident.field.estimated_financial_impact'|trans({}, 'incident') }}:</span>
                                <span class="value"><strong>{{ incident.estimatedFinancialImpact|number_format(2) }} EUR</strong></span>
                            </div>
                        {% endif %}
                        {% if incident.nationalAuthorityNotified %}
                            <div class="impact-item">
                                <span class="label">{{ 'incident.field.national_authority_notified'|trans({}, 'incident') }}:</span>
                                <span class="value">{{ incident.nationalAuthorityNotified }}</span>
                            </div>
                        {% endif %}
                        {% if incident.authorityReferenceNumber %}
                            <div class="impact-item">
                                <span class="label">{{ 'incident.field.authority_reference_number'|trans({}, 'incident') }}:</span>
                                <span class="value"><code>{{ incident.authorityReferenceNumber }}</code></span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% set _doraDuties = is_module_active('nis2_dora') ? reporting_duties(incident)|filter(d => d.type.value starts with 'dora_') : [] %}
            {% if _doraDuties|length > 0 %}
                {{ _rep.dora(incident, _doraDuties) }}
            {% endif %}

            {% if incident.description %}
                <div class="detail-section">
                    <h3 class="h5">{{ 'incident.field.description'|trans({}, 'incident') }}</h3>
                    <p>{{ incident.description }}</p>
                </div>
            {% endif %}

            {# Doppelpflege-Deprecation —
               render freetext affectedSystems read-only as "Legacy" alert
               ONLY when non-empty. Hidden for all new incidents (use the
               structured "Affected Assets" section below instead). #}
            {% if incident.affectedSystems %}
                <div class="detail-section">
                    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', icon: 'status-info', title: 'incident.section.affected_systems_legacy'|trans({}, 'incident') } } %}
                        {% block alert_body %}
                            <p class="mb-1">{{ incident.affectedSystems }}</p>
                            <small class="text-muted">{{ 'incident.section.affected_systems_legacy_hint'|trans({}, 'incident') }}</small>
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endif %}

            {% if incident.rootCause %}
                <div class="detail-section">
                    <h3 class="h5">{{ 'incident.section.root_cause'|trans({}, 'incident') }}</h3>
                    <p>{{ incident.rootCause }}</p>
                </div>
            {% endif %}

            {# Structured CAPA card (preferred display). #}
            {% if linkedCorrectiveActions is defined and linkedCorrectiveActions|length > 0 %}
                <div class="detail-section">
                    <h3 class="h5">{{ 'incident.section.linked_corrective_actions'|trans({}, 'incident') }}</h3>
                    <ul class="list-unstyled mb-0">
                        {% for ca in linkedCorrectiveActions %}
                            <li class="mb-2">
                                <a href="{{ path('app_corrective_action_show', { id: ca.id }) }}">
                                    <i class="fa-icon fa-icon--util-arrow-right me-1" aria-hidden="true"></i>
                                    {{ ca.title }}
                                </a>
                                <span class="fa-status-pill fa-status-pill--neutral ms-1">{{ ('corrective_action.status.' ~ ca.status)|trans({}, 'audits') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# Freetext shown only as legacy alert (ADR 2026-05-23). #}
            {% if incident.correctiveActions %}
                <div class="detail-section">
                    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', icon: 'status-info', title: 'incident.section.corrective_actions_legacy'|trans({}, 'incident') } } %}
                        {% block alert_body %}
                            <p class="mb-1">{{ incident.correctiveActions }}</p>
                            <small class="text-muted">{{ 'incident.section.corrective_actions_legacy_hint'|trans({}, 'incident') }}</small>
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endif %}

            {% if incident.lessonsLearned %}
                <div class="detail-section">
                    <h3 class="h5">{{ 'incident.field.lessons_learned'|trans({}, 'incident') }}</h3>
                    <p>{{ incident.lessonsLearned }}</p>
                </div>
            {% endif %}

            {% if incident.closedAt %}
                <div class="detail-section">
                    <h3 class="h5">{{ 'incident.section.closure'|trans({}, 'incident') }}</h3>
                    <p>{{ 'incident.field.closed_date'|trans({}, 'incident') }}: <strong>{{ incident.closedAt|fa_datetime }}</strong></p>
                </div>
            {% endif %}

            {# CRITICAL-05: BCM Impact Analysis — ISO 22301, bcm module only #}
            {% if is_module_active('bcm') %}
            <div id="bcm-impact" class="detail-section fa-show-section">
                <h3 class="h5"><i class="fa-icon fa-icon--nav-bar-chart" aria-hidden="true"></i> {{ 'incident.section.bcm_impact'|trans({}, 'incident') }}</h3>

                {% if incident.affectedBusinessProcesses|length > 0 %}
                    <div class="row mb-3">
                        <div class="col-md-4">
                            {% embed '_components/_card.html.twig' with { 'class': 'bg-body-secondary' } %}
                                {% block card_body %}
                                    <div class="text-center">
                                        <div class="fs-5 fw-bold">{{ incident.affectedProcessCount }}</div>
                                        <small class="text-muted">{{ 'incident.bcm.affected_processes'|trans({}, 'incident') }}</small>
                                        {% if incident.hasCriticalProcessesAffected %}
                                            <br>{% include '_components/_badge.html.twig' with { variant: 'danger', class: 'mt-1', content: 'incident.severity.critical'|trans({}, 'incident') } %}
                                        {% endif %}
                                    </div>
                                {% endblock %}
                            {% endembed %}
                        </div>
                        <div class="col-md-4">
                            {% embed '_components/_card.html.twig' with { 'class': 'bg-body-secondary' } %}
                                {% block card_body %}
                                    <div class="text-center">
                                        <div class="fs-5">
                                            {% set priority_class = {
                                                'immediate': 'danger',
                                                'high': 'warning',
                                                'medium': 'info',
                                                'low': 'secondary'
                                            }[incident.suggestedRecoveryPriority] %}
                                            {% include '_components/_badge.html.twig' with { variant: priority_class, content: incident.suggestedRecoveryPriority|upper } %}
                                        </div>
                                        <small class="text-muted">{{ 'incident.bcm.recovery_priority'|trans({}, 'incident') }}</small>
                                    </div>
                                {% endblock %}
                            {% endembed %}
                        </div>
                        <div class="col-md-4">
                            {% embed '_components/_card.html.twig' with { 'class': 'bg-body-secondary' } %}
                                {% block card_body %}
                                    <div class="text-center">
                                        <div class="fs-5 fw-bold">€{{ incident.calculateEstimatedFinancialImpact(24)|number_format(0) }}</div>
                                        <small class="text-muted">{{ 'incident.bcm.est_impact_24h'|trans({}, 'incident') }}</small>
                                    </div>
                                {% endblock %}
                            {% endembed %}
                        </div>
                    </div>

                    <div class="data-reuse-list mb-3">
                        {% for process in incident.affectedBusinessProcesses %}
                            <div class="data-reuse-item">
                                <strong>{{ process.name }}</strong>
                                {% set crit_class = pill_tone_severity(process.criticality|default('')) %}
                                {% include '_components/_badge.html.twig' with { variant: crit_class, content: process.criticality|upper } %}
                                <small>RTO: {{ process.rto }}h | {{ 'incident.bcm.owner'|trans({}, 'incident') }}: {{ process.effectiveProcessOwner ?? '—' }}</small>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('app_incident_bcm_impact', {id: incident.id}) }}" class="fa-cyber-btn fa-cyber-btn--primary">
                            <i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i> {{ 'incident.bcm.detailed_analysis'|trans({}, 'incident') }}
                        </a>
                        <form method="post" action="{{ path('app_incident_auto_detect_processes', {id: incident.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('auto-detect' ~ incident.id) }}">
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost">
                                <i class="fa-icon fa-icon--nav-magic" aria-hidden="true"></i> {{ 'incident.bcm.auto_detect_more'|trans({}, 'incident') }}
                            </button>
                        </form>
                    </div>
                {% else %}
                    {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'info', icon: 'status-info' } } %}
                        {% block alert_body %}<strong>{{ 'incident.bcm.empty_title'|trans({}, 'incident') }}</strong> {{ 'incident.bcm.empty_description'|trans({}, 'incident') }}{% endblock %}
                    {% endembed %}
                    <form method="post" action="{{ path('app_incident_auto_detect_processes', {id: incident.id}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('auto-detect' ~ incident.id) }}">
                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">
                            <i class="fa-icon fa-icon--nav-magic" aria-hidden="true"></i> {{ 'incident.bcm.auto_detect'|trans({}, 'incident') }}
                        </button>
                    </form>
                {% endif %}
            </div>
            {% endif %}

            {# Realised risks: level in the links block above, re-assessment here #}
            {% if incident.realizedRisks|length > 0 %}
                {% embed '_components/_fa_alert.html.twig' with { props: { variant: 'warning' } } %}
                    {% block alert_body %}<strong>{{ 'incident.reuse.risk_realization'|trans({}, 'incident') }}:</strong> {{ 'incident.reuse.risk_realization_detail'|trans({'%count%': incident.realizedRisks|length}, 'incident') }}{% endblock %}
                {% endembed %}
                {# ISO 27001 Cl. 6.1.2: re-assess each realised risk against the real incident #}
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0" data-testid="incident-risk-reassess">
                    {% for risk in incident.realizedRisks %}
                        <li class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                            <span>
                                <a href="{{ path('app_risk_show', {id: risk.id}) }}">{{ risk.title }}</a>
                                {% if risk.lastIncidentReassessmentAt %}
                                    <small class="text-muted d-block">{{ 'incident.fv5.last_reassessed'|trans({'%date%': risk.lastIncidentReassessmentAt|fa_datetime}, 'incident') }}</small>
                                {% endif %}
                            </span>
                            <form method="post" action="{{ path('app_incident_risk_reassess', {id: incident.id, riskId: risk.id}) }}" class="m-0">
                                <input type="hidden" name="_token" value="{{ csrf_token('incident-risk-reassess-' ~ incident.id ~ '-' ~ risk.id) }}">
                                <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm" title="{{ 'incident.fv5.reassess_help'|trans({}, 'incident') }}">
                                    {{ 'incident.fv5.reassess_button'|trans({}, 'incident') }}
                                </button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endblock %}
    {% endembed %}
    </div>

    {# Incident-Risk cross-links #}
    {% include 'incident/_linked_risks.html.twig' with {
        incident: incident,
        riskIncidentLinks: riskIncidentLinks|default([])
    } only %}

    {% include '_components/_fa_show_history.html.twig' with {
        auditLogs: auditLogs|default([]), total: totalAuditLogs|default(0),
        entityType: 'Incident', entityId: incident.id, lifecycle: 'incident'
    } only %}

    {# Comment-Thread adoption (C7 macro). #}
    <div id="comments" class="fa-show-section">
    {% include '_components/_isms_comment_thread.html.twig' with {
        comments: comments|default([]),
        entityType: 'Incident',
        entityId: incident.id,
        showForm: true,
        formAction: path('app_comment_post', {entityType: 'Incident', entityId: incident.id}),
        csrfToken: csrf_token('isms-comment')
    } only %}
    </div>
</div>

<style>
/* Workflow Status Alert Styles */
.workflow-status-alert {
    margin-bottom: 1.5rem;
    border-left: 4px solid currentColor;
    padding: 1.25rem;
}

.workflow-status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.workflow-status-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
}

.workflow-status-title i {
    font-size: 1.25rem;
}

.workflow-status-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.workflow-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}

.workflow-info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.workflow-info-item .label {
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.8;
}

.workflow-info-item .value {
    font-size: 1rem;
    font-weight: 600;
}

.gdpr-deadline-warning {
    background: rgba(220, 38, 38, 0.1);
    border: 2px solid var(--danger);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
}

.gdpr-deadline-warning i {
    font-size: 1.25rem;
    color: var(--danger);
}

.workflow-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
}

.badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}
/* badge-status-* and badge-nis2-* removed: dead code.
   BadgeExtension::getStatusBadgeClass() returns "badge bg-<color>" —
   styled centrally by Aurora's .badge.bg-* rules. */

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

/* NIS2 Timeline Section */
.nis2-timeline-section {
    background: linear-gradient(135deg, var(--bg) 0%, var(--primary-tint) 100%);
    border-left: 4px solid var(--primary);
    padding: 1.5rem;
    margin: 1.5rem 0;
    border-radius: 8px;
}

.nis2-timeline-section h3 {
    color: var(--primary-strong);
    margin-bottom: 0.5rem;
}

.nis2-timeline-section .text-muted {
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
}

.timeline-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
}

.timeline-stage {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: var(--bs-body-bg);
    border-radius: 8px;
    border: 2px solid var(--bs-border-color);
    transition: all 0.3s ease;
}

.timeline-stage.completed {
    border-color: var(--success);
    background: var(--success-glow);
}

.timeline-stage.overdue {
    border-color: var(--danger);
    background: var(--danger-glow);
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
}

.timeline-stage.pending {
    border-color: var(--primary);
    background: var(--primary-tint);
}

.timeline-icon {
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
}

.timeline-content {
    flex: 1;
}

.timeline-content .fw-bold {
    margin-bottom: 0.5rem;
    display: block;
}

.timeline-deadline {
    font-size: 0.9rem;
    color: var(--bs-secondary-color);
    margin: 0.5rem 0;
}

.timeline-completed {
    padding: 0.5rem;
    background: var(--success-glow);
    border-radius: 4px;
    color: var(--success);
    font-weight: 500;
}

.timeline-overdue {
    padding: 0.5rem;
    background: var(--danger-glow);
    border-radius: 4px;
    color: var(--danger);
    font-weight: 600;
    animation: pulse 2s infinite;
}

.timeline-countdown {
    padding: 0.5rem;
    background: var(--warning-glow);
    border-radius: 4px;
    color: var(--warning-text);
    font-weight: 500;
}

/* NIS2 Impact Grid */
.nis2-impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--bs-border-color);
}

.impact-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.impact-item .label {
    font-size: 0.85rem;
    color: var(--bs-secondary-color);
    font-weight: 500;
}

.impact-item .value {
    font-size: 1rem;
    color: var(--bs-body-color);
}

.impact-item code {
    background: var(--bs-tertiary-bg);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    color: var(--bs-body-color);
}

/* Data Reuse Sections */
.data-reuse-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
}
.data-reuse-item {
    padding: 0.75rem;
    background: var(--bs-tertiary-bg);
    color: var(--bs-body-color);
    border-left: 3px solid var(--primary);
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}
/* .alert and .alert-* — handled centrally in fairy-aurora-components.css */
/* .badge-risk-* removed: dead code, never referenced in markup */

/* Audit log styles: .fa-audit-feed / .fa-audit-row — handled centrally in fairy-aurora-components.css */

.text-danger {
    color: var(--danger);
}

.text-success {
    color: var(--success);
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .timeline-stage {
        flex-direction: column;
    }

    .timeline-icon {
        align-self: flex-start;
    }

    .nis2-impact-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}
