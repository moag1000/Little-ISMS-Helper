{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'quick_fix' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_cyber_field.html.twig' as _fa_cyber %}

{% block admin_title %}{{ 'quick_fix.settings.title'|trans({}, 'quick_fix') }}{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'quick_fix.settings.title'|trans({}, 'quick_fix') }}</li>
{% endblock %}

{% block admin_content %}
    {{ _fa_page_header.render({
        title: 'quick_fix.settings.title'|trans({}, 'quick_fix'),
        subtitle: 'quick_fix.settings.description'|trans({}, 'quick_fix'),
    }) }}

    <div class="row">
        <div class="col-lg-8">
            <section class="fa-section">
                <div class="fa-section__body">
                    <form method="post" action="{{ path('app_admin_quick_fix_settings') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('quick_fix_settings') }}">

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="auto_update" name="auto_update" value="1"
                                   {% if current.auto_update %}checked{% endif %}>
                            <label class="form-check-label fw-semibold" for="auto_update">
                                {{ 'quick_fix.settings.auto_update.label'|trans({}, 'quick_fix') }}
                            </label>
                            <div class="form-text">{{ 'quick_fix.settings.auto_update.help'|trans({}, 'quick_fix') }}</div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="fallback_ui_enabled" name="fallback_ui_enabled" value="1"
                                   {% if current.fallback_ui_enabled %}checked{% endif %}>
                            <label class="form-check-label fw-semibold" for="fallback_ui_enabled">
                                {{ 'quick_fix.settings.fallback_ui_enabled.label'|trans({}, 'quick_fix') }}
                            </label>
                            <div class="form-text">{{ 'quick_fix.settings.fallback_ui_enabled.help'|trans({}, 'quick_fix') }}</div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="require_installer_token" name="require_installer_token" value="1"
                                   {% if current.require_installer_token %}checked{% endif %}>
                            <label class="form-check-label fw-semibold" for="require_installer_token">
                                {{ 'quick_fix.settings.require_installer_token.label'|trans({}, 'quick_fix') }}
                            </label>
                            <div class="form-text">{{ 'quick_fix.settings.require_installer_token.help'|trans({}, 'quick_fix') }}</div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="allow_in_dev_only" name="allow_in_dev_only" value="1"
                                   {% if current.allow_in_dev_only %}checked{% endif %}>
                            <label class="form-check-label fw-semibold" for="allow_in_dev_only">
                                {{ 'quick_fix.settings.allow_in_dev_only.label'|trans({}, 'quick_fix') }}
                            </label>
                            <div class="form-text">{{ 'quick_fix.settings.allow_in_dev_only.help'|trans({}, 'quick_fix') }}</div>
                        </div>

                        <div class="mb-4">
                            {{ _fa_cyber.text('ip_allowlist', {
                                id: 'ip_allowlist',
                                label: 'quick_fix.settings.ip_allowlist.label'|trans({}, 'quick_fix'),
                                value: current.ip_allowlist,
                                placeholder: '10.0.0.1, 192.168.1.5',
                                help: 'quick_fix.settings.ip_allowlist.help'|trans({}, 'quick_fix')
                            }) }}
                        </div>

                        <div class="d-flex gap-2">
                            {% if is_granted('ADMIN_GLOBAL_OP') %}<button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">
                                <i class="fa-icon fa-icon--ui-save" aria-hidden="true"></i>
                                {{ 'quick_fix.settings.save'|trans({}, 'quick_fix') }}
                            </button>{% else %}<p class="small text-muted mb-0">{{ 'admin.global_op.readonly_hint'|trans({}, 'admin') }}</p>{% endif %}
                        </div>
                    </form>
                </div>
            </section>

            {% if is_granted('ROLE_SUPER_ADMIN') %}
            <section class="fa-section mt-4" aria-labelledby="quick-fix-token-title">
                <div class="fa-section__body">
                    <h2 id="quick-fix-token-title" class="h5">{{ 'quick_fix.settings.token.title'|trans({}, 'quick_fix') }}</h2>
                    <p class="text-muted">{{ 'quick_fix.settings.token.body'|trans({}, 'quick_fix') }}</p>
                    {% if quick_fix_link %}
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace" id="quick-fix-link" value="{{ quick_fix_link }}" readonly
                                   aria-label="{{ 'quick_fix.settings.token.link_label'|trans({}, 'quick_fix') }}">
                            <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost"
                                    data-controller="ui-actions" data-action="ui-actions#copyToClipboard"
                                    data-ui-actions-text-param="{{ quick_fix_link }}">
                                {{ 'quick_fix.settings.token.copy'|trans({}, 'quick_fix') }}
                            </button>
                        </div>
                    {% else %}
                        <form method="post" action="{{ path('app_admin_quick_fix_token') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('quick_fix_token') }}">
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">{{ 'quick_fix.settings.token.create'|trans({}, 'quick_fix') }}</button>
                        </form>
                    {% endif %}
                </div>
            </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
