{% extends 'admin/layout.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ module_name(module_key, module.name) }} - {{ 'admin.modules.details'|trans({}, 'admin') }}{% endblock %}

{% block admin_title %}{{ module_name(module_key, module.name) }}{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item"><a href="{{ path('admin_modules_index') }}">{{ 'admin.nav.module_management'|trans({}, 'admin') }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ module_name(module_key, module.name) }}</li>
{% endblock %}

{% block admin_content %}
    {{ _fa_page_header.render({
        badge: { icon: module.icon, label: 'admin.modules.badge_single'|trans({}, 'admin') },
        title: module_name(module_key, module.name),
        subtitle: module_description(module_key, module.description),
        actions: [
            { label: 'common.back_to_overview'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('admin_modules_index') }
        ]
    }) }}

    <div class="row">
        <div class="col-lg-8">
            {# Module Info #}
            <section class="fa-section mb-4">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">
                        <i class="fa-icon fa-icon--ui-info" aria-hidden="true"></i>
                        {{ 'admin.modules.info_title'|trans({}, 'admin') }}
                    </h2>
                    <div class="fa-section__tools">
                        {% if is_active %}
                            <span class="fa-status-pill fa-status-pill--success">{{ 'admin.modules.status.active'|trans({}, 'admin') }}</span>
                        {% else %}
                            <span class="fa-status-pill fa-status-pill--neutral">{{ 'admin.modules.status.inactive'|trans({}, 'admin') }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="fa-section__body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">{{ 'admin.modules.field.description'|trans({}, 'admin') }}</dt>
                        <dd class="col-sm-9">{{ module_description(module_key, module.description) }}</dd>

                        <dt class="col-sm-3">{{ 'admin.modules.field.status'|trans({}, 'admin') }}</dt>
                        <dd class="col-sm-9">
                            {% if module.required %}
                                <span class="fa-status-pill fa-status-pill--warning me-1">{{ 'admin.modules.required'|trans({}, 'admin') }}</span>
                            {% else %}
                                <span class="fa-status-pill fa-status-pill--primary me-1">{{ 'admin.modules.optional'|trans({}, 'admin') }}</span>
                            {% endif %}
                            {% if is_active %}
                                <span class="fa-status-pill fa-status-pill--success">{{ 'admin.modules.status.active'|trans({}, 'admin') }}</span>
                            {% else %}
                                <span class="fa-status-pill fa-status-pill--neutral">{{ 'admin.modules.status.inactive'|trans({}, 'admin') }}</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-3">{{ 'admin.modules.field.entities'|trans({}, 'admin') }}</dt>
                        <dd class="col-sm-9">
                            {% for entity in module.entities %}
                                <span class="fa-status-pill fa-status-pill--neutral me-1">{{ entity }}</span>
                            {% endfor %}
                        </dd>
                    </dl>
                </div>
            </section>

            {# Dependencies #}
            {% if graph.dependencies|length > 0 or graph.dependents|length > 0 %}
                <section class="fa-section mb-4">
                    <div class="fa-section__header">
                        <h2 class="fa-section__title">
                            <i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i>
                            {{ 'admin.modules.dependencies'|trans({}, 'admin') }}
                        </h2>
                    </div>
                    <div class="fa-section__body">
                        {% if graph.dependencies|length > 0 %}
                            <h3 class="h6 mb-2">
                                <i class="fa-icon fa-icon--ui-link text-warning" aria-hidden="true"></i>
                                {{ 'admin.modules.requires_modules'|trans({}, 'admin') }}
                            </h3>
                            <div class="mb-4">
                                {% for dep in graph.dependencies %}
                                    <span class="fa-status-pill fa-status-pill--warning me-2 mb-2">{{ module_name(dep) }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if graph.dependents|length > 0 %}
                            <h3 class="h6 mb-2">
                                <i class="fa-icon fa-icon--util-arrow-right text-info" aria-hidden="true"></i>
                                {{ 'admin.modules.required_by_modules'|trans({}, 'admin') }}
                            </h3>
                            <div>
                                {% for dep in graph.dependents %}
                                    <span class="fa-status-pill fa-status-pill--primary me-2 mb-2">{{ module_name(dep) }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% endif %}

            {# Sample Data #}
            {% if sample_data|length > 0 and is_active %}
                <section class="fa-section mb-4">
                    <div class="fa-section__header">
                        <h2 class="fa-section__title">
                            <i class="fa-icon fa-icon--nav-document" aria-hidden="true"></i>
                            {{ 'admin.modules.sample_data.title'|trans({}, 'admin') }}
                        </h2>
                    </div>
                    <div class="fa-section__body">
                        <form method="post" action="{{ path('admin_modules_import_data', {moduleKey: module_key}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('module_import_' ~ module_key) }}">
                            {% for key, data in sample_data %}
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" name="samples[{{ key }}]" value="1" id="sample_{{ key }}">
                                    <label class="form-check-label" for="sample_{{ key }}">
                                        <strong>{{ module_data_text(data, 'name') }}</strong>
                                        <br>
                                        <small class="text-muted">{{ module_data_text(data, 'description') }}</small>
                                    </label>
                                </div>
                            {% endfor %}
                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary mt-3">
                                <i class="fa-icon fa-icon--nav-download" aria-hidden="true"></i>
                                {{ 'admin.modules.sample_data.import_selected'|trans({}, 'admin') }}
                            </button>
                        </form>
                    </div>
                </section>
            {% endif %}
        </div>

        <div class="col-lg-4">
            {# Actions #}
            <section class="fa-section mb-4">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">
                        <i class="fa-icon fa-icon--nav-tools" aria-hidden="true"></i>
                        {{ 'common.actions'|trans({}, 'messages') }}
                    </h2>
                </div>
                <div class="fa-section__body">
                    <div class="d-grid gap-2">
                        {% if is_active %}
                            {% if not module.required %}
                                <form method="post" action="{{ path('admin_modules_deactivate', {moduleKey: module_key}) }}"
                                      data-controller="ui-actions"
                                      data-action="submit->ui-actions#confirm"
                                      data-ui-actions-message-param="{{ 'admin.modules.confirm_deactivate_named'|trans({'%name%': module_name(module_key, module.name)}, 'admin') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('module_deactivate_' ~ module_key) }}">
                                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--danger w-100">
                                        <i class="fa-icon fa-icon--ui-close" aria-hidden="true"></i>
                                        {{ 'admin.modules.deactivate_module'|trans({}, 'admin') }}
                                    </button>
                                </form>
                            {% else %}
                                <button type="button" class="fa-cyber-btn fa-cyber-btn--ghost" disabled>
                                    <i class="fa-icon fa-icon--ui-lock" aria-hidden="true"></i>
                                    {{ 'admin.modules.is_required'|trans({}, 'admin') }}
                                </button>
                            {% endif %}

                            <a href="{{ path('admin_modules_export', {moduleKey: module_key}) }}" class="fa-cyber-btn fa-cyber-btn--ghost">
                                <i class="fa-icon fa-icon--import" aria-hidden="true"></i>
                                {{ 'admin.modules.export_data'|trans({}, 'admin') }}
                            </a>
                        {% else %}
                            <form method="post" action="{{ path('admin_modules_activate', {moduleKey: module_key}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('module_activate_' ~ module_key) }}">
                                <button type="submit" class="fa-cyber-btn fa-cyber-btn--success w-100">
                                    <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
                                    {{ 'admin.modules.activate_module'|trans({}, 'admin') }}
                                </button>
                            </form>
                        {% endif %}

                        <a href="{{ path('admin_modules_graph') }}" class="fa-cyber-btn fa-cyber-btn--ghost">
                            <i class="fa-icon fa-icon--nav-process" aria-hidden="true"></i>
                            {{ 'admin.modules.dependency_graph'|trans({}, 'admin') }}
                        </a>
                    </div>
                </div>
            </section>

            {# Quick Info #}
            <section class="fa-section">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">
                        <i class="fa-icon fa-icon--ui-lightbulb" aria-hidden="true"></i>
                        {{ 'admin.modules.hints_title'|trans({}, 'admin') }}
                    </h2>
                </div>
                <div class="fa-section__body">
                    <ul class="mb-0 small">
                        {% if module.required %}
                            <li>{{ 'admin.modules.hint.required_cannot_deactivate'|trans({}, 'admin') }}</li>
                        {% endif %}
                        {% if graph.dependents|length > 0 %}
                            <li>{{ 'admin.modules.hint.has_dependents'|trans({}, 'admin') }}</li>
                        {% endif %}
                        <li>{{ 'admin.modules.hint.no_data_deleted'|trans({}, 'admin') }}</li>
                        <li>{{ 'admin.modules.hint.reactivate_anytime'|trans({}, 'admin') }}</li>
                    </ul>
                </div>
            </section>
        </div>
    </div>
{% endblock admin_content %}
