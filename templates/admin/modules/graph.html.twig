{% extends 'admin/layout.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'admin.modules.dependency_graph'|trans({}, 'admin') }} - {{ 'admin.panel.title'|trans({}, 'admin') }}{% endblock %}

{% block admin_title %}{{ 'admin.modules.dependency_graph'|trans({}, 'admin') }}{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item"><a href="{{ path('admin_modules_index') }}">{{ 'admin.nav.module_management'|trans({}, 'admin') }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'admin.modules.dependency_graph'|trans({}, 'admin') }}</li>
{% endblock %}

{% block admin_content %}
    {{ _fa_page_header.render({
        badge: { icon: 'nav-workflow', label: 'admin.modules.badge'|trans({}, 'admin') },
        title: 'admin.modules.graph.title'|trans({}, 'admin'),
        subtitle: 'admin.modules.graph.subtitle'|trans({}, 'admin'),
        actions: [
            { label: 'common.back_to_overview'|trans({}, 'messages'), variant: 'ghost', icon: 'util-arrow-left', href: path('admin_modules_index') }
        ]
    }) }}

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="fa-section">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">{{ 'admin.modules.dependency_graph'|trans({}, 'admin') }}</h2>
                </div>
                <div class="fa-section__body">
                    {% embed '_components/_fa_table.html.twig' %}
                        {% block table_head %}
                            <tr>
                                <th scope="col" class="fa-table__th">{{ 'admin.modules.graph.col.module'|trans({}, 'admin') }}</th>
                                <th scope="col" class="fa-table__th">{{ 'admin.modules.field.status'|trans({}, 'admin') }}</th>
                                <th scope="col" class="fa-table__th">{{ 'admin.modules.graph.col.type'|trans({}, 'admin') }}</th>
                                <th scope="col" class="fa-table__th">{{ 'admin.modules.graph.col.requires'|trans({}, 'admin') }}</th>
                                <th scope="col" class="fa-table__th">{{ 'admin.modules.required_by'|trans({}, 'admin') }}</th>
                            </tr>
                        {% endblock %}
                        {% block table_body %}
                            {% for key, graph in dependency_graph %}
                                <tr class="fa-table__row">
                                    <td class="fa-table__cell">
                                        <strong>{{ module_name(key, graph.name) }}</strong>
                                    </td>
                                    <td class="fa-table__cell">
                                        {% if key in active_modules %}
                                            <span class="fa-status-pill fa-status-pill--success">{{ 'admin.modules.status.active'|trans({}, 'admin') }}</span>
                                        {% else %}
                                            <span class="fa-status-pill fa-status-pill--neutral">{{ 'admin.modules.status.inactive'|trans({}, 'admin') }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="fa-table__cell">
                                        {% if graph.required %}
                                            <span class="fa-status-pill fa-status-pill--warning">{{ 'admin.modules.required'|trans({}, 'admin') }}</span>
                                        {% else %}
                                            <span class="fa-status-pill fa-status-pill--primary">{{ 'admin.modules.optional'|trans({}, 'admin') }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="fa-table__cell">
                                        {% if graph.dependencies|length > 0 %}
                                            {% for dep in graph.dependencies %}
                                                <span class="fa-status-pill fa-status-pill--warning me-1">{{ module_name(dep, dependency_graph[dep].name) }}</span>
                                            {% endfor %}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="fa-table__cell">
                                        {% if graph.dependents|length > 0 %}
                                            {% for dep in graph.dependents %}
                                                <span class="fa-status-pill fa-status-pill--primary me-1">{{ module_name(dep, dependency_graph[dep].name) }}</span>
                                            {% endfor %}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endblock %}
                    {% endembed %}
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="fa-section mb-3">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">{{ 'admin.modules.graph.legend'|trans({}, 'admin') }}</h2>
                </div>
                <div class="fa-section__body">
                    <dl class="mb-0">
                        <dt><span class="fa-status-pill fa-status-pill--success">{{ 'admin.modules.status.active'|trans({}, 'admin') }}</span></dt>
                        <dd>{{ 'admin.modules.graph.legend_active'|trans({}, 'admin') }}</dd>

                        <dt><span class="fa-status-pill fa-status-pill--neutral">{{ 'admin.modules.status.inactive'|trans({}, 'admin') }}</span></dt>
                        <dd>{{ 'admin.modules.graph.legend_inactive'|trans({}, 'admin') }}</dd>

                        <dt><span class="fa-status-pill fa-status-pill--warning">{{ 'admin.modules.required'|trans({}, 'admin') }}</span></dt>
                        <dd>{{ 'admin.modules.graph.legend_required'|trans({}, 'admin') }}</dd>

                        <dt><span class="fa-status-pill fa-status-pill--primary">{{ 'admin.modules.optional'|trans({}, 'admin') }}</span></dt>
                        <dd>{{ 'admin.modules.graph.legend_optional'|trans({}, 'admin') }}</dd>

                        <dt>{{ 'admin.modules.graph.col.requires'|trans({}, 'admin') }}</dt>
                        <dd>{{ 'admin.modules.graph.legend_requires'|trans({}, 'admin') }}</dd>

                        <dt>{{ 'admin.modules.required_by'|trans({}, 'admin') }}</dt>
                        <dd>{{ 'admin.modules.graph.legend_required_by'|trans({}, 'admin') }}</dd>
                    </dl>
                </div>
            </section>

            <section class="fa-section">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">
                        <i class="fa-icon fa-icon--ui-lightbulb" aria-hidden="true"></i>
                        {{ 'admin.modules.hints_title'|trans({}, 'admin') }}
                    </h2>
                </div>
                <div class="fa-section__body">
                    <ul class="mb-0 small">
                        <li>{{ 'admin.modules.hint.auto_dependencies'|trans({}, 'admin') }}</li>
                        <li>{{ 'admin.modules.hint.activate_required'|trans({}, 'admin') }}</li>
                        <li>{{ 'admin.modules.hint.deactivate_dependency'|trans({}, 'admin') }}</li>
                        <li>{{ 'admin.modules.hint.required_always_active'|trans({}, 'admin') }}</li>
                    </ul>
                </div>
            </section>
        </div>
    </div>
{% endblock admin_content %}
