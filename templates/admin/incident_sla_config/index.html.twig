{% extends 'admin/layout.html.twig' %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'incident_sla.title'|trans({}, 'incident_sla') }}{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    {{ _fa_page_header.render({
        title: 'incident_sla.title'|trans({}, 'incident_sla'),
        subtitle: 'incident_sla.subtitle'|trans({}, 'incident_sla'),
    }) }}

    <div class="row">
        <div class="col-lg-10">
            {% embed '_components/_fa_list_page.html.twig' with {
                page: page,
                list_title: 'incident_sla.section.list'|trans({}, 'incident_sla'),
                empty: { mood: 'sleeping', title: 'incident_sla.empty'|trans({}, 'incident_sla') },
            } %}
                {% block list_table %}
                    {% embed '_components/_fa_table.html.twig' with { hover: true, sortable: true } %}
                        {% block table_head %}
                            <tr>
                                <th scope="col" class="fa-table__th fa-table__th--sortable" data-sort-key="severity" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort keydown.space->fa-table-sort#sort">{{ 'incident_sla.field.severity'|trans({}, 'incident_sla') }}</th>
                                <th scope="col" class="fa-table__th fa-table__th--sortable fa-table__th--num" data-sort-key="response" tabindex="0" role="columnheader" aria-sort="none" data-action="click->fa-table-sort#sort keydown.enter->fa-table-sort#sort keydown.space->fa-table-sort#sort">{{ 'incident_sla.field.response_hours'|trans({}, 'incident_sla') }}</th>
                                <th scope="col" class="fa-table__th fa-table__th--num">{{ 'incident_sla.field.escalation_hours'|trans({}, 'incident_sla') }}</th>
                                <th scope="col" class="fa-table__th fa-table__th--num">{{ 'incident_sla.field.resolution_hours'|trans({}, 'incident_sla') }}</th>
                                <th scope="col" class="fa-table__th">{{ 'incident_sla.updated_at'|trans({}, 'incident_sla') }}</th>
                                <th scope="col" class="fa-table__th fa-table__th--actions">{{ 'common.actions'|trans({}, 'messages') }}</th>
                            </tr>
                        {% endblock %}
                        {% block table_body %}
                            {% import '_components/_status_pill.html.twig' as pill %}
                            {% for config in page %}
                                {% set variant = pill_tone_severity(config.severity) %}
                                <tr class="fa-table__row">
                                    <td class="fa-table__cell" data-sort-value="{{ config.severity }}">
                                        {% set _svtone = variant %}
                                        {{ pill.render(('incident_sla.severity.' ~ config.severity)|trans({}, 'incident_sla'), _svtone, {size: 'sm'}) }}
                                    </td>
                                    <td class="fa-table__cell fa-table__cell--num" data-sort-value="{{ config.responseHours }}"><strong>{{ config.responseHours }}h</strong></td>
                                    <td class="fa-table__cell fa-table__cell--num">{{ config.escalationHours ? config.escalationHours ~ 'h' : '—' }}</td>
                                    <td class="fa-table__cell fa-table__cell--num">{{ config.resolutionHours ? config.resolutionHours ~ 'h' : '—' }}</td>
                                    <td class="fa-table__cell fa-table__cell--muted">
                                        {{ config.updatedAt|fa_datetime }}
                                    </td>
                                    <td class="fa-table__cell fa-table__cell--actions">
                                        <a href="{{ path('app_admin_incident_sla_config_edit', {id: config.id}) }}"
                                           class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm"
                                           aria-label="{{ 'common.edit'|trans({}, 'messages') }}">
                                            <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endblock %}
                    {% endembed %}
                {% endblock %}
            {% endembed %}
            {{ _fa_alert.render({ variant: 'info', icon: 'status-info', class: 'small mb-0 mt-3', body: 'incident_sla.hint.regulatory'|trans({}, 'incident_sla') }) }}

            {% if is_module_active('nis2_dora') %}
                <section id="nis2-significance" class="card mt-4">
                    <div class="card-body">
                        <h2 class="h5">{{ 'incident_sla.significance.title'|trans({}, 'incident_sla') }}</h2>
                        <p class="text-muted small">{{ 'incident_sla.significance.hint'|trans({}, 'incident_sla') }}</p>
                        <form method="post" action="{{ path('app_admin_incident_sla_significance') }}" class="row g-3 align-items-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('incident_sla_significance') }}">
                            <div class="col-md-4">
                                <label class="form-label" for="nis2-financial-loss">{{ 'incident_sla.significance.financial_loss_eur'|trans({}, 'incident_sla') }}</label>
                                <input type="number" min="1" step="1" class="form-control" id="nis2-financial-loss" name="financial_loss_eur" value="{{ nis2_significance.financial_loss_eur }}" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="nis2-affected-persons">{{ 'incident_sla.significance.affected_persons'|trans({}, 'incident_sla') }}</label>
                                <input type="number" min="1" step="1" class="form-control" id="nis2-affected-persons" name="affected_persons" value="{{ nis2_significance.affected_persons }}" required>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">{{ 'common.save'|trans({}, 'messages') }}</button>
                            </div>
                        </form>
                    </div>
                </section>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
