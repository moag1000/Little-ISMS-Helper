{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'notification' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'notification.rule.index.title'|trans }}{% endblock %}
{% block admin_title %}{{ 'notification.rule.index.title'|trans }}{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'notification.rule.index.title'|trans }}</li>
{% endblock %}

{% block admin_content %}
    {{ _fa_page_header.render({
        title: 'notification.rule.index.title'|trans,
        subtitle: 'notification.rule.index.subtitle'|trans,
        actions: [
            {
                label: 'notification.rule.action.new'|trans,
                variant: 'primary',
                icon: 'plus',
                href: path('admin_notification_rule_new')
            },
            {
                label: 'notification.template.action.gallery'|trans,
                variant: 'ghost',
                icon: 'grid',
                href: path('admin_notification_template_index')
            }
        ]
    }) }}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('admin_notification_rule_index'),
        list_title: 'notification.rule.list'|trans({}, 'notification'),
        empty: {
            mood: 'thinking',
            title: 'notification.rule.empty.title'|trans({}, 'notification'),
            actions: [{ label: 'notification.rule.action.new'|trans({}, 'notification'), href: path('admin_notification_rule_new'), variant: 'primary' }],
        },
    } %}
        {% block list_summary %}
            {% if active_count > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'notification.rule.summary.active'|trans({'%count%': active_count}, 'notification') }}</span>{% endif %}
            {% if inactive_count > 0 %}<span class="fa-status-pill fa-status-pill--neutral">{{ 'notification.rule.summary.inactive'|trans({'%count%': inactive_count}, 'notification') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            <div class="table-responsive">
                    <table class="fa-table" aria-label="{{ 'notification.rule.list'|trans({}, 'notification') }}">
                        <thead>
                            <tr>
                                <th>{{ 'notification.rule.field.name'|trans({}, 'notification') }}</th>
                                <th>{{ 'notification.rule.field.event_type'|trans({}, 'notification') }}</th>
                                <th>{{ 'notification.rule.field.severity_filter'|trans({}, 'notification') }}</th>
                                <th>{{ 'notification.rule.field.is_active'|trans({}, 'notification') }}</th>
                                <th class="text-end">{{ 'notification.rule.field.evaluation_count'|trans({}, 'notification') }}</th>
                                <th>{{ 'common.actions'|trans({}, 'messages') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for rule in page %}
                            <tr>
                                <td>
                                    <a href="{{ path('admin_notification_rule_show', { id: rule.id }) }}" class="fw-semibold">
                                        {{ rule.name }}
                                    </a>
                                </td>
                                <td>
                                    <span class="fa-status-pill fa-status-pill--neutral">{{ rule.eventType }}</span>
                                </td>
                                <td>
                                    {% if rule.severityFilter %}
                                        <span class="fa-status-pill fa-status-pill--warning">{{ ('notification.severity.' ~ rule.severityFilter)|trans({}, 'notification') }}</span>
                                    {% else %}
                                        <span class="text-muted fst-italic">{{ 'notification.severity.all'|trans({}, 'notification') }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if rule.isActive %}
                                        <span class="fa-status-pill fa-status-pill--success">{{ 'common.active'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="fa-status-pill fa-status-pill--neutral">{{ 'common.inactive'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">{{ rule.evaluationCount }}</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('admin_notification_rule_edit', { id: rule.id }) }}"
                                           class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost"
                                           title="{{ 'common.edit'|trans({}, 'messages') }}">
                                            <i class="fa-icon fa-icon--edit" aria-hidden="true"></i>
                                        </a>
                                        <form method="post"
                                              action="{{ path('admin_notification_rule_toggle', { id: rule.id }) }}"
                                              class="d-inline">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('notification_rule_toggle_' ~ rule.id) }}">
                                            <button type="submit"
                                                    class="fa-cyber-btn fa-cyber-btn--sm {{ rule.isActive ? 'fa-cyber-btn--warning' : 'fa-cyber-btn--success' }}"
                                                    title="{{ (rule.isActive ? 'notification.rule.action.disable' : 'notification.rule.action.enable')|trans({}, 'notification') }}">
                                                <i class="fa-icon {{ rule.isActive ? 'fa-icon--pause' : 'fa-icon--play' }}" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                        <form method="post"
                                              action="{{ path('admin_notification_rule_delete', { id: rule.id }) }}"
                                              class="d-inline"
                                              data-controller="ui-actions"
                      data-action="submit->ui-actions#confirm"
                      data-ui-actions-message-param="{{ 'notification.rule.confirm.delete'|trans({}, 'notification') }}"
                      data-ui-actions-tone-param="danger">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('notification_rule_delete_' ~ rule.id) }}">
                                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--danger"
                                                    title="{{ 'common.delete'|trans({}, 'messages') }}">
                                                <i class="fa-icon fa-icon--trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
