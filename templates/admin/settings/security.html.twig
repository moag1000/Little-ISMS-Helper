{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'admin'%}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}
{% block admin_title %}{{ 'admin.settings.security.title'|trans({}, 'admin') }}{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item"><a href="{{ path('admin_settings_index') }}">{{ 'admin.settings.title'|trans({}, 'admin') }}</a></li>
    <li class="breadcrumb-item active">{{ 'admin.settings.security.title'|trans({}, 'admin') }}</li>
{% endblock %}

{% block admin_content %}
    {{ _fa_page_header.render({
        title: 'admin.settings.security.title'|trans({}, 'admin'),
    }) }}

    <div class="row">
        <div class="col-lg-8">
            <section class="fa-section">
                <div class="fa-section__header">
                    <h2 class="fa-section__title">
                        <i class="fa-icon fa-icon--mfa text-danger" aria-hidden="true"></i>
                        {{ 'admin.settings.security.title'|trans({}, 'admin') }}
                    </h2>
                </div>
                <div class="fa-section__body">
                    {{ form_start(form) }}
                        {# Strict_whitelist — security settings must not
                           leak any new auth field without explicit review. #}
                        {% include '_components/_auto_form.html.twig' with {
                            form: form,
                            strict_whitelist: true,
                            sections: {
                                'password_policy': {
                                    'label': 'admin.settings.security.password_settings'|trans({}, 'admin'),
                                    fields: ['password_min_length']
                                }
                            },
                            'col_widths': {
                                'password_min_length': 12
                            },
                            'translation_domain': 'admin'
                        } %}

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('admin_settings_index') }}" class="fa-cyber-btn fa-cyber-btn--ghost">
                                <i class="fa-icon fa-icon--util-arrow-left" aria-hidden="true"></i> {{ 'common.back'|trans({}, 'messages') }}
                            </a>
                            {% if is_granted('ADMIN_GLOBAL_OP') %}<button type="submit" class="fa-cyber-btn fa-cyber-btn--danger">
                                <i class="fa-icon fa-icon--ui-save" aria-hidden="true"></i> {{ 'common.save'|trans({}, 'messages') }}
                            </button>{% else %}<p class="small text-muted mb-0">{{ 'admin.global_op.readonly_hint'|trans({}, 'admin') }}</p>{% endif %}
                        </div>
                    {{ form_end(form) }}
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            {{ _fa_alert.render({ variant: 'info', title: 'admin.settings.security.mfa_policy_title'|trans({}, 'admin'), body: 'admin.settings.security.mfa_policy_hint'|trans({}, 'admin') }) }}
            <p class="mb-4">
                <a href="{{ path('admin_tenant_compliance_settings_current') }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">{{ 'admin.settings.security.mfa_policy_link'|trans({}, 'admin') }}</a>
            </p>
            {{ _fa_alert.render({ variant: 'warning', title: 'common.warning'|trans({}, 'messages'), body: 'admin.settings.security.warning'|trans({}, 'admin') }) }}
        </div>
    </div>
{% endblock %}
