{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'admin' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'admin.legacy_owners.title'|trans({}, 'admin') }}{% endblock %}

{% block admin_title %}
    <i class="fa-icon fa-icon--ui-person" aria-hidden="true"></i> {{ 'admin.legacy_owners.title'|trans({}, 'admin') }}
{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.admin'|trans({}, 'nav'), url: path('admin_dashboard') },
            { label: 'admin.data_repair.title'|trans({}, 'admin'), url: path('admin_data_repair_index') },
            { label: 'admin.legacy_owners.title'|trans({}, 'admin') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'admin.legacy_owners.title'|trans({}, 'admin'),
        subtitle: 'admin.legacy_owners.subtitle'|trans({}, 'admin'),
    }) }}

    {# Hidden fields that bring every POST back to the same filtered list #}
    {% set _keep %}
        <input type="hidden" name="_token" value="{{ csrf_token('legacy_owner') }}">
        {% if filterType %}<input type="hidden" name="type" value="{{ filterType }}">{% endif %}
        {% if filterMatch %}<input type="hidden" name="match" value="{{ filterMatch }}">{% endif %}
        {% if page.search %}<input type="hidden" name="q" value="{{ page.search }}">{% endif %}
    {% endset %}

    {% if withSuggestion > 0 %}
        <div class="d-flex justify-content-end mb-3">
            <form method="post" action="{{ path('admin_legacy_owner_apply_all') }}"
                  data-controller="ui-actions"
                  data-action="submit->ui-actions#confirm"
                  data-ui-actions-message-param="{{ 'admin.legacy_owners.apply_all_confirm'|trans({'%count%': withSuggestion}, 'admin') }}">
                {{ _keep }}
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm">
                    <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
                    {{ 'admin.legacy_owners.apply_all'|trans({'%count%': withSuggestion}, 'admin') }}
                </button>
            </form>
        </div>
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('admin_legacy_owner_index'),
        filter_keys: ['type', 'match'],
        list_title: 'admin.legacy_owners.list'|trans({}, 'admin'),
        empty: { mood: 'happy', title: 'admin.legacy_owners.empty'|trans({}, 'admin') },
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label class="form-label" for="legacy-owner-type">{{ 'admin.legacy_owners.filter.type'|trans({}, 'admin') }}</label>
                <select name="type" id="legacy-owner-type" class="form-select fa-cyber-input__field">
                    <option value="">{{ 'admin.legacy_owners.filter.all'|trans({}, 'admin') }}</option>
                    {% for t in types %}
                        <option value="{{ t }}" {% if filterType == t %}selected{% endif %}>{{ ('admin.legacy_owners.type.' ~ t)|trans({}, 'admin') }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="legacy-owner-match">{{ 'admin.legacy_owners.filter.match'|trans({}, 'admin') }}</label>
                <select name="match" id="legacy-owner-match" class="form-select fa-cyber-input__field">
                    <option value="">{{ 'admin.legacy_owners.filter.all'|trans({}, 'admin') }}</option>
                    <option value="suggested" {% if filterMatch == 'suggested' %}selected{% endif %}>{{ 'admin.legacy_owners.filter.suggested'|trans({}, 'admin') }}</option>
                    <option value="none" {% if filterMatch == 'none' %}selected{% endif %}>{{ 'admin.legacy_owners.filter.none'|trans({}, 'admin') }}</option>
                </select>
            </div>
        {% endblock %}
        {% block list_summary %}
            {% if withSuggestion > 0 %}<span class="fa-status-pill fa-status-pill--success">{{ 'admin.legacy_owners.summary.suggested'|trans({'%count%': withSuggestion}, 'admin') }}</span>{% endif %}
        {% endblock %}
        {% block list_table %}
            {% embed '_components/_fa_table.html.twig' %}
                {% block table_head %}
                    <tr>
                        <th scope="col" class="fa-table__th">{{ 'admin.legacy_owners.col.record'|trans({}, 'admin') }}</th>
                        <th scope="col" class="fa-table__th">{{ 'admin.legacy_owners.col.text'|trans({}, 'admin') }}</th>
                        {% if multiTenant %}<th scope="col" class="fa-table__th">{{ 'admin.legacy_owners.col.tenant'|trans({}, 'admin') }}</th>{% endif %}
                        <th scope="col" class="fa-table__th">{{ 'admin.legacy_owners.col.suggestion'|trans({}, 'admin') }}</th>
                        <th scope="col" class="fa-table__th fa-table__th--actions"><span class="visually-hidden">{{ 'admin.legacy_owners.col.actions'|trans({}, 'admin') }}</span></th>
                    </tr>
                {% endblock %}
                {% block table_body %}
                    {% import '_components/_status_pill.html.twig' as pill %}
                    {% for row in page %}
                        <tr class="fa-table__row">
                            <td class="fa-table__cell">
                                <div class="small text-body-secondary">{{ ('admin.legacy_owners.type.' ~ row.type)|trans({}, 'admin') }}</div>
                                <a href="{{ path(row.editRoute, {id: row.id}) }}">{{ row.title }}</a>
                            </td>
                            <td class="fa-table__cell">{{ row.legacy }}</td>
                            {% if multiTenant %}<td class="fa-table__cell">{{ row.tenant ? row.tenant.name : '—' }}</td>{% endif %}
                            <td class="fa-table__cell">
                                {% if row.suggestion %}
                                    {{ row.suggestionName }}
                                    {{ pill.render(row.suggestionIsUser ? 'admin.legacy_owners.kind.user'|trans({}, 'admin') : 'admin.legacy_owners.kind.person'|trans({}, 'admin'), row.suggestionIsUser ? 'primary' : 'neutral', {size: 'sm', class: 'ms-1'}) }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="fa-table__cell fa-table__cell--actions">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    {% if row.suggestion %}
                                        <form method="post" action="{{ path('admin_legacy_owner_apply', {type: row.type, id: row.id}) }}">
                                            {{ _keep }}
                                            <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm">
                                                <i class="fa-icon fa-icon--ui-check" aria-hidden="true"></i>
                                                {{ 'admin.legacy_owners.apply'|trans({}, 'admin') }}
                                            </button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="{{ path('admin_legacy_owner_person', {type: row.type, id: row.id}) }}"
                                          data-controller="ui-actions"
                                          data-action="submit->ui-actions#confirm"
                                          data-ui-actions-message-param="{{ 'admin.legacy_owners.person_confirm'|trans({'%name%': row.legacy}, 'admin') }}">
                                        {{ _keep }}
                                        <button type="submit" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                                            {{ 'admin.legacy_owners.as_person'|trans({}, 'admin') }}
                                        </button>
                                    </form>
                                    <a href="{{ path(row.editRoute, {id: row.id}) }}" class="fa-cyber-btn fa-cyber-btn--ghost fa-cyber-btn--sm">
                                        {{ 'admin.legacy_owners.edit'|trans({}, 'admin') }}
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
