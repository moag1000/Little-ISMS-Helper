{% extends 'admin/layout.html.twig' %} {# show-skeleton: no record — regulatory workflow definition from YAML, no entity #}
{% trans_default_domain 'admin' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alert.html.twig' as _fa_alert %}

{% block admin_title %}{{ 'admin.workflows.show.title'|trans({ '%workflow%': workflowName }, 'admin') }}{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin_workflow_overlay_index') }}">{{ 'admin.workflows.title'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ workflowName }}</li>
{% endblock %}

{% block admin_content %}
    {{ _fa_page_header.render({
        badge: { icon: 'nav-workflow', label: isRegulatory ? 'Regulatory' : 'Lifecycle' },
        title: workflowName,
        subtitle: 'admin.workflows.show.subtitle'|trans,
        actions: [
            {
                label: 'admin.workflows.action.back'|trans,
                href: path('admin_workflow_overlay_index'),
                icon: 'ui-arrow-left',
                variant: 'ghost',
            }
        ],
    }) }}

    <div class="row">
        <div class="col-lg-10">
            {% if steps is empty %}
                {{ _fa_alert.render({
                    variant: 'warning',
                    icon: 'status-warning',
                    body: 'admin.workflows.no_steps'|trans,
                }) }}
                {% if not isRegulatory %}
                    {{ _fa_alert.render({
                        variant: 'info',
                        icon: 'status-info',
                        class: 'mt-2',
                        body: 'admin.workflows.hint.lifecycle_has_transitions'|trans,
                    }) }}
                    <div class="mt-3">
                        <a href="{{ path('admin_lifecycle_overrides_show', {workflowName: workflowName}) }}"
                           class="fa-cyber-btn fa-cyber-btn--primary">
                            <i class="fa-icon fa-icon--nav-workflow" aria-hidden="true"></i>
                            {{ 'admin.workflows.action.edit_transitions'|trans }}
                        </a>
                    </div>
                {% endif %}
            {% else %}
                <section class="fa-section">
                    <div class="fa-section__header">
                        <h2 class="fa-section__title">
                            <i class="fa-icon fa-icon--nav-list-ordered" aria-hidden="true"></i>
                            {{ 'admin.workflows.section.steps'|trans }}
                        </h2>
                        <p class="fa-section__desc text-muted small mb-0">
                            {{ 'admin.workflows.section.steps_desc'|trans({ '%count%': steps|length }, 'admin') }}
                        </p>
                    </div>
                    <div class="fa-section__body">
                        {% embed '_components/_fa_table.html.twig' with { hover: true } %}
                            {% block table_head %}
                                {% trans_default_domain 'admin' %}
                                <tr>
                                    <th scope="col" class="fa-table__th fa-table__th--num" style="width:3rem">#</th>
                                    <th scope="col" class="fa-table__th">{{ 'admin.workflows.col.step_name'|trans }}</th>
                                    <th scope="col" class="fa-table__th">{{ 'admin.workflows.col.approver_role'|trans }}</th>
                                    <th scope="col" class="fa-table__th fa-table__th--num">{{ 'admin.workflows.col.days'|trans }}</th>
                                </tr>
                            {% endblock %}
                            {% block table_body %}
                                {% trans_default_domain 'admin' %}
                                {% for step in steps %}
                                    <tr class="fa-table__row">
                                        <td class="fa-table__cell fa-table__cell--num text-muted">
                                            {{ step.index + 1 }}
                                        </td>
                                        <td class="fa-table__cell">
                                            <strong>{{ step.yaml.name ?? ('admin.workflows.step.unnamed'|trans) }}</strong>
                                            {% if (step.yaml.step_type ?? 'approval') == 'notification' %}
                                                <span class="fa-status-pill fa-status-pill--neutral fa-status-pill--sm ms-1">{{ 'admin.workflows.step.notification'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="fa-table__cell">
                                            {% set role = step.yaml.approver_role ?? null %}
                                            {% if role == 'owner' %}
                                                {{ 'admin.workflows.step.owner'|trans }}
                                            {% elseif role %}
                                                <code class="text-primary small">{{ role }}</code>
                                            {% else %}
                                                <span class="fa-table__cell--muted">—</span>
                                            {% endif %}
                                        </td>
                                        <td class="fa-table__cell fa-table__cell--num">
                                            {{ step.yaml.days_to_complete ?? '—' }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endblock %}
                        {% endembed %}
                        {{ _fa_alert.render({
                            variant: 'info',
                            icon: 'status-info',
                            class: 'mt-3 small',
                            body: 'admin.workflows.hint.who_approves'|trans,
                        }) }}
                    </div>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
