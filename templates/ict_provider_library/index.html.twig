{% extends 'base.html.twig' %}
{% trans_default_domain 'suppliers' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}

{% block title %}{{ 'supplier.ict_library.title'|trans({}, 'suppliers') }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [{ label: 'supplier.ict_library.title'|trans({}, 'suppliers') }]
    } %}

    {{ _fa_page_header.render({
        title: 'supplier.ict_library.title'|trans({}, 'suppliers'),
        subtitle: 'supplier.ict_library.intro'|trans({}, 'suppliers')
    }) }}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('ict_provider_library_index'),
        filter_keys: ['category'],
        list_title: 'supplier.ict_library.list'|trans({}, 'suppliers'),
        empty: { mood: 'sleeping', title: 'supplier.ict_library.empty'|trans({}, 'suppliers') },
    } %}
        {% block list_filters %}
            <div class="col-md-4">
                <label for="category-filter" class="form-label">{{ 'supplier.ict_library.field.category'|trans({}, 'suppliers') }}</label>
                <select class="form-select fa-cyber-input__field" id="category-filter" name="category" data-controller="ui-actions" data-action="change->ui-actions#autoSubmit">
                    <option value=""></option>
                    {% for key in ['cloud_iaas', 'cloud_saas', 'network', 'identity', 'data', 'security', 'payment', 'communications'] %}
                        <option value="{{ key }}" {{ category == key ? 'selected' : '' }}>{{ ('supplier.ict_library.category.' ~ key)|trans({}, 'suppliers') }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endblock %}
        {% block list_table %}
            <table class="fa-table fa-table--hover">
                <thead class="fa-table__head">
                    <tr>
                        <th class="fa-table__th" scope="col">{{ 'supplier.ict_library.field.name'|trans({}, 'suppliers') }}</th>
                        <th class="fa-table__th" scope="col">{{ 'supplier.ict_library.field.category'|trans({}, 'suppliers') }}</th>
                        <th class="fa-table__th" scope="col">{{ 'supplier.ict_library.field.country'|trans({}, 'suppliers') }}</th>
                        <th scope="col" class="fa-table__th fa-table__th--actions">{{ 'common.actions'|trans({}, 'messages') }}</th>
                    </tr>
                </thead>
                <tbody class="fa-table__body">
                    {% for entry in page %}
                        <tr class="fa-table__row">
                            <td class="fa-table__cell">
                                <strong>{{ entry.name }}</strong>
                                {% if entry.eeaHosted %}<span class="fa-status-pill fa-status-pill--success">EEA</span>{% endif %}
                                <div class="text-body-secondary small">{{ entry.serviceType }}</div>
                            </td>
                            <td class="fa-table__cell">{{ ('supplier.ict_library.category.' ~ entry.category)|trans({}, 'suppliers') }}</td>
                            <td class="fa-table__cell">{{ entry.headquartersCountry ?? '—' }}</td>
                            <td class="fa-table__cell fa-table__cell--actions">
                                <form method="post" action="{{ path('ict_provider_library_apply', {id: entry.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('ict_provider_library_apply') }}">
                                    <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary fa-cyber-btn--sm">
                                        {{ 'supplier.ict_library.action.apply'|trans({}, 'suppliers') }}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
