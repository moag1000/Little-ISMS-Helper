{% extends 'base.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% import '_components/_fa_table.html.twig' as _fa_table %}

{% block title %}{{ 'bsi_200_4_exercise.page.index_title'|trans({}, 'bsi_200_4_exercise') }}{% endblock %}

{% block body %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.bcm'|trans({}, 'nav'), url: path('app_bcm_index') },
            { label: 'nav.bc_exercises'|trans({}, 'nav'), url: path('app_bc_exercise_index') },
            { label: 'bsi_200_4_exercise.nav.exercise_log'|trans({}, 'bsi_200_4_exercise') }
        ]
    } %}

    {{ _fa_page_header.render({
        title: 'bsi_200_4_exercise.page.index_title'|trans({}, 'bsi_200_4_exercise'),
        subtitle: 'bsi_200_4_exercise.page.index_subtitle'|trans({}, 'bsi_200_4_exercise'),
        actions: [
            { label: 'bsi_200_4_exercise.nav.exercise_log_calendar'|trans({}, 'bsi_200_4_exercise'), href: path('bcm_exercise_log_calendar'), variant: 'secondary', icon: 'ui-calendar' }
        ]
    }) }}
    {% include '_components/_focus_filter_notice.html.twig' with { focus: focus|default(null), count: page.total } %}

    {# Alva hints #}
    {% set _hints = alva_hints('bcm_exercise_log_index') %}
    {% for _h in _hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}

    {# Overdue warning #}
    {% if overdueCount > 0 %}
    {% import '_components/_fa_alert.html.twig' as _fa_alert %}
    {{ _fa_alert.render({ variant: 'warning', body: 'alva.improvement_action_overdue.body'|trans({'%count%': overdueCount, '%log_count%': page.total}, 'bsi_200_4_exercise'), class: 'mb-4' }) }}
    {% endif %}

    {% embed '_components/_fa_list_page.html.twig' with {
        page: page,
        search_action: path('bcm_exercise_log_index'),
        filter_keys: ['focus'],
        list_title: 'bsi_200_4_exercise.page.index_title'|trans({}, 'bsi_200_4_exercise'),
        empty: {
            mood: 'sleeping',
            title: 'bsi_200_4_exercise.empty_state.title'|trans({}, 'bsi_200_4_exercise'),
            text: 'bsi_200_4_exercise.empty_state.body'|trans({}, 'bsi_200_4_exercise'),
            actions: [
                { label: 'bsi_200_4_exercise.empty_state.action'|trans({}, 'bsi_200_4_exercise'), variant: 'primary', href: path('app_bc_exercise_index') }
            ]
        },
    } %}
        {% block list_table %}
                {% embed '_components/_fa_table.html.twig' with {
                    id: 'exercise-log-list-table',
                    class: 'mb-0'
                } %}
                    {% block table_head %}
                        <tr>
                            <th scope="col" class="fa-table__th">{{ 'bsi_200_4_exercise.table.header_exercise'|trans({}, 'bsi_200_4_exercise') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'bsi_200_4_exercise.table.header_type'|trans({}, 'bsi_200_4_exercise') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'bsi_200_4_exercise.table.header_template'|trans({}, 'bsi_200_4_exercise') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'bsi_200_4_exercise.table.header_status'|trans({}, 'bsi_200_4_exercise') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'bsi_200_4_exercise.table.header_rating'|trans({}, 'bsi_200_4_exercise') }}</th>
                            <th scope="col" class="fa-table__th">{{ 'bsi_200_4_exercise.table.header_submitted'|trans({}, 'bsi_200_4_exercise') }}</th>
                            <th scope="col" class="fa-table__th fa-table__th--actions">{{ 'bsi_200_4_exercise.table.header_actions'|trans({}, 'bsi_200_4_exercise') }}</th>
                        </tr>
                    {% endblock %}
                                        {% block table_body %}
                        {% for log in page %}
                        <tr class="fa-table__row">
                            <td class="fa-table__cell">
                                <a href="{{ path('bcm_exercise_log_show', {id: log.id}) }}" class="fw-semibold text-decoration-none">
                                    {{ log.bcExercise.name ?? '—' }}
                                </a>
                                {% if log.hasOverdueImprovementActions %}
                                    <span class="fa-status-pill fa-status-pill--warning ms-1" title="{{ 'alva.improvement_action_overdue.title'|trans({}, 'bsi_200_4_exercise') }}">
                                        <i class="fa-icon fa-icon--status-warning" aria-hidden="true"></i>
                                    </span>
                                {% endif %}
                            </td>
                            <td class="fa-table__cell">
                                <span class="fa-status-pill fa-status-pill--neutral">{{ ('bsi_200_4_exercise.exercise_type.' ~ log.exerciseType)|trans({}, 'bsi_200_4_exercise') }}</span>
                            </td>
                            <td class="fa-table__cell">{{ ('bsi_200_4_exercise.template.' ~ log.bsi2004Template)|trans({}, 'bsi_200_4_exercise') }}</td>
                            <td class="fa-table__cell">
                                {% if log.isConfirmed %}
                                    <span class="fa-status-pill fa-status-pill--success">{{ 'bsi_200_4_exercise.status.confirmed'|trans({}, 'bsi_200_4_exercise') }}</span>
                                {% elseif log.isSubmitted %}
                                    <span class="fa-status-pill fa-status-pill--primary">{{ 'bsi_200_4_exercise.status.submitted'|trans({}, 'bsi_200_4_exercise') }}</span>
                                {% else %}
                                    <span class="fa-status-pill fa-status-pill--neutral text-muted border">{{ 'bsi_200_4_exercise.status.draft'|trans({}, 'bsi_200_4_exercise') }}</span>
                                {% endif %}
                            </td>
                            <td class="fa-table__cell">
                                {% if log.overallRating %}
                                    {{ ('bsi_200_4_exercise.rating.' ~ log.overallRating)|trans({}, 'bsi_200_4_exercise') }}
                                {% else %}—{% endif %}
                            </td>
                            <td class="fa-table__cell">{{ log.submittedAt|fa_date }}</td>
                            <td class="fa-table__cell fa-table__cell--actions">
                                <a href="{{ path('bcm_exercise_log_show', {id: log.id}) }}" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost">
                                    <i class="fa-icon fa-icon--ui-eye" aria-hidden="true"></i>
                                </a>
                                {% if not log.isSubmitted %}
                                <a href="{{ path('bcm_exercise_log_edit', {id: log.id}) }}" class="fa-cyber-btn fa-cyber-btn--sm fa-cyber-btn--ghost">
                                    <i class="fa-icon fa-icon--ui-edit" aria-hidden="true"></i>
                                </a>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}
