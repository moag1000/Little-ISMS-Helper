{% extends 'base.html.twig' %}
{% import '_components/_fa_page_header.html.twig' as _fa_page_header %}
{% import '_components/_fa_alva_hint.html.twig' as _fa_alva_hint %}
{% import '_components/_fa_status_band.html.twig' as _fa_status_band %}
{% import '_components/_fa_anchor_bar.html.twig' as _fa_anchor_bar %}

{% block title %}{{ 'bsi_200_4_exercise.page.show_title'|trans({}, 'bsi_200_4_exercise') }} — {{ log.bcExercise.name ?? '' }}{% endblock %}

{% block body %}
<div class="container">
    {% include '_components/_breadcrumb.html.twig' with {
        breadcrumbs: [
            { label: 'nav.bcm'|trans({}, 'nav'), url: path('app_bcm_index') },
            { label: 'nav.bc_exercises'|trans({}, 'nav'), url: path('app_bc_exercise_index') },
            { label: 'bsi_200_4_exercise.nav.exercise_log'|trans({}, 'bsi_200_4_exercise'), url: path('bcm_exercise_log_index') },
            { label: log.bcExercise.name ?? 'Log' }
        ]
    } %}

    {{ _fa_page_header.render({
        title: log.bcExercise.name ?? 'bsi_200_4_exercise.page.show_title'|trans({}, 'bsi_200_4_exercise'),
        subtitle: ('bsi_200_4_exercise.exercise_type.' ~ log.exerciseType)|trans({}, 'bsi_200_4_exercise') ~ ' · ' ~ ('bsi_200_4_exercise.template.' ~ log.bsi2004Template)|trans({}, 'bsi_200_4_exercise'),
        actions: [
            not log.isSubmitted ? {
                label: 'bsi_200_4_exercise.action.saved'|trans({}, 'bsi_200_4_exercise'),
                href: path('bcm_exercise_log_edit', {id: log.id}),
                variant: 'primary',
                icon: 'ui-edit'
            } : null
        ]|filter(a => a is not null)
    }) }}

    {# Alva hints #}
    {% set _hints = alva_hints('bcm_exercise_log_show') %}
    {% for _h in _hints %}
        {{ _fa_alva_hint.render(_h) }}
    {% endfor %}

    {# Status band: lifecycle state + submit / confirm action #}
    {% set _status %}
        {% if log.isConfirmed %}
            <span class="fa-status-pill fa-status-pill--success">{{ 'bsi_200_4_exercise.status.confirmed'|trans({}, 'bsi_200_4_exercise') }}</span>
        {% elseif log.isSubmitted %}
            <span class="fa-status-pill fa-status-pill--info">{{ 'bsi_200_4_exercise.status.submitted'|trans({}, 'bsi_200_4_exercise') }}</span>
        {% else %}
            <span class="fa-status-pill fa-status-pill--neutral">{{ 'bsi_200_4_exercise.status.draft'|trans({}, 'bsi_200_4_exercise') }}</span>
        {% endif %}
    {% endset %}
    {% set _actions %}
        {% if log.isSubmitted and not log.isConfirmed and is_granted('ROLE_AUDITOR') %}
            <form method="post" action="{{ path('bcm_exercise_log_confirm', {id: log.id}) }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('bsi_log_confirm_' ~ log.id) }}">
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--success">
                    <i class="fa-icon fa-icon--status-ok" aria-hidden="true"></i>
                    {{ 'bsi_200_4_exercise.action.confirmed'|trans({}, 'bsi_200_4_exercise') }}
                </button>
            </form>
        {% elseif not log.isSubmitted and is_granted('ROLE_MANAGER') %}
            <form method="post" action="{{ path('bcm_exercise_log_submit', {id: log.id}) }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('bsi_log_submit_' ~ log.id) }}">
                <button type="submit" class="fa-cyber-btn fa-cyber-btn--primary">
                    <i class="fa-icon fa-icon--send" aria-hidden="true"></i>
                    {{ 'bsi_200_4_exercise.action.submitted'|trans({}, 'bsi_200_4_exercise') }}
                </button>
            </form>
        {% endif %}
    {% endset %}
    {{ _fa_status_band.render({
        status: _status,
        actions: _actions,
        facts: [
            { label: 'bsi_200_4_exercise.table.header_submitted'|trans({}, 'bsi_200_4_exercise'), value: log.isSubmitted and log.submittedAt ? log.submittedAt|fa_datetime : null },
            { label: 'bsi_200_4_exercise.table.header_confirmed'|trans({}, 'bsi_200_4_exercise'), value: log.isConfirmed and log.confirmedAt ? log.confirmedAt|fa_datetime : null },
        ],
        workflow: workflow_state(log),
    }) }}

    {% set _links = entity_links(log) %}
    {{ _fa_anchor_bar.render([
        { id: 'links', label: 'show.anchor.links'|trans({}, 'messages'), show: _links is not empty },
        { id: 'details', label: 'show.anchor.details'|trans({}, 'messages') },
        { id: 'history', label: 'show.anchor.history'|trans({}, 'messages') },
    ]) }}

    {% include '_components/_fa_entity_links.html.twig' with { entity: log } only %}

    <div id="details" class="fa-show-section">
        {% include 'bcm/exercise_log/_log_details.html.twig' with { log: log } %}
    </div>

    {% include '_components/_fa_show_history.html.twig' with { entity: log } only %}
</div>
{% endblock %}
