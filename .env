# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
# Default to production - use .env.local or docker-compose.dev.yml for development
APP_ENV=prod
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# Production: the public address (https://isms.example.org). Every link in e-mails,
# supplier questionnaires, Trust Center and QR labels is built from it, never from the
# Host header of a request (App\Http\PublicUrlGenerator).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> trusted hosts ###
# Host names this installation answers to, as comma-separated anchored regexes, e.g.
# SYMFONY_TRUSTED_HOSTS='^isms\.example\.org$,^localhost$'
# Any other Host header gets 400. Empty = every host accepted (development only).
SYMFONY_TRUSTED_HOSTS=
###< trusted hosts ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Database connection settings (configure in .env.local)
# NOTE: Passwords with special characters (!, @, #, $, %, etc.) are safe to use here.
#       Symfony's variable interpolation will automatically URL-encode them when building DATABASE_URL.
#       Just store the password as-is in DB_PASS, no manual encoding needed.
DB_USER=app
DB_PASS=!ChangeMe!
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=little_isms_helper

# MySQL is the default database (change in .env.local if needed)
# The ${DB_USER} and ${DB_PASS} variables are automatically interpolated and URL-encoded
DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=8.0.32&charset=utf8mb4"

# Alternative database configurations:
# For MariaDB:
# DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# For PostgreSQL:
# DB_PORT=5432
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=16&charset=utf8"
# For SQLite:
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> Azure OAuth2 Configuration ###
# Get these values from Azure Portal > App registrations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Directory id (GUID) of your Entra tenant. Only this directory may sign in;
# "common"/"organizations" allow none unless AZURE_ALLOWED_TENANT_IDS lists them.
AZURE_TENANT_ID=
# Further directories allowed to sign in (comma-separated GUIDs), e.g. a holding.
AZURE_ALLOWED_TENANT_IDS=
# Link an existing local account by e-mail on first Azure login (object id unknown).
# Off by default. Needs a verified e-mail (Entra optional claim xms_edov in the ID
# token); privileged accounts are never linked by e-mail.
AZURE_ALLOW_EMAIL_LINKING=false
###< Azure OAuth2 Configuration ###

###> Azure SAML Configuration ###
# Get these values from Azure Portal > Enterprise applications > SAML configuration
# SP entity id and ACS URL are built from DEFAULT_URI (public address), never the Host header.
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLO_URL=
SAML_IDP_CERT=
# Generate SP certificate and key with: openssl req -new -x509 -days 3652 -nodes -out sp.crt -keyout sp.key
SAML_SP_CERT=
SAML_SP_PRIVATE_KEY=
###< Azure SAML Configuration ###

###> WS-1 Feature Flags ###
# Dark-launch flag for mapping-based inheritance suggestions (docs/DATA_REUSE_IMPROVEMENT_PLAN.md v1.1).
COMPLIANCE_MAPPING_INHERITANCE_ENABLED=0
###< WS-1 Feature Flags ###
TISAX_PRE_FILL_TARGET=60
